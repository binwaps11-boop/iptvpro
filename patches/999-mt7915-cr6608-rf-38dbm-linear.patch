 #include "mt7915.h"
 #include "mcu.h"
 #include "mac.h"
@@ -39,6 +40,21 @@ static bool sr_scene_detect = true;
 module_param(sr_scene_detect, bool, 0644);
 MODULE_PARM_DESC(sr_scene_detect, "Enable firmware scene detection algorithm");
 
+static bool cr6608_rf_38dbm;
+module_param(cr6608_rf_38dbm, bool, 0444);
+MODULE_PARM_DESC(cr6608_rf_38dbm,
+		 "CR6608: raise mt7915 SKU/target power ceiling to 38 dBm request");
+
+bool mt7915_cr6608_rf_38dbm_enabled(struct mt7915_dev *dev)
+{
+	if (!dev ||
+	    !is_mt7915(&dev->mt76) ||
+	    !of_machine_is_compatible("xiaomi,mi-router-cr6608"))
+		return false;
+
+	return cr6608_rf_38dbm;
+}
