+			 "CR6608-RF-38DBM-LINEAR enabled (SKU cck/ofdm=76 mcs=72 ru=68 half-dBm; request ceiling only, actual RF hardware/PA limited)\n");
+
 	if (phy->mt76->cap.has_2ghz)
 		__mt7915_init_txpower(phy, &phy->mt76->sband_2g.sband);
 	if (phy->mt76->cap.has_5ghz)
