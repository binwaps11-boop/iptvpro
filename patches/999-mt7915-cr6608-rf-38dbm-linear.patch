diff --git a/mt7915/eeprom.c b/mt7915/eeprom.c
index eb92cbf..866c835 100644
--- a/mt7915/eeprom.c
+++ b/mt7915/eeprom.c
@@ -332,6 +332,10 @@ int mt7915_eeprom_get_target_power(struct mt7915_dev *dev,
 		target_power = is_7976 ? eeprom[index + group] : 0;
 	}
 
+	if (mt7915_cr6608_rf_38dbm_enabled(dev) &&
+	    target_power < MT7915_CR6608_MAX_HALF_DBM)
+		target_power = MT7915_CR6608_MAX_HALF_DBM;
+
 	return target_power;
 }
 
@@ -356,7 +360,12 @@ s8 mt7915_eeprom_get_power_delta(struct mt7915_dev *dev, int band)
 
 	delta = FIELD_GET(MT_EE_RATE_DELTA_MASK, val);
 
-	return val & MT_EE_RATE_DELTA_SIGN ? delta : -delta;
+	delta = val & MT_EE_RATE_DELTA_SIGN ? delta : -delta;
+
+	if (mt7915_cr6608_rf_38dbm_enabled(dev))
+		delta += MT7915_CR6608_EXTRA_DELTA_HALF;
+
+	return delta;
 }
 
 bool
diff --git a/mt7915/init.c b/mt7915/init.c
