+		if (mt7915_cr6608_rf_38dbm_enabled(dev)) {
+			chan->max_reg_power =
+				max_t(int, chan->max_reg_power,
+				      MT7915_CR6608_MAX_DBM);
+			chan->max_power = MT7915_CR6608_MAX_DBM;
+			chan->orig_mpwr = MT7915_CR6608_MAX_DBM;
+		}
 	}
 }
 
