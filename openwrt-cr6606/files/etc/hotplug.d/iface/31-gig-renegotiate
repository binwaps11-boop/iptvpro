#!/bin/sh
# Keep EEE off + nudge gigabit re-negotiation on link-up for mt7530 DSA ports.
# SAFE: never forces a speed; only restarts autoneg when a port is stuck at 100M AND
# its link-partner advertises 1000baseT (i.e. driver/EEE issue, not a 2-pair cable).
[ "$ACTION" = "ifup" ] || exit 0
command -v ethtool >/dev/null 2>&1 || exit 0
for p in lan1 lan2 lan3 lan4 wan; do
	[ -e "/sys/class/net/$p" ] || continue
	ethtool --set-eee "$p" eee off >/dev/null 2>&1
	car="$(cat /sys/class/net/$p/carrier 2>/dev/null)"
	spd="$(cat /sys/class/net/$p/speed 2>/dev/null)"
	[ "$car" = "1" ] && [ "$spd" = "100" ] || continue
	# only if the PEER actually offers gigabit (else it's the cable/peer — leave it)
	if ethtool "$p" 2>/dev/null | sed -n '/Link partner advertised link modes/,/Link partner advertised pause/p' | grep -q '1000baseT'; then
		ethtool -r "$p" >/dev/null 2>&1   # restart autonegotiation (no forced speed)
	fi
done
exit 0
