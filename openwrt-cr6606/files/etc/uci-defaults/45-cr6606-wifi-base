#!/bin/sh
# =============================================================================
# 45-cr6606-wifi-base  —  SHARED Wi-Fi base for ALL CR6606 variants
# -----------------------------------------------------------------------------
# Brings BOTH MT7915 radios up (2.4G + 5G), sets a country, SSID + WPA2 per band,
# and 802.11k/v. Does NOT set channel/htmode/txpower here — those are owned by the
# per-variant file (50-cr6606-variant) so each build can differ.
#
# 2x2 CHAINS: we deliberately DO NOT set txantenna/rxantenna. mt76 uses both chains
# by default (full 2x2). Restricting them would CUT a chain; not touching them keeps
# the radio at 2x2. Chains are PROVEN at runtime (iw phy "Available Antennas" = 0x3,
# station NSS=2) by /root/cr6606_all_channels_test.sh — never faked.
#
# NO EEPROM/caldata write, NO MAC change. Idempotent (guard file). UCI only.
# =============================================================================
[ -f /etc/cr6606-wifi.done ] && exit 0

COUNTRY="US"          # change here if your actual country gives a better legal table
KEY="Smart@12345"     # default WPA2 key (>=8) — change from the dashboard after flash
did=""                # set once >=1 radio is normalized (first-boot ordering guard)

# Wipe EVERY existing wifi-iface FIRST so no stray/duplicate/OPEN/OWE AP can survive
# from the board's default wireless config. A leftover open/OWE iface on a radio is
# exactly how the 2.4G ended up shown as "Enhanced Open" (OWE, no password). We then
# create exactly ONE secured (WPA2) AP per radio below.
while uci -q delete wireless.@wifi-iface[0]; do :; done

for dev in $(uci -q show wireless | sed -n "s/^wireless\.\([^.=]*\)=wifi-device/\1/p"); do
	did=1
	uci -q set wireless.$dev.country="$COUNTRY"
	uci -q set wireless.$dev.disabled='0'
	uci -q set wireless.$dev.cell_density='0'   # no extra distance-based power back-off

	band="$(uci -q get wireless.$dev.band)"
	case "$band" in 6g) ssfx='-6G';; 5g) ssfx='-5G';; *) ssfx='';; esac

	# create exactly ONE fresh AP iface for this radio (all old ifaces wiped above)
	ifc="$(uci add wireless wifi-iface)"
	uci -q set wireless.$ifc.device="$dev"
	uci -q set wireless.$ifc.mode='ap'
	uci -q set wireless.$ifc.network='lan'
	uci -q set wireless.$ifc.ssid="Smart-AP$ssfx"
	uci -q set wireless.$ifc.encryption='psk2'
	uci -q set wireless.$ifc.key="$KEY"
	uci -q set wireless.$ifc.ieee80211k='1'
	uci -q set wireless.$ifc.ieee80211v='1'

	# --- STRONG build: clean range/throughput boosters (real, not power) ---
	# keep distant/weak clients connected instead of kicking them (wider felt range)
	uci -q set wireless.$ifc.disassoc_low_ack='0'
	# explicit beamforming: focuses energy toward each client => more effective range.
	# (OpenWrt drops any option the driver/hostapd doesn't support, so this is safe.)
	uci -q set wireless.$ifc.vht_su_beamformer='1'
	uci -q set wireless.$ifc.vht_su_beamformee='1'
	uci -q set wireless.$ifc.vht_mu_beamformer='1'
	uci -q set wireless.$ifc.he_su_beamformer='1'
	uci -q set wireless.$ifc.he_su_beamformee='1'
	uci -q set wireless.$ifc.he_mu_beamformer='1'
	# IPTV/streaming over Wi-Fi: convert multicast -> per-client unicast (much higher
	# effective rate + reliability for live streams). Big win for IPTV on Wi-Fi.
	uci -q set wireless.$ifc.multicast_to_unicast='1'
	# IPTV/PS latency floor: deliver buffered multicast every beacon (~100ms) vs default 2.
	uci -q set wireless.$ifc.dtim_period='1'
	# explicitly assert WMM/WME QoS (needed for HE AMPDU aggregation + AC_VI video priority).
	uci -q set wireless.$ifc.wmm='1'
done

# first-boot ordering race: if /etc/config/wireless wasn't generated yet, no radio was
# normalized — exit WITHOUT writing the guard so this retries on the next boot.
[ -n "$did" ] || exit 0
uci -q commit wireless
touch /etc/cr6606-wifi.done
exit 0
