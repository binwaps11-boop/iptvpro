{
	"luci-app-kt412": {
		"description": "Grant access to the Smart AP (KT412) dashboard views",
		"read": {
			"ubus": {
				"session": [ "access", "get", "set" ],
				"network.wireless": [ "status" ],
				"network.interface": [ "dump" ],
				"system": [ "info", "board" ]
			},
			"uci": [ "wireless", "network", "dhcp", "system", "luci" ]
		},
		"write": {
			"ubus": {
				"session": [ "set" ]
			},
			"uci": [ "wireless", "network", "dhcp", "system" ]
		}
	}
}
