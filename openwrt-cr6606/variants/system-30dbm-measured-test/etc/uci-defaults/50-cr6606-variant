#!/bin/sh
# =============================================================================
# 50-cr6606-variant  (VARIANT: cr6606-system-30dbm-measured-test)
# -----------------------------------------------------------------------------
# Same clean tuning as the stable build, but this is the POWER-TEST image: the
# system REQUESTS 30 dBm on BOTH radios and ships the all-channel measurement
# tooling + dmesg markers so you can PROVE where the real RF lands / gets clamped.
#   2.4G : HE20  ch1   txpower 30
#   5G   : HE80  ch149  txpower 30
# This is an HONEST driver/system request — NOT a regdb/caldata break. Real output
# = min(30, regdb, caldata); /root/cr6606_all_channels_test.sh measures it.
# NO EEPROM/caldata write, NO MAC change, NO regdb patch, NO fake numbers.
# Idempotent (guard). Runs after 45-cr6606-wifi-base.
# =============================================================================
[ -f /etc/cr6606-variant.done ] && exit 0

for dev in $(uci -q show wireless | sed -n "s/^wireless\.\([^.=]*\)=wifi-device/\1/p"); do
	uci -q set wireless.$dev.txpower='30'   # request the US legal max on every radio
	case "$(uci -q get wireless.$dev.band)" in
		# 2.4G: HE20 (20 MHz) — user choice for MAX RANGE / wall penetration. 2x2 HE20
		# still peaks ~287 Mbps PHY (HE-MCS11, 2 streams); a narrower channel concentrates
		# the same TX power into half the spectrum => higher spectral density + far more
		# robust at distance than HE40. noscan is a 40 MHz coexistence knob, so it is
		# intentionally NOT set here. Power untouched (30).
		2g) uci -q set wireless.$dev.channel='1';   uci -q set wireless.$dev.htmode='HE20';;
		5g) uci -q set wireless.$dev.channel='149'; uci -q set wireless.$dev.htmode='HE80';;
	esac
done
uci -q commit wireless

if uci -q get firewall.@defaults[0] >/dev/null 2>&1; then
	uci -q set firewall.@defaults[0].flow_offloading='1'
	# HW PPE offload OFF: mt7621 24.10 PPE has a conntrack bug that drops long-lived
	# UDP (IPTV multicast). Software offload + packet_steering carry AX1800 line-rate.
	uci -q set firewall.@defaults[0].flow_offloading_hw='0'
	uci -q commit firewall
fi

touch /etc/cr6606-variant.done
exit 0
