#!/bin/sh
# ===========================================================================
# VARIANT: cr6606-max-clean-measured
# MAX CLEAN power = request the regulatory maximum; the driver applies up to
# the caldata/PA ceiling (the real hardware limit). NO caldata/EEPROM/MAC/DFS
# tampering. This is the highest HONEST power the device can emit.
# 2.4G: HE20 (range) + ACS(1/6/11). 5G: HE80 + ch149 (UNII-3, non-DFS).
# Full 2x2 (no antenna mask). SW+HW flow offload. Ships /root/cr6606-ab-compare.sh.
# ===========================================================================
. /lib/functions.sh
COUNTRY='US'
PW='30'

set_iface_ssid() {
	local radio="$1" ssid="$2" sec="cr6606_${radio}"
	uci -q delete wireless.${sec} 2>/dev/null
	uci -q set wireless.${sec}='wifi-iface'
	uci -q set wireless.${sec}.device="$radio"
	uci -q set wireless.${sec}.mode='ap'
	uci -q set wireless.${sec}.network='lan'
	uci -q set wireless.${sec}.ssid="$ssid"
	uci -q set wireless.${sec}.encryption='psk2'
	uci -q set wireless.${sec}.key='Cr6606-Change-Me'
}

[ -s /etc/config/wireless ] || /sbin/wifi config 2>/dev/null || true

for r in $(uci -q show wireless | sed -n 's/^wireless\.\([a-z0-9]*\)=wifi-device/\1/p'); do
	band="$(uci -q get wireless.${r}.band)"
	uci -q set wireless.${r}.country="$COUNTRY"
	uci -q set wireless.${r}.txpower="$PW"
	uci -q set wireless.${r}.disabled='0'
	uci -q set wireless.${r}.cell_density='0'
	uci -q delete wireless.${r}.txantenna 2>/dev/null    # use ALL chains (2x2)
	uci -q delete wireless.${r}.rxantenna 2>/dev/null
	case "$band" in
		2g) uci -q set wireless.${r}.htmode='HE20'; uci -q set wireless.${r}.channel='auto'; set_iface_ssid "$r" 'Xiaomi-2G' ;;
		5g) uci -q set wireless.${r}.htmode='HE80'; uci -q set wireless.${r}.channel='149'; set_iface_ssid "$r" 'Xiaomi-5G' ;;
	esac
done
for i in $(uci -q show wireless | sed -n 's/^wireless\.\(default_[a-z0-9]*\)=wifi-iface/\1/p'); do
	uci -q delete wireless.${i}
done

uci -q set firewall.@defaults[0].flow_offloading='1'
uci -q set firewall.@defaults[0].flow_offloading_hw='1'

chmod +x /etc/init.d/cr6606-maxclean-marker 2>/dev/null
[ -x /etc/init.d/cr6606-maxclean-marker ] && /etc/init.d/cr6606-maxclean-marker enable 2>/dev/null

uci -q commit wireless
uci -q commit firewall
logger -t cr6606-wifi "MAX-CLEAN applied: country=US txpower=30(req, applied up to caldata ceiling) 2g=HE20 5g=HE80/149 2x2 offload=sw+hw"
exit 0
