#!/bin/sh /etc/rc.common
# procd service for the CR6606 health check (auto-restart, no reboots).
START=99
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /bin/sh /root/cr6606-healthcheck.sh 60
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 0
	procd_set_param stderr 1
	procd_close_instance
}
