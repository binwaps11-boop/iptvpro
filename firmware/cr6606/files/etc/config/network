#
# (G) /etc/config/network  —  CR6606 default: router mode, DSA layout.
# LAN 192.168.100.1/24, WAN DHCP. Port names follow OpenWrt DSA for mt7621.
# >>> VERIFY YOUR PORT NAMES against `ip link` / `bridge link` on YOUR unit. <<<
# On the stock CR660x DTS the ports are: wan, lan1, lan2, lan3.
#

config interface 'loopback'
	option device 'lo'
	option proto 'static'
	option ipaddr '127.0.0.1'
	option netmask '255.0.0.0'

config globals 'globals'
	option ula_prefix 'fdca:1234:5678::/48'

config device
	option name 'br-lan'
	option type 'bridge'
	list ports 'lan1'
	list ports 'lan2'
	list ports 'lan3'

config interface 'lan'
	option device 'br-lan'
	option proto 'static'
	option ipaddr '192.168.100.1'
	option netmask '255.255.255.0'
	option ip6assign '60'

# WAN = DHCP by default. PPPoE / static templates are in templates/.
config interface 'wan'
	option device 'wan'
	option proto 'dhcp'
	option peerdns '1'

config interface 'wan6'
	option device 'wan'
	option proto 'dhcpv6'
