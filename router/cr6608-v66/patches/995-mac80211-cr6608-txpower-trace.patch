 #include <linux/rtnetlink.h>
 #include <linux/vmalloc.h>
 #include "ieee80211_i.h"
@@ -72,6 +74,60 @@
 DEBUGFS_READONLY_FILE(rate_ctrl_alg, "%s",
 	local->rate_ctrl ? local->rate_ctrl->ops->name : "hw/driver");
 
+static ssize_t txpower_state_read(struct file *file, char __user *userbuf,
+				  size_t count, loff_t *ppos)
+{
+	struct ieee80211_local *local = file->private_data;
+	struct ieee80211_sub_if_data *sdata;
+	struct cfg80211_chan_def chandef;
+	u64 snapshot_uptime_ms;
+	char buf[320];
+	int band = -1, channel = -1, freq = -1, width = -1;
+	int chandef_power = -127, vif_power = INT_MAX;
+	int len;
+
+	wiphy_lock(local->hw.wiphy);
+	chandef = local->hw.conf.chandef;
+	snapshot_uptime_ms = div_u64(ktime_get_boottime_ns(), NSEC_PER_MSEC);
+	if (chandef.chan && cfg80211_chandef_valid(&chandef)) {
+		band = chandef.chan->band;
+		channel = chandef.chan->hw_value;
+		freq = chandef.chan->center_freq;
+		width = chandef.width;
+		chandef_power = ieee80211_chandef_max_power(&chandef);
+	}
+
+	rcu_read_lock();
+	list_for_each_entry_rcu(sdata, &local->interfaces, list) {
+		if (!rcu_access_pointer(sdata->vif.bss_conf.chanctx_conf))
+			continue;
+		if (sdata->vif.type == NL80211_IFTYPE_AP_VLAN)
+			continue;
+		if (sdata->vif.bss_conf.txpower == INT_MIN)
+			continue;
+		vif_power = min(vif_power, sdata->vif.bss_conf.txpower);
+	}
+	rcu_read_unlock();
+
+	len = scnprintf(buf, sizeof(buf),
+			"snapshot_seq=%u snapshot_uptime_ms=%llu valid=%u wiphy=%s band=%d channel=%d freq=%d width=%d user_dbm=%d chandef_dbm=%d vif_dbm=%d result_dbm=%d\n",
+			local->txpower_state_generation, snapshot_uptime_ms,
+			chandef.chan && cfg80211_chandef_valid(&chandef),
+			wiphy_name(local->hw.wiphy), band, channel, freq, width,
+			local->user_power_level, chandef_power,
+			vif_power == INT_MAX ? -127 : vif_power,
+			local->hw.conf.power_level);
+	wiphy_unlock(local->hw.wiphy);
+
+	return simple_read_from_buffer(userbuf, count, ppos, buf, len);
+}
+
+static const struct file_operations txpower_state_ops = {
+	.read = txpower_state_read,
+	.open = simple_open,
+	.llseek = generic_file_llseek,
+};
+
 static ssize_t aqm_read(struct file *file,
 			char __user *user_buf,
 			size_t count,
@@ -705,6 +761,7 @@
