#!/bin/sh

SESSION_AUTH_LIB="${CR6608_SESSION_AUTH_LIB:-/usr/libexec/cr6608-session-auth}"
SET_COOKIE=""
CLEAR_LEGACY_COOKIE=""
PENDING_LUCI_SID=""

cleanup_pending_luci_session() {
	[ -n "$PENDING_LUCI_SID" ] || return 0
	if command -v cr6608_destroy_luci_session >/dev/null 2>&1; then
		cr6608_destroy_luci_session "$PENDING_LUCI_SID" >/dev/null 2>&1 || true
	fi
	PENDING_LUCI_SID=""
}

reply() {
	status="$1"; payload="$2"
	[ -n "$status" ] && printf 'Status: %s\r\n' "$status"
	[ "$status" = "405 Method Not Allowed" ] && printf 'Allow: POST\r\n'
	[ "$status" = "503 Service Unavailable" ] && printf 'Retry-After: 1\r\n'
	[ "$status" = "429 Too Many Requests" ] && printf 'Retry-After: 60\r\n'
	printf 'Content-Type: application/json\r\nCache-Control: no-store\r\nX-Content-Type-Options: nosniff\r\nReferrer-Policy: no-referrer\r\nX-Frame-Options: DENY\r\nContent-Security-Policy: default-src '\''none'\''; frame-ancestors '\''none'\''\r\n'
	[ -n "$CLEAR_LEGACY_COOKIE" ] && printf 'Set-Cookie: %s\r\n' "$CLEAR_LEGACY_COOKIE"
	[ -n "$SET_COOKIE" ] && printf 'Set-Cookie: %s\r\n' "$SET_COOKIE"
	printf '\r\n'
	printf '%s\n' "$payload"
	cleanup_pending_luci_session
	exit 0
}

[ -r "$SESSION_AUTH_LIB" ] || reply "500 Internal Server Error" '{"ok":false,"message":"session security helper unavailable"}'
. "$SESSION_AUTH_LIB" || reply "500 Internal Server Error" '{"ok":false,"message":"session security helper unavailable"}'

[ "${REQUEST_METHOD:-GET}" = POST ] || reply "405 Method Not Allowed" '{"ok":false,"message":"POST required"}'
CL="${CONTENT_LENGTH:-0}"
case "$CL" in ''|*[!0-9]*) reply "400 Bad Request" '{"ok":false,"message":"invalid Content-Length"}' ;; esac
[ "${#CL}" -le 4 ] 2>/dev/null && [ "$CL" -le 4096 ] 2>/dev/null || reply "413 Payload Too Large" '{"ok":false,"message":"request too large"}'
BODY=""
[ "$CL" -gt 0 ] 2>/dev/null && BODY="$(head -c "$CL" 2>/dev/null)"

form_value() {
	printf '%s' "$BODY" | tr '&' '\n' | sed -n "s/^$1=//p" | head -n 1 | awk '
		BEGIN { for (i = 0; i < 256; i++) { x = sprintf("%02X", i); h[x] = h[tolower(x)] = sprintf("%c", i) } }
		{ gsub(/\+/, " "); n = split($0, a, "%"); out = a[1];
		  for (i = 2; i <= n; i++) { c = substr(a[i], 1, 2); out = out ((c in h) ? h[c] substr(a[i], 3) : "%" a[i]) }
		  printf "%s", out }
	'
}

case "${CONTENT_TYPE:-}" in
	application/json*)
		user="$(jsonfilter -s "$BODY" -e '@.username' 2>/dev/null)"
		pass="$(jsonfilter -s "$BODY" -e '@.password' 2>/dev/null)"
		;;
	application/x-www-form-urlencoded*)
		user="$(form_value username)"
		pass="$(form_value password)"
		;;
	*) reply "415 Unsupported Media Type" '{"ok":false,"message":"JSON or form body required"}' ;;
esac

client="$(printf '%s' "${REMOTE_ADDR:-unknown}" | sed 's/[^0-9A-Fa-f:.]//g' | cut -c1-64)"
[ -n "$client" ] || client=unknown
RATE_DIR=/tmp/dashlogin-rate
umask 077
cr6608_prepare_root_dir "$RATE_DIR" 0700 ||
	reply "503 Service Unavailable" '{"ok":false,"message":"login limiter unavailable"}'
rate_id="$(printf '%s' "$client" | md5sum | cut -c1-32)"
rate_file="$RATE_DIR/$rate_id"
rate_lock="$rate_file.lock"
[ ! -L "$rate_lock" ] || reply "503 Service Unavailable" '{"ok":false,"message":"login limiter unavailable"}'
exec 8>>"$rate_lock" || reply "503 Service Unavailable" '{"ok":false,"message":"login limiter unavailable"}'
chmod 0600 "$rate_lock" 2>/dev/null || reply "503 Service Unavailable" '{"ok":false,"message":"login limiter unavailable"}'
cr6608_path_owned_by_root "$rate_lock" || reply "503 Service Unavailable" '{"ok":false,"message":"login limiter unavailable"}'
flock -xn 8 || reply "503 Service Unavailable" '{"ok":false,"message":"login limiter busy; retry"}'
# Rate-limit against monotonic uptime, not wall-clock time.  NTP/browser time
# synchronisation can move CLOCK_REALTIME backwards after boot; the previous
# implementation then kept an otherwise valid client blocked until the clock
# caught up with the old timestamp.  /tmp is reboot-volatile, so uptime is the
# correct lifetime for both new and legacy limiter files.
now="$(cr6608_uptime_seconds)"; case "$now" in ''|*[!0-9]*) now=0 ;; esac
fails=0; window="$now"
if [ -r "$rate_file" ]; then
	read -r fails window < "$rate_file" || true
fi
case "$fails" in ''|*[!0-9]*) fails=0 ;; esac
case "$window" in ''|*[!0-9]*) window="$now" ;; esac
[ "$now" -ge "$window" ] 2>/dev/null && [ $((now - window)) -le 60 ] 2>/dev/null || {
	fails=0
	window="$now"
}
if [ "$fails" -ge 5 ] 2>/dev/null; then
	sleep 2
	reply "429 Too Many Requests" '{"ok":false,"message":"too many failed attempts; retry later"}'
fi

login_failed() {
	fails=$((fails + 1))
	printf '%s %s\n' "$fails" "$window" >"$rate_file" ||
		reply "503 Service Unavailable" '{"ok":false,"message":"login limiter unavailable"}'
	sleep "$([ "$fails" -ge 3 ] 2>/dev/null && echo 2 || echo 1)"
	reply "401 Unauthorized" '{"ok":false,"message":"invalid username or password"}'
}

[ -n "$user" ] || user=root
# Accept the familiar router-UI name as an alias, but authenticate only the
# real root account below.  This handles password-manager/autofill profiles
# which replace the visible `root` value with `admin`; it does not create a
# second account, grant another ACL, or change the password being checked.
user="$(printf '%s' "$user" | tr '[:upper:]' '[:lower:]' |
	sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
case "$user" in
	root|admin) user=root ;;
	*) login_failed ;;
esac

# Authenticate through rpcd's root login. The $p$root indirection validates
# the live /etc/shadow credential, keeping Smart AP, LuCI, SSH and console
# authentication synchronized without copying a password hash into UCI.
[ -r /usr/share/libubox/jshn.sh ] || reply "503 Service Unavailable" '{"ok":false,"message":"authentication service unavailable"}'
. /usr/share/libubox/jshn.sh || reply "503 Service Unavailable" '{"ok":false,"message":"authentication service unavailable"}'
json_init
json_add_string username "$user"
json_add_string password "$pass"
# This authenticated rpcd session becomes the LuCI session as well.  Keeping
# its lifetime aligned with the Smart AP cookie avoids a second session-create
# and dozens of ACL grants when the operator opens OpenWrt settings.
json_add_int timeout 43200
login_request="$(json_dump)"
login_reply="$(cr6608_ubus -S call session login "$login_request" 2>/dev/null)"
login_rc=$?
if [ "$login_rc" -ne 0 ]; then
	case "$login_rc" in
		7|124) reply "503 Service Unavailable" '{"ok":false,"message":"authentication service timed out"}' ;;
	esac
	login_failed
fi
login_sid="$(jsonfilter -s "$login_reply" -e '@.ubus_rpc_session' 2>/dev/null)"
cr6608_valid_hex32 "$login_sid" || login_failed
PENDING_LUCI_SID="$login_sid"
unset pass login_request login_reply

rm -f "$rate_file" 2>/dev/null || reply "503 Service Unavailable" '{"ok":false,"message":"login limiter unavailable"}'
flock -u 8 2>/dev/null || true
exec 8>&-

cr6608_luci_session_lock || reply "503 Service Unavailable" '{"ok":false,"message":"session lock unavailable"}'
existing_tok="$(cr6608_session_from_request)"
if cr6608_session_valid "$existing_tok"; then
	# Rotate both bearers after every successful authentication.  This prevents
	# session fixation and guarantees that an old LuCI cookie is revoked.
	cr6608_revoke_session_unlocked "$existing_tok" ||
		reply "503 Service Unavailable" '{"ok":false,"message":"old session revocation failed"}'
fi
tok="$(cr6608_random_hex32)" || reply "500 Internal Server Error" '{"ok":false,"message":"session creation failed"}'
session_epoch="$(date +%s 2>/dev/null)"
session_uptime="$(cr6608_uptime_seconds)"
case "$session_epoch" in ''|*[!0-9]*) reply "500 Internal Server Error" '{"ok":false,"message":"session clock unavailable"}' ;; esac
case "$session_uptime" in ''|*[!0-9]*) reply "500 Internal Server Error" '{"ok":false,"message":"session clock unavailable"}' ;; esac

# LuCI requires a CSRF token in the authenticated rpcd session.  The rpcd root
# login already carries the complete read/write ACL set; only this value and
# the private Smart-to-LuCI map are added here.
luci_csrf_token="$(cr6608_random_hex32)" || reply "500 Internal Server Error" '{"ok":false,"message":"session token creation failed"}'
json_init
json_add_string ubus_rpc_session "$login_sid"
json_add_object values
json_add_string username root
json_add_string token "$luci_csrf_token"
json_close_object
cr6608_ubus call session set "$(json_dump)" >/dev/null 2>&1 ||
	reply "503 Service Unavailable" '{"ok":false,"message":"OpenWrt session initialization failed"}'
unset luci_csrf_token

session_tmp="$(mktemp "/tmp/dashsess/.session.$$.XXXXXX" 2>/dev/null)" ||
	reply "500 Internal Server Error" '{"ok":false,"message":"session creation failed"}'
if ! printf '%s %s\n' "$session_epoch" "$session_uptime" >"$session_tmp" ||
   ! chmod 0600 "$session_tmp" ||
   ! mv -f "$session_tmp" "/tmp/dashsess/$tok"; then
	rm -f "$session_tmp" 2>/dev/null
	reply "500 Internal Server Error" '{"ok":false,"message":"session creation failed"}'
fi
if ! cr6608_write_luci_map_unlocked "$tok" "$login_sid"; then
	rm -f "/tmp/dashsess/$tok" 2>/dev/null || true
	reply "500 Internal Server Error" '{"ok":false,"message":"OpenWrt session mapping failed"}'
fi
PENDING_LUCI_SID=""
unset login_sid
for stale_file in $(find /tmp/dashsess -type f ! -name '.luci-session.lock' -mmin +720 -print 2>/dev/null); do
	stale_sid="${stale_file##*/}"
	cr6608_valid_hex32 "$stale_sid" && cr6608_revoke_session_unlocked "$stale_sid" >/dev/null 2>&1 || true
done
secure_cookie=""
[ "${HTTPS:-off}" = on ] && secure_cookie=" Secure;"
cookie_name="$(cr6608_session_cookie_name)"
CLEAR_LEGACY_COOKIE="cr6608_sid=; Path=/; Max-Age=0;${secure_cookie} HttpOnly; SameSite=Strict"
SET_COOKIE="$cookie_name=$tok; Path=/; Max-Age=43200;${secure_cookie} HttpOnly; SameSite=Strict"
reply "" '{"ok":true}'
