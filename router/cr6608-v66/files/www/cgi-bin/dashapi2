}
catv() { [ -r "$1" ] && cat "$1" 2>/dev/null; }
# BEGIN CR6608_DASHAPI2_RUN_LIMIT
collector_budget_seconds="${CR6608_DASHAPI_BUDGET:-10}"
case "$collector_budget_seconds" in ''|*[!0-9]*) collector_budget_seconds=10 ;; esac
[ "$collector_budget_seconds" -ge 5 ] 2>/dev/null && [ "$collector_budget_seconds" -le 30 ] 2>/dev/null || collector_budget_seconds=10
collector_started="$(dashapi_monotonic_seconds 2>/dev/null)" || collector_started=0
collector_deadline=$((collector_started + collector_budget_seconds))
collector_degraded_marker="$cache_dir/.degraded.$$"
collector_remaining() {
  _collector_now="$(dashapi_monotonic_seconds 2>/dev/null)" || return 1
  _collector_left=$((collector_deadline - _collector_now))
  [ "$_collector_left" -gt 0 ] 2>/dev/null || return 1
  printf '%s\n' "$_collector_left"
