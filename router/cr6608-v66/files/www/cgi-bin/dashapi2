  cache_cleanup
  exit 0
fi

cr6608_dashboard_cache_reader_release
if cr6608_dashboard_cache_collector_acquire; then
  cache_owner=1
else
  [ "$internal_refresh" = 0 ] || exit 0
  cache_wait=0
  while [ "$cache_wait" -lt 4 ]; do
    sleep 1
    if cr6608_dashboard_cache_collector_acquire; then cache_owner=1; break; fi
    cache_wait=$((cache_wait + 1))
  done
  if [ "$cache_owner" = 0 ]; then
    cache_load_view || true
    if [ "$cache_valid" = 1 ] && [ "$cache_age" -ge 0 ]; then
      cache_emit_view true
    else
      printf '{"ok":false,"error":"busy","message":"hardware snapshot is already being collected"}\n'
