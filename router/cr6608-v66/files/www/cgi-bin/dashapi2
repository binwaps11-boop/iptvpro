      "$(jstr "$mac")" "$(jstr "$ip")" "$(jnum "$sig")" "$(jnum "$noise")" "$(jnum "$snr")" \
      "$(jnum "$txr")" "$(jnum "$rxr")" "$(jstr "$txdetail")" "$(jstr "$rxdetail")" "$(jnum "$inact")" "$(jnum "$conn")" \
      "$(jnum "$rxb")" "$(jnum "$txb")" "$(jnum "$txp")" "$(jnum "$txretry")" "$(jnum "$txfail")" \
