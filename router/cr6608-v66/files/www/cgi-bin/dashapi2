    function flush(){ if(mac!="") printf "%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s\n", mac, sig, inact, conn, txr, rxr, txdetail, rxdetail, rxb, txb, txp, txretry, txfail }
    /^Station/ { flush(); mac=$2; sig=""; inact=""; conn=""; txr=""; rxr=""; txdetail=""; rxdetail=""; rxb=""; txb=""; txp=""; txretry=""; txfail="" }
