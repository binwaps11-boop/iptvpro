RUN_LIMIT_PID=""
RUN_LIMIT_START=""
RUN_LIMIT_OUT=""
RUN_LIMIT_ERR=""
run_limit_process_start() {
  # /proc/PID/stat encloses comm in parentheses, and comm may itself contain a
  # space or ')'.  Parse after the final ") "; state is tail field 1 and the
  # process identity starttime is tail field 20 (original field 22).
  awk '
    {
      line=$0; close_at=0
      for (i=length(line)-1; i>0; i--)
        if (substr(line,i,2)==") ") { close_at=i; break }
      if (!close_at) exit 1
      count=split(substr(line,close_at+2), field, " ")
      if (count < 20) exit 1
      print field[1] " " field[20]
    }' "/proc/$1/stat" 2>/dev/null
}
run_limit_process_running() {
  _rl_seen="$(run_limit_process_start "$1")"
  [ -n "$_rl_seen" ] || return 1
  _rl_state="${_rl_seen%% *}"
  _rl_seen_start="${_rl_seen#* }"
  [ "$_rl_state" != Z ] && [ "$_rl_seen_start" = "$2" ]
}
run_limit_fast_grace() {
  sleep 0.1 2>/dev/null && return 0
  [ -x /usr/bin/ucode ] &&
    /usr/bin/ucode -e 'sleep(100)' >/dev/null 2>&1 && return 0
  return 0
}
run_limit_signal_group() {
  _rl_signal="$1"
  _rl_group="$2"
  # procps kill needs `--` before a negative process-group id, while BusyBox
  # 1.37 rejects it. Probe only argument parsing with a nonexistent group.
  /bin/kill -0 -- -999999 >/dev/null 2>&1
  if [ "$?" -eq 2 ]; then
    /bin/kill "-$_rl_signal" "-$_rl_group" 2>/dev/null
  else
    /bin/kill "-$_rl_signal" -- "-$_rl_group" 2>/dev/null
  fi
}
run_limit_cancel_active() {
  if [ -n "$RUN_LIMIT_PID" ] && [ -n "$RUN_LIMIT_START" ] &&
     run_limit_process_running "$RUN_LIMIT_PID" "$RUN_LIMIT_START"; then
    run_limit_signal_group TERM "$RUN_LIMIT_PID" ||
      /bin/kill -TERM "$RUN_LIMIT_PID" 2>/dev/null || true
    sleep 1
    # Kill the original process group even if its leader exited after TERM;
    # descendants which ignored TERM can otherwise retain collector resources.
    run_limit_signal_group KILL "$RUN_LIMIT_PID" ||
      /bin/kill -KILL "$RUN_LIMIT_PID" 2>/dev/null || true
  fi
  RUN_LIMIT_PID=""
  RUN_LIMIT_START=""
  [ -z "$RUN_LIMIT_OUT" ] || rm -f "$RUN_LIMIT_OUT" 2>/dev/null
  [ -z "$RUN_LIMIT_ERR" ] || rm -f "$RUN_LIMIT_ERR" 2>/dev/null
  RUN_LIMIT_OUT=""
  RUN_LIMIT_ERR=""
}
run_limit() {
  _rl_sec="$1"; shift
  case "$_rl_sec" in ''|*[!0-9]*|0) _rl_sec=1 ;; esac
  _rl_remaining="$(collector_remaining)" || {
    : > "$collector_degraded_marker"
    return 124
  }
  [ "$_rl_sec" -le "$_rl_remaining" ] 2>/dev/null || _rl_sec="$_rl_remaining"
  _rl_out="$(mktemp "$cache_dir/.dashcmd-out.$$.XXXXXX" 2>/dev/null)" || return 125
  _rl_err="$(mktemp "$cache_dir/.dashcmd-err.$$.XXXXXX" 2>/dev/null)" || {
    rm -f "$_rl_out" 2>/dev/null
    return 125
  }
  chmod 0600 "$_rl_out" "$_rl_err" 2>/dev/null || {
    rm -f "$_rl_out" "$_rl_err" 2>/dev/null
    return 125
  }
  RUN_LIMIT_OUT="$_rl_out"
  RUN_LIMIT_ERR="$_rl_err"
  # setsid gives the bounded command a private process group. Output goes to
  # private regular files so even an uninterruptible kernel task cannot retain
  # the CGI socket, cache locks, or request body descriptors.
  ( close_dashboard_fds; exec /usr/bin/setsid "$@" ) </dev/null >"$_rl_out" 2>"$_rl_err" &
  _rl_pid=$!
  _rl_identity="$(run_limit_process_start "$_rl_pid")"
  _rl_start="${_rl_identity#* }"
  RUN_LIMIT_PID="$_rl_pid"
  RUN_LIMIT_START="$_rl_start"
  if [ -z "$_rl_identity" ] || [ -z "$_rl_start" ]; then
    # A fast command can finish before procfs is sampled. Reap only a process
    # already known to be gone. If it is still present but cannot be identified,
    # kill it and return without an unbounded wait (for example, a D-state task).
    if /bin/kill -0 "$_rl_pid" 2>/dev/null; then
      run_limit_signal_group KILL "$_rl_pid" ||
        /bin/kill -KILL "$_rl_pid" 2>/dev/null || true
      _rl_rc=125
    else
      wait "$_rl_pid" 2>/dev/null
      _rl_rc=$?
    fi
  else
    _rl_elapsed=0
    if run_limit_process_running "$_rl_pid" "$_rl_start"; then
      run_limit_fast_grace
    fi
    while run_limit_process_running "$_rl_pid" "$_rl_start" &&
          [ "$_rl_elapsed" -lt "$_rl_sec" ]; do
      sleep 1
      _rl_elapsed=$((_rl_elapsed + 1))
    done
    if run_limit_process_running "$_rl_pid" "$_rl_start"; then
      run_limit_signal_group TERM "$_rl_pid" ||
        /bin/kill -TERM "$_rl_pid" 2>/dev/null || true
      sleep 1
      run_limit_signal_group KILL "$_rl_pid" ||
        /bin/kill -KILL "$_rl_pid" 2>/dev/null || true
      sleep 1
      _rl_rc=124
      # Never wait for a task that remains uninterruptible. It owns only the
      # private files unlinked below, so the CGI request can still complete.
      if ! run_limit_process_running "$_rl_pid" "$_rl_start"; then
        wait "$_rl_pid" 2>/dev/null || true
      fi
    else
      wait "$_rl_pid" 2>/dev/null
      _rl_rc=$?
    fi
  fi
  RUN_LIMIT_PID=""
  RUN_LIMIT_START=""
  cat "$_rl_out"
  cat "$_rl_err" >&2
  rm -f "$_rl_out" "$_rl_err" 2>/dev/null
  RUN_LIMIT_OUT=""
  RUN_LIMIT_ERR=""
  case "$_rl_rc" in 124|125|137|143) : > "$collector_degraded_marker" ;; esac
  return "$_rl_rc"
}
# END CR6608_DASHAPI2_RUN_LIMIT
# Every ubus read gets both the native libubus deadline and the independent
# process watchdog from the session helper.
ubus() {
  collector_remaining >/dev/null || { : > "$collector_degraded_marker"; return 124; }
  cr6608_ubus "$@"
}
