iface_json() {
  dev="$1"
  [ -d "/sys/class/net/$dev" ] || return 1
  set -- $(awk -v d="$dev:" '$1==d{printf "%s %s %s %s %s %s", $2, $10, $4, $12, $5, $13}' /proc/net/dev 2>/dev/null)
  rx="${1:-0}"; tx="${2:-0}"; rxerr="${3:-0}"; txerr="${4:-0}"; rxd="${5:-0}"; txd="${6:-0}"
  rx_rate=0; tx_rate=0; pdev="$(printf '%s' "$dev" | tr -c 'A-Za-z0-9_.-' '_')"; prev="$cache_dir/iface.$pdev"
  if [ -r "$prev" ]; then
    read old_rx old_tx old_ts < "$prev"
    rx_rate="$(dashapi_counter_rate "$rx" "$old_rx" "$now_s" "$old_ts")"
    tx_rate="$(dashapi_counter_rate "$tx" "$old_tx" "$now_s" "$old_ts")"
  fi
  # Only advance the baseline when the sample window is strictly positive.
  # Two full collections inside the same 1-second uptime tick give dt=0, which
  # would publish 0 bps AND reset the baseline; skipping the rewrite lets the
  # next run average over a valid longer window instead.
  if [ ! -r "$prev" ] || [ "${old_ts:-0}" -lt "$now_s" ] 2>/dev/null; then
    printf '%s %s %s\n' "$rx" "$tx" "$now_s" > "$prev" 2>/dev/null
  fi
