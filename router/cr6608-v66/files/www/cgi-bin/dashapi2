    return 0
  fi

  # A syntactically valid boot snapshot can still be partial (for example,
  # radio0 is ready while radio1 is still registering).  Retry ubus once only
  # when that cached snapshot lacks the requested interface mapping.
  [ "$used_cached" = 1 ] || return 1
  status="$(ubus -S call network.wireless status 2>/dev/null)"
  dev="$(wifi_dev_from_status "$ifn" "$status")" || dev=""
  [ -n "$dev" ] || return 1
  printf '%s\n' "$dev"
}
# END CR6608_DASHAPI2_WIRELESS_STATUS_HELPER

phy_for_dev() {
  local dev="$1" ifn="$2" wiphy configured_band path candidate
  if [ -n "$ifn" ]; then
    wiphy="$(iw dev "$ifn" info 2>/dev/null | awk '$1=="wiphy"{print $2; exit}')"
    [ -z "$wiphy" ] || { printf 'phy%s\n' "$wiphy"; return 0; }
  fi
  configured_band="$(uci -q get "wireless.${dev}.band" 2>/dev/null)"
  for path in /sys/class/ieee80211/*; do
    [ -e "$path" ] || continue
    candidate="${path##*/}"
    iw phy "$candidate" info 2>/dev/null | awk -v wanted="$configured_band" '
      / MHz \[[0-9]+\]/ {
        band = (($2 + 0) < 3000 ? "2g" : (($2 + 0) < 5925 ? "5g" : "6g"))
        if (band == wanted) found = 1
      }
      END { exit(found ? 0 : 1) }
    ' || continue
    printf '%s\n' "$candidate"
    return 0
  done
  return 1
}

txpower_applied_for_if() {
  ifn="$1"
  value="$(iw dev "$ifn" info 2>/dev/null | awk '$1=="txpower"{print $2; exit}')"
  [ -n "$value" ] || value="$(iwinfo "$ifn" info 2>/dev/null | sed -n 's/.*Tx-Power: *\([0-9][0-9.]*\) *dBm.*/\1/p' | head -n 1)"
  printf '%s' "$value"
}

# BEGIN CR6608_DASHAPI2_TXPOWER_SNAPSHOT_HELPER
# The interface loop already paid for bounded iw and iwinfo snapshots.  Reuse
# those exact live reads before spawning another command: on MT7621 a busy
# 10-second collector could otherwise exhaust its budget between radio0 and
# radio1 and incorrectly report the second driver's accepted power as unknown.
iw_snapshot_for_if() {
  awk -v target="$1" '
    /^phy#/ {
      if (seen) exit
    }
    $1 == "Interface" {
      if (seen && $2 != target) exit
      active = ($2 == target)
      if (active) seen = 1
    }
    active { print }
  '
}

txpower_applied_from_text() {
  awk '
    $1 == "txpower" && $2 ~ /^[0-9]+([.][0-9]+)?$/ {
      print $2
      exit
    }
    $1 == "Tx-Power:" && $2 ~ /^[0-9]+([.][0-9]+)?$/ {
      print $2
      exit
    }
  '
}

txpower_max_from_text() {
  awk '
    tolower($0) ~ /dbm/ {
      token = ($1 == "*" ? $2 : $1)
      if (token !~ /^[0-9]+([.][0-9]+)?$/) next
      v = token + 0
      if (!seen || v > max) max = v
      seen = 1
    }
    END { if (seen) print max }
  '
}
# END CR6608_DASHAPI2_TXPOWER_SNAPSHOT_HELPER

txpower_max_for_if() {
  iwinfo "$1" txpowerlist 2>/dev/null | txpower_max_from_text
}
txpower_channel_max_for_dev() {
  dev="$1"; ifn="$2"; phy="$3"
  [ -n "$phy" ] || phy="$(phy_for_dev "$dev" "$ifn" 2>/dev/null)" || return
  channel="$(uci -q get wireless."$dev".channel 2>/dev/null)"
  case "$channel" in
    ''|*[!0-9]*)
      [ -n "$ifn" ] || return
      channel="$(iw dev "$ifn" info 2>/dev/null |
        awk '$1 == "channel" { print $2; exit }')"
      ;;
  esac
  case "$channel" in ''|*[!0-9]*) return ;; esac
  iw phy "$phy" info 2>/dev/null |
    sed -n "s/.*\\[$channel\\].*(\\([0-9][0-9.]*\\) dBm).*/\\1/p" |
    head -n 1
}
txpower_effective_max() {
  awk -v channel="$1" -v driver="$2" '
    function numeric(v) { return v ~ /^[0-9]+([.][0-9]+)?$/ }
    BEGIN {
      if (numeric(channel) && numeric(driver))
        print ((channel + 0) < (driver + 0) ? channel : driver)
      else if (numeric(channel))
        print channel
      else if (numeric(driver))
        print driver
    }
  '
}
uci_iface_for_if() {
  ifn="$1"; role="$2"; dev="$3"
  [ -n "$dev" ] || dev="$(wifi_dev_for_if "$ifn")"
  case "$role" in
    AP) want="ap" ;;
    mesh*) want="mesh" ;;
    managed) want="sta" ;;
    *) return ;;
  esac
  [ -n "$dev" ] || return
  uci -q show wireless 2>/dev/null | awk -F'[.=]' -v d="$dev" -v want="$want" '
    /=wifi-iface/{sec=$2; ok=0}
    $0 ~ "\\."sec"\\.device=.?"d".?"{ok=1}
    ok && $0 ~ "\\."sec"\\.mode=.?"want".?"{print sec; exit}
  '
}

primary_iface_for_dev() {
  local dev="$1" section mode first=""
  for section in $(uci -q show wireless 2>/dev/null |
    sed -n 's/^wireless\.\([^.=]*\)=wifi-iface$/\1/p'); do
    [ "$(uci -q get "wireless.${section}.device" 2>/dev/null)" = "$dev" ] ||
      continue
    [ -n "$first" ] || first="$section"
    mode="$(uci -q get "wireless.${section}.mode" 2>/dev/null)"
    [ "$mode" = ap ] || continue
    case "$section" in *rescue*|*recovery*) continue ;; esac
    printf '%s\n' "$section"
    return 0
  done
  [ -z "$first" ] || printf '%s\n' "$first"
}

survey_raw() {
  IF="$1"; fallback_noise="$2"
  iw dev "$IF" survey dump 2>/dev/null | awk -v fb="$fallback_noise" '
    /^Survey data/ { inuse=0 }
    /\[in use\]/ { inuse=1 }
    inuse && /noise:/ {
      for (i=1; i<=NF; i++) if ($i ~ /^-?[0-9]+$/) { noise=$i; break }
    }
    inuse && /channel active time:/ {
      for (i=1; i<=NF; i++) if ($i ~ /^[0-9]+$/) { active=$i; break }
    }
    inuse && /channel busy time:/ {
      for (i=1; i<=NF; i++) if ($i ~ /^[0-9]+$/) { busy=$i; break }
    }
    inuse && /channel receive time:/ && $0 !~ /BSS/ {
      for (i=1; i<=NF; i++) if ($i ~ /^[0-9]+$/) { rx=$i; break }
    }
    inuse && /channel BSS receive time:/ {
      for (i=1; i<=NF; i++) if ($i ~ /^[0-9]+$/) { bss=$i; break }
    }
    inuse && /channel transmit time:/ {
      for (i=1; i<=NF; i++) if ($i ~ /^[0-9]+$/) { tx=$i; break }
    }
    END {
      if (noise == "") noise=fb
      if (noise == "") noise="null"
      if (active == "") active=0
      if (busy == "") busy=0
      if (rx == "") rx=0
      if (tx == "") tx=0
      if (bss == "") bss=0
      printf "%s %s %s %s %s %s\n", noise, active, busy, rx, tx, bss
    }'
}

device_rows="$cache_dir/.devices.$$"
