    cpu_pct="$(awk -v b="$db_cpu" -v t="$dt_cpu" 'BEGIN{v=(b/t)*100; if(v<0)v=0; if(v>100)v=100; printf "%d", v}')"
    printf '%s %s %s %s\n' "$cpu_total" "$cpu_busy" "$uptime_s" "$cpu_pct" > "$cpu_prev" 2>/dev/null
  elif [ "$old_pct" -ge 0 ] 2>/dev/null; then
