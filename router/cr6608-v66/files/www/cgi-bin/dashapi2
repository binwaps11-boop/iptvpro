      [ -e "$_collector_if" ] || continue
      printf '%s:' "${_collector_if##*/}"
      cat "$_collector_if/ifindex" "$_collector_if/operstate" \
        "$_collector_if/carrier" 2>/dev/null || printf 'unavailable\n'
    done
  } | sha256sum 2>/dev/null | awk '{print $1}')"
