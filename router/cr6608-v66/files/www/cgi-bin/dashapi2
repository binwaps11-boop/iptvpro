fdb_live="$cache_dir/.fdb.$$"
lease_rows="$cache_dir/.lease.$$"
bridge fdb show 2>/dev/null | awk '$1 ~ /:/ && !/permanent/ && !/self/ {mac=tolower($1);dev="";for(k=1;k<=NF;k++)if($k=="dev")dev=$(k+1); if(dev!=""&&mac!="00:00:00:00:00:00")print mac"|"dev}' > "$fdb_live"
awk 'NR>1 && $3=="0x2" && $4 ~ /:/ && $4!="00:00:00:00:00:00" && $1 ~ /\./ {print tolower($4) "|" $1 "|" $6 "|Ethernet|"}' /proc/net/arp 2>/dev/null > "$arp_rows"
awk 'NF>=4{print tolower($2)"|"$4}' /tmp/dhcp.leases 2>/dev/null > "$lease_rows"
devices_body="$(awk -F'|' '
  FILENAME ~ /fdb/   { fdbport[$1]=$2; next }
  FILENAME ~ /lease/ { lhost[$1]=$2; next }
  FILENAME ~ /devices/ { wifi[$1]=1 }
  { rows[NR]=$0 }
  END{
    n=0
    for(i=1;i<=NR;i++){
      if(rows[i]=="") continue
      split(rows[i],f,"|"); mac=f[1]
      if(mac=="" || seen[mac]) continue
      if(!wifi[mac] && !(mac in fdbport)) continue
      seen[mac]=1; n++
      host=lhost[mac]; if(host=="*") host=""
      port=f[3]; if(mac in fdbport) port=fdbport[mac]
      printf "%s|%s|%s|%s|%s|%s\n", mac, f[2], port, f[4], f[5], host
    }
  }' "$fdb_live" "$lease_rows" "$device_rows" "$arp_rows" | while IFS='|' read -r mac ip iface typ sig host; do
  [ -n "$mac" ] || continue
  [ "$dfirst" = "" ] && dfirst=1
  [ "$dfirst" = 1 ] || printf ','
  printf '{"ip":%s,"mac":%s,"iface":%s,"type":%s,"host":%s,"signal":%s}' \
    "$(jstr "$ip")" "$(jstr "$mac")" "$(jstr "$iface")" "$(jstr "$typ")" "$(jstr "$host")" "$(jnum "$sig")"
  dfirst=0
done)"
devices="[$devices_body]"
rm -f "$device_rows" "$arp_rows" "$fdb_live" "$lease_rows" 2>/dev/null
clients="$(printf '%s' "$devices_body" | grep -o '"mac"' | wc -l | tr -d ' ')"
[ -n "$clients" ] || clients=0

mem_pct="$(awk -v t="$mt" -v a="$ma" 'BEGIN{if(t>0)printf "%d", (1-a/t)*100; else print 0}')"
st_pct="$(awk -v t="$st_total" -v u="$st_used" 'BEGIN{if(t>0)printf "%d", (u/t)*100; else print 0}')"
score=100
[ "${cpu_pct:-0}" -gt 90 ] 2>/dev/null && score=$((score-10))
[ "${mem_pct:-0}" -gt 90 ] 2>/dev/null && score=$((score-10))
[ "${st_pct:-0}" -gt 90 ] 2>/dev/null && score=$((score-10))
if [ -n "$temp_c" ]; then awk -v t="$temp_c" 'BEGIN{exit !(t>=70)}' && score=$((score-15)); fi
[ "$score" -lt 0 ] && score=0
if [ "$score" -ge 95 ]; then grade="excellent"; elif [ "$score" -ge 70 ]; then grade="ok"; else grade="weak"; fi
health="{\"score\":$score,\"grade\":$(jstr "$grade"),\"busy_pct\":$(jnum "$health_busy_max"),\"reasons\":[{\"level\":\"ok\",\"ar\":\"الواجهة متزامنة مع قراءات النظام الحية\",\"en\":\"Dashboard is synced with live system counters\"}]}"

# Read process names once for the full snapshot. This avoids ubus/pgrep forks
# while exposing real service state instead of mislabeling health-score fields.
service_processes="$(for service_comm in /proc/[0-9]*/comm; do
  [ -r "$service_comm" ] || continue
  IFS= read -r service_name <"$service_comm" 2>/dev/null || service_name=""
  [ -n "$service_name" ] && printf '%s\n' "$service_name"
done)"
service_running() { printf '%s\n' "$service_processes" | grep -Fxq "$1" && echo true || echo false; }
prplmesh_running=false
printf '%s\n' "$service_processes" | grep -Eq '^(beerocks_|ieee1905_)' && prplmesh_running=true
services="{\"uhttpd\":$(service_running uhttpd),\"rpcd\":$(service_running rpcd),\"netifd\":$(service_running netifd),\"dnsmasq\":$(service_running dnsmasq),\"odhcpd\":$(service_running odhcpd),\"prplMesh\":$prplmesh_running}"

# Performance pack live state (read from uci/sysfs so the dashboard shows the REAL config).
pget() { uci -q get "$1" 2>/dev/null; }
pb() { [ "$1" = "1" ] && echo true || echo false; }
# perf JSON is ~24 uci/sysfs forks; cache it for 60s so fast dashboard polls don't burn CPU.
# The first line is the configuration generation, preventing an invalidated
# in-flight collector from feeding old UCI/sysfs state into a fresh snapshot.
perf_cache="$cache_dir/perf"
perf=""
if [ -r "$perf_cache" ] && [ ! -L "$perf_cache" ]; then
  pc_generation="$(sed -n '1p' "$perf_cache" 2>/dev/null)"
  pc_ts="$(sed -n '2p' "$perf_cache" 2>/dev/null)"
  [ "$pc_generation" = "$collector_generation" ] &&
    [ "$((uptime_s - ${pc_ts:-0}))" -ge 0 ] 2>/dev/null &&
    [ "$((uptime_s - ${pc_ts:-0}))" -lt 60 ] 2>/dev/null &&
    perf="$(sed -n '3p' "$perf_cache" 2>/dev/null)"
fi
if [ -z "$perf" ]; then
  drv_banner="$(dmesg 2>/dev/null | grep -oiE 'CR6608-LAB-38[A-Za-z0-9-]*' | tail -1)"; [ -n "$drv_banner" ] || drv_banner="$(logread 2>/dev/null | grep -oiE 'CR6608-LAB-38[A-Za-z0-9-]*' | tail -1)"
  perf="{\"driver_banner\":$(jstr "$drv_banner"),\"txpower\":$(jnum "$(pget wireless.radio1.txpower)"),\"dynack\":$([ "$(pget wireless.radio0.distance)" = "auto" ] && echo true || echo false),\"ldpc\":$(pb "$(pget wireless.radio1.ldpc)"),\"stbc\":$(pb "$(pget wireless.radio1.tx_stbc)"),\"sgi\":$(pb "$(pget wireless.radio1.short_gi_80)"),\"su_bf\":$(pb "$(pget wireless.radio1.he_su_beamformer)"),\"mu_bf_he\":$(pb "$(pget wireless.radio1.he_mu_beamformer)"),\"mu_bf_vht\":$(pb "$(pget wireless.radio1.mu_beamformer)"),\"spatial_reuse\":$([ -n "$(pget wireless.radio1.he_spr_sr_control)" ] && echo true || echo false),\"bss_color\":$(pb "$(pget wireless.radio1.he_bss_color)"),\"airtime\":$(pb "$(pget wireless.radio0.airtime_mode)"),\"kv\":$(pb "$(pget wireless.wifinet0.ieee80211k)"),\"m2u\":$(pb "$(pget wireless.wifinet0.multicast_to_unicast)"),\"maxassoc\":$(jnum "$(pget wireless.wifinet0.maxassoc)"),\"max_inact\":$(jnum "$(pget wireless.wifinet0.max_inactivity)"),\"keep_weak\":$([ "$(pget wireless.wifinet0.disassoc_low_ack)" = "0" ] && echo true || echo false),\"hw_offload\":$(pb "$(pget firewall.@defaults[0].flow_offloading_hw)"),\"sw_offload\":$(pb "$(pget firewall.@defaults[0].flow_offloading)"),\"rps\":$(pb "$(pget network.globals.packet_steering)"),\"dns_cache\":$(jnum "$(pget dhcp.@dnsmasq[0].cachesize)"),\"fastopen\":$([ "$(cat /proc/sys/net/ipv4/tcp_fastopen 2>/dev/null)" = "3" ] && echo true || echo false),\"backlog\":$(jnum "$(cat /proc/sys/net/core/netdev_max_backlog 2>/dev/null)")}"
  perf_tmp="$(mktemp "$cache_dir/.perf.$$.XXXXXX" 2>/dev/null)"
  if [ -n "$perf_tmp" ]; then
    { echo "$collector_generation"; echo "$uptime_s"; echo "$perf"; } >"$perf_tmp" 2>/dev/null &&
      chmod 0600 "$perf_tmp" 2>/dev/null &&
      [ "$(cr6608_dashboard_cache_generation 2>/dev/null)" = "$collector_generation" ] &&
      ! cr6608_dashboard_cache_mutation_active &&
      mv -f "$perf_tmp" "$perf_cache" 2>/dev/null || rm -f "$perf_tmp" 2>/dev/null
  fi
fi

# UL MURU guard state is deliberately injected after the 60-second performance
# cache.  A firmware hang must become visible on the next dashboard refresh,
# not remain hidden behind otherwise-safe configuration caching.
ul_guard_state="missing"
ul_guard_reason="state-file-missing"
if [ -r /tmp/cr6608-ul-muru-state ]; then
  ul_guard_state="$(sed -n 's/.*"state":"\([^"]*\)".*/\1/p' /tmp/cr6608-ul-muru-state | head -n 1)"
  ul_guard_reason="$(sed -n 's/.*"reason":"\([^"]*\)".*/\1/p' /tmp/cr6608-ul-muru-state | head -n 1)"
  [ -n "$ul_guard_state" ] || ul_guard_state="invalid"
  [ -n "$ul_guard_reason" ] || ul_guard_reason="reason-missing"
fi
ul_module_state="$(cat /sys/module/mt7915e/parameters/cr6608_ul_muru 2>/dev/null || printf 'missing')"
perf="${perf%?},\"ul_muru_state\":$(jstr "$ul_guard_state"),\"ul_muru_reason\":$(jstr "$ul_guard_reason"),\"ul_muru_module\":$(jstr "$ul_module_state")}"

# Customer/device identity advertised to MikroTik Neighbor Discovery (MNDP).
identity_enabled="$(pget smartap.identity.enabled)"; [ -n "$identity_enabled" ] || identity_enabled=1
identity_customer="$(pget smartap.identity.customer_name)"
identity_device="$(pget smartap.identity.device_name)"; [ -n "$identity_device" ] || identity_device="${host:-CR6608}"
identity_phone="$(pget smartap.identity.phone)"
identity_interval="$(pget smartap.identity.interval)"; [ -n "$identity_interval" ] || identity_interval=30
neighbor_identity="$(sed -n '1p' /tmp/cr6608-mndp.fields 2>/dev/null)"
if [ -z "$neighbor_identity" ]; then
  neighbor_identity="$identity_device"
  [ -n "$identity_customer" ] && neighbor_identity="$identity_customer | $neighbor_identity"
  [ -n "$identity_phone" ] && neighbor_identity="$neighbor_identity | Tel:$identity_phone"
fi
neighbor_state="$(sed -n 's/^state=//p' /tmp/cr6608-neighbor.status 2>/dev/null | head -n1)"; [ -n "$neighbor_state" ] || neighbor_state="starting"
neighbor_last="$(sed -n 's/^last_epoch=//p' /tmp/cr6608-neighbor.status 2>/dev/null | head -n1)"
[ "$identity_enabled" = 1 ] && identity_enabled_json=true || identity_enabled_json=false
identity="{\"enabled\":$identity_enabled_json,\"customer_name\":$(jstr "$identity_customer"),\"device_name\":$(jstr "$identity_device"),\"phone\":$(jstr "$identity_phone"),\"neighbor_identity\":$(jstr "$neighbor_identity"),\"protocol\":\"MNDP\",\"udp_port\":5678,\"interval_s\":$(jnum "$identity_interval"),\"state\":$(jstr "$neighbor_state"),\"last_epoch\":$(jnum "$neighbor_last")}" 
[ -e "$collector_degraded_marker" ] && collector_degraded_json=true || collector_degraded_json=false

if [ "$cache_owner" = "1" ]; then
  cache_tmp="$(mktemp "$cache_dir/.collect.$$.XXXXXX" 2>/dev/null)" || {
    cache_cleanup
    [ "$internal_refresh" = 1 ] || printf '{"ok":false,"error":"cache_state"}\n'
    exit 0
  }
  exec 3>&1
  exec > "$cache_tmp"
fi
printf '{"ok":true,"collector_degraded":%s,"hostname":%s,"model":%s,"board_name":"xiaomi,mi-router-cr6608","target":"ramips/mt7621","os":%s,"kernel":%s,"uptime":%s,"load":[%s,%s,%s],"cpu":{"cores":%s,"percent":%s,"source":"/proc/stat"},"mem":{"total":%s,"free":%s,"available":%s,"source":"/proc/meminfo"},"storage":{"total":%s,"used":%s,"available":%s,"source":"df -k /overlay"},"temperature_c":%s,"lan_ip":%s,"clients":%s,"backhaul":{"online":%s,"default_route":%s,"device":%s,"gateway":%s},"traffic":{"source":"/proc/net/dev","scope":"client-edge","counter_window":"since-interface-reset","calendar_accounting":false,"topology_complete":%s,"uplink_device":%s,"edge_count":%s,"counter_signature":%s,"rx_bytes":%s,"tx_bytes":%s,"rx_bps":%s,"tx_bps":%s},"switch":{"mode":"Managed switch","ipv6_stack":%s,"ipv6_lan":%s,"ipv6_bridge_passthrough":true},"latency_ms":%s,"health":%s,"services":%s,"perf":%s,"identity":%s,"lte":{"available":false},"interfaces":%s,"wifi":%s,"devices":%s}\n' \
  "$collector_degraded_json" "$(jstr "$host")" "$(jstr "$model")" "$(jstr "$osver")" "$(jstr "$kernel")" "$(jnum "$uptime_s")" \
  "$(jnum "$l1")" "$(jnum "$l5")" "$(jnum "$l15")" "$(jnum "$cpu_units")" "$(jnum "$cpu_pct")" \
  "$(jnum "$mt")" "$(jnum "$mf")" "$(jnum "$ma")" "$(jnum "$st_total")" "$(jnum "$st_used")" "$(jnum "$st_avail")" "$(jnum "$temp_c")" \
  "$(jstr "$lanip")" "$(jnum "$clients")" "$internet_online" "$(jstr "$default4")" "$(jstr "$default_dev")" "$(jstr "$default_gw")" \
  "$traffic_topology" "$(jstr "$traffic_uplink")" "$(jnum "$traffic_edges")" "$(jstr "$traffic_counter_signature")" "$(jnum "$traffic_rx")" "$(jnum "$traffic_tx")" "$(jnum "$rx_bps")" "$(jnum "$tx_bps")" "$ipv6_stack" "$ipv6_lan" "$(jnum "$latency_ms")" \
  "$health" "$services" "$perf" "$identity" "$interfaces" "$wifi" "$devices"
if [ "$cache_owner" = "1" ]; then
  exec 1>&3 3>&-
  collector_end_fingerprint="$(collector_state_fingerprint 2>/dev/null)" || collector_end_fingerprint=""
  collector_coherent=0
  [ -n "$collector_end_fingerprint" ] &&
    [ "$collector_end_fingerprint" = "$collector_start_fingerprint" ] && collector_coherent=1
  if [ "$collector_coherent" = 0 ]; then
    cr6608_dashboard_cache_invalidate >/dev/null 2>&1 ||
      cr6608_dashboard_cache_new_generation >/dev/null 2>&1 || true
  fi
  publish_rc=2
  if [ "$collector_coherent" = 1 ]; then
    cr6608_dashboard_cache_publish "$cache_tmp" "$collector_generation"
    publish_rc=$?
  fi
  if [ "$publish_rc" = 0 ]; then
    rm -f "$cache_tmp" 2>/dev/null
    cache_tmp=""
    if [ "$internal_refresh" = 0 ]; then
      cache_load_view || true
      if [ "$cache_valid" = 1 ] && [ "$cache_is_current" = 1 ] &&
         [ "$cache_age" -ge 0 ] && [ "$cache_age" -le "$cache_fresh_seconds" ]; then
        cache_emit_view false
      elif [ "$cache_valid" = 1 ] && [ "$cache_age" -ge 0 ]; then
        # A mutation can begin after the atomic publish but before this request
        # copies the result.  Never present that invalidated snapshot as fresh.
        cache_emit_view true
      else
        printf '{"ok":false,"error":"cache_publish"}\n'
      fi
    fi
  else
    rm -f "$cache_tmp" 2>/dev/null
    cache_tmp=""
    if [ "$internal_refresh" = 0 ]; then
      cache_load_view || true
      if [ "$cache_valid" = 1 ] && [ "$cache_age" -ge 0 ]; then
        cache_emit_view true
      elif [ "$publish_rc" = 2 ]; then
        printf '{"ok":false,"error":"invalidated","message":"configuration changed during collection"}\n'
      else
        printf '{"ok":false,"error":"cache_publish","message":"hardware snapshot validation failed"}\n'
      fi
    fi
  fi
  cache_cleanup
fi
