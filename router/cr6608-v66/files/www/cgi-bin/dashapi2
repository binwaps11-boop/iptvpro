#!/bin/sh

SESSION_AUTH_LIB="${CR6608_SESSION_AUTH_LIB:-/usr/libexec/cr6608-session-auth}"
. "$SESSION_AUTH_LIB" || exit 1

internal_refresh="${CR6608_DASHAPI_INTERNAL:-0}"
[ "$internal_refresh" = 1 ] || internal_refresh=0
session_probe=0
case "&${QUERY_STRING:-}&" in
  *'&lite=1&'*)
    case "&${QUERY_STRING:-}&" in *'&probe=1&'*) session_probe=1 ;; esac
    ;;
esac

qparam() {
  printf '%s' "$QUERY_STRING" | tr '&' '\n' | sed -n "s/^$1=//p" | head -n 1 | sed 's/[^A-Fa-f0-9]//g'
}

deny_auth() {
  if [ "$session_probe" = 1 ]; then
    printf 'Status: 200 OK\r\n'
  else
    printf 'Status: 403 Forbidden\r\n'
  fi
  printf 'Content-Type: application/json; charset=utf-8\r\n'
  printf 'Cache-Control: no-store\r\n'
  printf 'X-Content-Type-Options: nosniff\r\n'
  printf 'Referrer-Policy: no-referrer\r\n'
  printf '\r\n'
  if [ "$session_probe" = 1 ]; then
    printf '{"ok":false,"authenticated":false,"error":"forbidden"}\n'
  else
    printf '{"ok":false,"error":"forbidden","message":"valid Smart AP session required"}\n'
  fi
  exit 0
}

if [ "$internal_refresh" = 0 ]; then
  sid="$(cr6608_session_from_request "$(qparam sid)")"
  cr6608_session_valid "$sid" || deny_auth

  printf 'Content-Type: application/json; charset=utf-8\r\n'
  printf 'Cache-Control: no-store\r\n'
  printf 'X-Content-Type-Options: nosniff\r\n'
  printf 'Referrer-Policy: no-referrer\r\n'
  printf '\r\n'
else
  # Only a root-owned local process can set a plain CGI environment variable;
  # HTTP request headers are mapped to HTTP_* and cannot enable this path.
  QUERY_STRING=""
fi

CACHE_STATE_LIB="${CR6608_DASHBOARD_CACHE_STATE_LIB:-/usr/libexec/cr6608-dashboard-cache-state}"
if ! . "$CACHE_STATE_LIB" || ! cr6608_dashboard_cache_prepare; then
  printf '{"ok":false,"error":"cache_state","message":"secure dashboard cache is unavailable"}\n'
  exit 0
fi
cache_dir="$CR6608_DASHBOARD_CACHE_DIR"

# BEGIN CR6608_DASHAPI2_CLIENT_TRAFFIC_HELPER
# Resolve the physical DSA uplink before summing client-edge counters.  In AP
# mode the default route is on br-lan, so the gateway's bridge FDB entry is the
# only reliable way to distinguish the uplink LAN port from wired clients.  In
# routed/PPPoE mode the configured WAN device supplies the same information.
dashapi_client_normalize_uplink() {
  _cnu_dev="${1:-}"
  case "$_cnu_dev" in
    ''|*[!A-Za-z0-9_.-]*) return 1 ;;
  esac
  case "$_cnu_dev" in
    lan[0-9]*)
      printf '%s\n' "$_cnu_dev" | grep -Eq '^lan[0-9]+([.][0-9]+)?$' || return 1
      printf '%s\n' "${_cnu_dev%%.*}"
      ;;
    wan|wan.[0-9]*)
      printf '%s\n' "$_cnu_dev" | grep -Eq '^wan([.][0-9]+)?$' || return 1
      printf '%s\n' "${_cnu_dev%%.*}"
      ;;
    eth[0-9]*)
      printf '%s\n' "$_cnu_dev" | grep -Eq '^eth[0-9]+([.][0-9]+)?$' || return 1
      printf '%s\n' "${_cnu_dev%%.*}"
      ;;
    phy[0-9]*-sta[0-9]*)
      printf '%s\n' "$_cnu_dev" | grep -Eq '^phy[0-9]+-sta[0-9]+$' || return 1
      printf '%s\n' "$_cnu_dev"
      ;;
    wlan[0-9]*)
      printf '%s\n' "$_cnu_dev" | grep -Eq '^wlan[0-9]+$' || return 1
      printf '%s\n' "$_cnu_dev"
      ;;
    *) return 1 ;;
  esac
}

dashapi_client_uplink_port() {
  _cup_default_dev="${1:-}"
  _cup_default_gw="${2:-}"
  _cup_lan_dev="${3:-br-lan}"
  if _cup_port="$(dashapi_client_normalize_uplink "$_cup_default_dev" 2>/dev/null)"; then
    printf '%s\n' "$_cup_port"
    return 0
  fi
  case "$_cup_default_dev" in
    br-*)
      case "$_cup_default_dev" in *[!A-Za-z0-9_.-]*) return 1 ;; esac
      _cup_bridge_dev="$_cup_default_dev"
      if [ -n "$_cup_default_gw" ]; then
        _cup_mac="$(ip neigh show to "$_cup_default_gw" dev "$_cup_bridge_dev" 2>/dev/null |
          awk '/lladdr/{for(i=1;i<=NF;i++) if($i=="lladdr"){print tolower($(i+1)); exit}}')"
        [ -n "$_cup_mac" ] || _cup_mac="$(ip neigh show to "$_cup_default_gw" 2>/dev/null |
          awk '/lladdr/{for(i=1;i<=NF;i++) if($i=="lladdr"){print tolower($(i+1)); exit}}')"
        if [ -n "$_cup_mac" ]; then
          _cup_port="$(bridge fdb show br "$_cup_bridge_dev" 2>/dev/null |
            awk -v mac="$_cup_mac" 'tolower($1)==mac {for(i=1;i<NF;i++) if($i=="dev" && $(i+1) ~ /^(lan[0-9]+|wan|eth[0-9]+|phy[0-9]+-sta[0-9]+|wlan[0-9]+)$/){print $(i+1); exit}}')"
          [ -n "$_cup_port" ] || _cup_port="$(bridge fdb show 2>/dev/null |
            awk -v mac="$_cup_mac" 'tolower($1)==mac {for(i=1;i<NF;i++) if($i=="dev" && $(i+1) ~ /^(lan[0-9]+|wan|eth[0-9]+|phy[0-9]+-sta[0-9]+|wlan[0-9]+)$/){print $(i+1); exit}}')"
          if _cup_port="$(dashapi_client_normalize_uplink "$_cup_port" 2>/dev/null)"; then
            printf '%s\n' "$_cup_port"
            return 0
          fi
        fi
      fi
      ;;
    *)
      _cup_wan_dev="$(uci -q get network.wan.device 2>/dev/null)"
      [ -n "$_cup_wan_dev" ] || _cup_wan_dev="$(uci -q get network.wan.ifname 2>/dev/null)"
      if _cup_port="$(dashapi_client_normalize_uplink "$_cup_wan_dev" 2>/dev/null)"; then
        printf '%s\n' "$_cup_port"
        return 0
      fi
      ;;
  esac
  return 1
}

# Report direction from the client's point of view:
#   download = TX on a client edge, upload = RX on a client edge.
# Bridges/CPU ports are deliberately excluded, and the resolved DSA uplink is
# excluded, so an Internet packet is counted once rather than at both edges.
dashapi_client_edge_counters() {
  _cec_file="${1:-/proc/net/dev}"
  _cec_uplink="${2:-}"
  _cec_topology_complete="${3:-false}"
  case "$_cec_topology_complete" in true|false) ;; *) _cec_topology_complete=false ;; esac
  awk -v uplink="$_cec_uplink" -v complete="$_cec_topology_complete" '
    BEGIN { download=0; upload=0; edges=0; signature="" }
    {
      dev=$1; sub(/:$/, "", dev)
      if (dev ~ /^lan[0-9]+$/) {
        # Without a proven uplink, a DSA port may be the upstream edge.  Omit
        # all wired ports rather than publish a possibly double-counted total.
        if (complete != "true") next
      } else if (dev !~ /^phy[0-9]+-ap[0-9]+$/) next
      if (uplink != "" && dev == uplink) next
      download += $10
      upload += $2
      edges++
      signature = signature (signature == "" ? "" : ",") dev
    }
    END { printf "%.0f %.0f %d %s", download, upload, edges, (signature == "" ? "none" : signature) }
  ' "$_cec_file" 2>/dev/null
}

dashapi_client_topology_complete() {
  _ctc_default_dev="${1:-}"
  _ctc_uplink="${2:-}"
  [ -n "$_ctc_default_dev" ] || return 1
  # A route name such as pppoe-wan does not prove which DSA port carries WAN.
  # Only a normalized physical client-edge exclusion (or a proven non-client
  # device such as wan/eth*/STA) makes the aggregate complete.
  dashapi_client_normalize_uplink "$_ctc_uplink" >/dev/null 2>&1
}

DASHAPI_TOPOLOGY_TTL="${CR6608_DASHAPI_TOPOLOGY_TTL:-30}"
case "$DASHAPI_TOPOLOGY_TTL" in ''|*[!0-9]*|0) DASHAPI_TOPOLOGY_TTL=30 ;; esac
[ "$DASHAPI_TOPOLOGY_TTL" -le 300 ] 2>/dev/null || DASHAPI_TOPOLOGY_TTL=300
dashapi_topology_cache_load() {
  _tcl_file="$1"; _tcl_now="$2"; _tcl_generation="$3"
  DASHAPI_TOPOLOGY_DEFAULT_DEV=""; DASHAPI_TOPOLOGY_DEFAULT_GW=""
  DASHAPI_TOPOLOGY_LAN_DEV=""; DASHAPI_TOPOLOGY_UPLINK=""
  DASHAPI_TOPOLOGY_COMPLETE=false
  [ -f "$_tcl_file" ] && [ ! -L "$_tcl_file" ] || return 1
  IFS='|' read -r _tcl_saved _tcl_saved_generation _tcl_dev _tcl_gw _tcl_lan _tcl_uplink _tcl_complete <"$_tcl_file" || return 1
  case "$_tcl_now:$_tcl_saved" in *[!0-9:]*|:|*:) return 1 ;; esac
  case "$_tcl_generation:$_tcl_saved_generation" in *[!A-Za-z0-9._:-]*|:|*:) return 1 ;; esac
  [ "$_tcl_generation" = "$_tcl_saved_generation" ] || return 1
  _tcl_age=$((_tcl_now - _tcl_saved))
  [ "$_tcl_age" -ge 0 ] 2>/dev/null && [ "$_tcl_age" -le "$DASHAPI_TOPOLOGY_TTL" ] 2>/dev/null || return 1
  case "$_tcl_dev:$_tcl_gw:$_tcl_lan:$_tcl_uplink" in *[!A-Za-z0-9_.:-]*) return 1 ;; esac
  case "$_tcl_complete" in true|false) ;; *) return 1 ;; esac
  DASHAPI_TOPOLOGY_DEFAULT_DEV="$_tcl_dev"
  DASHAPI_TOPOLOGY_DEFAULT_GW="$_tcl_gw"
  DASHAPI_TOPOLOGY_LAN_DEV="$_tcl_lan"
  DASHAPI_TOPOLOGY_UPLINK="$_tcl_uplink"
  DASHAPI_TOPOLOGY_COMPLETE="$_tcl_complete"
  return 0
}

dashapi_topology_cache_store() {
  _tcs_file="$1"; _tcs_now="$2"; _tcs_generation="$3"
  _tcs_tmp="$(mktemp "${_tcs_file}.XXXXXX" 2>/dev/null)" || return 1
  if ! printf '%s|%s|%s|%s|%s|%s|%s\n' "$_tcs_now" "$_tcs_generation" \
      "$DASHAPI_TOPOLOGY_DEFAULT_DEV" "$DASHAPI_TOPOLOGY_DEFAULT_GW" \
      "$DASHAPI_TOPOLOGY_LAN_DEV" "$DASHAPI_TOPOLOGY_UPLINK" \
      "$DASHAPI_TOPOLOGY_COMPLETE" >"$_tcs_tmp" ||
     ! chmod 0600 "$_tcs_tmp" || ! mv -f "$_tcs_tmp" "$_tcs_file"; then
    rm -f "$_tcs_tmp" 2>/dev/null
    return 1
  fi
}

# Cache both successful and unresolved topology for a short monotonic window.
# The 3-second lite path therefore performs only procfs reads on a cache hit;
# ip/bridge/uci resolution is bounded to one attempt per TTL/generation.
dashapi_client_topology_cached() {
  _ctc_file="$1"; _ctc_now="$2"; _ctc_generation="$3"
  dashapi_topology_cache_load "$_ctc_file" "$_ctc_now" "$_ctc_generation" && return 0
  _ctc_default4="$(ip -4 route show default 2>/dev/null | head -n 1)"
  DASHAPI_TOPOLOGY_DEFAULT_DEV="$(printf '%s\n' "$_ctc_default4" | awk '{for(i=1;i<=NF;i++) if($i=="dev"){print $(i+1); exit}}')"
  DASHAPI_TOPOLOGY_DEFAULT_GW="$(printf '%s\n' "$_ctc_default4" | awk '{for(i=1;i<=NF;i++) if($i=="via"){print $(i+1); exit}}')"
  DASHAPI_TOPOLOGY_LAN_DEV=""
  case "$DASHAPI_TOPOLOGY_DEFAULT_DEV" in br-*) DASHAPI_TOPOLOGY_LAN_DEV="$DASHAPI_TOPOLOGY_DEFAULT_DEV" ;; esac
  [ -n "$DASHAPI_TOPOLOGY_LAN_DEV" ] || DASHAPI_TOPOLOGY_LAN_DEV="$(uci -q get network.lan.device 2>/dev/null)"
  [ -n "$DASHAPI_TOPOLOGY_LAN_DEV" ] || DASHAPI_TOPOLOGY_LAN_DEV=br-lan
  DASHAPI_TOPOLOGY_UPLINK="$(dashapi_client_uplink_port "$DASHAPI_TOPOLOGY_DEFAULT_DEV" "$DASHAPI_TOPOLOGY_DEFAULT_GW" "$DASHAPI_TOPOLOGY_LAN_DEV" 2>/dev/null || true)"
  if dashapi_client_topology_complete "$DASHAPI_TOPOLOGY_DEFAULT_DEV" "$DASHAPI_TOPOLOGY_UPLINK"; then
    DASHAPI_TOPOLOGY_COMPLETE=true
  else
    DASHAPI_TOPOLOGY_COMPLETE=false
  fi
  dashapi_topology_cache_store "$_ctc_file" "$_ctc_now" "$_ctc_generation" || true
  return 0
}
# END CR6608_DASHAPI2_CLIENT_TRAFFIC_HELPER

# The overview only needs counters from procfs. Serving this lightweight path
# avoids both the full wireless collector and UCI content fingerprinting every
# few seconds while keeping traffic, CPU, memory and load figures live.  Full
# snapshots still fingerprint every external LuCI/SSH edit before serving.
case "${internal_refresh}:&${QUERY_STRING:-}&" in
  0:*'&lite=1&'*)
    lite_uptime="$(cut -d. -f1 /proc/uptime 2>/dev/null)"; lite_uptime="${lite_uptime:-0}"
    set -- $(cat /proc/loadavg 2>/dev/null); lite_l1="${1:-0}"; lite_l5="${2:-0}"; lite_l15="${3:-0}"
    set -- $(awk '
      /^MemTotal:/ {t=$2*1024}
      /^MemFree:/ {f=$2*1024}
      /^MemAvailable:/ {a=$2*1024}
      END {printf "%s %s %s", t+0, f+0, a+0}
    ' /proc/meminfo 2>/dev/null)
    lite_mt="${1:-0}"; lite_mf="${2:-0}"; lite_ma="${3:-$lite_mf}"
    set -- $(df -k /overlay 2>/dev/null | awk 'NR==2{printf "%s %s %s", $2*1024, $3*1024, $4*1024}')
    lite_st="${1:-0}"; lite_su="${2:-0}"; lite_sa="${3:-0}"
    lite_generation=uninitialized
    if [ -f "$cache_dir/generation" ] && [ ! -L "$cache_dir/generation" ]; then
      IFS= read -r lite_generation <"$cache_dir/generation" 2>/dev/null || lite_generation=uninitialized
    fi
    case "$lite_generation" in ''|*[!A-Za-z0-9._-]*) lite_generation=uninitialized ;; esac
    dashapi_client_topology_cached "$cache_dir/traffic.topology" "$lite_uptime" "$lite_generation"
    lite_default_dev="$DASHAPI_TOPOLOGY_DEFAULT_DEV"
    lite_uplink="$DASHAPI_TOPOLOGY_UPLINK"
    set -- $(dashapi_client_edge_counters /proc/net/dev "$lite_uplink" "$DASHAPI_TOPOLOGY_COMPLETE")
    lite_rx="${1:-0}"; lite_tx="${2:-0}"; lite_edges="${3:-0}"; lite_edge_signature="${4:-none}"
    lite_topology="$DASHAPI_TOPOLOGY_COMPLETE"
    lite_counter_signature="${lite_topology}:${lite_uplink:-none}:$lite_edge_signature"
    set -- $(awk '/^cpu /{total=0; for(i=2;i<=NF;i++) total+=$i; idle=$5+$6; printf "%s %s", total, total-idle}' /proc/stat 2>/dev/null)
    lite_total="${1:-0}"; lite_busy="${2:-0}"; lite_cpu=""; lite_prev="$cache_dir/lite.cpu"
    if [ -r "$lite_prev" ]; then
      read lite_old_total lite_old_busy lite_old_pct < "$lite_prev"
      lite_dt=$((lite_total - ${lite_old_total:-0})); lite_db=$((lite_busy - ${lite_old_busy:-0}))
      if [ "$lite_dt" -gt 0 ] 2>/dev/null && [ "$lite_db" -ge 0 ] 2>/dev/null; then
        lite_cpu="$(awk -v b="$lite_db" -v t="$lite_dt" 'BEGIN{v=b*100/t; if(v<0)v=0; if(v>100)v=100; printf "%d",v}')"
      else
        lite_cpu="${lite_old_pct:-0}"
      fi
    fi
    if [ -z "$lite_cpu" ]; then
      lite_cores="$(grep -c '^processor' /proc/cpuinfo 2>/dev/null)"; [ "${lite_cores:-0}" -gt 0 ] 2>/dev/null || lite_cores=1
      lite_cpu="$(awk -v l="$lite_l1" -v c="$lite_cores" 'BEGIN{v=l*100/c; if(v<0)v=0; if(v>100)v=100; printf "%d",v}')"
    fi
    printf '%s %s %s\n' "$lite_total" "$lite_busy" "$lite_cpu" > "$lite_prev" 2>/dev/null
    lite_cores="$(grep -c '^processor' /proc/cpuinfo 2>/dev/null)"; [ "${lite_cores:-0}" -gt 0 ] 2>/dev/null || lite_cores=1
    printf '{"ok":true,"lite":true,"uptime":%s,"load":[%s,%s,%s],"cpu":{"cores":%s,"percent":%s,"source":"/proc/stat"},"mem":{"total":%s,"free":%s,"available":%s,"source":"/proc/meminfo"},"storage":{"total":%s,"used":%s,"available":%s,"source":"df -k /overlay"},"traffic":{"source":"/proc/net/dev","scope":"client-edge","counter_window":"since-interface-reset","calendar_accounting":false,"topology_complete":%s,"uplink_device":"%s","edge_count":%s,"counter_signature":"%s","rx_bytes":%s,"tx_bytes":%s}}\n' \
      "$lite_uptime" "$lite_l1" "$lite_l5" "$lite_l15" "$lite_cores" "$lite_cpu" \
      "$lite_mt" "$lite_mf" "$lite_ma" "$lite_st" "$lite_su" "$lite_sa" "$lite_topology" "$lite_uplink" "$lite_edges" "$lite_counter_signature" "$lite_rx" "$lite_tx"
    exit 0
    ;;
esac

cr6608_dashboard_cache_recover_dirty
cache_recover_rc=$?
case "$cache_recover_rc" in
  0|2) ;;
  *)
    printf '{"ok":false,"error":"cache_recovery","message":"dashboard cache recovery failed safely"}\n'
    exit 0
    ;;
esac
if ! cr6608_dashboard_cache_external_sync; then
  printf '{"ok":false,"error":"cache_fingerprint","message":"dashboard source fingerprint failed safely"}\n'
  exit 0
fi

# Share one short-lived hardware snapshot between dashboard tabs.  All state is
# below a root-only runtime directory and every published document is parsed in
# full before it can be served.
response_cache="$cache_dir/response.json"
cache_fresh_seconds=10
cache_view=""
cache_emit_tmp=""
cache_tmp=""
cache_owner=0
cache_valid=0
cache_age=0
cache_current_generation=""
cache_snapshot_generation=""
cache_is_current=0
cache_mutation_active=0

cache_cleanup() {
  command -v run_limit_cancel_active >/dev/null 2>&1 &&
    run_limit_cancel_active
  [ -z "$cache_view" ] || rm -f "$cache_view" 2>/dev/null
  [ -z "$cache_emit_tmp" ] || rm -f "$cache_emit_tmp" 2>/dev/null
  [ -z "$cache_tmp" ] || rm -f "$cache_tmp" 2>/dev/null
  rm -f "$cache_dir/.devices.$$" "$cache_dir/.arp.$$" "$cache_dir/.fdb.$$" \
    "$cache_dir/.lease.$$" "$cache_dir/.degraded.$$" 2>/dev/null
  cr6608_dashboard_cache_collector_release
  command -v cr6608_dashboard_cache_reader_release >/dev/null 2>&1 &&
    cr6608_dashboard_cache_reader_release
  command -v cr6608_dashboard_cache_cleanup_process >/dev/null 2>&1 &&
    cr6608_dashboard_cache_cleanup_process
  cache_owner=0
}
cache_signal_exit() {
  _cache_signal_rc="$1"
  trap - EXIT HUP INT TERM
  cache_cleanup
  exit "$_cache_signal_rc"
}
trap cache_cleanup EXIT
trap 'cache_signal_exit 129' HUP
trap 'cache_signal_exit 130' INT
trap 'cache_signal_exit 143' TERM

close_dashboard_fds() { exec 4>&- 5>&- 6>&- 7>&- 8>&-; }

# BEGIN CR6608_DASHAPI2_MONOTONIC_HELPERS
# Traffic baselines must follow time-since-boot.  Wall time can legitimately
# jump forwards or backwards when NTP corrects a router that booted without an
# RTC, which must not create a false multi-gigabit spike or freeze a baseline.
dashapi_monotonic_seconds() {
  _dashapi_uptime_file="${CR6608_PROC_UPTIME_FILE:-/proc/uptime}"
  _dashapi_now="$(cut -d. -f1 "$_dashapi_uptime_file" 2>/dev/null)"
  case "$_dashapi_now" in ''|*[!0-9]*) return 1 ;; esac
  printf '%s\n' "$_dashapi_now"
}

dashapi_counter_rate() {
  _dashapi_current="$1"
  _dashapi_previous="$2"
  _dashapi_rate_now="$3"
  _dashapi_previous_ts="$4"
  case "$_dashapi_current" in ''|*[!0-9]*) printf '0\n'; return 0 ;; esac
  case "$_dashapi_previous" in ''|*[!0-9]*) printf '0\n'; return 0 ;; esac
  case "$_dashapi_rate_now" in ''|*[!0-9]*) printf '0\n'; return 0 ;; esac
  case "$_dashapi_previous_ts" in ''|*[!0-9]*) printf '0\n'; return 0 ;; esac
  _dashapi_dt=$((_dashapi_rate_now - _dashapi_previous_ts))
  _dashapi_delta=$((_dashapi_current - _dashapi_previous))
  if [ "$_dashapi_dt" -le 0 ] 2>/dev/null ||
     [ "$_dashapi_delta" -lt 0 ] 2>/dev/null; then
    printf '0\n'
    return 0
  fi
  printf '%s\n' "$((_dashapi_delta / _dashapi_dt))"
}

dashapi_scoped_counter_rate() {
  _dashapi_scope="${5:-}"
  _dashapi_previous_scope="${6:-}"
  if [ -z "$_dashapi_scope" ] || [ "$_dashapi_scope" != "$_dashapi_previous_scope" ]; then
    printf '0\n'
    return 0
  fi
  dashapi_counter_rate "$1" "$2" "$3" "$4"
}
# END CR6608_DASHAPI2_MONOTONIC_HELPERS

cache_load_view() {
  cr6608_dashboard_cache_reader_release
  [ -z "$cache_view" ] || rm -f "$cache_view" 2>/dev/null
  cache_view=""
  cache_valid=0
  cache_is_current=0
  cache_mutation_active=0
  cr6608_dashboard_cache_reader_acquire || return 1
  cache_before_generation="$(cr6608_dashboard_cache_generation)" || { cr6608_dashboard_cache_reader_release; return 1; }
  cache_view="$(cr6608_dashboard_cache_snapshot)" || { cache_view=""; cr6608_dashboard_cache_reader_release; return 1; }
  if ! cr6608_dashboard_cache_inspect "$cache_view"; then
    rm -f "$cache_view" 2>/dev/null
    cache_view=""
    cr6608_dashboard_cache_reader_release
    return 1
  fi
  cache_now="$(dashapi_monotonic_seconds 2>/dev/null)" || cache_now=0
  cache_age=$((cache_now - CR6608_DASHBOARD_SNAPSHOT_COMPLETED))
  cache_snapshot_generation="$CR6608_DASHBOARD_SNAPSHOT_GENERATION"
  if cr6608_dashboard_cache_mutation_active; then cache_mutation_active=1; fi
  cache_current_generation="$(cr6608_dashboard_cache_generation)" || { cr6608_dashboard_cache_reader_release; return 1; }
  cache_valid=1
  if [ "$cache_before_generation" = "$cache_current_generation" ] &&
     [ "$cache_snapshot_generation" = "$cache_current_generation" ] &&
     [ "$cache_mutation_active" = 0 ]; then
    cache_is_current=1
  fi
  return 0
}

cache_emit_view() {
  _cache_stale="$1"
  [ "$cache_valid" = 1 ] && [ -n "$cache_view" ] || return 1
  _cache_invalidated=false
  [ "$cache_is_current" = 1 ] || _cache_invalidated=true
  cache_emit_tmp="$(mktemp "$cache_dir/.emit.$$.XXXXXX" 2>/dev/null)" || {
    cr6608_dashboard_cache_reader_release
    return 1
  }
  if ! sed '1s/^{/{"snapshot_stale":'"$_cache_stale"',"snapshot_age_s":'"$cache_age"',"snapshot_invalidated":'"$_cache_invalidated"',"current_generation":"'"$cache_current_generation"'",/' \
      "$cache_view" >"$cache_emit_tmp" || ! chmod 0600 "$cache_emit_tmp"; then
    rm -f "$cache_emit_tmp" 2>/dev/null
    cache_emit_tmp=""
    cr6608_dashboard_cache_reader_release
    return 1
  fi
  # The response is now a request-private, fully classified regular file.
  # Release the shared metadata lock before writing to the client socket: a
  # stalled browser must never block a configuration mutation or Safe Apply.
  cr6608_dashboard_cache_reader_release
  cat "$cache_emit_tmp"
  _cache_emit_rc=$?
  rm -f "$cache_emit_tmp" 2>/dev/null
  cache_emit_tmp=""
  return "$_cache_emit_rc"
}

cache_load_view || true
if [ "$cache_valid" = 1 ] && [ "$cache_is_current" = 1 ] &&
   [ "$cache_age" -ge 0 ] && [ "$cache_age" -le "$cache_fresh_seconds" ]; then
  cache_emit_view false
  cache_cleanup
  exit 0
fi

# A current-boot snapshot is useful immediately even when old, but it is never
# labelled fresh.  The browser shows its exact age and retries with bounded
# backoff while an atomic flock admits at most one detached collector.
if [ "$internal_refresh" = 0 ] && [ "$cache_valid" = 1 ] && [ "$cache_age" -ge 0 ]; then
  # A fast tab change aborts the browser's CGI socket.  Keep the refresh worker
  # outside that CGI process group so uhttpd cancellation cannot strand the UI
  # on an old snapshot.  The worker has no request descriptors or stdin, and
  # internal_refresh prevents it from recursively spawning another worker.
  ( close_dashboard_fds; exec /usr/bin/setsid /usr/bin/env CR6608_DASHAPI_INTERNAL=1 "$0" ) \
    </dev/null >/dev/null 2>&1 &
