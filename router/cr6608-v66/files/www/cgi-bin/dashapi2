}

wifi="["
wf=1
health_busy_max=""
wifi_seen=""
for IF in $(printf '%s\n' "$iw_dev_snapshot" | awk '$1=="Interface"{print $2}' | sort -u); do
  [ -d "/sys/class/net/$IF" ] || continue
  iw_snapshot="$(printf '%s\n' "$iw_dev_snapshot" | iw_snapshot_for_if "$IF")"
  role="$(printf '%s\n' "$iw_snapshot" | awk '$1=="type"{$1=""; sub(/^ /,""); print; exit}')"
  [ "$role" = AP ] || continue
  dev="$(wifi_dev_for_if "$IF")"
  [ -n "$dev" ] || continue
  hostapd_raw="$(ubus -S call "hostapd.${IF}" get_status 2>/dev/null)"
  hostapd_rc=$?
  hostapd_state=""
