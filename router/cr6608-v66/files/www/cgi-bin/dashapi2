# CPU%: honest average over a >=15s window. Back-to-back dashboard polls used to make the
# delta window equal the collector's OWN busy burst (2 polls within ~1s -> "97%" while
# loadavg showed 0.00) — short windows now REUSE the last good reading and keep the old
# baseline instead of resampling.
set -- $(awk '/^cpu /{total=0; for(i=2;i<=NF;i++) total+=$i; idle=$5+$6; busy=total-idle; printf "%s %s", total, busy}' /proc/stat 2>/dev/null)
