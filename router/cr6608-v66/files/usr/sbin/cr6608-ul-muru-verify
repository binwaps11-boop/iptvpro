#!/bin/sh

module_state="$(cat /sys/module/mt7915e/parameters/cr6608_ul_muru 2>/dev/null || printf 'missing')"
uci_state="$(uci -q get smartap.experimental.ul_muru || printf 'missing')"
guard_state="$(cat /tmp/cr6608-ul-muru-state 2>/dev/null || printf '{"state":"missing"}')"

muru_debug_node=""
muru_debug_original=""
restore_muru_debug() {
	[ -n "$muru_debug_node" ] || return 0
	[ -n "$muru_debug_original" ] || return 0
	printf '%s\n' "$muru_debug_original" > "$muru_debug_node" 2>/dev/null || true
}
trap restore_muru_debug EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

for node in /sys/kernel/debug/ieee80211/phy*/mt76/muru_debug; do
	[ -f "$node" ] || continue
	muru_debug_node="$node"
	muru_debug_original="$(cat "$node" 2>/dev/null || printf 'error')"
	break
done

fw_stats_query=unavailable
if [ -n "$muru_debug_node" ]; then
	case "$muru_debug_original" in
		0)
			# mt7915's debugfs setter historically returns a non-zero write
			# result on some kernels even though it applies the requested state.
			# Read the node back instead of trusting the write syscall status.
			printf '1\n' > "$muru_debug_node" 2>/dev/null || true
			if [ "$(cat "$muru_debug_node" 2>/dev/null)" = 1 ]; then
				fw_stats_query=temporarily-enabled
			else
				fw_stats_query=enable-failed
			fi
			;;
		1) fw_stats_query=already-enabled ;;
		*) fw_stats_query=state-read-failed ;;
	esac
fi

printf 'CR6608 experimental UL MU-MIMO/OFDMA verification\n'
printf '%-38s %s\n' 'module request' "$module_state"
printf '%-38s %s\n' 'UCI request' "$uci_state"
printf '%-38s %s\n' 'guard state' "$guard_state"
printf '%-38s %s\n' 'firmware MURU stats query' "$fw_stats_query"

gate_count=0
active_count=0
for node in /sys/kernel/debug/ieee80211/phy*/mt76/cr6608_ul_muru; do
	[ -f "$node" ] || continue
	gate_count=$((gate_count + 1))
	state="$(cat "$node" 2>/dev/null || printf 'error')"
	[ "$state" = 1 ] && active_count=$((active_count + 1))
	printf '%-38s %s\n' "driver gate ${node}" "$state"
done

policy_count=0
policy_ready_count=0
for node in /sys/kernel/debug/ieee80211/phy*/mt76/cr6608_ul_muru_state; do
	[ -f "$node" ] || continue
	policy_count=$((policy_count + 1))
	data="$(cat "$node" 2>/dev/null)"
	printf '%s\n' "MediaTek STA_REC policy ${node}"
	printf '%s\n' "$data"
	if printf '%s\n' "$data" | grep -qx 'allowed=1' &&
	   printf '%s\n' "$data" | grep -qx 'enabled=1' &&
	   printf '%s\n' "$data" | \
		grep -qx 'policy=mediatek-vendor-sta-rec-muru'; then
		policy_ready_count=$((policy_ready_count + 1))
	fi
done

cap_count="$(iw phy 2>/dev/null | grep -c 'Full Bandwidth UL MU-MIMO')"
printf '%-38s %s\n' 'advertised full-bandwidth UL MU-MIMO' "$cap_count"

ul_mumimo_ppdu=0
ul_ofdma_ppdu=0
stats_count=0
for stats in /sys/kernel/debug/ieee80211/phy*/mt76/muru_stats; do
	[ -f "$stats" ] || continue
	data="$(cat "$stats" 2>/dev/null)"
	printf '%s\n' "$data" | grep -q '^Uplink$' || continue
	stats_count=$((stats_count + 1))
	printf '%s\n' "$data" | grep -E 'Total HE (MU-MIMO|OFDMA) UL TB PPDU count:' || true
	for value in $(printf '%s\n' "$data" | sed -n \
		's/.*Total HE MU-MIMO UL TB PPDU count: \([0-9][0-9]*\).*/\1/p'); do
		ul_mumimo_ppdu=$((ul_mumimo_ppdu + value))
	done
	for value in $(printf '%s\n' "$data" | sed -n \
		's/.*Total HE OFDMA UL TB PPDU count: \([0-9][0-9]*\).*/\1/p'); do
		ul_ofdma_ppdu=$((ul_ofdma_ppdu + value))
	done
done

associated_stations=0
for object in $(ubus list 'hostapd.*' 2>/dev/null); do
	iface="${object#hostapd.}"
	count="$(iw dev "$iface" station dump 2>/dev/null | grep -c '^Station ' || true)"
	associated_stations=$((associated_stations + count))
done

printf '%-38s %s\n' 'associated AP stations now' "$associated_stations"
printf '%-38s %s\n' 'observed UL MU-MIMO TB PPDU total' "$ul_mumimo_ppdu"
printf '%-38s %s\n' 'observed UL OFDMA TB PPDU total' "$ul_ofdma_ppdu"
printf '%-38s %s\n' 'firmware MURU stats radios' "$stats_count"

restore_muru_debug
muru_debug_node=""
muru_debug_original=""

if [ "$module_state" = Y ] && [ "$uci_state" = 1 ] && \
	   [ "$gate_count" -gt 0 ] && [ "$active_count" -eq "$gate_count" ] && \
	   [ "$policy_count" -gt 0 ] && \
	   [ "$policy_ready_count" -eq "$policy_count" ] && \
	   [ "$stats_count" -eq "$gate_count" ] && \
	   [ "$cap_count" -gt 0 ]; then
	echo 'RESULT_UL_MURU_FW_POLICY=MEDIATEK_VENDOR_STA_REC_ARMED'
	echo 'RESULT_UL_MURU_HOST_PATH=ARMED'
else
	echo 'RESULT_UL_MURU_FW_POLICY=NOT_ARMED'
	echo 'RESULT_UL_MURU_HOST_PATH=NOT_ARMED'
	exit 1
fi

if [ "$ul_mumimo_ppdu" -gt 0 ]; then
	echo 'RESULT_UL_MUMIMO_OVER_AIR=OBSERVED'
else
	echo 'RESULT_UL_MUMIMO_OVER_AIR=NOT_OBSERVED'
fi

if [ "$ul_ofdma_ppdu" -gt 0 ]; then
	echo 'RESULT_UL_OFDMA_OVER_AIR=OBSERVED'
else
	echo 'RESULT_UL_OFDMA_OVER_AIR=NOT_OBSERVED'
fi

if [ "$ul_mumimo_ppdu" -gt 0 ] && [ "$ul_ofdma_ppdu" -gt 0 ]; then
	echo 'RESULT_UL_MURU_OVER_AIR=BOTH_OBSERVED'
elif [ "$ul_mumimo_ppdu" -gt 0 ] || [ "$ul_ofdma_ppdu" -gt 0 ]; then
	echo 'RESULT_UL_MURU_OVER_AIR=PARTIAL_ONLY'
else
	echo 'RESULT_UL_MURU_OVER_AIR=NOT_PROVEN_NEEDS_TWO_ACTIVE_COMPATIBLE_CLIENTS'
fi
