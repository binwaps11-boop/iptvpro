#!/bin/sh

set -u

duration="${1:-60}"
debugfs_root="${CR6608_DEBUGFS_ROOT:-/sys/kernel/debug/ieee80211}"
tmp_root="${CR6608_TMP_ROOT:-/tmp}"
case "$duration" in
	''|*[!0-9]*)
		echo 'usage: cr6608-ul-muru-airtest [10-600 seconds]' >&2
		exit 64
		;;
esac
if [ "$duration" -lt 10 ] || [ "$duration" -gt 600 ]; then
	echo 'usage: cr6608-ul-muru-airtest [10-600 seconds]' >&2
	exit 64
fi

tmpdir="$(mktemp -d "${tmp_root%/}/cr6608-ul-muru-airtest.XXXXXX")" || exit 1
muru_debug_node=""
muru_debug_original=""
cleanup() {
	if [ -n "$muru_debug_node" ] && [ -n "$muru_debug_original" ]; then
		printf '%s\n' "$muru_debug_original" > "$muru_debug_node" 2>/dev/null || true
	fi
	rm -rf -- "$tmpdir"
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

collect_stations() {
	output="$1"
	: > "$output"
	iw dev "$target_iface" station dump 2>/dev/null |
		awk -v iface="$target_iface" -v clients="$capable_clients_file" '
		BEGIN {
			while ((getline client < clients) > 0)
				capable[tolower(client)] = 1
			close(clients)
		}
		/^Station / { mac=tolower($2) }
		/^[[:space:]]*rx bytes:/ && (mac in capable) {
			print mac, $3, iface
		}
	' >> "$output"
}

collect_stats() {
	mumimo=0
	ofdma=0
	count=0
	stats="$debugfs_root/$target_phy/mt76/muru_stats"
	[ -f "$stats" ] || { printf '0 0 0\n'; return; }
	data="$(cat "$stats" 2>/dev/null)"
	printf '%s\n' "$data" | grep -q '^Uplink$' || {
		printf '0 0 0\n'
		return
	}
	count=1
	for value in $(printf '%s\n' "$data" | sed -n \
		's/.*Total HE MU-MIMO UL TB PPDU count: \([0-9][0-9]*\).*/\1/p'); do
		mumimo=$((mumimo + value))
	done
	for value in $(printf '%s\n' "$data" | sed -n \
		's/.*Total HE OFDMA UL TB PPDU count: \([0-9][0-9]*\).*/\1/p'); do
		ofdma=$((ofdma + value))
	done
	printf '%s %s %s\n' "$mumimo" "$ofdma" "$count"
}

list_full_ul_mumimo_clients() {
	iface="$1"
	for capability in "$debugfs_root"/phy*/netdev:"$iface"/stations/*/cr6608_muru_capabilities; do
		[ -f "$capability" ] || continue
		# This build's proof policy accepts full-bandwidth UL MU-MIMO peers.
		# A partial-only capability is retained for diagnostics, not proof.
		grep -qx 'he=1' "$capability" 2>/dev/null || continue
		grep -qx 'ul_mumimo_full=1' "$capability" 2>/dev/null || continue
		grep -qx 'ul_mumimo_capable=1' "$capability" 2>/dev/null || continue
		station_dir="${capability%/cr6608_muru_capabilities}"
		basename "$station_dir" | tr 'A-F' 'a-f'
	done
}

count_full_ul_mumimo_clients() {
	list_full_ul_mumimo_clients "$1" | sort -u | awk 'END { print NR + 0 }'
}

target_iface=""
station_count=0
he_station_count=0
full_ul_mumimo_station_count=0
for object in $(ubus list 'hostapd.*' 2>/dev/null); do
	iface="${object#hostapd.}"
	client_data="$(ubus call "$object" get_clients 2>/dev/null || true)"
	iface_stations="$(iw dev "$iface" station dump 2>/dev/null | grep -c '^Station ' || true)"
	iface_he="$(printf '%s\n' "$client_data" | grep -c '"he":[[:space:]]*true' || true)"
	iface_full_ul_mumimo="$(count_full_ul_mumimo_clients "$iface")"
	if [ "$iface_stations" -ge 2 ] && [ "$iface_he" -ge 2 ] &&
	   [ -z "$target_iface" ]; then
		target_iface="$iface"
		station_count="$iface_stations"
		he_station_count="$iface_he"
		full_ul_mumimo_station_count="$iface_full_ul_mumimo"
	fi
	if [ "$iface_stations" -ge 2 ] && [ "$iface_he" -ge 2 ] &&
	   [ "$iface_full_ul_mumimo" -ge 2 ]; then
		target_iface="$iface"
		station_count="$iface_stations"
		he_station_count="$iface_he"
		full_ul_mumimo_station_count="$iface_full_ul_mumimo"
		break
	fi
done

if [ -z "$target_iface" ]; then
	target_iface=none
fi

printf 'CR6608 controlled UL MURU airtime test\n'
printf '%-38s %s\n' 'test duration seconds' "$duration"
printf '%-38s %s\n' 'selected AP interface' "$target_iface"
printf '%-38s %s\n' 'associated AP stations same radio' "$station_count"
printf '%-38s %s\n' 'associated HE stations same radio' "$he_station_count"
printf '%-38s %s\n' 'full-bandwidth UL MU-MIMO clients' "$full_ul_mumimo_station_count"

if [ "$station_count" -lt 2 ] || [ "$he_station_count" -lt 2 ]; then
	echo 'Connect at least two Wi-Fi 6 clients to the same Smart AP band, then run simultaneous uploads.'
	echo 'RESULT_UL_MURU_AIRTEST=PREREQUISITE_MISSING_TWO_HE_CLIENTS'
	exit 2
fi
if [ "$full_ul_mumimo_station_count" -lt 2 ]; then
	echo 'Connect two clients that advertise full-bandwidth UL MU-MIMO to the selected Smart AP band.'
	echo 'RESULT_UL_MURU_AIRTEST=PREREQUISITE_MISSING_TWO_FULL_BW_UL_MUMIMO_CLIENTS'
	exit 2
fi

capable_clients_file="$tmpdir/full-ul-mumimo-clients"
list_full_ul_mumimo_clients "$target_iface" | sort -u > "$capable_clients_file"
full_ul_mumimo_station_count="$(awk 'END { print NR + 0 }' "$capable_clients_file")"
if [ "$full_ul_mumimo_station_count" -lt 2 ]; then
	echo 'Client capability set changed before the proof window; retry with two full-bandwidth clients.'
	echo 'RESULT_UL_MURU_AIRTEST=PREREQUISITE_MISSING_TWO_FULL_BW_UL_MUMIMO_CLIENTS'
	exit 2
fi

target_wiphy="$(iw dev "$target_iface" info 2>/dev/null |
	awk '$1 == "wiphy" { print $2; exit }')"
case "$target_wiphy" in
	''|*[!0-9]*)
		echo 'RESULT_UL_MURU_AIRTEST=ERROR_CANNOT_MAP_INTERFACE_TO_PHY' >&2
		exit 1
		;;
esac
target_phy="phy${target_wiphy}"
muru_debug_node="$debugfs_root/$target_phy/mt76/muru_debug"
if [ ! -f "$muru_debug_node" ]; then
	echo 'RESULT_UL_MURU_AIRTEST=ERROR_NO_FIRMWARE_STATS' >&2
	exit 1
fi
muru_debug_original="$(cat "$muru_debug_node" 2>/dev/null || printf 'error')"
if [ "$muru_debug_original" = error ]; then
	echo 'RESULT_UL_MURU_AIRTEST=ERROR_NO_FIRMWARE_STATS' >&2
	exit 1
fi
printf '1\n' > "$muru_debug_node" 2>/dev/null || true
if [ "$(cat "$muru_debug_node" 2>/dev/null)" != 1 ]; then
	echo 'RESULT_UL_MURU_AIRTEST=ERROR_CANNOT_ENABLE_FIRMWARE_STATS' >&2
	exit 1
fi

set -- $(collect_stats)
before_mumimo="$1"
before_ofdma="$2"
stats_radios="$3"
printf '%-38s %s\n' 'selected firmware stats phy' "$target_phy"
printf '%-38s %s\n' 'firmware MURU stats target radio' "$stats_radios"
if [ "$stats_radios" -ne 1 ]; then
	echo 'RESULT_UL_MURU_AIRTEST=ERROR_INCOMPLETE_FIRMWARE_STATS'
	exit 1
fi

collect_stations "$tmpdir/before-stations"

echo "Start simultaneous upload traffic from both clients now; sampling for ${duration} seconds."
cp "$tmpdir/before-stations" "$tmpdir/previous-stations"
remaining="$duration"
overlap_samples=0
while [ "$remaining" -gt 0 ]; do
	interval=2
	[ "$remaining" -ge "$interval" ] || interval="$remaining"
	sleep "$interval"
	collect_stations "$tmpdir/current-stations"
	interval_uploaders="$(awk '
		NR == FNR { before[$1]=$2; next }
		($1 in before) && $2 > before[$1] { active++ }
		END { print active + 0 }
	' "$tmpdir/previous-stations" "$tmpdir/current-stations")"
	[ "$interval_uploaders" -lt 2 ] || overlap_samples=$((overlap_samples + 1))
	cp "$tmpdir/current-stations" "$tmpdir/previous-stations"
	remaining=$((remaining - interval))
done

cp "$tmpdir/previous-stations" "$tmpdir/after-stations"
set -- $(collect_stats)
after_mumimo="$1"
after_ofdma="$2"
after_stats_radios="$3"

delta_mumimo=$((after_mumimo - before_mumimo))
delta_ofdma=$((after_ofdma - before_ofdma))
[ "$delta_mumimo" -ge 0 ] || delta_mumimo=0
[ "$delta_ofdma" -ge 0 ] || delta_ofdma=0

active_uploaders="$(awk '
	NR == FNR { before[$1]=$2; next }
	($1 in before) && $2 > before[$1] { active++ }
	END { print active + 0 }
' "$tmpdir/before-stations" "$tmpdir/after-stations")"

printf '%-38s %s\n' 'clients with uplink byte growth' "$active_uploaders"
printf '%-38s %s\n' 'two-client overlapping 2s samples' "$overlap_samples"
printf '%-38s %s\n' 'UL MU-MIMO TB PPDU delta' "$delta_mumimo"
printf '%-38s %s\n' 'UL OFDMA TB PPDU delta' "$delta_ofdma"
printf '%-38s %s\n' 'firmware MURU target phy after' "$after_stats_radios"

if [ "$after_stats_radios" -ne 1 ]; then
	echo 'RESULT_UL_MURU_AIRTEST=ERROR_INCOMPLETE_FIRMWARE_STATS'
	exit 1
fi

if [ "$active_uploaders" -lt 2 ] || [ "$overlap_samples" -lt 1 ]; then
	echo 'RESULT_UL_MURU_AIRTEST=INVALID_NOT_TWO_SIMULTANEOUS_UPLOADERS'
	exit 3
fi

if [ "$delta_mumimo" -gt 0 ]; then
	echo 'RESULT_UL_MUMIMO_OVER_AIR=OBSERVED_IN_WINDOW'
else
	echo 'RESULT_UL_MUMIMO_OVER_AIR=NOT_OBSERVED_IN_WINDOW'
fi
if [ "$delta_ofdma" -gt 0 ]; then
	echo 'RESULT_UL_OFDMA_OVER_AIR=OBSERVED_IN_WINDOW'
else
	echo 'RESULT_UL_OFDMA_OVER_AIR=NOT_OBSERVED_IN_WINDOW'
fi

if [ "$delta_mumimo" -gt 0 ] && [ "$delta_ofdma" -gt 0 ]; then
	echo 'RESULT_UL_MURU_AIRTEST=BOTH_OBSERVED'
	exit 0
fi

echo 'RESULT_UL_MURU_AIRTEST=INCOMPLETE_COUNTER_EVIDENCE'
exit 4
