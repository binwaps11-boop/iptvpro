#!/bin/sh
# Per-client bridge rate guard AND MAC blocks using nftables. Rates are stored
# as Mbit/s in smartap qos sections (mac, down, up); blocks come from firewall
# rules named CR6608-Block-<mac> (the dashboard's block_mac action — the fw4
# rule alone only filters ROUTED traffic, but AP-mode clients are L2-bridged,
# so the actual enforcement happens here in the bridge family). The bridge
# forward hook covers AP-mode switching; input/output cover traffic routed
# through this device (PPPoE). Excess/blocked traffic is dropped.
#
# fw4 flushes the whole ruleset on every firewall reload, destroying foreign
# tables like this one — so the generated table is ALSO written to
# /usr/share/nftables.d/ruleset-post/, which fw4 replays at ruleset scope on
# every reload, keeping the policy alive without any hotplug race.

TABLE=smartap_qos
NFT_BIN="${CR6608_QOS_NFT_BIN:-nft}"
UCI_BIN="${CR6608_QOS_UCI_BIN:-uci}"
LOGGER_BIN="${CR6608_QOS_LOGGER_BIN:-logger}"
RUNTIME_DIR="${CR6608_QOS_RUNTIME_DIR:-/tmp}"
TMP="${RUNTIME_DIR}/cr6608-smartap-qos.$$.nft"
ACTIVE="${RUNTIME_DIR}/cr6608-smartap-qos.active.nft"
PREVIOUS="${RUNTIME_DIR}/cr6608-smartap-qos.previous.$$.nft"
FORWARD_RULES="${RUNTIME_DIR}/cr6608-smartap-qos.forward.$$.nft"
INPUT_RULES="${RUNTIME_DIR}/cr6608-smartap-qos.input.$$.nft"
OUTPUT_RULES="${RUNTIME_DIR}/cr6608-smartap-qos.output.$$.nft"

cleanup() {
	rm -f "$TMP" "$PREVIOUS" "$FORWARD_RULES" "$INPUT_RULES" "$OUTPUT_RULES"
}
trap cleanup EXIT INT TERM

RULESET_POST="${CR6608_QOS_RULESET_POST:-/usr/share/nftables.d/ruleset-post/smartap-qos.nft}"

remove_table() {
	"$NFT_BIN" delete table bridge "$TABLE" >/dev/null 2>&1 || true
	rm -f "$ACTIVE" "$RULESET_POST"
}

valid_rate() {
	case "$1" in ''|*[!0-9]*) return 1 ;; esac
	[ "$1" -ge 1 ] 2>/dev/null && [ "$1" -le 10000 ] 2>/dev/null
}

entries="$("$UCI_BIN" -q show smartap 2>/dev/null | awk -F'[.=]' '/=qos$/{print $2}')"
# Blocked MACs: every firewall rule the dashboard names CR6608-Block-<mac>.
blocked_macs="$("$UCI_BIN" -q show firewall 2>/dev/null |
	sed -n "s/^firewall\.[^.]*\.name='CR6608-Block-\([0-9a-f:]\{17\}\)'\$/\1/p" | sort -u)"
[ -n "$entries" ] || [ -n "$blocked_macs" ] || { remove_table; exit 0; }

: > "$FORWARD_RULES" || exit 1
: > "$INPUT_RULES" || exit 1
: > "$OUTPUT_RULES" || exit 1

rules=0
for mac in $blocked_macs; do
	case "$mac" in
		[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]) ;;
		*) continue ;;
	esac
	for dir_rule in "ether saddr $mac counter drop comment \"SmartAP block src\"" \
			"ether daddr $mac counter drop comment \"SmartAP block dst\""; do
		printf '  %s\n' "$dir_rule" >> "$FORWARD_RULES"
		printf '  %s\n' "$dir_rule" >> "$INPUT_RULES"
		printf '  %s\n' "$dir_rule" >> "$OUTPUT_RULES"
	done
	rules=$((rules + 2))
done
for sec in $entries; do
	mac="$("$UCI_BIN" -q get smartap."$sec".mac 2>/dev/null | tr A-F a-f)"
	dn="$("$UCI_BIN" -q get smartap."$sec".down 2>/dev/null)"
	up="$("$UCI_BIN" -q get smartap."$sec".up 2>/dev/null)"
	case "$mac" in
		[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]) ;;
		*) continue ;;
	esac
	if valid_rate "$dn"; then
		rate=$((dn * 125)); burst=$((rate / 10)); [ "$burst" -ge 64 ] || burst=64
		rule="  ether daddr $mac limit rate over $rate kbytes/second burst $burst kbytes counter drop comment \"SmartAP down $sec\""
		printf '%s\n' "$rule" >> "$FORWARD_RULES"
		printf '%s\n' "$rule" >> "$OUTPUT_RULES"
		rules=$((rules + 1))
	fi
	if valid_rate "$up"; then
		rate=$((up * 125)); burst=$((rate / 10)); [ "$burst" -ge 64 ] || burst=64
		rule="  ether saddr $mac limit rate over $rate kbytes/second burst $burst kbytes counter drop comment \"SmartAP up $sec\""
		printf '%s\n' "$rule" >> "$FORWARD_RULES"
		printf '%s\n' "$rule" >> "$INPUT_RULES"
		rules=$((rules + 1))
	fi
done

{
	echo "table bridge $TABLE {"
	echo " chain forward {"
	echo "  type filter hook forward priority 10; policy accept;"
	cat "$FORWARD_RULES"
	echo " }"
	echo " chain input {"
	echo "  type filter hook input priority 10; policy accept;"
	cat "$INPUT_RULES"
	echo " }"
	echo " chain output {"
	echo "  type filter hook output priority 10; policy accept;"
	cat "$OUTPUT_RULES"
	echo " }"
	echo "}"
} > "$TMP"

[ "$rules" -gt 0 ] || { remove_table; exit 0; }
"$NFT_BIN" -c -f "$TMP" >/dev/null 2>&1 || {
	"$LOGGER_BIN" -t smartap-qos "invalid generated rules; previous table kept"
	exit 1
}

[ ! -s "$ACTIVE" ] || cp -f "$ACTIVE" "$PREVIOUS"
remove_table
"$NFT_BIN" -f "$TMP" || {
	# A runtime failure must not silently remove a previously working policy.
	if [ -s "$PREVIOUS" ] && "$NFT_BIN" -f "$PREVIOUS" >/dev/null 2>&1; then
		cp -f "$PREVIOUS" "$ACTIVE"
		"$LOGGER_BIN" -t smartap-qos "new bridge rate rules failed; previous policy restored"
	else
		"$LOGGER_BIN" -t smartap-qos "failed to install bridge rate rules; no previous policy available"
	fi
	exit 1
}
cp -f "$TMP" "$ACTIVE"
# Persist across fw4 reloads: fw4 replays ruleset-post files at ruleset scope
# after flushing, so the table survives every firewall reload/restart.
if mkdir -p "$(dirname "$RULESET_POST")" 2>/dev/null && cp -f "$TMP" "$RULESET_POST" 2>/dev/null; then
	:
else
	"$LOGGER_BIN" -t smartap-qos "WARNING: could not persist ruleset-post copy; policy will not survive a firewall reload"
fi
"$LOGGER_BIN" -t smartap-qos "installed $rules per-client rate/block rules across bridge and routed paths"
exit 0
