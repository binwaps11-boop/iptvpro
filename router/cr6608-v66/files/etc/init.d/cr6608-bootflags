#!/bin/sh /etc/rc.common
# Late-boot belt-and-braces for the Xiaomi CR6608 single-boot pin.
#
# The real work lives in /usr/sbin/cr6608-bootflags-apply (see its header):
# it pins the vendor u-boot's A/B selector flags so ONLY system 1 (the
# OpenWrt kernel at 0x200000) is ever booted and the empty second slot can
# never be selected ("boot mode" brick).
#
# The applier already ran seconds into boot from /lib/preinit/81_cr6608_bootflags;
# reaching START=99 proves a fully successful boot, and the applier is
# idempotent (reads only, no flash write, unless a flag actually differs), so
# this second pass costs nothing in steady state while catching anything that
# touched the env after preinit (failsafe sessions, sysupgrade, stock tools).

START=99

boot() {
	[ -x /usr/sbin/cr6608-bootflags-apply ] || return 0
	/usr/sbin/cr6608-bootflags-apply late-boot
}

start() {
	[ -x /usr/sbin/cr6608-bootflags-apply ] || return 0
	/usr/sbin/cr6608-bootflags-apply start
}
