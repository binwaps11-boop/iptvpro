#!/bin/sh /etc/rc.common

USE_PROCD=1
START=01
STOP=89

start_service() {
	/usr/sbin/smartap-time-anchor apply || return 1
	procd_open_instance
	procd_set_param command /usr/sbin/smartap-time-anchor monitor
	# A genuine crash is retried, but a broken helper cannot spin forever.
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 0
	procd_set_param stderr 1
	procd_close_instance
}
