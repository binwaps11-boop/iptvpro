#!/bin/sh

# Older quick-settings builds briefly persisted the root password in UCI.
# Remove those fields and any generated archives which may contain them.
uci -q delete cr6608quick.default.admin_password
uci -q delete cr6608quick.default.change_password
uci -q delete smartap.quick.admin_password
uci -q delete smartap.quick.device_password
uci -q delete smartap.quick.change_password
uci -q commit cr6608quick
uci -q commit smartap

rm -rf /root/dashboard-backups /root/cr6608-quicksettings-backups
logger -t cr6608-security "legacy plaintext administrator-password state removed"
exit 0
