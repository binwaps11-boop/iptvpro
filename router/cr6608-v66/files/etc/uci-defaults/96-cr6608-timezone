#!/bin/sh
# Default the clock to UTC+3 (Asia/Riyadh — same zone the shipped
# /etc/config/system uses, so the two defaults agree) — only when still on
# factory UTC, so a user-chosen timezone is never overridden on upgrades
# that keep settings.
zn="$(uci -q get system.@system[0].zonename)"
if [ -z "$zn" ] || [ "$zn" = "UTC" ]; then
	uci set system.@system[0].zonename='Asia/Riyadh'
	uci set system.@system[0].timezone='<+03>-3'
	uci commit system
fi
exit 0
