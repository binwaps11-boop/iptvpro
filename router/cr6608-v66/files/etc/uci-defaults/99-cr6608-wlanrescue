#!/bin/sh
# CR6608: guarantee the Wi-Fi rescue IP 221.221.221.221 exists as a network
# interface. The overlay ships it in /etc/config/network, but a keep-settings
# upgrade restores the unit's OLD network config — which may predate the
# rescue interface or have had it deleted — so re-assert it here to keep the
# owner's recovery escape hatch (http://221.221.221.221/ over any Wi-Fi).
# Idempotent: only creates/repairs the interface, never overwrites a user-moved device.
[ -n "$(uci -q get network.wlanrescue)" ] || uci set network.wlanrescue='interface'
uci set network.wlanrescue.proto='static'
uci set network.wlanrescue.ipaddr='221.221.221.221'
uci set network.wlanrescue.netmask='255.255.255.0'
uci set network.wlanrescue.ipv6='0'
# Park it on the plain bridge so it follows the Wi-Fi clients; Quick Settings moves it to
# br-lan.<vid> in VLAN modes and back to br-lan in AP mode.
[ -n "$(uci -q get network.wlanrescue.device)" ] || uci set network.wlanrescue.device='br-lan'
uci commit network
exit 0
