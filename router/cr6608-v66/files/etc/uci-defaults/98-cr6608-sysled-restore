#!/bin/sh

# Keep boot/failsafe/upgrade LEDs under the DTS diagnostic state machine
# (older images reused them for ethernet links, making boot state ambiguous),
# and remove any static blue:net binding: that LED is owned by the
# cr6608-lanled daemon (on only while a wired LAN port has real link; the old
# br-lan netdev binding kept it lit from Wi-Fi alone, and lan1-only hid
# lan2/lan3).
#
# Delete ONE victim per pass and re-resolve: anonymous sections are addressed
# as @led[N], and deleting one shifts every later index — a pre-collected
# list would delete the wrong sections on units with LuCI-created LED entries.
while :; do
	victim=""
	for s in $(uci -q show system | sed -n "s/^system\.\([^.=]*\)=led$/\1/p"); do
		case "$(uci -q get "system.$s.sysfs")" in
			blue:sys | yellow:sys | blue:net)
				victim="$s"
				break
				;;
		esac
	done
	[ -n "$victim" ] || break
	uci -q delete "system.$victim" || break
done

uci -q set system.led_lan2='led'
uci -q set system.led_lan2.name='WAN link and traffic'
uci -q set system.led_lan2.sysfs='yellow:net'
uci -q set system.led_lan2.trigger='netdev'
uci -q set system.led_lan2.dev='wan'
uci -q set system.led_lan2.mode='link tx rx'
uci -q commit system

exit 0
