#!/bin/sh
# Legacy 802.11b interoperability on 2.4 GHz is OPT-IN. 802.11b basic rates cost
# significant 2.4 GHz airtime and drag the whole band down, so the fast default
# is legacy_rates=0 (OFDM). Enable 11b only when an operator explicitly requests
# it via smartap.wifi.legacy_11b=1 (settable from the dashboard). Never fail on a
# no-op, or uci-defaults would keep re-running this every boot.

board="$(cat /tmp/sysinfo/board_name 2>/dev/null || true)"
[ "$board" = 'xiaomi,mi-router-cr6608' ] || exit 0

want="$(uci -q get smartap.wifi.legacy_11b 2>/dev/null || true)"
[ "$want" = "1" ] || exit 0

changed=0
radios="$(uci -q show wireless 2>/dev/null | sed -n 's/^wireless\.\([^.=]*\)=wifi-device$/\1/p')"
for radio in $radios; do
	band="$(uci -q get "wireless.${radio}.band" 2>/dev/null || true)"
	case "$band" in
		2g|2.4g)
			[ "$(uci -q get "wireless.${radio}.legacy_rates" 2>/dev/null)" = "1" ] && continue
			uci -q set "wireless.${radio}.legacy_rates=1"
			changed=1
			;;
	esac
done

if [ "$changed" -eq 1 ]; then
	uci -q commit wireless
	logger -t cr6608-wireless 'legacy 802.11b rates enabled on 2.4 GHz by operator opt-in'
fi
exit 0
