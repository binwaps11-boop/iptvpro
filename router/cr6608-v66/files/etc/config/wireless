
# CR6608 RF baseline: both radios request 38 dBm and radio1 uses US channel
# 149. The driver-reported accepted value is shown separately; this is not an
# external RF measurement and board/regulatory/firmware limits remain in force.
# Reliability-oriented additions:
#   ldpc / tx_stbc / rx_stbc  -> stronger error-correction + antenna diversity: far clients
#                                decode weak signals reliably (n/ac/ax all benefit)
#   short_gi_*                -> short guard interval: higher rates for ac/n clients
#   distance is omitted       -> netifd/driver default ACK timing; the invalid
#                                legacy string "auto" is removed during apply
#   he_spr_sr_control         -> advertise AX spatial-reuse support when the driver accepts it
config wifi-device 'radio0'
	option type 'mac80211'
	option path '1e140000.pcie/pci0000:00/0000:00:01.0/0000:02:00.0'
	option band '2g'
	option channel '11'
	option htmode 'HE20'
	option country 'US'
	option cell_density '0'
	option antenna_gain '0'
	option airtime_mode '1'
	option he_su_beamformer '1'
	option he_su_beamformee '1'
	option he_mu_beamformer '1'
	# he_bss_color left to the driver default (random) so fleet APs get distinct
	# colours and OBSS-PD spatial reuse can classify inter-BSS frames.
	option he_bss_color_enabled '1'
	# 0 => hostapd computes SR Control = 5 (Non-SRG OBSS-PD ALLOWED + offset
	# present). The stock default 3 leaves bit1 set = OBSS-PD disallowed, so
	# spatial reuse never activates. This enables AX spatial reuse.
	option he_spr_sr_control '0'
	option he_spr_psr_enabled '0'
	option he_spr_non_srg_obss_pd_max_offset '5'
	option he_default_pe_duration '4'
	option he_twt_required '0'
	option ldpc '1'
	option tx_stbc '1'
	option rx_stbc '1'
	option short_gi_20 '1'
	option short_gi_40 '1'
	# 2.4 GHz AC_BE TXOP bursting (radio1/5G gets this implicitly via the VHT
	# path; 2.4 GHz needs it set explicitly).
	option tx_burst '2.0'
	# Fleet-flashable SmartAP image: both radios ship ENABLED so a freshly
	# flashed device is immediately usable without per-device provisioning.
	# The default WiFi passphrase (see the wifi-iface sections) and the
	# root/admin dashboard login are meant to be changed from the dashboard.
	option disabled '0'
	option txpower '38'
	# OFDM basic rates (6/12/24) instead of 1 Mbps CCK: ~6x less beacon/mgmt
	# airtime on 2.4 GHz. Set 1 only if 802.11b-only IoT must associate.
	option legacy_rates '0'

config wifi-device 'radio1'
	option type 'mac80211'
	option path '1e140000.pcie/pci0000:00/0000:00:01.0/0000:02:00.0+1'
	option band '5g'
	option channel '149'
	option htmode 'HE80'
	option country 'US'
	option cell_density '0'
	option antenna_gain '0'
	option he_su_beamformer '1'
	option he_su_beamformee '1'
	option he_mu_beamformer '1'
	option mu_beamformer '1'
	option su_beamformer '1'
	option su_beamformee '1'
	# he_bss_color left to the driver default (random) — see radio0.
	option he_bss_color_enabled '1'
	# 0 => hostapd computes SR Control = 5 (Non-SRG OBSS-PD ALLOWED + offset
	# present). The stock default 3 leaves bit1 set = OBSS-PD disallowed, so
	# spatial reuse never activates. This enables AX spatial reuse.
	option he_spr_sr_control '0'
	option he_spr_psr_enabled '0'
	option he_spr_non_srg_obss_pd_max_offset '5'
	option he_default_pe_duration '4'
	option he_twt_required '0'
	option ldpc '1'
	option tx_stbc '1'
	option rx_stbc '1'
	option short_gi_80 '1'
	option short_gi_40 '1'
	option short_gi_20 '1'
	option airtime_mode '1'
	option disabled '0'
	option txpower '38'
	option legacy_rates '0'

config wifi-iface 'wifinet0'
	option device 'radio0'
	option network 'lan'
	option mode 'ap'
	# Unified SSID on both bands: enables Smart Connect band steering (usteer)
	# and one 802.11r mobility domain across the whole fleet (the domain is
	# derived from the SSID, so every AP with this SSID roams seamlessly).
	option ssid 'Smart ap'
	option encryption 'sae-mixed'
	option key 'smartap2038'
	option ieee80211w '1'
	option disabled '0'
	option mbo '1'
	option ieee80211k '1'
	option ieee80211v '1'
	option bss_transition '1'
	option ieee80211r '1'
	option ft_over_ds '0'
	# Pinned mobility domain so every fleet AP (and the quick-apply executor)
	# agrees; b1a0 = md5("Smart ap\n") which is hostapd's own default for this
	# SSID. ft_psk_generate_local is intentionally omitted: under sae-mixed
	# hostapd then auto-derives wildcard r0kh/r1kh from md5(mobility_domain/key),
	# so FT works for BOTH FT-PSK and FT-SAE clients across the fleet.
	option mobility_domain 'b1a0'
	option wnm_sleep_mode '1'
	option disassoc_low_ack '0'
	option multicast_to_unicast '1'
	option dtim_period '2'
	option wmm '1'
	option isolate '0'
	option uapsd '1'
	option maxassoc '200'
	option max_inactivity '3600'

config wifi-iface 'wifinet1'
	option device 'radio1'
	option network 'lan'
	option mode 'ap'
	option ssid 'Smart ap'
	option encryption 'sae-mixed'
	option key 'smartap2038'
	option ieee80211w '1'
	option disabled '0'
	option mbo '1'
	option ieee80211k '1'
	option ieee80211v '1'
	option bss_transition '1'
	option ieee80211r '1'
	option ft_over_ds '0'
	option mobility_domain 'b1a0'
	option wnm_sleep_mode '1'
	option disassoc_low_ack '0'
	option multicast_to_unicast '1'
	option dtim_period '2'
	option wmm '1'
	option isolate '0'

	option uapsd '1'
	option maxassoc '200'
	option max_inactivity '3600'
