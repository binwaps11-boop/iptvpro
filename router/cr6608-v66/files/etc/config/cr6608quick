config quick 'default'
	option mode 'ap'
	option lan_ipaddr '192.168.1.1'
	option lan_netmask '255.255.255.0'
	option vlan_id '50'
	option ssid 'Smart ap'
	option ssid5 'Smart ap'
	option smart_connect '1'
	option fast_transition '1'
	option channel24 '11'
	option channel5 '149'
	option country24 'US'
	option country5 'US'
	option country 'US'
	option mesh_id 'CR6608-Mesh'
	option wds_ssid 'CR6608-WDS'
	option hide_ssid '0'
	option security 'mixed'
	option clear_previous '1'
	option pppoe_user ''
	option pppoe_pass ''
	option pppoe_port 'wan'
	option reset_lock '0'
	option reset_custom '0'
	option reset_seconds '15'
	option nat_enabled '0'
	option dhcp_server '0'
	option firewall_enabled '1'
	option ipv6_enabled '1'
	option watchcat_enabled '0'
	option broadband_enabled '0'
	option fake_mesh '0'
	# Must match the shipped wireless config (both radios enabled). A '0' here
	# is read back as the fallback for an untouched quick-settings toggle and
	# would turn Wi-Fi off on every apply, guaranteeing the reachability guard
	# rolls back the whole transaction for wireless admins.
	option radio0_enabled '1'
	option radio1_enabled '1'
	option txpower_radio0 '38'
	option txpower_radio1 '38'
	option txpower '38'
