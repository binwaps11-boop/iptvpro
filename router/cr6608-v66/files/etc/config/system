
config system
	option hostname 'CR6608'
	# A clean image has a locked root account, so the serial console is the only
	# provisioning path. Retail provisioning flips this to 1 after installing a
	# unique root credential, restoring password-gated console login.
	option ttylogin '0'
	option log_size '128'
	option urandom_seed '0'
	option compat_version '1.1'
	option zram_size_mb '64'
	option zram_comp_algo 'lzo'
	option zonename 'Asia/Riyadh'
	option timezone '<+03>-3'
	option log_proto 'udp'
	option conloglevel '8'
	# BusyBox crond otherwise records every one-minute session-reaper launch as
	# cron.err even when the job succeeds.  Keep the small in-memory log useful
	# for real faults; the jobs themselves log explicit failures.
	option cronloglevel '9'

config timeserver 'ntp'
	list server '0.openwrt.pool.ntp.org'
	list server '1.openwrt.pool.ntp.org'
	list server '2.openwrt.pool.ntp.org'
	list server '3.openwrt.pool.ntp.org'

# The CR6608 has exactly one LAN-capable LED (blue:net); the kernel netdev
# trigger follows a single interface, and binding it to lan1 left lan2/lan3
# invisible. br-lan covers every LAN port (and Wi-Fi bridge traffic).
config led 'led_lan1'
	option name 'LAN link and traffic'
	option sysfs 'blue:net'
	option trigger 'netdev'
	option dev 'br-lan'
	option mode 'link tx rx'

config led 'led_lan2'
	option name 'WAN link and traffic'
	option sysfs 'yellow:net'
	option trigger 'netdev'
	option dev 'wan'
	option mode 'link tx rx'
