config smartap 'management'
	option ipaddr '192.168.1.1'
	option recovery_always '1'
	option recovery_wifi '1'
	option vlan '1'

config smartap 'security'
	option enabled '1'
	option flood_guard '1'
	option loop_guard '0'
	option rogue_dhcp_guard '1'

config smartap 'quick'
	option txpower '38'
	option ch24 '11'
	option ch5 '149'
	option country24 'US'
	option country5 'US'
	option htmode24 'HE20'
	option htmode5 'HE80'
	option txpower_radio0 '38'
	option txpower_radio1 '38'

config smartap 'autochannel'
	option enabled '0'

config experimental 'experimental'
	option ul_muru '1'
	option ul_muru_guard '1'
	option ul_muru_state 'armed'

config port 'lan1'
	option enabled '1'
	option isolate '0'
	option vlan '1'
	option vlan_mode 'auto'

config port 'lan2'
	option enabled '1'
	option isolate '0'
	option vlan '1'
	option vlan_mode 'auto'

config port 'lan3'
	option enabled '1'
	option isolate '0'
	option vlan '1'
	option vlan_mode 'auto'

config identity 'identity'
	option enabled '1'
	option customer_name ''
	option device_name 'CR6608'
	option phone ''
	option interval '30'
