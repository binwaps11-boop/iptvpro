config usteer 'main'
	option enabled '1'
	option network 'lan'
	option syslog '1'
	option debug_level '1'
	option local_mode '1'
	option ipv6 '0'

	# Smart Connect owns the SSID list and interval when explicitly enabled.
	# Association/probe rejection and every forced-kick policy remain disabled.
	option assoc_steering '0'
	option aggressiveness '1'
	option min_connect_snr '0'
	option min_snr '0'
	option signal_diff_threshold '0'
	option load_balancing_threshold '0'
	option load_kick_enabled '0'
	# Non-zero intervals are REQUIRED or band_steering.c / local_node.c return
	# early and no steering runs at all — an enabled usteer with 0 intervals is
	# a silent no-op. These drive 5 GHz-preferred band steering conservatively.
	option band_steering_interval '120000'
	option band_steering_min_snr '-60'
	option link_measurement_interval '30000'
