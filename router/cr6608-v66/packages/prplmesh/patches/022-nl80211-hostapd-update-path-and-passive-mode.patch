From: Smart AP firmware project
Subject: [PATCH] nl80211: use hostapd update path and honor passive mode

Stock hostapd requires UPDATE to include the path of the configuration file.
Expose that path from the configuration object.  When the OpenWrt integration
is explicitly running in passive mode, do not rewrite netifd's generated
configuration; the existing AP remains the active fronthaul and the EasyMesh
control plane can monitor and steer it without changing SSIDs during boot.

--- a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
+++ b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
@@ -12,6 +12,7 @@
 #include <bcl/son/son_assoc_frame_utils.h>
 #include <bcl/son/son_wireless_utils.h>
 #include <bwl/key_value_parser.h>
+#include <cstdlib>
 #include <cmath>
 #include <easylogging++.h>
 #include <hostapd/configuration.h>
--- a/common/beerocks/hostapd/include/hostapd/configuration.h
+++ b/common/beerocks/hostapd/include/hostapd/configuration.h
@@ -215,6 +215,8 @@ public:
      */
     const std::string &get_last_message() const;
 
+    const std::string &file_name() const { return m_configuration_file; }
+
 private:
     /**
      * @brief helper: load configuration based on array of strings
--- a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
+++ b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
@@ -636,7 +636,7 @@ bool ap_wlan_hal_nl80211::set_channel(int chan, beerocks::eWiFiBandwidth bw, in
     }
 
     // make hostapd reload its configuration file:
-    const std::string cmd{"UPDATE "};
+    const std::string cmd{"UPDATE " + conf.file_name()};
     if (!wpa_ctrl_send_msg(cmd)) {
         LOG(ERROR) << "'" << cmd << "' command to hostapd failed";
         return false;
@@ -1037,13 +1037,19 @@ bool ap_wlan_hal_nl80211::update_vap_credentials(
         return false;
     }
 
+    const char *passive_mode = std::getenv("PRPLMESH_PASSIVE_MODE");
+    if (passive_mode && std::string(passive_mode) == "1") {
+        LOG(INFO) << "Autoconfiguration: passive OpenWrt mode keeps netifd hostapd data intact";
+        return true;
+    }
+
     if (conf.update_required()) {
         if (!conf.store()) {
             LOG(ERROR) << "Autoconfiguration: cannot save hostapd config!";
             return false;
         }
 
-        const std::string cmd("UPDATE ");
+        const std::string cmd("UPDATE " + conf.file_name());
         if (!wpa_ctrl_send_msg(cmd)) {
             LOG(ERROR) << "Autoconfiguration: \"" << cmd << "\" command to hostapd has failed";
             return false;
