From: Smart AP firmware project
Subject: [PATCH] prplMesh: remove moves that prevent copy elision

GCC 14 diagnoses std::move() applied directly to temporary objects as
pessimizing moves. Let C++14 copy elision construct the destinations
directly; this is equivalent and avoids the -Werror build failure.

--- a/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.cpp
+++ b/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.cpp
@@ -1534,7 +1534,7 @@ bool BackhaulManager::handle_slave_backhaul_message(int fd, ieee1905_1::CmduMess
     case beerocks_message::ACTION_BACKHAUL_REGISTER_REQUEST: {
 
         m_agent_fd      = fd;
-        auto agent_name = std::move(std::string("agent"));
+        auto agent_name = std::string("agent");
         LOG(DEBUG) << "Assigning FD (" << fd << ") to " << agent_name;
         m_cmdu_server->set_client_name(fd, agent_name);
 
--- a/agent/src/beerocks/slave/platform_manager/platform_manager.cpp
+++ b/agent/src/beerocks/slave/platform_manager/platform_manager.cpp
@@ -414,7 +414,7 @@ bool PlatformManager::handle_cmdu(int fd, ieee1905_1::CmduMessageRx &cmdu_rx)
             return false;
         }
 
-        auto agent_name = std::move(std::string("agent socket"));
+        auto agent_name = std::string("agent socket");
         LOG(DEBUG) << "Assigning FD (" << fd << ") to " << agent_name;
         m_cmdu_server->set_client_name(fd, agent_name);
 
--- a/framework/platform/bpl/cfg/uci/bpl_cfg_wifi.cpp
+++ b/framework/platform/bpl/cfg/uci/bpl_cfg_wifi.cpp
@@ -527,8 +527,7 @@ bool cfg_get_monitor_vaps(const std::string &iface, std::set<std::string> &monito
     }
     // the monitored_bsss option is a list seperated by the ',' delimiter
     auto monitored_BSSs_vec = beerocks::string_utils::str_split(monitored_bsss, ',');
-    monitored_BSSs =
-        std::move(std::set<std::string>(monitored_BSSs_vec.begin(), monitored_BSSs_vec.end()));
+    monitored_BSSs = std::set<std::string>(monitored_BSSs_vec.begin(), monitored_BSSs_vec.end());
     return true;
     // break monitor vaps to vector
 }
--- a/framework/platform/wbapi/ambiorix_variant.cpp
+++ b/framework/platform/wbapi/ambiorix_variant.cpp
@@ -240,6 +240,6 @@ bool AmbiorixVariant::get_children(AmbiorixVariantListSmartPtr &result, bool extr
 {
     if (!result) {
-        result = std::move(std::make_unique<AmbiorixVariantList>());
+        result = std::make_unique<AmbiorixVariantList>();
     } else {
         result->clear();
     }
