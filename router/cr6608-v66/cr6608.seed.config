# OpenWrt 25.12.5 diffconfig seed for Xiaomi Mi Router CR6608.
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_xiaomi_mi-router-cr6608=y
CONFIG_TARGET_MULTI_PROFILE=n
CONFIG_USE_APK=y
CONFIG_IPV6=y

# MT7915/mt76 wireless stack and runtime inspection tools.
CONFIG_PACKAGE_kmod-mt7915e=y
CONFIG_PACKAGE_kmod-mt7915-firmware=y
CONFIG_PACKAGE_kmod-mt76-connac=y
CONFIG_PACKAGE_kmod-mac80211=y
CONFIG_PACKAGE_kmod-cfg80211=y
CONFIG_PACKAGE_wireless-regdb=y
CONFIG_PACKAGE_iw-full=y
CONFIG_PACKAGE_iwinfo=y

# Official roaming-assist daemon; policy remains opt-in at runtime.
CONFIG_PACKAGE_usteer=y

# Full EasyMesh control plane: prplMesh Controller + Agent with the generic
# NL80211 backend. Runtime remains disabled until its on-device health gate
# confirms that IEEE1905, controller and agent processes stay healthy.
CONFIG_PACKAGE_prplmesh=y
# CONFIG_PRPLMESH_ENABLE_UNIT_TESTS is not set

# Full WPA2/WPA3 hostapd/wpa_supplicant variant used by the working image.
CONFIG_PACKAGE_wpad-openssl=y
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set
# CONFIG_PACKAGE_wpad-basic-wolfssl is not set

# LuCI/Argon integration and the RPC modules used by Smart AP.
CONFIG_PACKAGE_lldpd=y
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-usteer=y
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_luci-proto-ppp=y
CONFIG_PACKAGE_luci-i18n-base-ar=y
CONFIG_PACKAGE_luci-i18n-firewall-ar=y
CONFIG_PACKAGE_uhttpd-mod-ucode=y
CONFIG_PACKAGE_rpcd-mod-file=y
CONFIG_PACKAGE_rpcd-mod-iwinfo=y

# Networking and diagnostics retained from the verified runtime.
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_ip-bridge=y
CONFIG_PACKAGE_ip-tiny=y
CONFIG_PACKAGE_coreutils-stat=y
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_zram-swap=y

# Official SQM/CAKE stack. The upstream SQM config stays disabled until an
# administrator explicitly selects an uplink and rates.
CONFIG_PACKAGE_sqm-scripts=y
CONFIG_PACKAGE_tc-tiny=y
CONFIG_PACKAGE_kmod-sched-core=y
CONFIG_PACKAGE_kmod-sched-cake=y
CONFIG_PACKAGE_kmod-ifb=y
CONFIG_PACKAGE_iptables=y
CONFIG_PACKAGE_iptables-mod-ipopt=y

# firewall4 uses nftables, so select only the official nftables miniupnpd
# variant. UPnP/PCP/NAT-PMP remains disabled until an uplink is configured.
CONFIG_PACKAGE_miniupnpd-nftables=y

# u-boot env access (fw_printenv/fw_setenv). Required so cr6608-bootflags can
# clear the Xiaomi dual-boot failover flags in the u-boot environment and keep
# the device booting the OpenWrt slot instead of dropping to bootloader mode.
CONFIG_PACKAGE_uboot-envtools=y

# Keep the image compact while retaining the working feature set.
# CONFIG_PACKAGE_htop is not set
# CONFIG_PACKAGE_nano is not set
CONFIG_TARGET_ROOTFS_SQUASHFS=y
