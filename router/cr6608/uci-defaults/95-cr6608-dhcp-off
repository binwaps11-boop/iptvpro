#!/bin/sh
# Address-handout policy. In AP modes there is NO IPv4 DHCP and no IPv6 whatsoever — the
# upstream router (Mikrotik) is the only address server. In broadband/PPPoE router mode the
# device IS the main router, so it serves IPv4 DHCP to its clients (still no IPv6).

# --- IPv4 DHCP policy by mode ---
# Broadband/PPPoE router mode (wan is a live pppoe uplink): the device is the main router,
# so it MUST serve DHCP to its clients -> ensure a working LAN pool. Every other (AP) mode:
# DELETE all pools so nothing serves or appears.
if [ "$(uci -q get network.wan.proto)" = "pppoe" ] && [ "$(uci -q get network.wan.disabled)" != "1" ]; then
	uci -q get dhcp.lan >/dev/null 2>&1 || { uci -q set dhcp.lan=dhcp; uci -q set dhcp.lan.interface='lan'; uci -q set dhcp.lan.start='100'; uci -q set dhcp.lan.limit='150'; uci -q set dhcp.lan.leasetime='12h'; }
	uci -q delete dhcp.lan.ignore
	uci -q delete dhcp.lan.dhcpv4
	uci -q set dhcp.lan.dhcpv6='disabled'; uci -q set dhcp.lan.ra='disabled'; uci -q set dhcp.lan.ndp='disabled'
else
	for s in $(uci -q show dhcp | sed -n "s/^dhcp\.\([^.=]*\)=dhcp$/\1/p"); do
		uci -q delete dhcp."$s"
	done
fi
uci -q set dhcp.@dnsmasq[0].filter_aaaa='1'   # never answer IPv6 (AAAA) DNS either
# odhcpd (DHCPv6/RA server) hard-off; also stop+disable the service if it ever exists
uci -q set dhcp.odhcpd.disabled='1' 2>/dev/null || true
uci -q set dhcp.odhcpd.maindhcp='0' 2>/dev/null || true
[ -x /etc/init.d/odhcpd ] && { /etc/init.d/odhcpd stop >/dev/null 2>&1; /etc/init.d/odhcpd disable >/dev/null 2>&1; }
uci -q commit dhcp

# --- IPv6: disable on every network interface (the kernel here also has no IPv6 at all) ---
for i in $(uci -q show network | sed -n "s/^network\.\([^.=]*\)=interface$/\1/p"); do
	uci -q set network."$i".ipv6='0'
	uci -q set network."$i".delegate='0'
done
uci -q commit network

# --- belt-and-suspenders sysctl: refuse IPv6 addressing/RA if a module ever appeared ---
{
	echo 'net.ipv6.conf.all.disable_ipv6=1'
	echo 'net.ipv6.conf.default.disable_ipv6=1'
	echo 'net.ipv6.conf.all.accept_ra=0'
} 2>/dev/null | while read l; do sysctl -w "$l" >/dev/null 2>&1; done

/etc/init.d/dnsmasq reload >/dev/null 2>&1
exit 0
