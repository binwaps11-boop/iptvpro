#!/bin/sh
# cr6608-vlan-lib — the SINGLE owner of wired-port VLAN membership on br-lan (DSA).
# Port model (owner spec — any combination must work):
#   smartap.<port>.vlan  =  ''/1        -> NORMAL : untagged member of management VLAN 1
#   smartap.<port>.vlan  =  N (2..4094) -> ACCESS : untagged+PVID member of VLAN N —
#                                          a plain device plugged in lands INSIDE the VLAN
#   smartap.<port>.vlan_mode = 'trunk'  -> TRUNK  : management untagged + VLAN N tagged
#                                          (toward the Mikrotik / a VLAN-aware switch)
# wan with no explicit pref defaults to TRUNK of the quick-settings VLAN when one is
# active (the uplink must carry both networks), else NORMAL.
# Management guarantee: VLAN 1 keeps the dashboard reachable on every NORMAL/TRUNK port;
# Wi-Fi rescue 221.221.221.221 covers the case where every port is put in the VLAN.

cr6608_clear_port_vlans() {
	while uci -q show network 2>/dev/null | grep -Eq "\.name='SmartAP-(qvlan|pv)"; do
		local idx
		idx="$(uci show network 2>/dev/null | sed -n "s/^network\.\(@bridge-vlan\[[0-9]*\]\)\.name='SmartAP-\(qvlan\|pv\).*/\1/p" | head -n1)"
		[ -n "$idx" ] || break
		uci -q delete "network.$idx" || break
	done
}

cr6608_apply_port_vlans() { # $1 = active quick-settings client VID ('' when none)
	local qvid="$1" p pv pm s v pl vids="" mgmt_ports="" any_client=0

	cr6608_clear_port_vlans

	for p in lan1 lan2 lan3 wan; do
		[ -d "/sys/class/net/$p" ] || continue
		pv="$(uci -q get smartap.$p.vlan)"
		pm="$(uci -q get smartap.$p.vlan_mode)"
		# uplink default: carry the quick VLAN tagged + management untagged
		[ "$p" = "wan" ] && [ -z "$pv" ] && [ -n "$qvid" ] && { pv="$qvid"; pm="trunk"; }
		case "$pv" in ''|1|0|*[!0-9]*) pv="" ;; esac
		[ -n "$pv" ] && { [ "$pv" -ge 2 ] 2>/dev/null && [ "$pv" -le 4094 ] 2>/dev/null || pv=""; }
		if [ -z "$pv" ]; then
			mgmt_ports="$mgmt_ports $p"
		elif [ "$pm" = "trunk" ]; then
			mgmt_ports="$mgmt_ports $p"
			eval "_vpt_$pv=\"\${_vpt_$pv:-} $p\""
			echo " $vids " | grep -q " $pv " || vids="$vids $pv"
			any_client=1
		else
			eval "_vpu_$pv=\"\${_vpu_$pv:-} $p\""
			echo " $vids " | grep -q " $pv " || vids="$vids $pv"
			any_client=1
		fi
	done
	# the quick VLAN must exist even with zero wired members (Wi-Fi lives inside it)
	if [ -n "$qvid" ]; then
		echo " $vids " | grep -q " $qvid " || vids="$vids $qvid"
		any_client=1
	fi

	if [ "$any_client" = "0" ]; then
		# nothing asks for a VLAN -> plain bridge, management everywhere (original state)
		uci -q delete network.@device[0].vlan_filtering
		uci set network.lan.device='br-lan'
		uci -q get network.recovery >/dev/null 2>&1 && uci set network.recovery.device='@lan'
		return 0
	fi

	uci set network.@device[0].vlan_filtering='1'
	# management VLAN 1, untagged on every NORMAL/TRUNK port
	s="$(uci add network bridge-vlan)"
	uci set "network.$s.name=SmartAP-pv-mgmt"
	uci set "network.$s.device=br-lan"
	uci set "network.$s.vlan=1"
	for p in $mgmt_ports; do uci add_list "network.$s.ports=$p:u*"; done
	uci set network.lan.device='br-lan.1'
	uci -q get network.recovery >/dev/null 2>&1 && uci set network.recovery.device='br-lan.1'

	for v in $vids; do
		s="$(uci add network bridge-vlan)"
		uci set "network.$s.name=SmartAP-pv-$v"
		uci set "network.$s.device=br-lan"
		uci set "network.$s.vlan=$v"
		eval "pl=\$_vpu_$v"
		for p in $pl; do uci add_list "network.$s.ports=$p:u*"; done
		eval "pl=\$_vpt_$v"
		for p in $pl; do uci add_list "network.$s.ports=$p:t"; done
		eval "_vpu_$v=''; _vpt_$v=''"
	done
	return 0
}
