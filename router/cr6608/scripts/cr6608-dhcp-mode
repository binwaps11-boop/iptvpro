#!/bin/sh
# Single source of truth for the DHCP-by-mode policy.
#
# The LAN serves DHCP *only* when the WAN is a live PPPoE uplink (i.e. the unit was programmed
# as a broadband/PPPoE router). In that mode the device is the main router, so its Wi-Fi/LAN
# clients must get addresses automatically. In EVERY other case (Access Point, AP+VLAN, mesh,
# WDS, or a parked/disabled WAN) there is no DHCP pool at all — the upstream router is the only
# address server. Works no matter how PPPoE was set (Smart AP Quick Settings OR LuCI/Argon),
# because it keys purely off network.wan.proto.
proto="$(uci -q get network.wan.proto 2>/dev/null)"
dis="$(uci -q get network.wan.disabled 2>/dev/null)"
if [ "$proto" = "pppoe" ] && [ "$dis" != "1" ]; then
	# broadband router mode -> ensure a working LAN DHCP pool (IPv4 only; IPv6 stays off)
	uci -q get dhcp.lan >/dev/null 2>&1 || { uci set dhcp.lan=dhcp; uci set dhcp.lan.interface='lan'; uci set dhcp.lan.start='100'; uci set dhcp.lan.limit='150'; uci set dhcp.lan.leasetime='12h'; }
	uci -q delete dhcp.lan.ignore
	uci -q delete dhcp.lan.dhcpv4
	uci -q set dhcp.lan.dhcpv6='disabled'; uci -q set dhcp.lan.ra='disabled'; uci -q set dhcp.lan.ndp='disabled'
else
	# any AP mode -> delete every pool so nothing serves or appears
	for s in $(uci -q show dhcp 2>/dev/null | sed -n "s/^dhcp\.\([^.=]*\)=dhcp$/\1/p"); do
		uci -q delete dhcp."$s"
	done
fi
uci -q commit dhcp
/etc/init.d/dnsmasq reload >/dev/null 2>&1 || /etc/init.d/dnsmasq restart >/dev/null 2>&1 || true
exit 0
