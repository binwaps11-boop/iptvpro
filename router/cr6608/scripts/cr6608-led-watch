#!/bin/sh
# cr6608-led-watch — the Internet LED follows REAL cable state on ANY wired port.
# The stock netdev trigger can only watch ONE netdev (wan), but the owner plugs the
# uplink into any port. This watcher lights the LED when any of wan/lan1-3 has
# carrier and turns it off when no cable is in. 2s poll, negligible cost.
LED=""
for d in /sys/class/leds/blue:net /sys/class/leds/yellow:net; do
	[ -d "$d" ] && LED="$d" && break
done
[ -n "$LED" ] || exit 0
echo none > "$LED/trigger" 2>/dev/null
last=""
while :; do
	c=0
	for p in wan lan1 lan2 lan3; do
		[ "$(cat /sys/class/net/$p/carrier 2>/dev/null)" = "1" ] && { c=1; break; }
	done
	# write every cycle (not only on change): a 'system' reload can hand the LED
	# back to another trigger - reclaim it within 2s
	[ "$(cat "$LED/trigger" 2>/dev/null | grep -o '\[none\]')" = "[none]" ] || echo none > "$LED/trigger" 2>/dev/null
	echo "$( [ "$c" = "1" ] && echo 255 || echo 0 )" > "$LED/brightness" 2>/dev/null
	last="$c"
	sleep 2
done
