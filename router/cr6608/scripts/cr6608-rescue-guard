#!/bin/sh
# Make the Wi-Fi rescue IP 221.221.221.221 reachable ONLY over Wi-Fi.
#
# 221.221.221.221 is a static alias on br-lan, which bridges both the Wi-Fi radios and the
# wired ports that face the upstream Mikrotik. This rule drops every ARP/IP frame for that
# one address on the WIRED bridge ports (lan1/lan2/lan3/wan), so:
#   * the Mikrotik (and anything on a cable) can never reach 221.221.221.221, and
#   * the AP never answers/announces it toward the cable, so it does not appear upstream.
# The Wi-Fi AP interfaces (phy*-ap*) are untouched, so rescue over Wi-Fi still works.
#
# Uses the nftables *bridge* family (hooks into bridging directly; no br_netfilter needed).
# It matches ONLY 221.221.221.221 — all other traffic is policy-accept, so nothing else is
# affected. Fail-safe: if nft is missing or the ruleset errors, it simply does nothing and
# 192.168.1.1 over cable remains the primary way in.
[ -x /usr/sbin/nft ] || exit 0
RIP="221.221.221.221"
WIRED='"lan1", "lan2", "lan3", "wan"'
nft -f - 2>/dev/null <<EOF || exit 0
table bridge rescue221 {}
delete table bridge rescue221
table bridge rescue221 {
	chain ingress {
		type filter hook prerouting priority -300; policy accept;
		iifname { $WIRED } ether type arp arp daddr ip $RIP drop
		iifname { $WIRED } ether type ip ip daddr $RIP drop
	}
	chain egress {
		type filter hook postrouting priority 300; policy accept;
		oifname { $WIRED } ether type arp arp saddr ip $RIP drop
		oifname { $WIRED } ether type ip ip saddr $RIP drop
	}
}
EOF
exit 0
