#!/bin/sh

# Keep boot/failsafe/upgrade LEDs under the DTS diagnostic state machine. Older
# images reused them for ethernet links, which made boot state ambiguous.
for s in $(uci -q show system | sed -n "s/^system\.\([^.=]*\)=led$/\1/p"); do
	case "$(uci -q get "system.$s.sysfs")" in
		blue:sys|yellow:sys) uci -q delete "system.$s" ;;
	esac
done

# Bind the blue network LED to a physical Ethernet link, not br-lan. The bridge
# remains up while Wi-Fi is active and would otherwise keep the LED lit with no
# cable inserted.
uci -q set system.led_lan1='led'
uci -q set system.led_lan1.name='LAN1 link and traffic'
uci -q set system.led_lan1.sysfs='blue:net'
uci -q set system.led_lan1.trigger='netdev'
uci -q set system.led_lan1.dev='lan1'
uci -q set system.led_lan1.mode='link tx rx'
uci -q set system.led_lan2='led'
uci -q set system.led_lan2.name='WAN link and traffic'
uci -q set system.led_lan2.sysfs='yellow:net'
uci -q set system.led_lan2.trigger='netdev'
uci -q set system.led_lan2.dev='wan'
uci -q set system.led_lan2.mode='link tx rx'
uci -q commit system

exit 0
