#!/bin/sh
# TX power baseline on first boot. txpower=38 on both radios; the shipped regulatory.db
# grants 38 dBm on all countries incl. PA, the mt7915e build carries cr6608_rf_38dbm
# (target/SKU floored to 38), and cr6608-force-txpower38 pins + verifies it via iw — so
# iw dev / iwinfo / iw phy / LuCI report 38. beamforming focuses RF toward each client.
# The operator can change any of these from Quick Settings; a re-flash resets to these.
uci -q set wireless.radio0.txpower='38'
uci -q set wireless.radio1.txpower='38'
# 2.4G at 20 MHz (owner request): narrower, cleaner channel -> better range and far less
# co-channel interference in crowded 2.4G. 5G stays wide (HE80) for throughput.
uci -q set wireless.radio0.htmode='HE20'
uci -q set wireless.radio1.channel='36'
uci -q set wireless.radio0.he_su_beamformer='1'; uci -q set wireless.radio0.he_su_beamformee='1'; uci -q set wireless.radio0.he_mu_beamformer='1'
uci -q set wireless.radio1.he_su_beamformer='1'; uci -q set wireless.radio1.he_su_beamformee='1'; uci -q set wireless.radio1.he_mu_beamformer='1'
uci -q commit wireless
exit 0
