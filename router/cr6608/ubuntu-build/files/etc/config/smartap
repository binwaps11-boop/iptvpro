config smartap 'management'
	option ipaddr '192.168.1.1'
	option recovery_always '1'
	option recovery_wifi '1'
	option vlan '1'

config smartap 'security'
	option enabled '1'
	option flood_guard '1'
	option loop_guard '1'
	option rogue_dhcp_guard '1'

config smartap 'quick'
	option txpower '38'

config smartap 'autochannel'
	option enabled '0'
