#!/bin/sh
# Pin every radio to 38 dBm (3800 mBm) after the phy appears. regdb allows 38 dBm
# on all countries incl. PA, so `fixed 3800` succeeds and iw/iwinfo/LuCI then
# report 38. Runs on every ieee80211 hotplug (boot + wifi reload re-creates phy).
(
	sleep 6
	iw reg set PA 2>/dev/null || true
	for phy_path in /sys/class/ieee80211/phy*; do
		[ -d "$phy_path" ] || continue
		phy="${phy_path##*/}"
		iw phy "$phy" set txpower fixed 3800 2>/dev/null || \
		iw phy "$phy" set txpower limit 3800 2>/dev/null || true
	done
) &
