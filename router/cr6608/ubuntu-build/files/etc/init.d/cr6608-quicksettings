#!/bin/sh /etc/rc.common
# Two jobs:
#  1) BOOT SELF-HEAL: the unified store (cr6608quick) is the DESIRED STATE. Every
#     boot re-applies it, so a power cycle always comes back exactly as programmed —
#     even if /etc/config/network was corrupted or lan was deleted, the executor
#     recreates it (this is why Wi-Fi used to vanish after unplugging the power).
#  2) Native LuCI "Save & Apply" commits cr6608quick via rpcd/procd reload_config;
#     the procd reload trigger wires that to the SAME executor the page button uses.
START=99
USE_PROCD=1

start_service() {
	# 'sync' = inline apply (config + runtime): boot settles to the desired state
	procd_open_instance boot_apply
	procd_set_param command /usr/sbin/cr6608-quicksettings-apply sync
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "cr6608quick"
}

reload_service() {
	/usr/sbin/cr6608-quicksettings-apply apply
}
