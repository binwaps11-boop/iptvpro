#!/bin/sh
# cr6608-txpower-verify — prove Requested vs Applied TX power on the REAL device.
# Requested = what UCI saved. Applied = what the driver declares via iw/iwinfo.
# NEITHER is measured radiated power — real proof needs an RF power meter / spectrum analyzer.
echo "==================== CR6608 TX-POWER VERIFY ===================="
echo "# 1) Requested (saved in /etc/config/wireless):"
uci show wireless | grep txpower
echo
echo "# 2) Regulatory ceiling the kernel sees:"
iw reg get 2>/dev/null | sed -n '1,12p'
echo
echo "# 3) Per-channel limits the driver exposes (dBm):"
iw phy 2>/dev/null | grep -A2 -iE "MHz|dBm" | grep -iE "MHz|dBm" | head -40
echo
echo "# 4) Applied per interface (driver-declared, NOT measured):"
for IF in $(iw dev 2>/dev/null | awk '/Interface/{print $2}'); do
  a="$(iw dev "$IF" info 2>/dev/null | awk '/txpower/{print $2, $3}')"
  echo "   $IF : ${a:-unknown}"
done
echo
echo "# 5) iwinfo view:"
iwinfo 2>/dev/null | grep -iE "ESSID|Tx-Power|Mode|Channel" | head -30
echo
echo "# 6) Driver RF banner (35 vs 38 build):"
dmesg 2>/dev/null | grep -i "CR6608-RF" | tail -3
echo "   (expect 'CR6608-RF-38DBM-LINEAR' only after rebuilding mt76 with the 38 patch;"
echo "    'CR6608-RF-35DBM' means the 35-ceiling driver is still loaded.)"
echo
echo "# VERDICT LOGIC:"
echo "   Applied == Requested  -> driver accepted the request (still a REQUEST, not radiated power)."
echo "   Applied  < Requested  -> clipped. Order of clipping: regulatory -> mt76 SKU -> EEPROM/caldata -> PA."
echo "   On this 2x2 MT7915 the true ceiling is the PA (~20-22 dBm conducted / ~30 dBm EIRP)."
echo "   REAL proof of 38 dBm = RF power meter / calibrated spectrum analyzer, or RSSI A/B at fixed distance."
echo "==============================================================="
