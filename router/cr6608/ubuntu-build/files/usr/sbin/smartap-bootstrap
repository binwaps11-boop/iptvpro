#!/bin/sh
# Idempotent baseline for Smart AP installs on CR6608/OpenWrt.
# Keeps dashboard access alive while enabling the UI-owned VLAN/mesh/port features.

changed=0
changed_network=0
changed_firewall=0
changed_wireless=0
changed_smartap=0

mark_changed() {
  changed=1
  case "$1" in
    network) changed_network=1 ;;
    firewall) changed_firewall=1 ;;
    wireless) changed_wireless=1 ;;
    smartap) changed_smartap=1 ;;
  esac
}

g() { uci -q get "$1" 2>/dev/null; }

ensure_section() {
  key="$1"
  type="$2"
  cfg="$3"
  uci -q get "$key" >/dev/null 2>&1 && return 0
  uci set "$key=$type" 2>/dev/null && mark_changed "$cfg"
}

setv() {
  key="$1"
  val="$2"
  cfg="$3"
  [ "$(g "$key")" = "$val" ] && return 0
  uci set "$key=$val" 2>/dev/null && mark_changed "$cfg"
}

add_list_once() {
  sec="$1"
  opt="$2"
  val="$3"
  cfg="$4"
  uci -q get "$sec.$opt" 2>/dev/null | tr ' ' '\n' | grep -qx "$val" && return 0
  uci add_list "$sec.$opt=$val" 2>/dev/null && mark_changed "$cfg"
}

find_lan_zone() {
  uci show firewall 2>/dev/null | sed -n "s/^firewall\.\([^=]*\)\.name='lan'.*/\1/p" | head -n 1
}

find_radio0_ap() {
  for s in $(uci show wireless 2>/dev/null | awk -F'[.=]' '/=wifi-iface/{print $2}'); do
    [ "$s" = "smartap_mgmt" ] && continue
    [ "$(g wireless.$s.device)" = "radio0" ] || continue
    [ "$(g wireless.$s.mode)" = "ap" ] || continue
    [ "$(g wireless.$s.disabled)" = "1" ] && continue
    echo "$s"
    return 0
  done
}

host="$(cat /proc/sys/kernel/hostname 2>/dev/null)"
[ -n "$host" ] || host="CR6608-SmartAP"

# Smart AP defaults consumed by dashctl and cr6608-security-apply.
ensure_section smartap.security security smartap
setv smartap.security.enabled 1 smartap
setv smartap.security.flood_guard 1 smartap
setv smartap.security.rogue_dhcp_guard 1 smartap
setv smartap.security.loop_guard 1 smartap

ensure_section smartap.management management smartap
setv smartap.management.vlan 1 smartap
setv smartap.management.ipaddr 192.168.1.1 smartap
setv smartap.management.recovery_always 0 smartap
setv smartap.management.recovery_wifi 0 smartap

for n in 1 2 3; do
  ensure_section "smartap.lan$n" port smartap
  setv "smartap.lan$n.enabled" 1 smartap
  setv "smartap.lan$n.isolate" 0 smartap
  setv "smartap.lan$n.vlan" 1 smartap
done

# Fixed ethernet access address: 192.168.1.1 always answers over any LAN cable.
ensure_section network.lan interface network
setv network.lan.ipaddr 192.168.1.1 network
setv network.lan.netmask 255.255.255.0 network

# Recovery IP (192.168.66.1) removed by owner request. Any leftover recovery interface,
# its DHCP pool, and its Wi-Fi SSID from an older build are deleted so they cannot reappear.
# Access stays: 192.168.1.1 over any cable, and 221.221.221.221 over any Wi-Fi network.
uci -q delete network.recovery 2>/dev/null || true
uci -q delete dhcp.recovery 2>/dev/null || true
uci -q delete wireless.smartap_mgmt 2>/dev/null || true

# No DHCP client here. The device must never request an address from upstream nor hand
# one out. Any leftover 'mgmt' DHCP-client interface from an older build is removed so it
# can never reappear in LuCI or pull a lease.
uci -q delete network.mgmt 2>/dev/null || true
uci -q delete network.wan 2>/dev/null || true

# Trusted LAN zone: lan (192.168.1.1) and the Wi-Fi rescue address only.
zone="$(find_lan_zone)"
if [ -n "$zone" ]; then
  setv "firewall.$zone.input" ACCEPT firewall
  add_list_once "firewall.$zone" network lan firewall
  uci -q del_list "firewall.$zone.network=recovery" 2>/dev/null || true
fi


# Rescue programming IP (reference-source behavior): 221.221.221.221 on the bridge,
# reachable over Wi-Fi with a static client IP regardless of VLAN/mesh programming.
ensure_section network.wlanrescue interface network
setv network.wlanrescue.proto static network
# 221 rides WHEREVER the Wi-Fi clients are: the plain bridge normally, but INSIDE the
# quick-settings client VLAN (br-lan.<vid>) when AP+VLAN is programmed — otherwise every
# boot would yank it out of the VLAN and Wi-Fi phones would lose the programming page.
rescue_dev="br-lan"
case "$(uci -q get network.cr6608_vlan.device 2>/dev/null)" in br-lan.*) rescue_dev="$(uci -q get network.cr6608_vlan.device)" ;; esac
setv network.wlanrescue.device "$rescue_dev" network
setv network.wlanrescue.ipaddr 221.221.221.221 network
setv network.wlanrescue.netmask 255.255.255.0 network
setv network.wlanrescue.ipv6 0 network
if [ -n "$zone" ]; then
  add_list_once "firewall.$zone" network wlanrescue firewall
fi



# Configure requested Tx power in UCI, while the driver/regulatory layer still
# enforces the real maximum power supported by the country/radio.
uci -q get wireless.radio0 >/dev/null 2>&1 && setv wireless.radio0.txpower 35 wireless
uci -q get wireless.radio1 >/dev/null 2>&1 && setv wireless.radio1.txpower 35 wireless

# Recovery Wi-Fi SSID removed by owner request (no CR6608-Recovery network). Rescue over
# Wi-Fi is still available via 221.221.221.221 on any of the device's Wi-Fi networks.

[ "$changed_smartap" = 1 ] && uci commit smartap 2>/dev/null
[ "$changed_network" = 1 ] && uci commit network 2>/dev/null
[ "$changed_firewall" = 1 ] && uci commit firewall 2>/dev/null
[ "$changed_wireless" = 1 ] && uci commit wireless 2>/dev/null

[ "$changed_network" = 1 ] && /etc/init.d/network reload >/dev/null 2>&1
[ "$changed_firewall" = 1 ] && /etc/init.d/firewall reload >/dev/null 2>&1
[ "$changed_wireless" = 1 ] && wifi reload >/dev/null 2>&1

if [ "${1:-}" != "quiet" ]; then
  if [ "$changed" = 1 ]; then
    echo "Smart AP baseline applied."
  else
    echo "Smart AP baseline already OK."
  fi
fi

exit 0
