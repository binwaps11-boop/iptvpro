#!/bin/sh
# cr6608-wifi-sentinel — self-healing for the RADIOS ONLY. NEVER reboots anything.
# Cron runs it every 5 minutes: if a radio is enabled in uci but its AP interface
# has been missing for TWO consecutive checks, bring that radio back with a
# targeted `wifi up radioX` (the other radio and its clients are untouched).
# Guards: skips the first 3 minutes after boot, skips while an apply/reload is
# in flight, and heals each radio at most once per 10 minutes (no flapping).
UP="$(cut -d. -f1 /proc/uptime)"
[ "${UP:-0}" -lt 180 ] && exit 0
pgrep -f cr6608-quicksettings-apply >/dev/null 2>&1 && exit 0
pgrep -f cr6608-safe-wifi-reload   >/dev/null 2>&1 && exit 0
pgrep -f cr6608-security-apply     >/dev/null 2>&1 && exit 0
pgrep -f smartap-autochannel       >/dev/null 2>&1 && exit 0

LOCK=/tmp/cr6608-apply.lock
LOCK_OWNER=0
process_start() { awk '{print $22}' "/proc/$1/stat" 2>/dev/null; }
release_lock() {
	[ "$LOCK_OWNER" = 1 ] || return 0
	read owner_pid owner_start <"$LOCK/owner" 2>/dev/null || return 0
	[ "$owner_pid" = "$$" ] && [ "$owner_start" = "$LOCK_START" ] || return 0
	rm -f "$LOCK/owner" 2>/dev/null
	rmdir "$LOCK" 2>/dev/null || true
}
acquire_lock() {
	attempts=0
	ownerless=0
	while ! mkdir "$LOCK" 2>/dev/null; do
		owner_pid=""; owner_start=""
		read owner_pid owner_start <"$LOCK/owner" 2>/dev/null || true
		case "$owner_pid:$owner_start" in
			*[!0-9:]*|:|*:)
				ownerless=$((ownerless + 1))
				attempts=$((attempts + 1))
				if [ "$ownerless" -ge 3 ]; then
					rm -f "$LOCK/owner" 2>/dev/null
					rmdir "$LOCK" 2>/dev/null || true
				else
					sleep 1
				fi
				[ "$attempts" -le 3 ] || return 1
				continue
				;;
		esac
		live_start="$(process_start "$owner_pid")"
		[ -z "$live_start" ] || [ "$live_start" != "$owner_start" ] || return 1
		rm -f "$LOCK/owner" 2>/dev/null
		rmdir "$LOCK" 2>/dev/null || true
		attempts=$((attempts + 1))
		[ "$attempts" -le 3 ] || return 1
	done
	LOCK_START="$(process_start "$$")"
	[ -n "$LOCK_START" ] || { rmdir "$LOCK" 2>/dev/null; return 1; }
	printf '%s %s\n' "$$" "$LOCK_START" >"$LOCK/owner" || {
		rmdir "$LOCK" 2>/dev/null
		return 1
	}
	LOCK_OWNER=1
}

acquire_lock || exit 0
trap release_lock EXIT
trap 'release_lock; exit 130' HUP INT TERM
# Re-check after taking the mutex; a transaction may have started between the
# cheap preflight checks above and lock acquisition.
pgrep -f cr6608-safe-wifi-reload >/dev/null 2>&1 && exit 0
pgrep -f cr6608-security-apply >/dev/null 2>&1 && exit 0
[ -e /etc/smartap-pending-rollback ] && exit 0
[ -e /tmp/smartap-rollback-armed ] && exit 0
ST=/tmp/cr6608-wifi-sentinel
mkdir -p "$ST"

# Is radio $1 (phy $2) live right now? echoes nothing; returns 0=up, 1=down.
# owner-disabled counts as "up" (nothing to heal).
radio_is_up() {
	radio="$1"; phy="$2"
	[ "$(uci -q get wireless.$radio.disabled)" = "1" ] && return 0
	status="$(ubus call network.wireless status 2>/dev/null)"
	ifnames="$(printf '%s\n' "$status" | jsonfilter -e "@.$radio.interfaces[*].ifname" 2>/dev/null)"
	for ifname in $ifnames; do
		[ -d "/sys/class/net/$ifname" ] && iw dev "$ifname" info >/dev/null 2>&1 && return 0
	done
	# no ifname yet: accept the radio if the phy exists AND owns any interface.
	if [ -z "$ifnames" ] && iw phy "$phy" info >/dev/null 2>&1; then
		iw dev 2>/dev/null | awk -v target="${phy#phy}" '
			/^phy#[0-9]+/ { current=$1; sub(/^phy#/, "", current) }
			$1=="Interface" && current==target { found=1 }
			END { exit !found }
		' && return 0
	fi
	return 1
}

# any_iface_up: true if at least one wifi client interface exists — used to
# confirm an escalation actually brought the radios back before we trust it.
any_iface_up() { iw dev 2>/dev/null | grep -q Interface; }

# targeted, non-destructive heal for ONE radio: `wifi up radioX` only. Never
# touches the other radio, never the driver module. Rate-limited to once / 10min.
heal_radio() {
	radio="$1"; phy="$2"
	# Only rate-limit when we have actually healed before. The stamp file's ABSENCE
	# means "never healed" — the 180s boot guard already gates the first attempt, so
	# don't let the default 0 read as "healed at uptime 0" and suppress the very first
	# heal for a full 600s window.
	if [ -f "$ST/$radio.heal" ]; then
		last="$(cat "$ST/$radio.heal" 2>/dev/null || echo 0)"
		case "$last" in ''|*[!0-9]*) last=0 ;; esac
		[ $(( UP - last )) -lt 600 ] && return 0
	fi
	echo "$UP" > "$ST/$radio.heal"
	logger -t cr6608-sentinel "$radio ($phy) down -> targeted 'wifi up $radio' (no reboot, other radio untouched)"
	wifi up "$radio" >/dev/null 2>&1
}

# Escalation for the DBDC zombie state (mt76 #1083: a reconfigure can wedge BOTH
# radios of the single-function MT7915 and per-radio `wifi up` doesn't revive
# them). This is a full netifd reconfigure — `wifi down` then `wifi up`, which
# tears down and re-binds hostapd/netifd for every radio WITHOUT unloading the
# kernel module. It deliberately does NOT rmmod/modprobe mt7915e: on MT7621 an
# unbind can drop the PCIe endpoint so it never re-probes without a bus rescan,
# which would turn a recoverable glitch into a hard brick. Preconditions: it
# fires ONLY when BOTH radios have been down across two consecutive checks, and
# only after re-verifying no apply/reload is in flight. The cooldown is stamped
# ONLY on verified success, so a failed attempt is retried on the next tick
# instead of being locked out for an hour; targeted per-radio heals also keep
# running in the meantime.
escalate_reload() {
	# Only rate-limit when a prior escalation was actually stamped; the stamp's absence
	# means "never escalated", and the both-radios-down-twice precondition + 180s boot
	# guard already gate the first run — don't let the default 0 suppress it for 900s.
	if [ -f "$ST/escalate" ]; then
		last_esc="$(cat "$ST/escalate" 2>/dev/null || echo 0)"
		case "$last_esc" in ''|*[!0-9]*) last_esc=0 ;; esac
		[ $(( UP - last_esc )) -lt 900 ] && return 0
	fi
	# Re-verify right before acting: an apply/reload may have started during the
	# ubus/iw round-trips above, and racing it with `wifi down` is exactly what
	# wedges the driver.
	pgrep -f cr6608-quicksettings-apply >/dev/null 2>&1 && return 0
	pgrep -f cr6608-safe-wifi-reload    >/dev/null 2>&1 && return 0
	pgrep -f cr6608-security-apply       >/dev/null 2>&1 && return 0
	[ -e /etc/smartap-pending-rollback ] && return 0
	[ -e /tmp/smartap-rollback-armed ] && return 0
	logger -t cr6608-sentinel "BOTH radios down for 2 checks -> full netifd reconfigure (wifi down/up, no module unload; mt76#1083 recovery)"
	wifi down >/dev/null 2>&1
	sleep 3
	wifi up >/dev/null 2>&1
	sleep 5
	if any_iface_up; then
		echo "$UP" > "$ST/escalate"
		rm -f "$ST/radio0.down" "$ST/radio1.down"
		logger -t cr6608-sentinel "netifd reconfigure restored at least one radio"
	else
		# Do NOT stamp the cooldown: leave it retryable next tick. Never rmmod,
		# never reboot from here — the box may still be reachable over the wired
		# LAN (192.168.1.1) which this service never touches.
		logger -t cr6608-sentinel "netifd reconfigure did not restore a radio yet; will retry (wired LAN 192.168.1.1 unaffected)"
	fi
}

# --- main: evaluate both radios, then decide targeted vs escalation ----------
r0_up=1; r1_up=1
radio_is_up radio0 phy0 || r0_up=0
radio_is_up radio1 phy1 || r1_up=0

# Persist a "down for N consecutive checks" counter per radio (reset on recovery).
bump_down() { # $1=radio  $2=up(1/0) ; echoes the new down-streak
	if [ "$2" = 1 ]; then
		rm -f "$ST/$1.down" "$ST/$1.heal"
		echo 0
	else
		prev="$(cat "$ST/$1.down" 2>/dev/null || echo 0)"
		case "$prev" in ''|*[!0-9]*) prev=0 ;; esac
		prev=$(( prev + 1 ))
		echo "$prev" > "$ST/$1.down"
		echo "$prev"
	fi
}
r0_down="$(bump_down radio0 "$r0_up")"
r1_down="$(bump_down radio1 "$r1_up")"

if [ "$r0_down" -ge 2 ] && [ "$r1_down" -ge 2 ]; then
	# Both bands persistently dead — the DBDC zombie. Escalate (safe reload).
	escalate_reload
else
	# At most one band down (or a single missed check): heal it in isolation,
	# never disturbing a working radio.
	[ "$r0_up" = 0 ] && [ "$r0_down" -ge 2 ] && heal_radio radio0 phy0
	[ "$r1_up" = 0 ] && [ "$r1_down" -ge 2 ] && heal_radio radio1 phy1
fi
exit 0
