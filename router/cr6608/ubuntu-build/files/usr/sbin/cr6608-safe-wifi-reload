#!/bin/sh

MODE=apply
OWN_BACKUP=0
if [ "${1:-}" = "--verify-only" ]; then
	MODE=verify
	timeout="${2:-20}"
	SCOPE="${3:-all}"
	BACKUP=""
else
	timeout="${1:-20}"
	BACKUP="${2:-}"
	SCOPE="${3:-all}"
	[ -r "$BACKUP" ] || {
		BACKUP="/tmp/cr6608-wireless-last-good.conf"
		cp -f /etc/config/wireless "$BACKUP" 2>/dev/null || exit 1
		OWN_BACKUP=1
	}
fi

radio_enabled() {
	[ "$(uci -q get wireless."$1".disabled 2>/dev/null)" != "1" ]
}

runtime_type_for_mode() {
	case "$1" in
		ap) printf 'AP' ;;
		mesh) printf 'mesh point' ;;
		sta) printf 'managed' ;;
		adhoc) printf 'IBSS' ;;
		monitor) printf 'monitor' ;;
		*) return 1 ;;
	esac
}

runtime_value() {
	local expression="$1"
	printf '%s\n' "$RUNTIME_STATUS" |
		jsonfilter -e "$expression" 2>/dev/null
}

runtime_interface_index() {
	local radio="$1" section="$2" index=0 status_section
	while [ "$index" -lt 32 ]; do
		status_section="$(runtime_value "@.$radio.interfaces[$index].section")"
		[ -n "$status_section" ] || return 1
		if [ "$status_section" = "$section" ]; then
			printf '%s\n' "$index"
			return 0
		fi
		index=$((index + 1))
	done
	return 1
}

runtime_ifname_for_section() {
	local radio="$1" section="$2" index ifname
	index="$(runtime_interface_index "$radio" "$section")" || return 1
	ifname="$(runtime_value "@.$radio.interfaces[$index].ifname")"
	[ -n "$ifname" ] || return 1
	printf '%s\n' "$ifname"
}

runtime_ifname_has_type() {
	local ifname="$1" expected="$2"
	iw dev "$ifname" info 2>/dev/null | awk -v expected="$expected" '
		$1 == "type" {
			$1 = ""
			sub(/^[ \t]+/, "")
			if ($0 == expected)
				found = 1
		}
		END { exit(found ? 0 : 1) }
	'
}

runtime_any_for_radio() {
	local radio="$1" radio_interfaces
	radio_interfaces="$(runtime_value "@.${radio}.interfaces[*].ifname")"
	[ -z "$radio_interfaces" ]
}

normalize_words() {
	tr '	 ' '\n' |
		sed '/^$/d' |
		sort -u |
		tr '\n' ' ' |
		sed 's/[[:space:]]*$//'
}

runtime_radio_config_matches() {
	local radio="$1" option desired actual
	for option in channel country htmode txpower band; do
		desired="$(uci -q get wireless."$radio"."$option" 2>/dev/null)"
		[ -n "$desired" ] || continue
		actual="$(runtime_value "@.$radio.config.$option")"
		if [ "$option" = "country" ]; then
			desired="$(printf '%s' "$desired" | tr 'a-z' 'A-Z')"
			actual="$(printf '%s' "$actual" | tr 'a-z' 'A-Z')"
		fi
		[ "$actual" = "$desired" ] || return 1
	done
	[ "$(runtime_value "@.$radio.up")" = "true" ] || return 1
	[ "$(runtime_value "@.$radio.disabled")" != "true" ] || return 1
	[ "$(runtime_value "@.$radio.pending")" != "true" ] || return 1
	return 0
}

runtime_width_matches() {
	local ifname="$1" htmode="$2" expected=""
	case "$htmode" in
		*160) expected=160 ;;
		*80) expected=80 ;;
		*40*) expected=40 ;;
		*20) expected=20 ;;
		*) return 0 ;;
	esac
	iw dev "$ifname" info 2>/dev/null |
		awk -v expected="$expected" '
			/width:/ {
				for (i = 1; i <= NF; i++)
					if ($i == "width:" && $(i + 1) == expected)
						found = 1
			}
			END { exit(found ? 0 : 1) }
		'
}

runtime_channel_matches() {
	local ifname="$1" channel="$2"
	case "$channel" in ''|auto) return 0 ;; esac
	iw dev "$ifname" info 2>/dev/null |
		awk -v expected="$channel" '
			$1 == "channel" && $2 == expected { found = 1 }
			END { exit(found ? 0 : 1) }
		'
}

runtime_interface_config_matches() {
	local radio="$1" section="$2" mode="$3" ifname="$4"
	local index option desired actual desired_network actual_network raw state hostapd_ssid
	index="$(runtime_interface_index "$radio" "$section")" || return 1
	for option in mode ssid encryption; do
		desired="$(uci -q get wireless."$section"."$option" 2>/dev/null)"
		[ -n "$desired" ] || continue
		actual="$(runtime_value "@.$radio.interfaces[$index].config.$option")"
		[ "$actual" = "$desired" ] || return 1
	done
	desired_network="$(uci -q get wireless."$section".network 2>/dev/null |
		normalize_words)"
	actual_network="$(runtime_value "@.$radio.interfaces[$index].config.network[*]" |
		normalize_words)"
	[ "$actual_network" = "$desired_network" ] || return 1
	runtime_ifname_has_type "$ifname" "$(runtime_type_for_mode "$mode")" || return 1
	runtime_channel_matches "$ifname" "$(uci -q get wireless."$radio".channel 2>/dev/null)" ||
		return 1
	runtime_width_matches "$ifname" "$(uci -q get wireless."$radio".htmode 2>/dev/null)" ||
		return 1
	if [ "$mode" = "ap" ]; then
		ubus -S list "hostapd.$ifname" 2>/dev/null |
			grep -Fqx "hostapd.$ifname" || return 1
		raw="$(ubus -S call "hostapd.$ifname" get_status 2>/dev/null)" || return 1
		state="$(printf '%s\n' "$raw" | jsonfilter -e '@.status' 2>/dev/null)"
		[ "$state" = "ENABLED" ] || return 1
		hostapd_ssid="$(printf '%s\n' "$raw" | jsonfilter -e '@.ssid' 2>/dev/null)"
		desired="$(uci -q get wireless."$section".ssid 2>/dev/null)"
		[ -z "$desired" ] || [ "$hostapd_ssid" = "$desired" ] || return 1
	fi
	return 0
}

radio_ready() {
	local radio="$1" section mode ifname found=0 index
	RUNTIME_STATUS="$(ubus -S call network.wireless status 2>/dev/null)" || return 1
	if ! radio_enabled "$radio"; then
		[ "$(runtime_value "@.$radio.disabled")" = "true" ] || return 1
		[ "$(runtime_value "@.$radio.up")" != "true" ] || return 1
		runtime_any_for_radio "$radio"
		return $?
	fi

	runtime_radio_config_matches "$radio" || return 1
	for section in $(uci -q show wireless 2>/dev/null |
		sed -n "s/^wireless\.\([^.=]*\)=wifi-iface$/\1/p"); do
		[ "$(uci -q get wireless."$section".device 2>/dev/null)" = "$radio" ] || continue
		if [ "$(uci -q get wireless."$section".disabled 2>/dev/null)" = "1" ]; then
			! runtime_interface_index "$radio" "$section" >/dev/null 2>&1 || return 1
			continue
		fi
		mode="$(uci -q get wireless."$section".mode 2>/dev/null)"
		runtime_type_for_mode "$mode" >/dev/null || return 1
		found=1
		ifname="$(runtime_ifname_for_section "$radio" "$section")" || return 1
		runtime_interface_config_matches "$radio" "$section" "$mode" "$ifname" || return 1
	done

	[ "$found" = "1" ]
}

case "$timeout" in ''|*[!0-9]*) timeout=20 ;; esac
case "$SCOPE" in all|radio0|radio1) ;; *) SCOPE=all ;; esac
min_timeout="${CR6608_WIFI_MIN_TIMEOUT:-20}"
case "$min_timeout" in ''|*[!0-9]*) min_timeout=20 ;; esac
[ "$min_timeout" -ge 1 ] 2>/dev/null && [ "$min_timeout" -le 20 ] 2>/dev/null || min_timeout=20
[ "$timeout" -ge "$min_timeout" ] 2>/dev/null || timeout="$min_timeout"

adjust_timeout_for_channels() {
	local radio channel
	for radio in radio0 radio1; do
		channel="$(uci -q get wireless."$radio".channel 2>/dev/null)"
		case "$channel" in
			auto|52|56|60|64|100|104|108|112|116|120|124|128|132|136|140|144)
				# Weather-radar channels can require a ten-minute CAC.
				[ "$timeout" -ge 660 ] 2>/dev/null || timeout=660
				;;
		esac
	done
}

apply_wifi_scope() {
	case "$SCOPE" in
		radio0|radio1)
			if radio_enabled "$SCOPE"; then
				wifi up "$SCOPE" >/dev/null 2>&1
			else
				wifi down "$SCOPE" >/dev/null 2>&1
			fi
			;;
		*) wifi reload >/dev/null 2>&1 ;;
	esac
}

wait_runtime_ready() {
	local elapsed=0 ready
	while [ "$elapsed" -lt "$timeout" ]; do
		ready=0
		case "$SCOPE" in
			radio0) radio_ready radio0 && ready=1 ;;
			radio1) radio_ready radio1 && ready=1 ;;
			*) radio_ready radio0 && radio_ready radio1 && ready=1 ;;
		esac
		[ "$ready" = "1" ] && return 0
		sleep 1
		elapsed=$((elapsed + 1))
	done
	return 1
}

adjust_timeout_for_channels
if [ "$MODE" = "verify" ]; then
	wait_runtime_ready
	exit $?
fi

apply_failed=0
apply_wifi_scope || apply_failed=1
if [ "$apply_failed" = "0" ] && wait_runtime_ready; then
	logger -t cr6608-safe-apply "Wi-Fi reload OK; configured runtime roles and hostapd are active"
	[ "$OWN_BACKUP" = "1" ] && rm -f "$BACKUP"
	exit 0
fi

restore_failed=0
cp -f "$BACKUP" /etc/config/wireless 2>/dev/null || restore_failed=1
uci revert wireless >/dev/null 2>&1 || true
uci commit wireless >/dev/null 2>&1 || restore_failed=1
timeout="$min_timeout"
adjust_timeout_for_channels
apply_wifi_scope || restore_failed=1
if [ "$restore_failed" = "0" ] && wait_runtime_ready; then
	logger -t cr6608-safe-apply "Wi-Fi reload failed; previous wireless config restored and runtime verified"
	[ "$OWN_BACKUP" = "1" ] && rm -f "$BACKUP"
	exit 1
fi

logger -t cr6608-safe-apply "Wi-Fi reload failed and restored runtime did not become ready; backup retained at $BACKUP"
exit 2
