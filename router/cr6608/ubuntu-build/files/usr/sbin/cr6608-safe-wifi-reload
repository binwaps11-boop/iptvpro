#!/bin/sh

BACKUP="/tmp/cr6608-wireless-last-good.conf"

radio_enabled() {
	[ "$(uci -q get wireless."$1".disabled 2>/dev/null)" != "1" ]
}

iface_ok() {
	iw dev "$1" info >/dev/null 2>&1
}

cp -f /etc/config/wireless "$BACKUP" 2>/dev/null || exit 1
wifi reload >/dev/null 2>&1 || true
sleep "${1:-8}"

failed=0
if radio_enabled radio0 && ! iface_ok phy0-ap0; then
	failed=1
fi
if radio_enabled radio1 && ! iface_ok phy1-ap0; then
	failed=1
fi

if [ "$failed" = "1" ]; then
	cp -f "$BACKUP" /etc/config/wireless 2>/dev/null
	uci revert wireless >/dev/null 2>&1 || true
	uci commit wireless >/dev/null 2>&1 || true
	wifi reload >/dev/null 2>&1 || true
	logger -t cr6608-safe-apply "Wi-Fi reload failed; restored previous wireless config"
	exit 1
fi

logger -t cr6608-safe-apply "Wi-Fi reload OK"
exit 0
