#!/bin/sh
# cr6608-quick-apply — REAL apply bridge for the Argon quick page helper.
# Auth: a valid Smart AP dashsess token (?sid= / JSON .sid) OR a live LuCI ubus
# session (sysauth cookie). Parses the JSON body with jsonfilter, validates every
# field, writes cr6608quick.default, then runs /usr/sbin/cr6608-quicksettings-apply
# (the same executor Save & Apply uses), returning its real exit status.
echo "Content-Type: application/json"
echo "Cache-Control: no-store"

LEN="${CONTENT_LENGTH:-0}"
BODY=""
[ "$LEN" -gt 0 ] 2>/dev/null && BODY="$(dd bs=1 count="$LEN" 2>/dev/null)"

jget() { jsonfilter -s "$BODY" -e "@.$1" 2>/dev/null | head -1; }

# ---- auth (any ONE of these proves the caller is the logged-in operator) ----
ok_auth=0
valid_ubus() { [ -n "$1" ] && ubus call session get "{\"ubus_rpc_session\":\"$1\"}" 2>/dev/null | grep -q '"values"'; }

# 1) Smart AP dashboard session token (?sid= or JSON .sid)
sid="$(printf '%s' "${QUERY_STRING:-}" | sed -n 's/.*sid=\([0-9a-f]\{32\}\).*/\1/p')"
[ -z "$sid" ] && sid="$(jget sid | grep -oE '^[0-9a-f]{32}$')"
[ -n "$sid" ] && [ -f "/tmp/dashsess/$sid" ] && ok_auth=1

# 2) explicit LuCI ubus session id passed in the JSON body (rpc.getSessionID())
if [ "$ok_auth" != "1" ]; then
	ls2="$(jget luci_sid | grep -oE '^[0-9a-fA-F]{32}$')"
	valid_ubus "$ls2" && ok_auth=1
fi

# 3) LuCI sysauth cookie (any sysauth* name), validated via ubus
if [ "$ok_auth" != "1" ]; then
	for lsid in $(printf '%s' "${HTTP_COOKIE:-}" | grep -oE '[0-9a-fA-F]{32}'); do
		valid_ubus "$lsid" && { ok_auth=1; break; }
	done
fi

if [ "$ok_auth" != "1" ]; then
	echo "Status: 403"
	echo ""
	echo '{"ok":false,"error":"auth","hint":"no valid dashsess token or LuCI ubus session"}'
	exit 0
fi
echo ""

# ---- parse + validate (accepts BOTH the Argon field names and the legacy short ones) ----
u()  { [ -n "$2" ] && uci -q set "cr6608quick.default.$1=$2"; }        # set if non-empty
uw() { uci -q set "cr6608quick.default.$1=$2"; }                        # always set (checkboxes)
pick() { v=""; for k in "$@"; do v="$(jget "$k")"; [ -n "$v" ] && break; done; printf '%s' "$v"; }

# mode/security/channel value sets MUST match the LuCI ListValue options exactly, else a
# valid selection is silently dropped while the UI still reports success.
mode="$(pick mode program_mode | grep -oE '^(ap|ap_vlan|mesh|mesh_vlan|wds_sender|wds_sender_vlan|wds_receiver|wds_receiver_vlan|pppoe|pppoe_ap)$')"
# canonical executor vocabulary: 'pppoe_ap' (dashboard name) IS 'pppoe'
[ "$mode" = "pppoe_ap" ] && mode="pppoe"
ip="$(pick lan_ipaddr ipaddr device_ip | grep -oE '^([0-9]{1,3}\.){3}[0-9]{1,3}$')"
nm="$(pick lan_netmask netmask | grep -oE '^([0-9]{1,3}\.){3}[0-9]{1,3}$')"
vlan="$(pick vlan_id | grep -oE '^[0-9]{1,4}$')"
s24="$(pick ssid ssid24 | cut -c1-32)"
s5="$(pick ssid5 | cut -c1-32)"
c24="$(pick channel24 | grep -oE '^(auto|[1-9]|1[0-3])$')"
c5="$(pick channel5 | grep -oE '^(auto|[0-9]{1,3})$')"
tx="$(pick txpower | grep -oE '^[0-9]{1,2}$')"
cc="$(pick country | grep -oE '^[A-Za-z][A-Za-z0-9]$')"
sec="$(pick security | grep -oE '^(open|wpa2|wpa3|mixed|psk2|sae|sae-mixed|none)$')"
# normalize legacy aliases to the executor's vocabulary — psk2 stored raw used to be
# applied as OPEN (silent security downgrade)
case "$sec" in psk2) sec="wpa2" ;; sae) sec="wpa3" ;; sae-mixed) sec="mixed" ;; none) sec="open" ;; esac
key="$(pick wifi_key key)"
hide="$(pick hide_ssid | grep -oE '^[01]$')"
meshid="$(pick mesh_id | cut -c1-32)"
wds="$(pick wds_ssid | cut -c1-32)"
pu="$(pick pppoe_user | cut -c1-64)"
pp="$(pick pppoe_pass | cut -c1-64)"
pport="$(pick pppoe_port | grep -oE '^[a-z0-9]+$')"
natf="$(pick nat_enabled | grep -oE '^[01]$')"
dhcps="$(pick dhcp_server | grep -oE '^[01]$')"
fw="$(pick firewall_enabled | grep -oE '^[01]$')"
# fields the bridge previously DROPPED (audit): security tab + admin password + extras
cpw="$(pick change_password | grep -oE '^[01]$')"
apw="$(pick admin_password | cut -c1-80)"
clr="$(pick clear_previous | grep -oE '^[01]$')"
rlk="$(pick reset_lock | grep -oE '^[01]$')"
rcu="$(pick reset_custom | grep -oE '^[01]$')"
rsc="$(pick reset_seconds | grep -oE '^[0-9]{1,4}$')"
bbe="$(pick broadband_enabled | grep -oE '^[01]$')"
fkm="$(pick fake_mesh | grep -oE '^[01]$')"
h24="$(pick htmode24 | grep -oE '^(HT20|HT40|HE20|HE40|VHT20|VHT40)$')"
h5="$(pick htmode5 | grep -oE '^(HT20|HT40|HE20|HE40|HE80|HE160|VHT20|VHT40|VHT80|VHT160)$')"
case "$h5" in HE160|VHT160) h5="HE80" ;; esac   # DBDC MT7915: 80MHz physical max
mrl="$(pick mesh_role | grep -oE '^(sender|receiver)$')"

u mode        "$mode"
u lan_ipaddr  "$ip"
u lan_netmask "$nm"
u vlan_id     "$vlan"
u ssid        "$s24"
u ssid5       "$s5"
u channel24   "$c24"
u channel5    "$c5"
[ -n "$cc" ] && { uw country24 "$cc"; uw country5 "$cc"; }
u security    "$sec"
[ -n "$key" ] && uw wifi_key "$key"
[ -n "$hide" ] && uw hide_ssid "$hide"
u mesh_id     "$meshid"
u wds_ssid    "$wds"
u pppoe_user  "$pu"
u pppoe_pass  "$pp"
u pppoe_port  "$pport"
[ -n "$natf" ]  && uw nat_enabled "$natf"
[ -n "$dhcps" ] && uw dhcp_server "$dhcps"
[ -n "$fw" ]    && uw firewall_enabled "$fw"
[ -n "$cpw" ] && uw change_password "$cpw"
[ -n "$apw" ] && uw admin_password "$apw"
[ -n "$clr" ] && uw clear_previous "$clr"
[ -n "$rlk" ] && uw reset_lock "$rlk"
[ -n "$rcu" ] && uw reset_custom "$rcu"
u reset_seconds "$rsc"
[ -n "$bbe" ] && uw broadband_enabled "$bbe"
[ -n "$fkm" ] && uw fake_mesh "$fkm"
u htmode24 "$h24"
u htmode5  "$h5"
u mesh_role "$mrl"
# keep the dashboard preview truthful: mirror the shared keys into smartap.quick
mq() { [ -n "$2" ] && uci -q set smartap.quick."$1"="$2"; }
uci -q get smartap.quick >/dev/null 2>&1 || uci -q set smartap.quick='quicksettings'
pm="$mode"; [ "$pm" = "pppoe" ] && pm="pppoe_ap"
mq program_mode "$pm"; mq ssid "$s24"; mq ch24 "$c24"; mq ch5 "$c5"
mq vlan_id "$vlan"; mq security "$sec"; mq hide_ssid "$hide"
mq nat_enabled "$natf"; mq dhcp_server "$dhcps"; mq firewall_enabled "$fw"
mq broadband_enabled "$bbe"; mq fake_mesh "$fkm"; mq htmode24 "$h24"; mq htmode5 "$h5"
mq device_ip "$aip"; mq mesh_role "$mrl"
uci -q commit smartap
# txpower stays owner-fixed at 38 on both radios
uw txpower_radio0 "${tx:-38}"
uw txpower_radio1 "${tx:-38}"
uci -q commit cr6608quick

# ---- real apply (output kept off stdout so the HTTP response closes promptly) ----
/usr/sbin/cr6608-quicksettings-apply >/tmp/cr6608-quick-apply.log 2>&1
rc=$?
# last log line, JSON-escaped, so the UI can show the real cause if rc!=0
tail="$(tail -n 3 /tmp/cr6608-quick-apply.log 2>/dev/null | tr '\n' ' ' | sed 's/\\/\\\\/g; s/"/\\"/g' | cut -c1-300)"
if [ "$rc" = "0" ]; then
	echo "{\"ok\":true,\"applied\":true}"
else
	echo "{\"ok\":false,\"applied\":false,\"code\":$rc,\"detail\":\"$tail\"}"
fi
exit 0
