#!/bin/sh
# cr6608-quick-apply — REAL apply bridge for the Argon quick page helper.
# Auth: a valid Smart AP dashsess token (?sid= / JSON .sid) OR a live LuCI ubus
# session (sysauth cookie). Parses the JSON body with jsonfilter, validates every
# field, writes cr6608quick.default, then runs /usr/sbin/cr6608-quicksettings-apply
# (the same executor Save & Apply uses), returning its real exit status.
echo "Content-Type: application/json"
echo "Cache-Control: no-store"

LEN="${CONTENT_LENGTH:-0}"
BODY=""
[ "$LEN" -gt 0 ] 2>/dev/null && BODY="$(dd bs=1 count="$LEN" 2>/dev/null)"

jget() { jsonfilter -s "$BODY" -e "@.$1" 2>/dev/null | head -1; }

# ---- auth ----
ok_auth=0
sid="$(printf '%s' "${QUERY_STRING:-}" | sed -n 's/.*sid=\([0-9a-f]\{32\}\).*/\1/p')"
[ -z "$sid" ] && sid="$(jget sid | grep -oE '^[0-9a-f]{32}$')"
[ -n "$sid" ] && [ -f "/tmp/dashsess/$sid" ] && ok_auth=1
if [ "$ok_auth" != "1" ]; then
	lsid="$(printf '%s' "${HTTP_COOKIE:-}" | sed -n 's/.*sysauth[^=]*=\([0-9a-fA-F]\{32\}\).*/\1/p' | head -1)"
	[ -n "$lsid" ] && ubus call session get "{\"ubus_rpc_session\":\"$lsid\"}" >/dev/null 2>&1 && ok_auth=1
fi
if [ "$ok_auth" != "1" ]; then
	echo "Status: 403"
	echo ""
	echo '{"ok":false,"error":"auth"}'
	exit 0
fi
echo ""

# ---- parse + validate ----
ip="$(jget ipaddr    | grep -oE '^([0-9]{1,3}\.){3}[0-9]{1,3}$')"
nm="$(jget netmask   | grep -oE '^([0-9]{1,3}\.){3}[0-9]{1,3}$')"
s24="$(jget ssid24   | cut -c1-32)"
s5="$(jget ssid5     | cut -c1-32)"
c24="$(jget channel24| grep -oE '^([1-9]|1[0-3])$')"
c5="$(jget channel5  | grep -oE '^[0-9]{1,3}$')"
tx="$(jget txpower   | grep -oE '^[0-9]{1,2}$')"
cc="$(jget country   | grep -oE '^[A-Z][A-Z0-9]$')"

u() { [ -n "$2" ] && uci -q set "cr6608quick.default.$1=$2"; }
u lan_ipaddr  "$ip"
u lan_netmask "$nm"
u ssid        "$s24"
u ssid5       "$s5"
u channel24   "$c24"
u channel5    "$c5"
u country24   "$cc"
u country5    "$cc"
u txpower_radio0 "${tx:-38}"
u txpower_radio1 "${tx:-38}"
uci -q commit cr6608quick

# ---- real apply (output kept off stdout so the HTTP response closes promptly) ----
if /usr/sbin/cr6608-quicksettings-apply >/tmp/cr6608-quick-apply.log 2>&1; then
	echo '{"ok":true,"applied":true}'
else
	rc=$?
	echo "{\"ok\":false,\"applied\":false,\"code\":$rc}"
fi
exit 0
