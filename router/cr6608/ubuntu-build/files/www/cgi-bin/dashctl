      kc=$((kc+1))
      { nm="$(run_limit 1 nslookup "$rip" 2>/dev/null | sed -n 's/.*name = \([^ ]*\)\.$/\1/p;s/.*name = \([^ ]*\)$/\1/p' | grep -vi in-addr | head -1)"; [ -n "$nm" ] && printf '%s|%s\n' "$rip" "$nm" >> "$st/rdns"; } 2>/dev/null &
