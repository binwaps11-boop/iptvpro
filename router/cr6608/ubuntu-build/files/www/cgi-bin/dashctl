        text="المهام المجدولة تُدار داخلياً."
        form="$(form_json <<EOF
cron_line|Cron line||Example: 0 4 * * * /sbin/reboot
EOF
)"
        actions='[{"id":"add_cron","label":"Add cron line","confirm":true}]'
        ;;
      leds)
        text="مؤشرات LED تعمل بإعدادات المصنع."
        led_opts="$(for l in /sys/class/leds/*; do [ -d "$l" ] || continue; b="$(basename "$l")"; printf '%s:%s,' "$b" "$b"; done | sed 's/,$//')"; [ -n "$led_opts" ] || led_opts="status:status"
        form="$(form_json <<EOF
led_name|LED|status|Runtime LED under /sys/class/leds|select|0|||$led_opts
led_trigger|Trigger|none|Example: none, timer, default-on
led_brightness|Brightness|1|0 or 1 usually|number
EOF
)"
        actions='[{"id":"set_led","label":"Set LED runtime","confirm":true}]'
        ;;
      flash)
        text="النسخ الاحتياطية محفوظة داخل الجهاز."
        actions='[{"id":"create_config_backup","label":"Create config backup","confirm":true}]'
        ;;
      reboot)
        text="Reboot is available inside Xiaomi CR6608 with double confirmation. TX Power is not modified."
        actions='[{"id":"system_reboot","label":"Reboot router now","confirm":true}]'
        ;;
      interfaces)
        text="الواجهات تُدار من قسم الشبكة."
        if_proto_cur="$(uci -q get network.lan.proto 2>/dev/null)"; if_dev_cur="$(uci -q get network.lan.device 2>/dev/null)"; if_ip_cur="$(uci -q get network.lan.ipaddr 2>/dev/null)"; if_mask_cur="$(uci -q get network.lan.netmask 2>/dev/null)"
        dev_opts="$(for d in br-lan wan lan1 lan2 lan3 eth0 lo; do [ -d /sys/class/net/$d ] && printf '%s:%s,' "$d" "$d"; done | sed 's/,$//')"; [ -n "$dev_opts" ] || dev_opts="br-lan:br-lan,wan:wan"
        form="$(form_json <<EOF
if_name|Interface name|lan|Existing name or new interface id
if_proto|Protocol|${if_proto_cur:-static}|OpenWrt protocol|select|0|||static:Static address,dhcp:DHCP client,pppoe:PPPoE,none:Unmanaged
if_device|Device|${if_dev_cur:-br-lan}|Linux device / bridge / VLAN|select|0|||$dev_opts
if_ipaddr|IPv4 address|${if_ip_cur:-192.168.1.1}|Static only
if_netmask|Netmask|${if_mask_cur:-255.255.255.0}|Static only
if_gateway|Gateway||Optional
if_dns|DNS||Optional
if_auto|Auto start|1|Start interface automatically|select|0|||1:on,0:off
if_username|PPPoE username||Only used when protocol is pppoe
if_password|PPPoE password||Leave blank to keep current password|password
EOF
)"
        actions='[{"id":"save_interface","label":"Save interface","confirm":true},{"id":"delete_interface","label":"Delete interface","confirm":true}]'
        ;;
    esac
    emit true "$section" "" "${cards:-[]}" "$text" "$actions" "$form" ;;
  logout)
    emit true "Log out" "End local dashboard session" "[]" "Use the button below to clear the browser session." '[{"id":"logout","label":"Log out"}]' '[]' ;;
  *)
    url="$(luci_url "$section")"
    emit true "$section" "" "[]" "This section is handled inside the Xiaomi CR6608 page." '[]' '[]' ;;
esac
