#!/bin/sh
# --- safety: no system command may hang the API ---
run_limit() { sec="$1"; shift; "$@" & pid=$!; ( sleep "$sec"; kill "$pid" 2>/dev/null; sleep 1; kill -KILL "$pid" 2>/dev/null ) >/dev/null 2>&1 & guard=$!; wait "$pid" 2>/dev/null; rc=$?; kill "$guard" 2>/dev/null; return "$rc"; }
ubus() { run_limit 3 /bin/ubus "$@" 2>/dev/null; }
iwinfo() { run_limit 4 /usr/bin/iwinfo "$@" 2>/dev/null; }
iw() { run_limit 4 /usr/sbin/iw "$@" 2>/dev/null; }
POST_DATA=""
if [ "$REQUEST_METHOD" = "POST" ] && [ "${CONTENT_LENGTH:-0}" -gt 0 ] 2>/dev/null; then
  POST_DATA="$(dd bs=1 count="$CONTENT_LENGTH" 2>/dev/null)"
fi
REQ="$QUERY_STRING"
[ -n "$POST_DATA" ] && REQ="${REQ:+$REQ&}$POST_DATA"
qparam() { printf '%s' "$REQ" | tr '&' '\n' | sed -n "s/^$1=//p" | head -n 1; }
param() {
  qparam "$1" | sed 's/+/ /g; s/%3A/:/g; s/%3a/:/g; s/%2E/./g; s/%2e/./g; s/%2D/-/g; s/%2d/-/g; s/%5F/_/g; s/%5f/_/g; s/%2F/\//g; s/%2f/\//g; s/%20/ /g; s/%40/@/g; s/%23/#/g; s/%2B/+/g; s/%2b/+/g; s/%26/\&/g; s/%3D/=/g; s/%3d/=/g'
}
deny_auth() {
  printf 'Status: 403 Forbidden\r\nContent-Type: application/json\r\nCache-Control: no-store\r\n\r\n'
  printf '{"ok":false,"error":"forbidden","message":"valid Xiaomi CR6608 session required"}\n'
  exit 0
}
sid="$(qparam sid | sed 's/[^A-Fa-f0-9]//g')"
case "$sid" in 00000000000000000000000000000000|'') deny_auth ;; esac
[ "${#sid}" = 32 ] 2>/dev/null || deny_auth
[ -f "/tmp/dashsess/$sid" ] || deny_auth

printf 'Content-Type: application/json\r\nCache-Control: no-store\r\n\r\n'

json_escape() { tr '\011' ' ' | tr -d '\000-\010\013\014\016-\037\177' | awk 'BEGIN{ORS=""}{gsub(/\\/,"\\\\"); gsub(/"/,"\\\""); if (NR>1) printf "\\n"; printf "%s",$0}'; }
jstr() { printf '"'; printf '%s' "$1" | json_escape; printf '"'; }
jnum() { case "$1" in ''|*[!0-9.-]*) printf 'null' ;; *) printf '%s' "$1" ;; esac; }
redact() { sed 's/[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd][^ ]*/[redacted]/g; s/[Tt][Oo][Kk][Ee][Nn][^ ]*/[redacted]/g; s/[Ss][Ee][Cc][Rr][Ee][Tt][^ ]*/[redacted]/g; s/\.key=.*/.key=[redacted]/g'; }
safe_host() { printf '%s' "$1" | sed 's/[^A-Za-z0-9._:-]//g' | cut -c1-80; }
safe_mac() { printf '%s' "$1" | tr A-F a-f | sed 's/[^0-9a-f:]//g' | cut -c1-17; }
safe_num() { printf '%s' "$1" | sed 's/[^0-9]//g' | cut -c1-4; }
# safe_num caps at 4 digits (fine for vlan/hour/limit); use safe_bignum for values that can
# legitimately exceed 9999 (TCP ports up to 65535, SQM kbit/s, DNS cache) so they are NOT
# silently truncated (a truncated SSH/HTTP port would lock the admin out).
safe_bignum() { printf '%s' "$1" | sed 's/[^0-9]//g' | cut -c1-9; }
safe_port() { p="$(printf '%s' "$1" | sed 's/[^0-9]//g' | cut -c1-5)"; [ -n "$p" ] && [ "$p" -ge 1 ] 2>/dev/null && [ "$p" -le 65535 ] 2>/dev/null && printf '%s' "$p"; }
# Accept an htmode only if it's valid for the radio's band: 2.4G cannot do 80/160 MHz, and
# writing HE80/VHT80 to radio0 makes hostapd reject the config so the 2.4G radio never starts.
htmode_ok() { _b="$(uci -q get wireless."$1".band)"; case "$1" in *0) _b="${_b:-2g}" ;; *1) _b="${_b:-5g}" ;; esac
  case "$_b" in
    2g) case "$2" in HT20|HT40|HE20|HE40|VHT20|VHT40) return 0 ;; esac ;;
    *)  case "$2" in HT20|HT40|HE20|HE40|HE80|HE160|VHT20|VHT40|VHT80|VHT160) return 0 ;; esac ;;
  esac
  return 1; }
safe_word() { printf '%s' "$1" | sed 's/[^A-Za-z0-9_.:-]//g' | cut -c1-48; }
safe_uci_ref() { printf '%s' "$1" | sed 's/[^A-Za-z0-9_@.:\[\]-]//g' | cut -c1-64; }
safe_uci_opt() { printf '%s' "$1" | sed 's/[^A-Za-z0-9_:-]//g' | cut -c1-64; }
safe_uci_value() { printf '%s' "$1" | tr -d '\000-\010\013\014\016-\037\177' | cut -c1-256; }
safe_port_list() { printf '%s' "$1" | sed 's/[^A-Za-z0-9_:. *-]//g' | cut -c1-160; }
cards_json() {
  printf '['; first=1
  while IFS='|' read -r label value hint level; do
    [ -n "$label$value$hint$level" ] || continue
    [ "$first" = 1 ] || printf ','
    printf '{"label":%s,"value":%s,"hint":%s,"level":%s}' "$(jstr "$label")" "$(jstr "$value")" "$(jstr "$hint")" "$(jstr "${level:-neutral}")"
    first=0
  done
  printf ']'
}
form_json() {
  printf '['; first=1
  while IFS='|' read -r name label value hint type readonly group modes options; do
    [ -n "$name$label$value$hint" ] || continue
    [ "$first" = 1 ] || printf ','
    printf '{"name":%s,"label":%s,"value":%s,"hint":%s,"type":%s,"readonly":%s,"group":%s,"modes":%s,"options":%s}' \
      "$(jstr "$name")" "$(jstr "$label")" "$(jstr "$value")" "$(jstr "$hint")" "$(jstr "${type:-text}")" "$([ "$readonly" = "1" ] && echo true || echo false)" "$(jstr "$group")" "$(jstr "$modes")" "$(jstr "$options")"
    first=0
  done
  printf ']'
}
emit() {
  ok="${1:-true}"; title="$2"; summary="$3"; cards="${4:-[]}"; text="$5"; actions="${6:-[]}"; form="${7:-[]}"
  printf '{"ok":%s,"section":%s,"title":%s,"summary":%s,"cards":%s,"actions":%s,"form":%s,"text":%s}\n' \
    "$ok" "$(jstr "$section")" "$(jstr "$title")" "$(jstr "$summary")" "$cards" "$actions" "$form" "$(jstr "$text")"
}
backup_cfg() {
  tag="$(safe_word "$1")"; [ -n "$tag" ] || tag="change"
  mkdir -p /root/dashboard-backups
  [ -f /etc/config/smartap ] || touch /etc/config/smartap 2>/dev/null
  ts="$(date +%Y%m%d-%H%M%S 2>/dev/null || echo now)"
  tar -czf "/root/dashboard-backups/smartap-${tag}-${ts}.tar.gz" /etc/config/network /etc/config/wireless /etc/config/dhcp /etc/config/firewall /etc/config/system /etc/config/smartap /etc/crontabs/root /etc/passwd /etc/shadow /etc/rc.button/reset 2>/dev/null
  printf '/root/dashboard-backups/smartap-%s-%s.tar.gz' "$tag" "$ts"
}
# APPLY & KEEP: settings are applied and saved immediately — there is NO auto-revert
# timer. The backup path is only recorded so the manual "Rollback now" button
# (rollback_last) can restore the previous state on demand.
arm_rollback() {
  backup="$1"
  [ -n "$backup" ] || return 0
  printf '%s\n' "$backup" > /tmp/smartap-rollback-backup
  rm -f /tmp/smartap-rollback-armed
}
confirm_required() {
  [ "$confirm" = "1" ] && return 0
  emit false "$1" "Confirmation required" "[]" "Press the action again to apply. A backup will be created first. TX Power is never modified." "[]" "[]"
  exit 0
}
radio_ifaces() { uci -q show wireless | awk -F'[.=]' '/=wifi-iface/{print $2}'; }
luci_action() {
  printf '[]'
}
luci_url() {
  echo ""
}
mode_has_vlan() {
  case "$1" in ap_vlan|mesh_vlan|wds_sender_vlan|wds_receiver_vlan) return 0 ;; esac
  return 1
}
valid_ipv4() {
  printf '%s' "$1" | grep -Eq '^[0-9]{1,3}(\.[0-9]{1,3}){3}$'
}
config_radio_iface() {
  radio="$1"
  uci show wireless 2>/dev/null | awk -F'[.=]' -v r="$radio" '
    /=wifi-iface/ {sec=$2; dev=0; ap=0}
    $0 ~ "\\."sec"\\.device=.?"r".?" {dev=1}
    $0 ~ "\\."sec"\\.mode=.?ap.?" {ap=1}
    dev && ap {print sec; exit}
  '
}
lan_zone_add() {
  # keep network $1 in the 'lan' firewall zone so uhttpd/the dashboard answers on it (input ACCEPT)
  net="$1"; [ -n "$net" ] || return 0
  zsec="$(uci show firewall 2>/dev/null | awk -F'[.=]' '$0 ~ "\\.name=.?lan.?$" {print $2; exit}')"
  [ -n "$zsec" ] || return 0
  uci -q get firewall."$zsec".network 2>/dev/null | tr ' ' '\n' | grep -qx "$net" || uci add_list firewall."$zsec".network="$net"
}
lan_zone_del() {
  net="$1"; [ -n "$net" ] || return 0
  zsec="$(uci show firewall 2>/dev/null | awk -F'[.=]' '$0 ~ "\\.name=.?lan.?$" {print $2; exit}')"
  [ -n "$zsec" ] || return 0
  uci -q del_list firewall."$zsec".network="$net" 2>/dev/null
}
store_royal_config() {
  touch /etc/config/smartap 2>/dev/null
  uci -q set smartap.quick='quicksettings'
  for k in program_mode device_ip vlan_id ssid ch24 ch5 htmode24 htmode5 mesh_id mesh_role wds_peer_ssid hide_ssid security delete_previous broadband_port reset_button_enabled reset_mode nat_enabled dhcp_server firewall_enabled watchcat_enabled broadband_enabled fake_mesh txpower; do
    v="$(param "$k" | cut -c1-96)"
    [ -n "$v" ] && uci -q set smartap.quick."$k"="$v"
  done
  # keep a sane txpower default if the field wasn't submitted
  [ -n "$(uci -q get smartap.quick.txpower)" ] || uci -q set smartap.quick.txpower='38'
  uci -q commit smartap
}
set_wifi_security() {
  ifc="$1"; sec="$2"; key="$3"
  [ -n "$ifc" ] || return 0
  case "$sec" in
    open) uci set wireless."$ifc".encryption='none'; uci delete wireless."$ifc".key 2>/dev/null ;;
    wpa3) uci set wireless."$ifc".encryption='sae-mixed'; [ -n "$key" ] && uci set wireless."$ifc".key="$key" ;;
    *) uci set wireless."$ifc".encryption='psk2'; [ -n "$key" ] && uci set wireless."$ifc".key="$key" ;;
  esac
}
valid_config() {
  case "$1" in network|wireless|dhcp|firewall|system|sqm|uhttpd|dropbear|smartap) return 0 ;; esac
  return 1
}
reload_by_config() {
  case "$1" in
    network) /etc/init.d/network reload >/dev/null 2>&1 ;;
    wireless) wifi reload >/dev/null 2>&1 ;;
    dhcp) /etc/init.d/dnsmasq restart >/dev/null 2>&1 ;;
    firewall) /etc/init.d/firewall reload >/dev/null 2>&1 ;;
    system) /etc/init.d/system reload >/dev/null 2>&1 || true ;;
    sqm) /etc/init.d/sqm restart >/dev/null 2>&1 ;;
    uhttpd) /etc/init.d/uhttpd reload >/dev/null 2>&1 ;;
    dropbear) /etc/init.d/dropbear restart >/dev/null 2>&1 ;;
  esac
}

section="$(param section)"; action="$(param action)"; confirm="$(param confirm)"
[ -n "$section" ] || section="control"
board="$(ubus call system board 2>/dev/null)"
info="$(ubus call system info 2>/dev/null)"
model="$(printf '%s\n' "$board" | jsonfilter -e '@.model' 2>/dev/null)"
version="$(printf '%s\n' "$board" | jsonfilter -e '@.release.version' 2>/dev/null)"
target="$(printf '%s\n' "$board" | jsonfilter -e '@.release.target' 2>/dev/null)"
kernel="$(printf '%s\n' "$board" | jsonfilter -e '@.kernel' 2>/dev/null)"
uptime_s="$(printf '%s\n' "$info" | jsonfilter -e '@.uptime' 2>/dev/null)"
# bulletproof fallbacks when ubus is momentarily busy (files/commands never hang)
[ -n "$model" ] || model="$(cat /tmp/sysinfo/model 2>/dev/null)"
[ -n "$model" ] || model="Xiaomi Mi Router CR6608"
[ -n "$kernel" ] || kernel="$(uname -r 2>/dev/null)"
[ -n "$target" ] || target="$(cat /tmp/sysinfo/board_name 2>/dev/null)"
[ -n "$target" ] || target="ramips/mt7621"
[ -n "$version" ] || version="$(. /etc/openwrt_release 2>/dev/null; echo "$DISTRIB_DESCRIPTION")"
{ [ -z "$uptime_s" ] || [ "$uptime_s" = "0" ]; } && uptime_s="$(cut -d. -f1 /proc/uptime 2>/dev/null)"
[ -n "$uptime_s" ] || uptime_s="0"
loadavg="$(cat /proc/loadavg 2>/dev/null)"
lan_ip="$(ip -4 addr show br-lan 2>/dev/null | awk '/inet /{print $2; exit}')"
default_route="$(ip -4 route show default 2>/dev/null | head -n 1)"
tx0="$(uci -q get wireless.radio0.txpower 2>/dev/null)"
tx1="$(uci -q get wireless.radio1.txpower 2>/dev/null)"

case "$action" in
  keep_changes) rm -f /tmp/smartap-rollback-armed /tmp/smartap-rollback-backup; emit true "Keep changes" "Rollback timer cancelled" "[]" "The current settings are kept." "[]" "[]"; exit 0 ;;
  apply_isolation)
    # instant one-click apply (Apply & Keep) — no confirmation, no auto-revert
    backup="$(backup_cfg security)"
    [ -f /etc/config/smartap ] || : > /etc/config/smartap
    uci -q get smartap.security >/dev/null 2>&1 || { uci set smartap.security='security'; }
    uci -q get smartap.management >/dev/null 2>&1 || { uci set smartap.management='management'; uci set smartap.management.vlan='1'; uci set smartap.management.ipaddr='192.168.1.1'; uci set smartap.management.recovery_always='1'; }
    se="$(safe_num "$(param sec_enabled)")"; fg="$(safe_num "$(param flood_guard)")"; rg="$(safe_num "$(param rogue_dhcp_guard)")"; lg="$(safe_num "$(param loop_guard)")"
    uci set smartap.security.enabled="${se:-1}"
    uci set smartap.security.flood_guard="${fg:-1}"
    uci set smartap.security.rogue_dhcp_guard="${rg:-1}"
    uci set smartap.security.loop_guard="${lg:-1}"
    w24="$(safe_num "$(param iso_wifi24)")"; w5="$(safe_num "$(param iso_wifi5)")"
    [ "$w24" = "1" ] && uci set wireless.wifinet0.isolate='1' || uci set wireless.wifinet0.isolate='0'
    [ "$w5" = "1" ] && uci set wireless.wifinet1.isolate='1' || uci set wireless.wifinet1.isolate='0'
    uci set smartap.security.wifi_isolate="$w24"
    for n in 1 2 3; do
      pen="$(safe_num "$(param lan${n}_enabled)")"; pil="$(safe_num "$(param lan${n}_isolate)")"; pvl="$(safe_num "$(param lan${n}_vlan)")"
      [ -n "$pvl" ] || pvl="1"; [ "$pvl" -ge 1 ] 2>/dev/null && [ "$pvl" -le 4094 ] 2>/dev/null || pvl="1"
      uci -q get smartap.lan$n >/dev/null 2>&1 || uci set smartap.lan$n='port'
      uci set smartap.lan$n.enabled="${pen:-1}"
      uci set smartap.lan$n.isolate="${pil:-0}"
      uci set smartap.lan$n.vlan="$pvl"
    done
    uci commit wireless; uci commit smartap
    wifi reload >/dev/null 2>&1
    /usr/sbin/cr6608-security-apply apply >/dev/null 2>&1
    /etc/init.d/cr6608-security enable >/dev/null 2>&1
    arm_rollback "$backup"
    emit true "الحماية والمنافذ" "تم التطبيق والحفظ فوراً" "[]" "نسخة احتياطية: $backup\nالحماية العامة=$se فيضان=$fg تسريب=$rg لوب=$lg. واي فاي 2.4G=$w24 5G=$w5. المنافذ محفوظة وتُعاد عند الإقلاع. الوصول للإدارة مضمون على كل المنافذ والواي فاي. الإعدادات محفوظة نهائياً. زر \"إرجاع الآن\" متاح لو أردت الرجوع للحالة السابقة. طاقة البث لم تُلمس." '[{"id":"keep_changes","label":"الاحتفاظ بالتغييرات"},{"id":"rollback_last","label":"إرجاع الآن","confirm":true}]' "[]"; exit 0 ;;
  rollback_last)
    rb="$(cat /tmp/smartap-rollback-backup 2>/dev/null)"
    if [ -r "$rb" ]; then
      tar -xzf "$rb" -C / 2>/dev/null
      /etc/init.d/dnsmasq restart >/dev/null 2>&1; /etc/init.d/firewall reload >/dev/null 2>&1; /etc/init.d/network reload >/dev/null 2>&1; wifi reload >/dev/null 2>&1
      rm -f /tmp/smartap-rollback-armed
      emit true "Rollback" "Restored previous backup" "[]" "Restored: $rb" "[]" "[]"
    else
      emit false "Rollback" "No rollback backup available" "[]" "No readable rollback backup found." "[]" "[]"
    fi
    exit 0 ;;
  clear_api_cache) rm -f /tmp/dashapi2.cache /tmp/dashapi2.cache.ts; emit true "Cache" "Cache cleared" "[]" "Live API cache was cleared." "[]" "[]"; exit 0 ;;
  eeprom_status)
    out="$(/usr/sbin/cr6608-eeprom-power status 2>&1)"
    drv="$(cat /sys/module/mt7915e/parameters/cr6608_rf_35dbm 2>/dev/null)"
    emit true "EEPROM / RF Power" "Status" "[]" "Driver RF override (cr6608_rf_35dbm)= ${drv:-unknown}\n$out" "[]" "[]"; exit 0 ;;
  eeprom_backup)
    out="$(/usr/sbin/cr6608-eeprom-power backup 2>&1)"
    emit true "EEPROM Backup" "Factory backed up" "[]" "$out\nنسخة المعايرة الاحتياطية جاهزة للتنزيل: http://<router>/factory.orig" "[]" "[]"; exit 0 ;;
  eeprom_boost)
    confirm_required "EEPROM power boost (writes calibration flash)"
    out="$(/usr/sbin/cr6608-eeprom-power apply 2>&1)"
    case "$out" in
      APPLIED-OK*) emit true "EEPROM Boost" "Applied (+6 dB rate delta)" "[]" "$out\nتم رفع دلتا الطاقة في المعايرة. الخرج الفعلي يُقص حسب regulatory + caldata + الدرايفر + قدرة PA (والـEIRP = خرج الراديو + ربح الأنتينا - الفقد)." "[]" "[]" ;;
      ALREADY-APPLIED*) emit true "EEPROM Boost" "Already applied" "[]" "$out" "[]" "[]" ;;
      *) emit false "EEPROM Boost" "Failed / rolled back" "[]" "$out\nتمت استعادة المعايرة الأصلية تلقائيًا." "[]" "[]" ;;
    esac
    exit 0 ;;
  eeprom_restore)
    confirm_required "Restore original Factory calibration"
    out="$(/usr/sbin/cr6608-eeprom-power restore 2>&1)"
    emit true "EEPROM Restore" "Factory calibration restored" "[]" "$out" "[]" "[]"; exit 0 ;;
  add_interface)
    confirm_required "Add interface"
    ifname="$(safe_word "$(param if_name)")"; proto="$(safe_word "$(param if_proto)")"; dev="$(safe_word "$(param if_device)")"
    ipaddr="$(param if_ipaddr | cut -c1-32)"; netmask="$(param if_netmask | cut -c1-32)"; gateway="$(param if_gateway | cut -c1-32)"; dns="$(param if_dns | cut -c1-80)"
    [ -n "$ifname" ] || { emit false "Interfaces" "Missing name" "[]" "Interface name is required." "[]" "[]"; exit 0; }
    case "$ifname" in lan|wan|loopback) emit false "Interfaces" "Protected interface" "[]" "Use LAN/DHCP panel for lan and broadband mode for wan." "[]" "[]"; exit 0 ;; esac
    case "$proto" in static|dhcp|none) : ;; *) proto="static" ;; esac
    backup="$(backup_cfg interface)"
    uci -q get network."$ifname" >/dev/null || uci set network."$ifname"='interface'
    uci set network."$ifname".proto="$proto"
    [ -n "$dev" ] && uci set network."$ifname".device="$dev"
    if [ "$proto" = "static" ]; then
      [ -n "$ipaddr" ] && uci set network."$ifname".ipaddr="$ipaddr"
      [ -n "$netmask" ] && uci set network."$ifname".netmask="$netmask"
      [ -n "$gateway" ] && uci set network."$ifname".gateway="$gateway"
      [ -n "$dns" ] && uci set network."$ifname".dns="$dns"
    fi
    uci commit network; arm_rollback "$backup"; /etc/init.d/network reload >/dev/null 2>&1
    emit true "Interfaces" "Interface saved with rollback" "[]" "Backup: $backup\nInterface $ifname was saved and network reloaded. TX Power unchanged." '[{"id":"keep_changes","label":"Keep changes"},{"id":"rollback_last","label":"Rollback now","confirm":true}]' "[]"; exit 0 ;;
  add_route)
    confirm_required "Add route"
    r_iface="$(safe_word "$(param route_interface)")"; r_target="$(param route_target | cut -c1-32)"; r_netmask="$(param route_netmask | cut -c1-32)"; r_gateway="$(param route_gateway | cut -c1-32)"
    [ -n "$r_iface" ] || r_iface="lan"
    valid_ipv4 "$r_target" || { emit false "Routing" "Invalid target" "[]" "Route target must be IPv4." "[]" "[]"; exit 0; }
    valid_ipv4 "$r_netmask" || r_netmask="255.255.255.0"
    valid_ipv4 "$r_gateway" || { emit false "Routing" "Invalid gateway" "[]" "Gateway must be IPv4." "[]" "[]"; exit 0; }
    backup="$(backup_cfg route)"
    s="$(uci add network route)"; uci set network."$s".interface="$r_iface"; uci set network."$s".target="$r_target"; uci set network."$s".netmask="$r_netmask"; uci set network."$s".gateway="$r_gateway"
    uci commit network; arm_rollback "$backup"; /etc/init.d/network reload >/dev/null 2>&1
    emit true "Routing" "Static route added" "[]" "Backup: $backup\nRoute $r_target/$r_netmask via $r_gateway was added. TX Power unchanged." '[{"id":"keep_changes","label":"Keep changes"},{"id":"rollback_last","label":"Rollback now","confirm":true}]' "[]"; exit 0 ;;
  add_firewall_rule)
    confirm_required "Firewall"
    fname="$(param rule_name | cut -c1-48)"; fsrc="$(safe_word "$(param rule_src)")"; fdest="$(safe_word "$(param rule_dest)")"; fproto="$(safe_word "$(param rule_proto)")"; fdport="$(safe_num "$(param rule_dport)")"; ftarget="$(safe_word "$(param rule_target)")"
    [ -n "$fname" ] || fname="CR6608-Rule"; [ -n "$fsrc" ] || fsrc="lan"; [ -n "$fdest" ] || fdest="wan"; [ -n "$fproto" ] || fproto="tcp"; case "$ftarget" in ACCEPT|REJECT|DROP) : ;; *) ftarget="ACCEPT" ;; esac
    backup="$(backup_cfg firewall-rule)"
    r="$(uci add firewall rule)"; uci set firewall."$r".name="$fname"; uci set firewall."$r".src="$fsrc"; uci set firewall."$r".dest="$fdest"; uci set firewall."$r".proto="$fproto"; [ -n "$fdport" ] && uci set firewall."$r".dest_port="$fdport"; uci set firewall."$r".target="$ftarget"; uci set firewall."$r".family='ipv4'
    uci commit firewall; /etc/init.d/firewall reload >/dev/null 2>&1
    emit true "Firewall" "Rule added" "[]" "Backup: $backup\nFirewall rule $fname was added and firewall reloaded. TX Power unchanged." "[]" "[]"; exit 0 ;;
  save_system)
    confirm_required "System"
    newhost="$(safe_word "$(param hostname)")"; newtz="$(param timezone | cut -c1-64)"
    backup="$(backup_cfg system)"
    [ -n "$newhost" ] && uci set system.@system[0].hostname="$newhost"
    [ -n "$newtz" ] && uci set system.@system[0].timezone="$newtz"
    uci commit system; /etc/init.d/system reload >/dev/null 2>&1 || true
    emit true "System" "System values saved" "[]" "Backup: $backup\nHostname/timezone saved. TX Power unchanged." "[]" "[]"; exit 0 ;;
  add_cron)
    confirm_required "Scheduled Tasks"
    line="$(param cron_line | tr -d '\r\n' | cut -c1-180)"
