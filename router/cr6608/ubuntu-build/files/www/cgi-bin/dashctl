    cards="$(cards_json <<EOF
الحماية العامة|$(yn "$sec_en")|المفتاح الرئيسي لكل الحمايات|$(lvl "$sec_en")
حماية الفيضان|$(yn "$flood")|حد أقصى لطلبات الويب ضد البوتات|$(lvl "$flood")
منع تسريب IP|$(yn "$rogue")|يمنع توزيع/تسريب العناوين للميكروتك والمنافذ|$(lvl "$rogue")
