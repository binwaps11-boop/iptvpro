# cr6608.seed.config
#
# diffconfig-style seed for OpenWrt 24.10.6 buildroot.
# Fed into .config, then expanded with `make defconfig`.
#
# Target: ramips / mt7621
# Device: xiaomi,mi-router-cr6608
# ---------------------------------------------------------------------------

# --- Target selection -------------------------------------------------------
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_xiaomi_mi-router-cr6608=y

# Build only this one device profile (smaller/faster build).
CONFIG_TARGET_MULTI_PROFILE=n

# --- Wi-Fi: MT7915 (mt76) ---------------------------------------------------
CONFIG_PACKAGE_kmod-mt7915e=y
CONFIG_PACKAGE_kmod-mt7915-firmware=y
# WED (Wireless Ethernet Dispatch) offload support for mt7621+mt7915.
CONFIG_PACKAGE_kmod-mt76-connac=y

# --- Supplicant / hostapd (WPA3/SAE needs OpenSSL or mbedTLS build) ----------
# Full WPA3-capable supplicant. Use wpad-openssl for widest cipher support.
CONFIG_PACKAGE_wpad-openssl=y
# (Do NOT also select wpad-basic-mbedtls; they conflict. See README.)
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set

# --- Regulatory database ----------------------------------------------------
CONFIG_PACKAGE_wireless-regdb=y
# iw-full provides the `iw` binary used by /usr/sbin/set-txpower.
# (Do not also select the basic `iw` package; they conflict/provide the same.)
CONFIG_PACKAGE_iw-full=y

# --- LuCI web UI ------------------------------------------------------------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-proto-ipv6=y

# --- Handy userspace --------------------------------------------------------
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_kmod-usb3=y

# --- Image / rootfs sizing --------------------------------------------------
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_zram-swap=y
CONFIG_PACKAGE_kmod-zram=y
CONFIG_PACKAGE_ip-bridge=y
