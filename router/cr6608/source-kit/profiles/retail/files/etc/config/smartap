config smartap 'management'
	option ipaddr '192.168.1.1'
	option recovery_always '1'
	option recovery_wifi '1'
	option vlan '1'

config smartap 'security'
	option enabled '1'
	option flood_guard '1'
	option loop_guard '0'
	option loop_guard_owner 'inherit'
	option rogue_dhcp_guard '1'

config smartap 'quick'
	option ch24 '11'
	option ch5 '36'
	option htmode24 'HE20'
	option htmode5 'HE80'
	option radio0_enabled '0'
	option radio1_enabled '0'
	option hide_ssid '1'
	option security 'mixed'

config smartap 'autochannel'
	option enabled '0'

config experimental 'experimental'
	option ul_muru '0'
	option muru_mask '0'
	option ul_muru_guard '0'
	option ul_muru_state 'retail-disabled'
	option ul_muru_reason 'immutable-retail-radio-policy'

config port 'lan1'
	option enabled '1'
	option isolate '0'
	option vlan '1'
	option vlan_mode 'auto'

config port 'lan2'
	option enabled '1'
	option isolate '0'
	option vlan '1'
	option vlan_mode 'auto'

config port 'lan3'
	option enabled '1'
	option isolate '0'
	option vlan '1'
	option vlan_mode 'auto'

config identity 'identity'
	option enabled '1'
	option customer_name ''
	option device_name 'CR6608'
	option phone ''
	option interval '30'
