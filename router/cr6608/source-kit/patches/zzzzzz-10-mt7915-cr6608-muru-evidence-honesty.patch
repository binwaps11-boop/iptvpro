@@ -474,6 +490,56 @@ static int mt7915_cr6608_ul_attribution_show(struct seq_file *file, void *data)
 
 DEFINE_SHOW_ATTRIBUTE(mt7915_cr6608_ul_attribution);
 
+/* Opt-in, bounded evidence window: enable RXD group 5 (C-RXV) so received
+ * HE TB PPDUs can be recognised and attributed to their WCID.  This is the
+ * same register bit upstream sets for a monitor interface (mt7915/main.c,
+ * mt7915_configure_filter) and carries the same documented hardware risk
+ * (d33943ba: per-packet rate reporting can stall RX).  It is never enabled
+ * by a profile; the evidence tool turns it on for a window and restores it.
+ * A firmware reset re-clears it (mt7915_mac_init_band).
+ */
+static int mt7915_cr6608_rxv_group5_get(void *data, u64 *val)
+{
+	struct mt7915_phy *phy = data;
+
+	*val = !!(mt76_rr(phy->dev, MT_DMA_DCR0(phy->mt76->band_idx)) &
+		  MT_DMA_DCR0_RXD_G5_EN);
+	return 0;
+}
+
+static int mt7915_cr6608_rxv_group5_set(void *data, u64 val)
+{
+	struct mt7915_phy *phy = data;
+	struct mt7915_dev *dev = phy->dev;
+
+	if (val > 1)
+		return -EINVAL;
+	if (!dev->cr6608_ul_muru_allowed)
+		return -EOPNOTSUPP;
+
+	mutex_lock(&dev->mt76.mutex);
+	if (!test_bit(MT76_STATE_RUNNING, &phy->mt76->state)) {
+		mutex_unlock(&dev->mt76.mutex);
+		return -ENETDOWN;
+	}
+	mt76_rmw_field(dev, MT_DMA_DCR0(phy->mt76->band_idx),
+		       MT_DMA_DCR0_RXD_G5_EN, !!val);
+	mutex_unlock(&dev->mt76.mutex);
+
+	if (val)
+		dev_warn(dev->mt76.dev,
+			 "CR6608 band %u: RXD group 5 (C-RXV) enabled for an evidence window; upstream keeps it off outside monitor mode because per-packet rate reporting can stall RX\n",
+			 phy->mt76->band_idx);
+	else
+		dev_info(dev->mt76.dev,
+			 "CR6608 band %u: RXD group 5 (C-RXV) disabled again\n",
+			 phy->mt76->band_idx);
+	return 0;
+}
+
+DEFINE_DEBUGFS_ATTRIBUTE(fops_cr6608_rxv_group5, mt7915_cr6608_rxv_group5_get,
+			 mt7915_cr6608_rxv_group5_set, "%lld\n");
+
 static int mt7915_muru_stats_show(struct seq_file *file, void *data)
 {
 	struct mt7915_phy *phy = file->private;
@@ -502,8 +568,15 @@ static int mt7915_muru_stats_show(struct seq_file *file, void *data)
 	mutex_lock(&dev->mt76.mutex);
 
 	ret = mt7915_mcu_muru_debug_get(phy);
-	if (ret)
+	if (ret) {
+		/* Say so in the file instead of failing the read, so a tool can
+		 * tell "firmware refused/timed out on MURU_GET_TXC_TX_STATS" apart
+		 * from "no PPDUs".
+		 */
+		seq_printf(file, "firmware-stats-unavailable err=%d\n", ret);
+		ret = 0;
 		goto exit;
+	}
 
 	/* Non-HE Downlink*/
 	seq_puts(file, "[Non-HE]\nDownlink\nData Type:  ");
@@ -1522,6 +1595,8 @@ int mt7915_init_debugfs(struct mt7915_phy *phy)
 			    &mt7915_cr6608_ul_muru_state_fops);
 	debugfs_create_file("cr6608_ul_attribution", 0400, dir, phy,
 			    &mt7915_cr6608_ul_attribution_fops);
+	debugfs_create_file("cr6608_rxv_group5", 0600, dir, phy,
+			    &fops_cr6608_rxv_group5);
 
 	debugfs_create_file("muru_stats", 0400, dir, phy,
 			    &mt7915_muru_stats_fops);
@@ -1769,7 +1844,12 @@ static int mt7915_cr6608_sta_ul_show(struct seq_file *file, void *data)
 	 */
 	seq_printf(file, "he_tb_ul_mumimo_shared=%u\n", mumimo);
 	seq_printf(file, "last_tb_timestamp=%u\n", ts);
-	seq_puts(file, "evidence=client-attributed-rx-descriptor-wcid\n");
+	if (is_mt7915(&phy->dev->mt76) &&
+	    !(mt76_rr(phy->dev, MT_DMA_DCR0(phy->mt76->band_idx)) &
+	      MT_DMA_DCR0_RXD_G5_EN))
+		seq_puts(file, "evidence=unavailable-crxv-disabled\n");
+	else
+		seq_puts(file, "evidence=client-attributed-rx-descriptor-wcid\n");
 
 	return 0;
 }

