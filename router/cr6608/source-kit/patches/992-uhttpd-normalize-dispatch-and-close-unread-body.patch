+bool uh_proc_header_exists(struct client *cl, const char *name)
+{
+	struct dispatch_proc *p = &cl->dispatch.proc;
+	struct blob_attr *cur;
+	int rem;
+
+	if (!name || cl->dispatch.free != proc_free ||
+	    p->r.header_cb || !p->hdr.head)
+		return false;
+
+	blob_for_each_attr(cur, p->hdr.head, rem) {
+		if (!strcasecmp(blobmsg_name(cur), name))
+			return true;
+	}
+
+	return false;
+}
 
