+static char * canonpath(const char *path, char *path_resolved)
+{
+	if (conf.no_symlinks)
+		return realpath(path, path_resolved);
+
+	return canonpath_lexical(path, path_resolved);
+}
+
+/*
+ * URL based handlers are selected before uh_path_lookup() decodes and
+ * canonicalizes the request path. Match handlers against the same logical
+ * path that the filesystem dispatcher will use, otherwise percent-encoding,
+ * repeated slashes or dot segments can bypass a configured prefix and reach
+ * a CGI below it.
+ *
+ * Keep the original query string, but decode and normalize only the path.
+ * A malformed or overlong URL simply falls back to the existing filesystem
+ * lookup, which will reject it in the usual way.
+ */
+static char * normalize_dispatch_url(const char *url)
+{
+	static char decoded[PATH_MAX];
+	static char normalized[PATH_MAX];
+	static char result[PATH_MAX];
+	const char *query;
+	size_t path_len, normalized_len, query_len = 0;
+	int decoded_len;
+
+	if (!url)
+		return NULL;
+
+	query = strchr(url, '?');
+	path_len = query ? (size_t)(query - url) : strlen(url);
+	if (!path_len || path_len > INT_MAX)
+		return NULL;
+
+	decoded_len = uh_urldecode(decoded, sizeof(decoded), url, path_len);
+	if (decoded_len < 0 || decoded[0] != '/' ||
+	    (size_t)decoded_len != strlen(decoded))
+		return NULL;
+
+	canonpath_lexical(decoded, normalized);
+	normalized_len = strlen(normalized);
+	if (query)
+		query_len = strlen(query);
+
+	if (normalized_len + query_len >= sizeof(result))
+		return NULL;
+
+	memcpy(result, normalized, normalized_len);
+	if (query_len)
+		memcpy(result + normalized_len, query, query_len);
+	result[normalized_len + query_len] = 0;
+
+	return result;
+}
