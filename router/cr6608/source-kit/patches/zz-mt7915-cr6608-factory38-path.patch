diff --git a/mt7915/eeprom.c b/mt7915/eeprom.c
--- a/mt7915/eeprom.c
+++ b/mt7915/eeprom.c
@@ -9,6 +9,63 @@ static bool enable_6ghz;
 module_param(enable_6ghz, bool, 0644);
 MODULE_PARM_DESC(enable_6ghz, "Enable 6 GHz instead of 5 GHz on hardware that supports both");
 
+#define CR6608_FACTORY38_CHIP_ID		0x7915
+#define CR6608_FACTORY38_WIFI_CONF7		0x15
+#define CR6608_FACTORY38_RATE_DELTA_2G		0xc6
+#define CR6608_FACTORY38_RATE_DELTA_5G		0xc4
+#define CR6608_FACTORY38_TARGET_2G		0x40
+#define CR6608_FACTORY38_TARGET_5G		0x42
+#define CR6608_FACTORY38_SAFE_2G		0x28
+#define CR6608_FACTORY38_SAFE_5G		0x26
+#define CR6608_FACTORY38_SAFE_DELTA_2G		6
+#define CR6608_FACTORY38_SAFE_DELTA_5G		4
+#define CR6608_FACTORY38_CHAINS		4
+#define CR6608_FACTORY38_5G_GROUPS		8
+
+static bool cr6608_factory38_persisted_match;
+
+static const struct kernel_param_ops cr6608_factory38_persisted_match_ops = {
+	.get = param_get_bool,
+};
+
+module_param_cb(cr6608_factory38_persisted_match,
+		&cr6608_factory38_persisted_match_ops,
+		&cr6608_factory38_persisted_match, 0444);
+MODULE_PARM_DESC(cr6608_factory38_persisted_match,
+		 "CR6608: read-only proof that every persisted Factory-38 identity and target byte matches exactly across all four chains and all eight 5 GHz EEPROM channel groups");
+
+bool
+mt7915_cr6608_factory38_raw_match(struct mt7915_dev *dev)
+{
+	u8 *eeprom = dev->mt76.eeprom.data;
+	bool match = false;
+	int chain, group;
+
+	if (!eeprom ||
+	    get_unaligned_le16(eeprom + MT_EE_CHIP_ID) !=
+					CR6608_FACTORY38_CHIP_ID ||
+	    eeprom[MT_EE_WIFI_CONF + 7] != CR6608_FACTORY38_WIFI_CONF7 ||
+	    eeprom[MT_EE_RATE_DELTA_2G] != CR6608_FACTORY38_RATE_DELTA_2G ||
+	    eeprom[MT_EE_RATE_DELTA_5G] != CR6608_FACTORY38_RATE_DELTA_5G)
+		goto out;
+
+	for (chain = 0; chain < CR6608_FACTORY38_CHAINS; chain++) {
+		if (eeprom[MT_EE_TX0_POWER_2G + chain * 3] !=
+		    CR6608_FACTORY38_TARGET_2G)
+			goto out;
+
+		for (group = 0; group < CR6608_FACTORY38_5G_GROUPS; group++)
+			if (eeprom[MT_EE_TX0_POWER_5G + chain * 12 + group] !=
+			    CR6608_FACTORY38_TARGET_5G)
+				goto out;
+	}
+
+	match = true;
+out:
+	WRITE_ONCE(cr6608_factory38_persisted_match, match);
+	return match;
+}
+
 static int mt7915_eeprom_load_precal(struct mt7915_dev *dev)
 {
 	struct mt76_dev *mdev = &dev->mt76;
@@ -293,7 +348,7 @@ int mt7915_eeprom_get_target_power(struct mt7915_dev *dev,
 {
 	u8 *eeprom = dev->mt76.eeprom.data;
 	int index, target_power;
-	bool tssi_on, is_7976;
+	bool tssi_on, is_7976, persisted_match, request_armed, request_enabled;
 
 	if (chain_idx > 3)
 		return -EINVAL;
@@ -332,6 +387,30 @@ int mt7915_eeprom_get_target_power(struct mt7915_dev *dev,
 		target_power = is_7976 ? eeprom[index + group] : 0;
 	}
 
+	/* Keep the persisted-byte result as truthful telemetry, but allow the
+	 * explicitly armed CR6608 LAB path to synthesize the audited Factory-38
+	 * targets in RAM.  The MCU transaction still verifies every applied SKU
+	 * table and rolls back on any mismatch.
+	 */
+	persisted_match = mt7915_cr6608_factory38_raw_match(dev);
+	request_armed = mt7915_cr6608_rf_request_armed(dev);
+	request_enabled = mt7915_cr6608_rf_request_enabled(dev);
+	if (request_armed && !persisted_match) {
+		dev_warn_once(dev->mt76.dev,
+			      "CR6608-RF persisted Factory-38 identity mismatch; activating the audited volatile 38 dBm target override\n");
+		/* The Factory image remains unchanged and is reported as a mismatch.
+		 * Only the in-memory target and rate-delta readers are overridden.
+		 * The verified MCU readback remains the authority for applied power.
+		 * Any failed write or readback forces the conservative rollback path.
+		 */
+	}
+	if (request_enabled) {
+		if (chan->band == NL80211_BAND_2GHZ)
+			target_power = CR6608_FACTORY38_TARGET_2G;
+		else if (chan->band == NL80211_BAND_5GHZ)
+			target_power = CR6608_FACTORY38_TARGET_5G;
+	}
+
 	return target_power;
 }
 
@@ -338,6 +416,14 @@ s8 mt7915_eeprom_get_power_delta(struct mt7915_dev *dev, int band)
 	u32 val, offs;
 	s8 delta;
 	bool is_7976 = mt7915_check_adie(dev, false) || is_mt7916(&dev->mt76);
+
+	if (mt7915_cr6608_rf_request_armed(dev)) {
+		/* Match the audited Factory-38 rate deltas in volatile RAM. */
+		if (band == NL80211_BAND_2GHZ)
+			return CR6608_FACTORY38_SAFE_DELTA_2G;
+		if (band == NL80211_BAND_5GHZ)
+			return CR6608_FACTORY38_SAFE_DELTA_5G;
+	}
 
 	if (band == NL80211_BAND_2GHZ)
 		offs = is_7976 ? MT_EE_RATE_DELTA_2G_V2 : MT_EE_RATE_DELTA_2G;
diff --git a/mt7915/mt7915.h b/mt7915/mt7915.h
--- a/mt7915/mt7915.h
+++ b/mt7915/mt7915.h
@@ -443,6 +443,8 @@ int mt7915_eeprom_init(struct mt7915_dev *dev);
 void mt7915_eeprom_parse_hw_cap(struct mt7915_dev *dev,
 				struct mt7915_phy *phy);
 bool mt7915_cr6608_rf_request_enabled(struct mt7915_dev *dev);
+bool mt7915_cr6608_rf_request_armed(struct mt7915_dev *dev);
+bool mt7915_cr6608_factory38_raw_match(struct mt7915_dev *dev);
 int mt7915_eeprom_get_target_power(struct mt7915_dev *dev,
 				   struct ieee80211_channel *chan,
 				   u8 chain_idx);
