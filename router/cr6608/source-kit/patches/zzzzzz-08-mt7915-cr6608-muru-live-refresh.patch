  */
 #define CR6608_MURU_MAX_STRIKES	3
 
+/* Strikes count unattributed recoveries that happened close together.  A
+ * healthy radio that later hits one more unrelated event must not inherit
+ * strikes from weeks ago, so the counter decays to zero once the radio has
+ * run this long without any disarm.  Three unrelated recoveries inside the
+ * window still end the experiment permanently.
+ */
+#define CR6608_MURU_STRIKE_DECAY	(15 * 60 * HZ)
+
+/* Private msta->changed bit, outside the IEEE80211_RC_* space, asking
+ * mt7915_mac_sta_rc_work() to replay this peer's station record so its
+ * STA_REC_MURU reflects the live mask.
+ */
+#define CR6608_RC_MURU_REFRESH		BIT(31)
+
+void mt7915_cr6608_muru_refresh_stations(struct mt7915_dev *dev,
+					 const char *why);
