+/* Replay every associated peer's station record so its STA_REC_MURU carries
+ * the live scheduler mask.  Reuses the rate-control work: the atomic
+ * iterator only queues peers, and mt7915_mac_sta_rc_work() does the MCU
+ * transactions from process context, exactly like a bitrate-mask change.
+ * Covers both phys of a DBDC device.
+ */
+void mt7915_cr6608_muru_refresh_stations(struct mt7915_dev *dev,
+					 const char *why)
+{
+	struct mt76_phy *ext_phy = dev->mt76.phys[MT_BAND1];
+	u32 changed = CR6608_RC_MURU_REFRESH;
+
+	if (!dev->cr6608_ul_muru_allowed)
+		return;
+
+	ieee80211_iterate_stations_atomic(mt76_hw(dev), mt7915_sta_rc_work,
+					  &changed);
+	if (ext_phy)
+		ieee80211_iterate_stations_atomic(ext_phy->hw,
+						  mt7915_sta_rc_work,
+						  &changed);
+	ieee80211_queue_work(mt76_hw(dev), &dev->rc_work);
+	dev_info(dev->mt76.dev,
+		 "CR6608 MURU station records queued for refresh (%s, mask 0x%x)\n",
+		 why, mt7915_cr6608_muru_effective_mask(dev));
+}
