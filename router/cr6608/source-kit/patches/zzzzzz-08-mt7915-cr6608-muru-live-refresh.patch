 static inline bool mt7915_cr6608_muru_disarm(struct mt7915_dev *dev)
 {
 	if (!dev->cr6608_ul_muru_allowed)
@@ -492,10 +516,37 @@ static inline bool mt7915_cr6608_muru_disarm(struct mt7915_dev *dev)
 		return false;
 
 	atomic_inc(&dev->cr6608_muru_disarms);
+	WRITE_ONCE(dev->cr6608_muru_last_disarm, jiffies);
 
 	return true;
 }
 
+/* Called from the periodic MAC work on the primary phy.  Decays the strike
+ * counter after a full healthy window; never touches a latched device, and
+ * never runs while a recovery is in flight.
+ */
+static inline void mt7915_cr6608_muru_strike_decay(struct mt7915_dev *dev)
+{
+	unsigned long last;
+	int strikes;
+
+	if (!dev->cr6608_ul_muru_allowed)
+		return;
+	strikes = atomic_read(&dev->cr6608_muru_strikes);
+	if (!strikes || atomic_read(&dev->cr6608_muru_fault_latched))
+		return;
+	if (test_bit(MT76_MCU_RESET, &dev->mphy.state) ||
+	    test_bit(MT76_RESET, &dev->mphy.state))
+		return;
+	last = READ_ONCE(dev->cr6608_muru_last_disarm);
+	if (!time_after(jiffies, last + CR6608_MURU_STRIKE_DECAY))
+		return;
+	if (atomic_cmpxchg(&dev->cr6608_muru_strikes, strikes, 0) == strikes)
+		dev_info(dev->mt76.dev,
+			 "CR6608 MURU strike counter decayed from %d after %u s without a disarm\n",
+			 strikes, jiffies_to_msecs(CR6608_MURU_STRIKE_DECAY) / 1000);
+}
