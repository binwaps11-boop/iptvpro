diff --git a/mt7915/mac.c b/mt7915/mac.c
index b491c21..196608b 100644
--- a/mt7915/mac.c
+++ b/mt7915/mac.c
@@ -259,6 +259,134 @@ mt7915_wed_check_ppe(struct mt7915_dev *dev, struct mt76_queue *q,
 				 FIELD_GET(MT_DMA_PPE_ENTRY, info));
 }
 
+/* Map the P-RXV HE RU allocation index to its tone count.  The index layout is
+ * the one mt76_connac2_mac_decode_he_radiotap_ru() already decodes; this
+ * returns tones so it can be compared against the operating bandwidth without
+ * duplicating the radiotap enum.
+ */
+static u16 mt7915_cr6608_ul_ru_tones(const __le32 *rxv)
+{
+	u32 ru_l = le32_get_bits(rxv[0], MT_PRXV_HE_RU_ALLOC_L);
+	u32 ru_h = le32_get_bits(rxv[1], MT_PRXV_HE_RU_ALLOC_H);
+	u8 ru = (u8)(ru_l | ru_h << 4);
+
+	if (ru <= 36)
+		return 26;
+	if (ru <= 52)
+		return 52;
+	if (ru <= 60)
+		return 106;
+	if (ru <= 64)
+		return 242;
+	if (ru <= 66)
+		return 484;
+	if (ru == 67)
+		return 996;
+	if (ru == 68)
+		return 1992;
+
+	return 0;
+}
+
+static u16 mt7915_cr6608_ul_full_bw_tones(enum nl80211_chan_width width)
+{
+	switch (width) {
+	case NL80211_CHAN_WIDTH_20_NOHT:
+	case NL80211_CHAN_WIDTH_20:
+		return 242;
+	case NL80211_CHAN_WIDTH_40:
+		return 484;
+	case NL80211_CHAN_WIDTH_80:
+		return 996;
+	case NL80211_CHAN_WIDTH_160:
+	case NL80211_CHAN_WIDTH_80P80:
+		return 1992;
+	default:
+		return 0;
+	}
+}
+
+/* Account one received HE trigger-based PPDU against its transmitting peer.
+ *
+ * Called from the RX NAPI path only for MT_PHY_TYPE_HE_TB frames while an
+ * uplink MU-RU bit is armed, so the added cost is confined to airtime the
+ * scheduler actually solicited.  Everything here is read-only telemetry: it
+ * never changes scheduling, capability or power state.
+ */
+static void
+mt7915_cr6608_ul_account_tb(struct mt7915_phy *phy, struct mt7915_sta *msta,
+			    struct mt76_rx_status *status, const __le32 *rxv)
+{
+	u16 full_bw_tones = mt7915_cr6608_ul_full_bw_tones(phy->mt76->chandef.width);
+	u16 tones = mt7915_cr6608_ul_ru_tones(rxv);
+	bool full_bw = full_bw_tones && tones >= full_bw_tones;
+	unsigned long flags;
+	bool seen = false;
+	u8 i;
+
+	if (!tones)
+		return;
+
+	spin_lock_irqsave(&phy->cr6608_ul.lock, flags);
+
+	phy->cr6608_ul.tb_ppdu++;
+	msta->cr6608_ul.tb_ppdu++;
+	msta->cr6608_ul.last_ts = status->timestamp;
+	if (full_bw) {
+		phy->cr6608_ul.tb_full_bw++;
+		msta->cr6608_ul.tb_full_bw++;
+	} else {
+		phy->cr6608_ul.tb_ofdma_ru++;
+		msta->cr6608_ul.tb_ofdma_ru++;
+	}
+
+	/* Start a new timestamp group whenever the PHY start time changes.  A
+	 * group is only interesting once a second distinct peer joins it, and
+	 * each group is counted at most once.
+	 */
+	if (phy->cr6608_ul.group_ts != status->timestamp ||
+	    !phy->cr6608_ul.group_n) {
+		phy->cr6608_ul.group_ts = status->timestamp;
+		phy->cr6608_ul.group_n = 0;
+		phy->cr6608_ul.group_full_bw = 0;
+		phy->cr6608_ul.group_counted = false;
+	}
+
+	for (i = 0; i < phy->cr6608_ul.group_n; i++) {
+		if (phy->cr6608_ul.group_wcid[i] == msta->wcid.idx) {
+			seen = true;
+			break;
+		}
+	}
+
+	if (!seen && phy->cr6608_ul.group_n < CR6608_UL_TB_GROUP_MAX) {
+		phy->cr6608_ul.group_wcid[phy->cr6608_ul.group_n++] =
+			msta->wcid.idx;
+		if (full_bw)
+			phy->cr6608_ul.group_full_bw++;
+
+		if (phy->cr6608_ul.group_n > phy->cr6608_ul.max_group_peers)
+			phy->cr6608_ul.max_group_peers = phy->cr6608_ul.group_n;
+
+		if (phy->cr6608_ul.group_n == 2 &&
+		    !phy->cr6608_ul.group_counted) {
+			phy->cr6608_ul.group_counted = true;
+			/* Two peers sharing the PPDU start time on the full
+			 * operating bandwidth is full-bandwidth UL MU-MIMO;
+			 * on smaller RUs it is UL OFDMA.
+			 */
+			if (phy->cr6608_ul.group_full_bw >= 2) {
+				phy->cr6608_ul.mumimo_groups++;
+				msta->cr6608_ul.tb_mumimo++;
+			} else {
+				phy->cr6608_ul.ofdma_groups++;
+			}
+		}
+	}
+
+	spin_unlock_irqrestore(&phy->cr6608_ul.lock, flags);
+}
+
 static int
 mt7915_mac_fill_rx(struct mt7915_dev *dev, struct sk_buff *skb,
 		   enum mt76_rxq_id q, u32 *info)
@@ -455,6 +583,17 @@ mt7915_mac_fill_rx(struct mt7915_dev *dev, struct sk_buff *skb,
 							    sband, rxv, &mode);
 			if (ret < 0)
 				return ret;
+
+			/* Only a Trigger frame from this AP can produce a HE TB
+			 * PPDU, so this is client-attributed proof that the MU-RU
+			 * scheduler solicited uplink airtime from this exact peer.
+			 */
+			if (mode == MT_PHY_TYPE_HE_TB && msta &&
+			    (mt7915_cr6608_muru_mask(dev) &
+			     CR6608_MURU_UL_MASK) &&
+			    mphy->chandef.chan)
+				mt7915_cr6608_ul_account_tb(phy, msta, status,
+							    rxv);
 		}
 	}
 
