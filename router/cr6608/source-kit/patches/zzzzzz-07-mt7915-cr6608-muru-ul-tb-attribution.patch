diff --git a/mt7915/debugfs.c b/mt7915/debugfs.c
index df35bcc..5cece9d 100644
--- a/mt7915/debugfs.c
+++ b/mt7915/debugfs.c
@@ -396,6 +428,46 @@ static int mt7915_cr6608_ul_muru_state_show(struct seq_file *file,
 
 DEFINE_SHOW_ATTRIBUTE(mt7915_cr6608_ul_muru_state);
 
+/* Per-radio roll-up of the same client-attributed uplink evidence.
+ *
+ * "groups" count distinct PHY start timestamps in which two or more different
+ * peers transmitted, which is the observable definition of a simultaneous
+ * uplink multi-user transmission.  Single-peer trigger responses deliberately
+ * do not count towards either group total.
+ */
+static int mt7915_cr6608_ul_attribution_show(struct seq_file *file, void *data)
+{
+	struct mt7915_phy *phy = file->private;
+	unsigned long flags;
+	u32 tb, ofdma_ru, full_bw, ofdma_groups, mumimo_groups, max_peers;
+
+	spin_lock_irqsave(&phy->cr6608_ul.lock, flags);
+	tb = phy->cr6608_ul.tb_ppdu;
+	ofdma_ru = phy->cr6608_ul.tb_ofdma_ru;
+	full_bw = phy->cr6608_ul.tb_full_bw;
+	ofdma_groups = phy->cr6608_ul.ofdma_groups;
+	mumimo_groups = phy->cr6608_ul.mumimo_groups;
+	max_peers = phy->cr6608_ul.max_group_peers;
+	spin_unlock_irqrestore(&phy->cr6608_ul.lock, flags);
+
+	seq_printf(file, "band=%u\n", phy->mt76->band_idx);
+	seq_printf(file, "armed_mask=%u\n",
+		   mt7915_cr6608_muru_mask(phy->dev));
+	seq_printf(file, "he_tb_ppdu=%u\n", tb);
+	seq_printf(file, "he_tb_ul_ofdma_ru=%u\n", ofdma_ru);
+	seq_printf(file, "he_tb_full_bw=%u\n", full_bw);
+	seq_printf(file, "ul_ofdma_multi_user_ppdus=%u\n", ofdma_groups);
+	seq_printf(file, "ul_mumimo_multi_user_ppdus=%u\n", mumimo_groups);
+	seq_printf(file, "max_peers_in_one_ppdu=%u\n", max_peers);
+	seq_puts(file, "evidence=client-attributed-rx-descriptor-wcid\n");
+	seq_puts(file,
+		 "note=host-observed-scheduling-evidence-not-a-regulatory-or-rf-measurement\n");
+
+	return 0;
+}
+
+DEFINE_SHOW_ATTRIBUTE(mt7915_cr6608_ul_attribution);
+
 static int mt7915_muru_stats_show(struct seq_file *file, void *data)
 {
 	struct mt7915_phy *phy = file->private;
@@ -1442,6 +1514,8 @@ int mt7915_init_debugfs(struct mt7915_phy *phy)
 			    &fops_cr6608_muru_mask);
 	debugfs_create_file("cr6608_ul_muru_state", 0400, dir, dev,
 			    &mt7915_cr6608_ul_muru_state_fops);
+	debugfs_create_file("cr6608_ul_attribution", 0400, dir, phy,
+			    &mt7915_cr6608_ul_attribution_fops);
 
 	debugfs_create_file("muru_stats", 0400, dir, phy,
 			    &mt7915_muru_stats_fops);
@@ -1649,6 +1723,53 @@ static int mt7915_cr6608_sta_muru_show(struct seq_file *file, void *data)
 
 DEFINE_SHOW_ATTRIBUTE(mt7915_cr6608_sta_muru);
 
+/* Client-attributed uplink evidence for one peer.
+ *
+ * Unlike the aggregate radio counters in muru_stats, every number here is
+ * produced from RX descriptors that carry this peer's WCID, so it answers
+ * "did the scheduler solicit uplink airtime from THIS client" without capture
+ * hardware.  It is read-only and never used to make scheduling decisions.
+ */
+static int mt7915_cr6608_sta_ul_show(struct seq_file *file, void *data)
+{
+	struct ieee80211_sta *sta = file->private;
+	struct mt7915_sta *msta = (struct mt7915_sta *)sta->drv_priv;
+	struct mt7915_phy *phy;
+	unsigned long flags;
+	u32 tb, ofdma, full_bw, mumimo, ts;
+
+	if (!msta->vif || !msta->vif->phy)
+		return -ENODEV;
+	phy = msta->vif->phy;
+
+	spin_lock_irqsave(&phy->cr6608_ul.lock, flags);
+	tb = msta->cr6608_ul.tb_ppdu;
+	ofdma = msta->cr6608_ul.tb_ofdma_ru;
+	full_bw = msta->cr6608_ul.tb_full_bw;
+	mumimo = msta->cr6608_ul.tb_mumimo;
+	ts = msta->cr6608_ul.last_ts;
+	spin_unlock_irqrestore(&phy->cr6608_ul.lock, flags);
+
+	seq_printf(file, "wcid=%u\n", msta->wcid.idx);
+	/* A HE TB PPDU is only ever a response to a Trigger frame. */
+	seq_printf(file, "he_tb_ppdu=%u\n", tb);
+	/* Sub-bandwidth RU: this peer was given part of the channel. */
+	seq_printf(file, "he_tb_ul_ofdma_ru=%u\n", ofdma);
+	/* Full operating bandwidth: SU trigger, or UL MU-MIMO when shared. */
+	seq_printf(file, "he_tb_full_bw=%u\n", full_bw);
+	/* Full-bandwidth TB PPDU that shared its PHY start time with another
+	 * peer: full-bandwidth UL MU-MIMO, the only uplink MIMO mode MT7915
+	 * supports.
+	 */
+	seq_printf(file, "he_tb_ul_mumimo_shared=%u\n", mumimo);
+	seq_printf(file, "last_tb_timestamp=%u\n", ts);
+	seq_puts(file, "evidence=client-attributed-rx-descriptor-wcid\n");
+
+	return 0;
+}
+
+DEFINE_SHOW_ATTRIBUTE(mt7915_cr6608_sta_ul);
+
 void mt7915_sta_add_debugfs(struct ieee80211_hw *hw, struct ieee80211_vif *vif,
 			    struct ieee80211_sta *sta, struct dentry *dir)
 {
@@ -1656,9 +1777,12 @@ void mt7915_sta_add_debugfs(struct ieee80211_hw *hw, struct ieee80211_vif *vif,
 
 	debugfs_create_file("fixed_rate", 0600, dir, sta, &fops_fixed_rate);
 	debugfs_create_file("hw-queues", 0400, dir, sta, &mt7915_queues_fops);
-	if (mt7915_cr6608_muru_mask(dev) & CR6608_MURU_UL_MASK)
+	if (mt7915_cr6608_muru_mask(dev) & CR6608_MURU_UL_MASK) {
 		debugfs_create_file("cr6608_muru_capabilities", 0400, dir, sta,
 				    &mt7915_cr6608_sta_muru_fops);
+		debugfs_create_file("cr6608_ul_attribution", 0400, dir, sta,
+				    &mt7915_cr6608_sta_ul_fops);
+	}
 }
 
 #endif

