+
 struct mt7915_phy {
 	struct mt76_phy *mt76;
 	struct mt7915_dev *dev;
@@ -229,6 +244,35 @@ struct mt7915_phy {
 	bool sku_limit_en:1;
 	bool sku_path_en:1;
 
+	/* Client-attributed uplink trigger-based (TB) PPDU accounting.
+	 *
+	 * A HE TB PPDU exists only as a response to a Trigger frame this AP
+	 * transmitted, so counting them per WCID is direct, per-peer evidence
+	 * that the firmware MU-RU scheduler is really soliciting uplink
+	 * airtime - the attribution that aggregate radio counters cannot give.
+	 *
+	 * Frames belonging to one uplink MU PPDU share the PHY start
+	 * timestamp.  Two or more distinct peers in the same timestamp group
+	 * are therefore a genuine simultaneous uplink transmission: on a
+	 * sub-bandwidth RU that is UL OFDMA, and on the full operating
+	 * bandwidth it is full-bandwidth UL MU-MIMO, the only uplink MIMO mode
+	 * MT7915 supports.
+	 */
+	struct {
+		spinlock_t lock;
+		u32 group_ts;
+		u16 group_wcid[CR6608_UL_TB_GROUP_MAX];
+		u8 group_n;
+		u8 group_full_bw;
+		bool group_counted;
+		u32 tb_ppdu;
+		u32 tb_ofdma_ru;
+		u32 tb_full_bw;
+		u32 ofdma_groups;
+		u32 mumimo_groups;
+		u32 max_group_peers;
+	} cr6608_ul;
+
 #ifdef CONFIG_NL80211_TESTMODE
 	struct {
