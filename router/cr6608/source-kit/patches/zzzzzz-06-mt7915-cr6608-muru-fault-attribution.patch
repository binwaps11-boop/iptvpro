diff --git a/mt7915/mt7915.h b/mt7915/mt7915.h
index b2fba5d..75e9feb 100644
--- a/mt7915/mt7915.h
+++ b/mt7915/mt7915.h
@@ -317,10 +361,15 @@ struct mt7915_dev {
 	bool flash_mode;
 	bool muru_debug;
 	bool cr6608_ul_muru_allowed;
+	atomic_t cr6608_muru_ceiling;
+	atomic_t cr6608_muru_dl_floor;
 	atomic_t cr6608_muru_mask;
 	spinlock_t cr6608_muru_telemetry_lock;
 	atomic_t cr6608_muru_fault_latched;
 	atomic_t cr6608_muru_fault_latches;
+	atomic_t cr6608_muru_disarms;
+	atomic_t cr6608_muru_rearms;
+	atomic_t cr6608_muru_strikes;
 	atomic_t cr6608_ul_muru_sta_rec_attempted;
 	atomic_t cr6608_ul_muru_sta_rec_response_ok;
 	atomic_t cr6608_ul_muru_sta_rec_failed;
@@ -361,6 +410,26 @@ static inline u8 mt7915_cr6608_muru_mask(struct mt7915_dev *dev)
 	return atomic_read(&dev->cr6608_muru_mask) & CR6608_MURU_MASK;
 }
 
+/* Upstream MT7915 unconditionally requests DL OFDMA and, for a beamforming
+ * capable BSS, DL MU-MIMO.  Those are supported, stable features that have
+ * nothing to do with the uplink experiment, so a UL fault latch, an
+ * unattributed disarm or the UL kill switch must not drag the radio below
+ * plain upstream behaviour.  The floor holds exactly those two bits and is
+ * lowered only by an explicit operator mask write.
+ */
+#define CR6608_MURU_DL_MASK	(CR6608_MURU_OFDMA_DL | CR6608_MURU_MUMIMO_DL)
+
+static inline u8 mt7915_cr6608_muru_dl_floor(struct mt7915_dev *dev)
+{
+	return atomic_read(&dev->cr6608_muru_dl_floor) & CR6608_MURU_DL_MASK;
+}
+
+/* The mask the station-record builder should actually request. */
+static inline u8 mt7915_cr6608_muru_effective_mask(struct mt7915_dev *dev)
+{
+	return mt7915_cr6608_muru_mask(dev) | mt7915_cr6608_muru_dl_floor(dev);
+}
+
 /* This lock covers only short telemetry groups.  Never hold it across an MCU
  * send, recovery_tx_lock, recovery scheduling, or any sleeping operation.
  */
@@ -399,6 +468,34 @@ mt7915_cr6608_muru_sta_rec_failure(struct mt7915_dev *dev, bool timed_out)
 	spin_unlock_irqrestore(&dev->cr6608_muru_telemetry_lock, flags);
 }
 
+/* A recovery that is not attributable to the MURU scheduler must still take
+ * every scheduler bit down before the firmware is reset, because the station
+ * records that carry those bits are about to be destroyed.  It must not,
+ * however, spend the one-way fault latch: on this device the 38 dBm SKU
+ * transaction, DFS and ordinary MCU health events all funnel into the same
+ * mt7915_mcu_schedule_full_recovery() entry point, so latching there
+ * permanently disabled MU-RU scheduling for faults MU-RU never caused.
+ *
+ * Disarm is therefore the default for unattributed recovery; the permanent
+ * latch is reserved for evidence that the scheduler itself misbehaved
+ * (mt7915_cr6608_muru_fault_latch below).  Both clear the live mask first,
+ * so the firmware never sees a scheduler bit survive into a reset.
+ */
+#define CR6608_MURU_MAX_STRIKES	3
+
+static inline bool mt7915_cr6608_muru_disarm(struct mt7915_dev *dev)
+{
+	if (!dev->cr6608_ul_muru_allowed)
+		return false;
+
+	if (!atomic_xchg(&dev->cr6608_muru_mask, 0))
+		return false;
+
+	atomic_inc(&dev->cr6608_muru_disarms);
+
+	return true;
+}
+
 /* Clear every scheduler bit before firmware recovery.  The fault flag, not
  * the previous mask value, is the one-way arbitration point so a concurrent
  * kill-switch clear cannot hide the first real fault.  Flag and latch count
@@ -412,6 +509,7 @@ static inline bool mt7915_cr6608_muru_fault_latch(struct mt7915_dev *dev)
 	if (!dev->cr6608_ul_muru_allowed)
 		return false;
 
+	atomic_xchg(&dev->cr6608_muru_ceiling, 0);
 	atomic_xchg(&dev->cr6608_muru_mask, 0);
 	spin_lock_irqsave(&dev->cr6608_muru_telemetry_lock, flags);
 	latched = !atomic_xchg(&dev->cr6608_muru_fault_latched, 1);
@@ -422,6 +520,98 @@ static inline bool mt7915_cr6608_muru_fault_latch(struct mt7915_dev *dev)
 	return latched;
 }
 
+/* Shared, non-inline-critical reporting for a disarm that happened inside a
+ * spinlock-held region; the caller invokes it after dropping the lock.
+ */
+static inline void mt7915_cr6608_muru_report_disarm(struct mt7915_dev *dev)
+{
+	atomic_inc(&dev->cr6608_muru_strikes);
+	dev_warn(dev->mt76.dev,
+		 "CR6608 MURU scheduler disarmed for unattributed firmware recovery (strike %d/%d); it re-arms after a verified reset\n",
+		 atomic_read(&dev->cr6608_muru_strikes),
+		 CR6608_MURU_MAX_STRIKES);
+}
+
+/* Restore the scheduler mask once the firmware is known good again.
+ *
+ * The restored value is the live ceiling, never the boot value: the ceiling
+ * starts at the operator-locked boot mask and is only ever lowered - by the
+ * runtime debugfs writers (which stay strictly one-way) and by the fault
+ * latch, which drops it to zero.  Re-arming therefore cannot resurrect a bit
+ * an operator or a fault already retired; it can only undo the disarm that
+ * this recovery itself performed.
+ *
+ * Called from the recovery worker after the reset completed and before
+ * mac80211 replays the station records, so the replayed STA_REC_MURU
+ * transactions carry the restored bits.
+ */
+static inline u8 mt7915_cr6608_muru_rearm(struct mt7915_dev *dev)
+{
+	u8 mask;
+
+	if (!dev->cr6608_ul_muru_allowed)
+		return 0;
+	if (atomic_read(&dev->cr6608_muru_fault_latched))
+		return 0;
+	if (atomic_read(&dev->cr6608_muru_strikes) >= CR6608_MURU_MAX_STRIKES) {
+		/* Repeated unattributed recovery while the scheduler was live is
+		 * itself evidence.  Spend the latch instead of cycling forever.
+		 */
+		mt7915_cr6608_muru_fault_latch(dev);
+		return 0;
+	}
+
+	mask = atomic_read(&dev->cr6608_muru_ceiling) & CR6608_MURU_MASK;
+	if (!mask)
+		return 0;
+
+	if (atomic_cmpxchg(&dev->cr6608_muru_mask, 0, mask))
+		return 0;
+
+	/* The ceiling may have been lowered between the read above and the
+	 * exchange.  Re-apply it so a concurrent one-way clear always wins.
+	 */
+	for (;;) {
+		u8 ceiling = atomic_read(&dev->cr6608_muru_ceiling) &
+			     CR6608_MURU_MASK;
