+/* Lower the one-way ceiling and, with it, the live mask.  Every runtime path
+ * that retires a scheduler bit goes through here so a later re-arm can never
+ * bring it back.
+ */
+static inline void mt7915_cr6608_muru_lower_ceiling(struct mt7915_dev *dev,
+						    u8 mask)
+{
+	u8 old;
+
+	mask &= CR6608_MURU_MASK;
+	do {
+		old = atomic_read(&dev->cr6608_muru_ceiling) & CR6608_MURU_MASK;
+		if (!(old & ~mask))
+			return;
+	} while ((atomic_cmpxchg(&dev->cr6608_muru_ceiling, old,
+				 old & mask) & CR6608_MURU_MASK) != old);
+}
