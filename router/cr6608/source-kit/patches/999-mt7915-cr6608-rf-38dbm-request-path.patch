+void mt7915_mcu_schedule_full_recovery(struct mt7915_dev *dev)
+{
+	struct mt76_phy *ext_phy = dev->mt76.phys[MT_BAND1];
+	unsigned long flags;
+	bool full_in_progress;
+
+	spin_lock_irqsave(&dev->recovery_tx_lock, flags);
+	/* Probe-time MCU errors are returned to the caller and unwind device
+	 * registration synchronously.  reset_work must never run against an
+	 * ieee80211_hw that has not completed registration.
+	 */
+	if (!dev->recovery.hw_init_done) {
+		spin_unlock_irqrestore(&dev->recovery_tx_lock, flags);
+		return;
+	}
+	/* Calls from a failing transaction and its outer channel/config path can
+	 * describe the same fault.  Promote an outstanding partial request, but
+	 * allocate a new generation only when no recovery is already pending.
+	 * Independent firmware fault notifications increment generation in
+	 * mt7915_reset(), so they are not coalesced here.
+	 */
+	if (dev->recovery.hw_full_reset ||
+	    dev->recovery.generation ==
+	    dev->recovery.completed_generation)
+		dev->recovery.generation++;
+	dev->recovery.restart = true;
+	set_bit(MT76_MCU_RESET, &dev->mphy.state);
+	set_bit(MT76_RESET, &dev->mphy.state);
+	ieee80211_stop_queues(mt76_hw(dev));
+	if (ext_phy) {
+		set_bit(MT76_RESET, &ext_phy->state);
+		ieee80211_stop_queues(ext_phy->hw);
+	}
+	full_in_progress = dev->recovery.hw_full_reset;
+	if (!full_in_progress)
+		queue_work(dev->mt76.wq, &dev->reset_work);
+	spin_unlock_irqrestore(&dev->recovery_tx_lock, flags);
+
+	wake_up(&dev->mt76.mcu.wait);
+	wake_up(&dev->reset_wait);
+}
+
+static void mt7915_cr6608_schedule_recovery(struct mt7915_phy *phy)
+{
+	mt7915_mcu_schedule_full_recovery(phy->dev);
+}
+
+static int
+mt7915_mcu_send_txpower_sku_table(struct mt7915_phy *phy, u8 limit_type,
+				  const s8 *table, size_t table_len)
+{
+	struct mt7915_dev *dev = phy->dev;
+	struct {
+		u8 format_id;
+		u8 limit_type;
+		u8 band_idx;
+	} __packed hdr = {
+		.format_id = TX_POWER_LIMIT_TABLE,
+		.limit_type = limit_type,
+		.band_idx = phy->mt76->band_idx,
+	};
+	struct sk_buff *skb;
+
+	if ((limit_type == TX_POWER_LIMIT_TABLE_RATE &&
+	     table_len != MT7915_SKU_RATE_NUM) ||
+	    (limit_type == TX_POWER_LIMIT_TABLE_PATH &&
+	     table_len != MT7915_SKU_PATH_NUM) ||
+	    (limit_type != TX_POWER_LIMIT_TABLE_RATE &&
+	     limit_type != TX_POWER_LIMIT_TABLE_PATH))
+		return -EINVAL;
+
+	skb = mt76_mcu_msg_alloc(&dev->mt76, NULL, sizeof(hdr) + table_len);
+	if (!skb)
+		return -ENOMEM;
+
+	skb_put_data(skb, &hdr, sizeof(hdr));
+	skb_put_data(skb, table, table_len);
+
+	return mt76_mcu_skb_send_msg(&dev->mt76, skb,
+				     MCU_EXT_CMD(TX_POWER_FEATURE_CTRL), true);
+}
