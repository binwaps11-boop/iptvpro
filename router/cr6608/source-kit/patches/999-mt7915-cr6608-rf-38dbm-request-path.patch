+static bool mt76_channel_reset_commit(struct mt76_dev *dev,
+				       struct mt76_phy *phy)
+{
+	unsigned long old, new;
+
+	/* Recovery owns MCU_RESET on the primary PHY.  Clear this channel's
+	 * RESET bit only with a compare/exchange, then verify the cross-PHY MCU
+	 * hand-off again.  A concurrent producer either makes the cmpxchg retry
+	 * or restores RESET before the worker is unparked.
+	 */
+	do {
+		if (test_bit(MT76_MCU_RESET, &dev->phy.state))
+			return false;
+
+		old = READ_ONCE(phy->state);
+		if (old & BIT(MT76_MCU_RESET))
+			return false;
+		new = old & ~BIT(MT76_RESET);
+	} while (cmpxchg(&phy->state, old, new) != old);
+
+	smp_mb__after_atomic();
+	if (test_bit(MT76_MCU_RESET, &dev->phy.state)) {
+		set_bit(MT76_RESET, &phy->state);
+		return false;
+	}
+
+	return true;
+}
