+struct mt7915_cr6608_sku_transaction {
+	struct mt76_power_limits limits;
+	s8 rate_table[MT7915_SKU_RATE_NUM];
+	s8 previous_rate_table[MT7915_SKU_RATE_NUM];
+	s8 rate_readback[MT7915_SKU_RATE_NUM];
+	s8 path_table[MT7915_SKU_PATH_NUM];
+	s8 previous_path_table[MT7915_SKU_PATH_NUM];
+	s8 path_readback[MT7915_SKU_PATH_NUM];
+};
+
+static int
+mt7915_sku_table_append(s8 *table, size_t table_len, size_t *offset,
+			const void *data, size_t data_len)
+{
+	if (*offset > table_len || data_len > table_len - *offset)
+		return -EOVERFLOW;
+
+	memcpy(table + *offset, data, data_len);
+	*offset += data_len;
+
+	return 0;
+}
+
+static int
+mt7915_sku_table_append_zero(s8 *table, size_t table_len, size_t *offset,
+			     size_t data_len)
+{
+	if (*offset > table_len || data_len > table_len - *offset)
+		return -EOVERFLOW;
+
+	memset(table + *offset, 0, data_len);
+	*offset += data_len;
+
+	return 0;
+}
+
+static int
+mt7915_serialize_rate_sku(const struct mt76_power_limits *la, s8 *table,
+			  size_t table_len)
+{
+	const u8 *len = mt7915_sku_group_len;
+	size_t offset = 0;
+	int i, ret;
+
+	if (table_len != MT7915_SKU_RATE_NUM)
+		return -EINVAL;
+
+	ret = mt7915_sku_table_append(table, table_len, &offset, &la->cck,
+				     len[SKU_CCK] + len[SKU_OFDM]);
+	if (ret)
+		return ret;
+
+	ret = mt7915_sku_table_append(table, table_len, &offset, &la->mcs[0],
+				     len[SKU_HT_BW20]);
+	if (ret)
+		return ret;
+
+	ret = mt7915_sku_table_append(table, table_len, &offset, &la->mcs[1],
+				     len[SKU_HT_BW40]);
+	if (ret)
+		return ret;
+
+	for (i = 0; i < 4; i++) {
+		ret = mt7915_sku_table_append(table, table_len, &offset,
+					     &la->mcs[i],
+					     sizeof(la->mcs[i]));
+		if (ret)
+			return ret;
+
+		ret = mt7915_sku_table_append_zero(table, table_len, &offset, 2);
+		if (ret)
+			return ret;
+	}
+
+	ret = mt7915_sku_table_append(table, table_len, &offset, &la->ru[0],
+				     sizeof(la->ru));
+	if (ret)
+		return ret;
+
+	return offset == table_len ? 0 : -EINVAL;
+}
+
+static int
+mt7915_serialize_path_sku(const struct mt76_power_limits *la, s8 *table,
+			  size_t table_len)
+{
+	size_t offset = 0;
+	int i, ret;
+
+	if (table_len != MT7915_SKU_PATH_NUM)
+		return -EINVAL;
+
+	ret = mt7915_sku_table_append(table, table_len, &offset, &la->path.cck,
+				     sizeof(la->path.cck));
+	if (ret)
+		return ret;
+
+	ret = mt7915_sku_table_append(table, table_len, &offset,
+				     &la->path.ofdm, sizeof(la->path.ofdm));
+	if (ret)
+		return ret;
+
+	ret = mt7915_sku_table_append(table, table_len, &offset,
+				     &la->path.ofdm_bf[1],
+				     sizeof(la->path.ofdm_bf) - 1);
+	if (ret)
+		return ret;
+
+	ret = mt7915_sku_table_append(table, table_len, &offset,
+				     &la->path.ru[3],
+				     sizeof(la->path.ru[3]));
+	if (ret)
+		return ret;
+
+	ret = mt7915_sku_table_append(table, table_len, &offset,
+				     &la->path.ru_bf[3][1],
+				     sizeof(la->path.ru_bf[3]) - 1);
+	if (ret)
+		return ret;
+
+	ret = mt7915_sku_table_append(table, table_len, &offset,
+				     &la->path.ru[4],
+				     sizeof(la->path.ru[4]));
+	if (ret)
+		return ret;
+
+	ret = mt7915_sku_table_append(table, table_len, &offset,
+				     &la->path.ru_bf[4][1],
+				     sizeof(la->path.ru_bf[4]) - 1);
+	if (ret)
+		return ret;
+
+	for (i = 0; i < 8; i++) {
+		bool bf = i % 2;
+		u8 idx = (i + 6) / 2;
+		const s8 *buf = bf ? la->path.ru_bf[idx] : la->path.ru[idx];
+
+		ret = mt7915_sku_table_append(table, table_len, &offset,
+					     bf ? buf + 1 : buf,
+					     bf ? 9 : 10);
+		if (ret)
+			return ret;
+	}
+
+	for (i = 0; i < 6; i++) {
+		bool bf = i % 2;
+		u8 idx = i / 2;
+		const s8 *buf = bf ? la->path.ru_bf[idx] : la->path.ru[idx];
+
+		ret = mt7915_sku_table_append(table, table_len, &offset,
+					     buf, 10);
+		if (ret)
+			return ret;
+	}
+
+	return offset == table_len ? 0 : -EINVAL;
+}
+
+#define MT7915_CR6608_READBACK_ATTEMPTS	6
+
+static int
+mt7915_cr6608_validate_sku_readback(const s8 *actual, const s8 *cap,
+				    size_t table_len, int required_peak,
+				    int *observed_peak, int *first_violation)
+{
+	int peak = S8_MIN;
+	int violation = -1;
+	size_t i;
+
+	for (i = 0; i < table_len; i++) {
+		peak = max_t(int, peak, actual[i]);
+		if (violation < 0 && actual[i] > cap[i])
+			violation = i;
+	}
+
+	if (observed_peak)
+		*observed_peak = peak;
+	if (first_violation)
+		*first_violation = violation;
+	if (violation >= 0)
+		return -ERANGE;
+	if (required_peak >= 0 && peak != required_peak)
+		return -EREMOTEIO;
+
+	return 0;
+}
+
+static int
+mt7915_cr6608_poll_sku_readback(struct mt7915_phy *phy, u8 category,
+				const s8 *cap, s8 *actual,
+				size_t table_len, int required_peak,
+				int *observed_peak, int *attempts,
+				int *first_violation)
+{
+	int attempt, ret = -ETIMEDOUT;
+
+	for (attempt = 1; attempt <= MT7915_CR6608_READBACK_ATTEMPTS;
+	     attempt++) {
+		ret = mt7915_mcu_get_txpower_sku(phy, actual, table_len,
+						  category);
+		if (!ret)
+			ret = mt7915_cr6608_validate_sku_readback(
+				actual, cap, table_len, required_peak,
+				observed_peak, first_violation);
+		if (!ret)
+			break;
+		if (attempt < MT7915_CR6608_READBACK_ATTEMPTS)
+			usleep_range(10000, 20000);
+	}
+
+	if (attempts)
+		*attempts = min(attempt, MT7915_CR6608_READBACK_ATTEMPTS);
+
+	return ret;
+}
+
+static void
+mt7915_sku_table_merge_conservative(s8 *rollback, const s8 *target,
+				    size_t table_len)
+{
+	size_t i;
+
+	for (i = 0; i < table_len; i++)
+		rollback[i] = min(rollback[i], target[i]);
+}
+
+static int mt7915_cr6608_pause_tx(struct mt7915_phy *phy,
+				  bool tx_already_paused,
+				  bool *pause_owned)
+{
+	struct mt76_phy *mphy = phy->mt76;
+	struct mt76_dev *mdev = mphy->dev;
+	unsigned long flags;
+	bool recovery_pending;
+
+	lockdep_assert_held(&mdev->mutex);
+	*pause_owned = false;
+	spin_lock_irqsave(&phy->dev->recovery_tx_lock, flags);
+	recovery_pending =
+		test_bit(MT76_MCU_RESET, &phy->dev->mphy.state) ||
+		phy->dev->recovery.restart ||
+		phy->dev->recovery.generation !=
+		phy->dev->recovery.completed_generation;
+	if (recovery_pending ||
+	    (tx_already_paused && !test_bit(MT76_RESET, &mphy->state)) ||
+	    (!tx_already_paused &&
+	     test_and_set_bit(MT76_RESET, &mphy->state))) {
+		spin_unlock_irqrestore(&phy->dev->recovery_tx_lock, flags);
+		return -EBUSY;
+	}
+	if (tx_already_paused) {
+		spin_unlock_irqrestore(&phy->dev->recovery_tx_lock, flags);
+		return 0;
+	}
+	*pause_owned = true;
+
+	ieee80211_stop_queues(mphy->hw);
+	spin_unlock_irqrestore(&phy->dev->recovery_tx_lock, flags);
+	mt76_worker_disable(&mdev->tx_worker);
+
+	if (!wait_event_timeout(mdev->tx_wait, !mt76_has_tx_pending(mphy),
+				HZ / 5)) {
+		dev_err(phy->dev->mt76.dev,
+			"CR6608-RF timed out while draining TX before SKU update\n");
+		return -ETIMEDOUT;
+	}
+
+	spin_lock_irqsave(&phy->dev->recovery_tx_lock, flags);
+	recovery_pending =
+		test_bit(MT76_MCU_RESET, &phy->dev->mphy.state) ||
+		phy->dev->recovery.restart ||
+		phy->dev->recovery.generation !=
+		phy->dev->recovery.completed_generation;
+	spin_unlock_irqrestore(&phy->dev->recovery_tx_lock, flags);
+	if (recovery_pending)
+		return -EBUSY;
+
+	return 0;
+}
+
+static bool mt7915_cr6608_resume_tx(struct mt7915_phy *phy)
+{
+	struct mt76_phy *mphy = phy->mt76;
+	struct mt76_dev *mdev = mphy->dev;
+	unsigned long flags;
+	bool recovery_pending;
+
+	/* Keep MT76_RESET asserted while unparking the worker.  A recovery
+	 * producer can then claim RESET at any point without a later worker
+	 * enable escaping its stop.  The final clear/wake is the atomic commit.
+	 */
+	mt76_worker_enable(&mdev->tx_worker);
+	mt76_worker_schedule(&mdev->tx_worker);
+
+	spin_lock_irqsave(&phy->dev->recovery_tx_lock, flags);
+	recovery_pending =
+		test_bit(MT76_MCU_RESET, &phy->dev->mphy.state) ||
+		phy->dev->recovery.restart ||
+		phy->dev->recovery.generation !=
+		phy->dev->recovery.completed_generation;
+	if (recovery_pending) {
+		spin_unlock_irqrestore(&phy->dev->recovery_tx_lock, flags);
+		return false;
+	}
+	clear_bit(MT76_RESET, &mphy->state);
+	ieee80211_wake_queues(mphy->hw);
+	spin_unlock_irqrestore(&phy->dev->recovery_tx_lock, flags);
+
+	return true;
+}
+
+int mt7915_mcu_txpower_pause(struct mt7915_phy *phy, bool *pause_owned)
+{
+	return mt7915_cr6608_pause_tx(phy, false, pause_owned);
+}
+
+bool mt7915_mcu_txpower_resume(struct mt7915_phy *phy)
+{
+	return mt7915_cr6608_resume_tx(phy);
+}
