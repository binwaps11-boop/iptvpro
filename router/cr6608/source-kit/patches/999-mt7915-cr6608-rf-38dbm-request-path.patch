+		int ret;
+		bool safe_cap_applied = false;
+
+		ret = mt7915_cr6608_mcu_set_txpower_sku(
+			phy, requested_power, hw->conf.power_level,
+			!force_lowering && channel_ready &&
+			(!failure_latched || requested_power < 38),
+			tx_already_paused,
+			&safe_cap_applied);
+		/* Off-channel scans must replace a previously verified high table
+		 * with an MCU-read-back safe table for the active channel, but that
+		 * expected lowering is transient and must not permanently latch the
+		 * experiment.  A previously latched band may likewise complete a
+		 * channel transition after a verified lowering without being raised.
+		 */
+		if (ret == -ERANGE && safe_cap_applied &&
+		    (force_lowering || requested_power == 0 || !channel_ready ||
+		     (channel_changed && failure_latched && !sar_update))) {
+			dev_info_ratelimited(phy->dev->mt76.dev,
+				"CR6608-RF verified lowering-only SKU refresh for band=%u channel_ready=%d failure_latched=%d\n",
+				phy->mt76->band_idx, channel_ready,
+				failure_latched);
+			return 0;
+		}
+		if (ret)
+			dev_err_ratelimited(phy->dev->mt76.dev,
+				"CR6608-RF %d dBm request failed verified MCU transaction (%d); refusing to hide the failure behind a default-path success\n",
+				requested_power, ret);
+		cr6608_rf_failure_latched[phy->mt76->band_idx] =
+			failure_latched || !!ret;
+		return ret;
+	}
+}
+
+int mt7915_mcu_set_sar_power_sku(struct mt7915_phy *phy,
+				 const struct cfg80211_sar_specs *sar)
+{
+	struct ieee80211_hw *hw = phy->mt76->hw;
+	bool experiment_active;
+	bool pause_owned = false;
+	int ret;
+
+	lockdep_assert_held(&phy->dev->mt76.mutex);
+	experiment_active = mt7915_cr6608_rf_request_enabled(phy->dev) &&
+			    hw->conf.power_level >= 0 &&
+			    hw->conf.power_level <= 38;
+	if (!experiment_active) {
+		ret = mt76_init_sar_power(hw, sar);
+		if (ret)
+			return ret;
+
+		return mt7915_mcu_set_txpower_sku(phy, false, true, false,
+						 false);
+	}
+
+	/* Quiesce TX before publishing stricter SAR state.  Otherwise the old
+	 * verified 38 dBm MCU table could remain active for a short interval
+	 * between the software SAR update and the lowering transaction.
+	 */
+	ret = mt7915_cr6608_pause_tx(phy, false, &pause_owned);
+	if (ret)
+		goto out;
+
+	ret = mt76_init_sar_power(hw, sar);
+	if (ret)
+		goto out;
+
+	ret = mt7915_mcu_set_txpower_sku(phy, false, true, true, false);
+out:
+	if (pause_owned && !mt7915_cr6608_resume_tx(phy) && !ret)
+		ret = -EBUSY;
+
+	return ret;
+}
