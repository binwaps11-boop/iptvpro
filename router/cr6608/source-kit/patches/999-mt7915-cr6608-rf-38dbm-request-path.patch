+static unsigned int
+mt7915_cr6608_rf_record_start(struct mt7915_phy *phy, int requested_dbm,
+			      int kernel_dbm, int regulatory_dbm,
+			      int path_delta_half_dbm,
+			      int sar_bounded_per_path_half_dbm,
+			      int rate_limited_per_path_half_dbm,
+			      int eeprom_target_per_path_half_dbm,
+			      bool override_active)
+{
+	struct mt7915_cr6608_rf_band_state *state;
+	struct ieee80211_channel *chan = phy->mt76->chandef.chan;
+	unsigned long flags;
+	unsigned int generation;
+	u8 band = phy->mt76->band_idx;
+
+	if (!mt7915_cr6608_rf_request_enabled(phy->dev) ||
+	    band >= ARRAY_SIZE(cr6608_rf_bands))
+		return 0;
+
+	state = &cr6608_rf_bands[band];
+	spin_lock_irqsave(&cr6608_rf_telemetry_lock, flags);
+	state->generation++;
+	if (!(state->generation & 1))
+		state->generation++;
+	smp_wmb();
+	state->requested_dbm = requested_dbm;
+	state->kernel_dbm = kernel_dbm;
+	state->regulatory_dbm = regulatory_dbm;
+	state->frequency_mhz = chan ? chan->center_freq : -1;
+	state->channel = chan ? chan->hw_value : -1;
+	state->path_delta_half_dbm = path_delta_half_dbm;
+	state->sar_bounded_per_path_half_dbm =
+		sar_bounded_per_path_half_dbm;
+	state->rate_limited_per_path_half_dbm =
+		rate_limited_per_path_half_dbm;
+	state->eeprom_target_per_path_half_dbm =
+		eeprom_target_per_path_half_dbm;
+	state->sku_applied_per_path_half_dbm = -1;
+	state->override_active = override_active;
+	state->mcu_generation = -1;
+	state->channel_ready = mt7915_cr6608_channel_ready(phy->mt76);
+	state->mcu_result = -EINPROGRESS;
+	smp_wmb();
+	state->generation++;
+	generation = state->generation;
+	spin_unlock_irqrestore(&cr6608_rf_telemetry_lock, flags);
+
+	dev_info_ratelimited(phy->dev->mt76.dev,
+			     "CR6608-RF MCU/SKU path band=%u generation=%u request=%d dBm kernel=%d dBm regulatory=%d dBm frequency=%d MHz channel=%d path_delta=%d half-dBm sar=%d half-dBm rate=%d half-dBm eeprom_observed=%d half-dBm override=%d\n",
+			     band, generation, requested_dbm, kernel_dbm,
+			     regulatory_dbm, chan ? chan->center_freq : -1,
+			     chan ? chan->hw_value : -1, path_delta_half_dbm,
+			     sar_bounded_per_path_half_dbm,
+			     rate_limited_per_path_half_dbm,
+			     eeprom_target_per_path_half_dbm,
+			     override_active);
+
+	return generation;
+}
+
+static void
+mt7915_cr6608_rf_record_mcu_result(struct mt7915_phy *phy,
+				   unsigned int generation, int result,
+				   int sku_applied_per_path_half_dbm)
+{
+	struct mt7915_cr6608_rf_band_state *state;
+	unsigned long flags;
+	bool recorded = false;
+	u8 band = phy->mt76->band_idx;
+
+	if (!generation || band >= ARRAY_SIZE(cr6608_rf_bands))
+		return;
+
+	state = &cr6608_rf_bands[band];
+	spin_lock_irqsave(&cr6608_rf_telemetry_lock, flags);
+	if (state->generation == generation && !(generation & 1)) {
+		state->generation++;
+		smp_wmb();
+		state->sku_applied_per_path_half_dbm =
+			result ? -1 : sku_applied_per_path_half_dbm;
+		state->mcu_result = result;
+		state->mcu_generation = generation + 2;
+		smp_wmb();
+		state->generation++;
+		generation = state->generation;
+		recorded = true;
+	}
+	spin_unlock_irqrestore(&cr6608_rf_telemetry_lock, flags);
+
+	if (recorded)
+		dev_info_ratelimited(phy->dev->mt76.dev,
+				     "CR6608-RF MCU/SKU result band=%u generation=%u result=%d\n",
+				     band, generation, result);
+}
