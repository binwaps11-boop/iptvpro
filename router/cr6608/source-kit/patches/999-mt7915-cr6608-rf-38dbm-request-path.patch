 		       bool offchannel)
 {
@@ -1059,7 +1088,12 @@ int __mt76_set_channel(struct mt76_phy *phy, struct cfg80211_chan_def *chandef,
 
 	ret = dev->drv->set_channel(phy);
 
-	clear_bit(MT76_RESET, &phy->state);
+	/* A driver that escalated a channel/SKU failure to MCU recovery owns
+	 * the paused state.  Do not undo that fail-closed hand-off here.
+	 */
+	if (!mt76_channel_reset_commit(dev, phy))
+		return ret ? ret : -EBUSY;
+
 	mt76_worker_enable(&dev->tx_worker);
 	mt76_worker_schedule(&dev->tx_worker);
 
