+static int
+mt7915_cr6608_rf_rollback_sku(struct mt7915_phy *phy,
+			      const s8 *rate_table, bool have_rate,
+			      const s8 *path_table, bool have_path)
+{
+	s8 verify_rate[MT7915_SKU_RATE_NUM];
+	s8 verify_path[MT7915_SKU_PATH_NUM];
+	int rate_peak = -1, path_peak = -1;
+	int rate_attempts = 0, path_attempts = 0;
+	int rate_violation = -1, path_violation = -1;
+	int rate_ret = 0, path_ret = 0;
+
+	if (have_path) {
+		path_ret = mt7915_mcu_send_txpower_sku_table(
+			phy, TX_POWER_LIMIT_TABLE_PATH, path_table,
+			sizeof(verify_path));
+		if (!path_ret)
+			path_ret = mt7915_cr6608_poll_sku_readback(
+				phy, TX_POWER_INFO_PATH, path_table,
+				verify_path, sizeof(verify_path), -1,
+				&path_peak, &path_attempts, &path_violation);
+	}
+
+	if (have_rate) {
+		rate_ret = mt7915_mcu_send_txpower_sku_table(
+			phy, TX_POWER_LIMIT_TABLE_RATE, rate_table,
+			sizeof(verify_rate));
+		if (!rate_ret)
+			rate_ret = mt7915_cr6608_poll_sku_readback(
+				phy, TX_POWER_INFO_RATE, rate_table,
+				verify_rate, sizeof(verify_rate), -1,
+				&rate_peak, &rate_attempts, &rate_violation);
+	}
+
+	if (rate_ret || path_ret)
+		dev_err(phy->dev->mt76.dev,
+			"CR6608-RF SKU rollback verification failed: rate=%d rate_peak=%d rate_attempts=%d rate_violation=%d path=%d path_peak=%d path_attempts=%d path_violation=%d; forcing radio recovery\n",
+			rate_ret, rate_peak, rate_attempts, rate_violation,
+			path_ret, path_peak, path_attempts, path_violation);
+	else
+		dev_warn_ratelimited(phy->dev->mt76.dev,
+				     "CR6608-RF SKU transaction rolled back to conservative firmware caps (rate_peak=%d attempts=%d path=%s)\n",
+				     rate_peak, rate_attempts,
+				     have_path ? "verified" : "disabled");
+
+	return rate_ret ? rate_ret : path_ret;
+}
+
+static int
+mt7915_cr6608_mcu_set_txpower_sku(struct mt7915_phy *phy,
+				  int requested_power, int kernel_power,
+				  bool allow_raise,
+				  bool tx_already_paused,
+				  bool *safe_cap_applied)
+{
+	struct mt7915_dev *dev = phy->dev;
+	struct mt76_phy *mphy = phy->mt76;
+	struct ieee80211_channel *chan = mphy->chandef.chan;
+	struct mt7915_cr6608_sku_transaction *transaction;
+	int accepted_txpower_cur, readback_peak = -1;
+	int required_rate_peak, rate_attempts = 0, rate_violation = -1;
+	int path_peak = -1, path_attempts = 0, path_violation = -1;
+	int bounded_power, ret, tx_power, sar_power, e2p_power_limit;
+	int previous_txpower_cur = mphy->txpower_cur;
+	int regulatory_power = chan ? chan->max_reg_power : -1;
+	int path_delta = mt76_tx_power_path_delta(hweight16(mphy->chainmask));
+	unsigned int telemetry_generation;
+	bool runtime_override;
+	bool have_previous_rate = false;
+	bool have_previous_path = false;
+	bool sku_write_attempted = false;
+	bool pause_owned = false;
+	bool tx_resume_safe = true;
+	bool high_power_preflight_ok;
+
+	lockdep_assert_held(&dev->mt76.mutex);
+	if (safe_cap_applied)
+		*safe_cap_applied = false;
+	transaction = kzalloc(sizeof(*transaction), GFP_KERNEL);
+	if (!transaction) {
+		bool emergency_pause_owned = false;
+
+		mt7915_cr6608_pause_tx(phy, tx_already_paused,
+				       &emergency_pause_owned);
+		mt7915_cr6608_schedule_recovery(phy);
+		return -ENOMEM;
+	}
+
+	bounded_power = chan ? min(kernel_power, chan->max_power) : kernel_power;
+	/* The 38 dBm lab gate intentionally raises chan->max_power on the main
+	 * channel.  A lowering-only/off-channel refresh must instead retain the
+	 * kernel regulatory ceiling for the active scan channel.
+	 */
+	if (chan && !allow_raise)
+		bounded_power = min(bounded_power, chan->max_reg_power);
+	tx_power = mt76_get_power_bound(mphy, bounded_power);
+	sar_power = tx_power;
+	runtime_override = allow_raise &&
+			   requested_power >= 1 && requested_power <= 38 &&
+			   kernel_power == requested_power &&
+			   chan && chan->max_power >= requested_power &&
+			   mt7915_cr6608_channel_ready(mphy) &&
+			   sar_power + path_delta >= requested_power * 2;
+	if (phy->sku_limit_en) {
+		tx_power = mt76_get_rate_power_limits(mphy, mphy->chandef.chan,
+						      &transaction->limits,
+						      tx_power);
+		runtime_override = runtime_override &&
+				   tx_power + path_delta >= requested_power * 2;
+	} else {
+		accepted_txpower_cur =
+			mt7915_cr6608_calculate_txpower_cur(
+				phy, tx_power, false, &e2p_power_limit);
+		telemetry_generation =
+			mt7915_cr6608_rf_record_start(phy, requested_power,
+						     kernel_power,
+						     regulatory_power,
+						     path_delta, sar_power,
+						     tx_power,
+						     e2p_power_limit,
+						     runtime_override);
+		/*
+		 * The CR6608 test path is valid only when the firmware SKU
+		 * transaction can be read back and validated.  Do not publish a
+		 * software-only accepted value when SKU enforcement is absent.
+		 */
+		ret = -EOPNOTSUPP;
+		mt7915_cr6608_rf_record_mcu_result(phy, telemetry_generation,
+					  ret, -1);
+		mt7915_cr6608_schedule_recovery(phy);
+		kfree(transaction);
+		return ret;
+	}
+
+	accepted_txpower_cur = mt7915_cr6608_calculate_txpower_cur(
+		phy, tx_power, runtime_override, &e2p_power_limit);
+	required_rate_peak = requested_power * 2 - path_delta;
+	telemetry_generation =
+		mt7915_cr6608_rf_record_start(phy, requested_power,
+					     kernel_power, regulatory_power,
+					     path_delta, sar_power, tx_power,
+					     e2p_power_limit,
+					     runtime_override);
+	high_power_preflight_ok = runtime_override &&
+				  accepted_txpower_cur == required_rate_peak;
+
+	ret = mt7915_cr6608_pause_tx(phy, tx_already_paused, &pause_owned);
+	if (ret) {
+		if (pause_owned || tx_already_paused) {
+			tx_resume_safe = false;
+			mt7915_cr6608_schedule_recovery(phy);
+		}
+		goto out;
+	}
+
+	ret = mt7915_serialize_rate_sku(&transaction->limits,
+					transaction->rate_table,
+					sizeof(transaction->rate_table));
+	if (ret)
+		goto recovery_without_snapshot;
+
+	if (phy->sku_path_en) {
+		ret = mt7915_serialize_path_sku(
+			&transaction->limits, transaction->path_table,
+			sizeof(transaction->path_table));
+		if (ret)
+			goto recovery_without_snapshot;
+	}
+
+	ret = mt7915_mcu_get_txpower_sku(
+		phy, transaction->previous_rate_table,
+		sizeof(transaction->previous_rate_table),
+		TX_POWER_INFO_RATE);
+	if (ret)
+		goto recovery_without_snapshot;
+	have_previous_rate = true;
+
+	if (phy->sku_path_en) {
+		ret = mt7915_mcu_get_txpower_sku(
+			phy, transaction->previous_path_table,
+			sizeof(transaction->previous_path_table),
+			TX_POWER_INFO_PATH);
+		if (ret)
+			goto recovery_without_snapshot;
+		have_previous_path = true;
+	}
+
+	/* A safety refresh after a latched failure is lowering-only.  Likewise,
+	 * a rejected high-power preflight must never raise an SKU entry.
+	 */
+	if (!high_power_preflight_ok) {
+		mt7915_sku_table_merge_conservative(
+			transaction->rate_table,
+			transaction->previous_rate_table,
+			sizeof(transaction->rate_table));
+		if (phy->sku_path_en)
+			mt7915_sku_table_merge_conservative(
+				transaction->path_table,
+				transaction->previous_path_table,
+				sizeof(transaction->path_table));
+	}
+
+	/* A failed lower-power transition must never restore a higher table. */
+	mt7915_sku_table_merge_conservative(
+		transaction->previous_rate_table,
+		transaction->rate_table,
+		sizeof(transaction->previous_rate_table));
+	if (phy->sku_path_en)
+		mt7915_sku_table_merge_conservative(
+			transaction->previous_path_table,
+			transaction->path_table,
+			sizeof(transaction->previous_path_table));
+
+	sku_write_attempted = true;
+	ret = mt7915_mcu_send_txpower_sku_table(
+		phy, TX_POWER_LIMIT_TABLE_RATE, transaction->rate_table,
+		sizeof(transaction->rate_table));
+	if (ret)
+		goto rollback;
+
+	if (phy->sku_path_en) {
+		ret = mt7915_mcu_send_txpower_sku_table(
+			phy, TX_POWER_LIMIT_TABLE_PATH,
+			transaction->path_table,
+			sizeof(transaction->path_table));
+		if (ret)
+			goto rollback;
+	}
+
+	ret = mt7915_cr6608_poll_sku_readback(
+		phy, TX_POWER_INFO_RATE, transaction->rate_table,
+		transaction->rate_readback,
+		sizeof(transaction->rate_readback),
+		high_power_preflight_ok ? required_rate_peak : -1,
+		&readback_peak, &rate_attempts, &rate_violation);
+	if (ret) {
+		dev_err_ratelimited(dev->mt76.dev,
+			"CR6608-RF firmware rate-SKU verification failed: ret=%d peak=%d required=%d attempts=%d first_cap_violation=%d\n",
+			ret, readback_peak, required_rate_peak,
+			rate_attempts, rate_violation);
+		goto rollback;
+	}
+
+	if (phy->sku_path_en) {
+		ret = mt7915_cr6608_poll_sku_readback(
+			phy, TX_POWER_INFO_PATH, transaction->path_table,
+			transaction->path_readback,
+			sizeof(transaction->path_readback), -1,
+			&path_peak, &path_attempts, &path_violation);
+		if (ret) {
+			dev_err_ratelimited(dev->mt76.dev,
+				"CR6608-RF firmware path-SKU cap verification failed: ret=%d peak=%d attempts=%d first_cap_violation=%d\n",
+				ret, path_peak, path_attempts, path_violation);
+			goto rollback;
+		}
+	}
+
+	if (!high_power_preflight_ok) {
+		/*
+		 * A previous verified high table may still be active when SAR,
+		 * regulatory or per-rate constraints become stricter.  The table
+		 * sent above contains those current safe caps.  Verify the lowering
+		 * before rejecting the requested value so the old table can
+		 * never remain effective merely because preflight stopped passing.
+		 */
+		mphy->txpower_cur = readback_peak;
+		if (safe_cap_applied)
+			*safe_cap_applied = true;
+		ret = -ERANGE;
+		dev_warn_ratelimited(dev->mt76.dev,
+			"CR6608-RF %d dBm preflight rejected after verified safe-cap update: override=%d applied_peak=%d half-dBm requested_peak=%d\n",
+			requested_power, runtime_override, readback_peak,
+			required_rate_peak);
+		goto out;
+	}
+
+	dev_info_ratelimited(dev->mt76.dev,
+			     "CR6608-RF %d dBm rate-SKU MCU witness verified: band=%u rate_peak=%d half-dBm required=%d attempts=%d path=%s\n",
+			     requested_power, mphy->band_idx, readback_peak,
+			     required_rate_peak, rate_attempts,
+			     phy->sku_path_en ? "cap-verified" : "disabled-not-verified");
+
+	mphy->txpower_cur = accepted_txpower_cur;
+
+	ret = 0;
+	goto out;
+
+rollback:
+	mphy->txpower_cur = min(previous_txpower_cur, accepted_txpower_cur);
+	readback_peak = -1;
+	if (sku_write_attempted) {
+		int rollback_ret;
+
+		rollback_ret = mt7915_cr6608_rf_rollback_sku(
+			phy, transaction->previous_rate_table,
+			have_previous_rate,
+			transaction->previous_path_table,
+			have_previous_path);
+		if (rollback_ret) {
+			tx_resume_safe = false;
+			ret = rollback_ret;
+			dev_err(dev->mt76.dev,
+				"CR6608-RF TX remains paused because SKU rollback could not be verified; scheduling firmware recovery\n");
+			mt7915_cr6608_schedule_recovery(phy);
+		} else if (!high_power_preflight_ok && safe_cap_applied) {
+			/* previous_* was conservatively merged with the lowering
+			 * target before rollback, so a verified rollback is also a
+			 * verified safe-cap transition.
+			 */
+			*safe_cap_applied = true;
+		}
+	}
+	goto out;
+
+recovery_without_snapshot:
+	/* Without a complete snapshot there is no trustworthy rollback source.
+	 * TX is already paused; keep it paused and force firmware recovery rather
+	 * than risk resuming with an older 70-half-dBm table.
+	 */
+	tx_resume_safe = false;
+	dev_err(dev->mt76.dev,
+		"CR6608-RF could not establish a complete SKU snapshot (%d); TX stays paused and firmware recovery is scheduled\n",
+		ret);
+	mt7915_cr6608_schedule_recovery(phy);
+out:
+	if (pause_owned && tx_resume_safe &&
+	    !mt7915_cr6608_resume_tx(phy) && !ret)
+		ret = -EBUSY;
+	mt7915_cr6608_rf_record_mcu_result(phy, telemetry_generation, ret,
+					  readback_peak);
+	kfree(transaction);
+
+	return ret;
+}
+
+int mt7915_mcu_set_txpower_sku(struct mt7915_phy *phy,
+			       bool channel_changed, bool sar_update,
+			       bool tx_already_paused, bool force_lowering)
+{
+	struct ieee80211_hw *hw = phy->mt76->hw;
+	int requested_power = hw->conf.power_level;
+	bool gate_enabled = mt7915_cr6608_rf_request_enabled(phy->dev);
+	bool channel_ready;
+	bool failure_latched;
+
+	if (!gate_enabled) {
+		if (mt7915_is_cr6608(phy->dev) && requested_power == 38) {
+			dev_warn_ratelimited(phy->dev->mt76.dev,
+				"CR6608-RF 38 dBm request rejected: CR6608 DTS property and cr6608_rf_38dbm=1 are both required\n");
+			if (tx_already_paused)
+				mt7915_mcu_schedule_full_recovery(phy->dev);
+			return -EPERM;
+		}
+
+		return mt7915_mcu_set_txpower_sku_default(phy);
+	}
+
+	/* The companion path supplies audited volatile 38 dBm Factory targets, so
+	 * every valid 0..38 request must use the paused/read-back transaction.
+	 * This proves 30 dBm as an exact 54-half-dBm rate peak (with two paths)
+	 * and prevents a failed default write from leaving a higher table active.
+	 */
+	if (phy->mt76->band_idx >= ARRAY_SIZE(cr6608_rf_failure_latched))
+		return -EINVAL;
+	failure_latched = cr6608_rf_failure_latched[phy->mt76->band_idx];
+	if (requested_power < 0 || requested_power > 38)
+		return requested_power > 38 ? -ERANGE : mt7915_mcu_set_txpower_sku_default(phy);
+	if (hweight16(phy->mt76->chainmask) != 2) {
+		bool pause_owned = false;
+		int pause_ret;
+
+		dev_err_ratelimited(phy->dev->mt76.dev,
+			"CR6608-RF requires exactly two active TX chains for exact 30/38 dBm accounting; keeping TX paused and forcing recovery\n");
+		pause_ret = mt7915_cr6608_pause_tx(phy, tx_already_paused,
+						 &pause_owned);
+		mt7915_cr6608_schedule_recovery(phy);
+		cr6608_rf_failure_latched[phy->mt76->band_idx] = true;
+		return pause_ret ? pause_ret : -EOPNOTSUPP;
+	}
+
+	channel_ready = mt7915_cr6608_channel_ready(phy->mt76);
+	if (requested_power == 38 && failure_latched &&
+	    !channel_changed && !sar_update &&
+	    channel_ready) {
+		dev_err_ratelimited(phy->dev->mt76.dev,
+			"CR6608-RF band=%u 38 dBm transaction is failure-latched until module reload/reboot\n",
+			phy->mt76->band_idx);
+		return -EREMOTEIO;
+	}
+	if (!mt7915_cr6608_active_channel_valid(phy->mt76)) {
+		bool pause_owned = false;
+		int pause_ret;
+
+		dev_err_ratelimited(phy->dev->mt76.dev,
+			"CR6608-RF has no valid active channel for a safe SKU refresh; keeping TX paused and forcing recovery\n");
+		pause_ret = mt7915_cr6608_pause_tx(phy, tx_already_paused,
+						 &pause_owned);
+		mt7915_cr6608_schedule_recovery(phy);
+		cr6608_rf_failure_latched[phy->mt76->band_idx] = true;
+		return pause_ret ? pause_ret : -EINVAL;
+	}
+
