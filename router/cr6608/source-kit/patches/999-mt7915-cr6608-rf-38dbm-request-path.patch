+static void mt7915_quiesce_recovery(struct mt7915_dev *dev)
+{
+	unsigned long flags;
+
+	/* Block every producer before draining dump_work: dump_work itself queues
+	 * reset_work at completion, so reset_work must be cancelled second.
+	 */
+	spin_lock_irqsave(&dev->recovery_tx_lock, flags);
+	dev->recovery.hw_init_done = false;
+	spin_unlock_irqrestore(&dev->recovery_tx_lock, flags);
+	cancel_work_sync(&dev->dump_work);
+	cancel_work_sync(&dev->reset_work);
+}
