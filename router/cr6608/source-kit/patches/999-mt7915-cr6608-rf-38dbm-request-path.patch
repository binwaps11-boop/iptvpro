+static bool mt7915_is_cr6608(struct mt7915_dev *dev)
+{
+	return dev &&
+	       is_mt7915(&dev->mt76) &&
+	       of_machine_is_compatible("xiaomi,mi-router-cr6608");
+}
+
+bool mt7915_cr6608_rf_request_armed(struct mt7915_dev *dev) {
+	return mt7915_is_cr6608(dev) &&
+		  device_property_read_bool(dev->mt76.dev,
+					    "mediatek,cr6608-lab-txpower-38dbm") &&
+		  cr6608_rf_38dbm;
+}
+bool mt7915_cr6608_rf_request_enabled(struct mt7915_dev *dev)
+{
+	bool enabled = mt7915_cr6608_rf_request_armed(dev);
+	mt7915_cr6608_factory38_raw_match(dev);
+	WRITE_ONCE(cr6608_rf_38dbm_active, enabled);
+	return enabled;
+}
+
+static bool mt7915_cr6608_channel_ready(struct mt76_phy *mphy)
+{
+	return !mphy->offchannel &&
+	       mphy->chandef.chan &&
+	       mphy->main_chandef.chan &&
+	       cfg80211_chandef_valid(&mphy->chandef) &&
+	       cfg80211_chandef_valid(&mphy->main_chandef) &&
+	       cfg80211_chandef_identical(&mphy->chandef,
+					 &mphy->main_chandef);
+}
+
+static bool mt7915_cr6608_active_channel_valid(struct mt76_phy *mphy)
+{
+	return mphy->chandef.chan &&
+	       cfg80211_chandef_valid(&mphy->chandef);
+}
