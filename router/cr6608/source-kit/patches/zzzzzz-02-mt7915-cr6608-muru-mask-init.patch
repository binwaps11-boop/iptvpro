diff --git a/mt7915/init.c b/mt7915/init.c
index c3e2b0c..ae0bdc8 100644
--- a/mt7915/init.c
+++ b/mt7915/init.c
@@ -15,7 +15,12 @@
 static bool cr6608_ul_muru;
 module_param(cr6608_ul_muru, bool, 0444);
 MODULE_PARM_DESC(cr6608_ul_muru,
-		 "Enable experimental CR6608 MT7915 UL MU-MIMO/OFDMA firmware scheduling");
+		 "Legacy CR6608 switch: enable both UL OFDMA and UL MU-MIMO");
+
+static unsigned char cr6608_muru_mask;
+module_param(cr6608_muru_mask, byte, 0444);
+MODULE_PARM_DESC(cr6608_muru_mask,
+		 "CR6608 MediaTek MURU bitmap: DL-OFDMA=1 UL-OFDMA=2 DL-MUMIMO=4 UL-MUMIMO=8");
 
 static const struct ieee80211_iface_limit if_limits[] = {
 	{
@@ -942,7 +947,7 @@ mt7915_set_stream_he_txbf_caps(struct mt7915_phy *phy,
 
 	c = IEEE80211_HE_PHY_CAP2_NDP_4x_LTF_AND_3_2US;
 	if (!is_mt7915(&dev->mt76) ||
-	    READ_ONCE(dev->cr6608_ul_muru))
+	    (mt7915_cr6608_muru_mask(dev) & CR6608_MURU_MUMIMO_UL))
 		c |= IEEE80211_HE_PHY_CAP2_UL_MU_FULL_MU_MIMO;
 	elem->phy_cap_info[2] |= c;
 
@@ -1243,22 +1248,36 @@ int mt7915_register_device(struct mt7915_dev *dev)
 	INIT_WORK(&dev->reset_work, mt7915_mac_reset_work);
 	INIT_WORK(&dev->dump_work, mt7915_mac_dump_work);
 	mutex_init(&dev->dump_mutex);
-	atomic_set(&dev->cr6608_ul_muru_sta_rec_updates, 0);
+	spin_lock_init(&dev->cr6608_muru_telemetry_lock);
+	atomic_set(&dev->cr6608_muru_mask, 0);
+	atomic_set(&dev->cr6608_muru_fault_latched, 0);
+	atomic_set(&dev->cr6608_muru_fault_latches, 0);
+	atomic_set(&dev->cr6608_ul_muru_sta_rec_attempted, 0);
+	atomic_set(&dev->cr6608_ul_muru_sta_rec_response_ok, 0);
+	atomic_set(&dev->cr6608_ul_muru_sta_rec_failed, 0);
+	atomic_set(&dev->cr6608_ul_muru_sta_rec_timeout, 0);
 	atomic_set(&dev->cr6608_ul_muru_he_sta_rec_updates, 0);
 	atomic_set(&dev->cr6608_ul_muru_mimo_capable_updates, 0);
 
 	dev->cr6608_ul_muru_allowed =
-		is_mt7915(&dev->mt76) && cr6608_ul_muru &&
+		is_mt7915(&dev->mt76) &&
+		(cr6608_muru_mask || cr6608_ul_muru) &&
+		!(cr6608_muru_mask & ~CR6608_MURU_MASK) &&
 		dev->mt76.dev->of_node &&
 		of_property_read_bool(dev->mt76.dev->of_node,
 				      "mediatek,cr6608-experimental-ul-muru");
-	dev->cr6608_ul_muru = dev->cr6608_ul_muru_allowed;
-	if (dev->cr6608_ul_muru)
+	if (dev->cr6608_ul_muru_allowed)
+		atomic_set(&dev->cr6608_muru_mask,
+			   cr6608_muru_mask ? cr6608_muru_mask :
+			   CR6608_MURU_MASK);
+	if (mt7915_cr6608_muru_mask(dev))
 		dev_warn(dev->mt76.dev,
-			 "CR6608 experimental UL MU-MIMO/OFDMA enabled: firmware MURU counters and hang guard are mandatory\n");
-	else if (cr6608_ul_muru && is_mt7915(&dev->mt76))
+			 "CR6608 MediaTek MURU candidate enabled with mask 0x%x: command-response telemetry (not apply/OTA proof) and fault latch are mandatory\n",
+			 mt7915_cr6608_muru_mask(dev));
+	else if ((cr6608_muru_mask || cr6608_ul_muru) &&
+		 is_mt7915(&dev->mt76))
 		dev_warn(dev->mt76.dev,
-			 "CR6608 experimental UL MU-MIMO/OFDMA request rejected by missing DTS gate\n");
+			 "CR6608 MURU request rejected by invalid mask or missing DTS gate\n");
 
 	dev->dbdc_support = mt7915_band_config(dev);
 
