#!/bin/sh
# Crash-log maintenance image: keep every radio disabled before netifd starts.

set -eu

BOARD_NAME='/tmp/sysinfo/board_name'
MAINTENANCE_MARKER='/etc/cr6608-crashlog-maintenance.marker'

board="$(cat "$BOARD_NAME" 2>/dev/null || true)"
[ "$board" = 'xiaomi,mi-router-cr6608' ] || exit 1
[ -f "$MAINTENANCE_MARKER" ] || exit 1

radios="$(uci -q show wireless | sed -n 's/^wireless\.\([^.=]*\)=wifi-device$/\1/p')"
[ -n "$radios" ] || exit 1

for radio in $radios; do
	uci -q set "wireless.${radio}.disabled=1"
done
uci commit wireless
wifi down 2>/dev/null || true
logger -t cr6608-crashlog 'maintenance image active; Wi-Fi forced disabled for the crash-log erase gate'

exit 0
