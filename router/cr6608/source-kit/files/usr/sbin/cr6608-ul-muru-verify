#!/bin/sh

legacy_module_param="${CR6608_UL_MURU_MODULE_PARAM:-/sys/module/mt7915e/parameters/cr6608_ul_muru}"
mask_module_param="${CR6608_MURU_MASK_MODULE_PARAM:-/sys/module/mt7915e/parameters/cr6608_muru_mask}"
advertise_module_param="${CR6608_UL_ADVERTISE_MODULE_PARAM:-/sys/module/mt7915e/parameters/cr6608_advertise_ul_mumimo}"
debug_root="${CR6608_UL_MURU_DEBUG_ROOT:-/sys/kernel/debug/ieee80211}"
guard_init="${CR6608_UL_MURU_GUARD_INIT:-/etc/init.d/cr6608-ul-muru-guard}"
guard_state_file="${CR6608_UL_MURU_GUARD_STATE_FILE:-/var/run/cr6608-private/ul-muru/state.json}"
guard_max_age="${CR6608_UL_MURU_GUARD_MAX_AGE:-60}"
module_file="${CR6608_UL_MURU_MODULE_FILE:-/etc/modules.d/mt7915e}"

if [ -n "${CR6608_UL_MURU_ARTIFACT_PROFILE:-}" ]; then
	artifact_profile="$CR6608_UL_MURU_ARTIFACT_PROFILE"
elif [ -f /rom/etc/cr6608-artifact-profile ] &&
     [ ! -L /rom/etc/cr6608-artifact-profile ]; then
	artifact_profile=/rom/etc/cr6608-artifact-profile
else
	artifact_profile=/etc/cr6608-artifact-profile
fi

profile_kind() {
	[ -f "$artifact_profile" ] && [ ! -L "$artifact_profile" ] &&
		[ "$(wc -l < "$artifact_profile" 2>/dev/null | tr -d '[:space:]')" = 3 ] || {
		printf 'unknown\n'
		return
	}
	if grep -Fqx 'profile=ul-muru-ram-v1' "$artifact_profile" &&
	   grep -Fqx 'sale_ready=NO' "$artifact_profile" &&
	   grep -Fqx 'radio_policy=ul-muru-ram-qualification' "$artifact_profile"; then
		printf 'ul-muru-ram-v1\n'
	elif grep -Fqx 'profile=ul-muru-forced-lab-v1' "$artifact_profile" &&
	     grep -Fqx 'sale_ready=NO' "$artifact_profile" &&
	     grep -Fqx 'radio_policy=ul-muru-persistent-mask15-38dbm-lab' "$artifact_profile"; then
		printf 'ul-muru-forced-lab-v1\n'
	elif grep -Fqx 'profile=lab-operator-v1' "$artifact_profile" &&
	     grep -Fqx 'sale_ready=NO' "$artifact_profile" &&
	     grep -Fqx 'radio_policy=lab-operator-38dbm-ul-muru' "$artifact_profile"; then
		printf 'lab-operator-v1\n'
	elif grep -Fqx 'profile=retail-v1' "$artifact_profile" &&
	     grep -Fqx 'sale_ready=NO' "$artifact_profile" &&
	     grep -Fqx 'radio_policy=retail-disabled' "$artifact_profile"; then
		printf 'retail-v1\n'
	else
		printf 'unknown\n'
	fi
}

module_token_value() {
	awk -v key="$1" '
		$1 == "mt7915e" {
			lines++
			for (i = 2; i <= NF; i++) {
				prefix = key "="
				if (index($i, prefix) == 1) {
					count++
					value = substr($i, length(prefix) + 1)
				}
			}
		}
		END {
			if (lines == 1 && count == 1) print value
			else exit 1
		}' "$module_file" 2>/dev/null
}

collect_state_contract() {
	local expected_mask="$1" allowed enabled bit node record
	local fault latches attempted response_ok failed timeout he_updates mimo_updates
	state_count=0
	state_ready=0
	fault_latched_max=0
	fault_latches_max=0
	sta_rec_attempted_max=0
	sta_rec_response_ok_max=0
	sta_rec_failed_max=0
	sta_rec_timeout_max=0
	[ "$expected_mask" = 15 ] && allowed=1 || allowed=0
	[ "$expected_mask" = 15 ] && enabled=1 || enabled=0
	[ "$expected_mask" = 15 ] && bit=1 || bit=0
	for node in "$debug_root"/phy*/mt76/cr6608_ul_muru_state; do
		[ -f "$node" ] || continue
		state_count=$((state_count + 1))
		record="$(awk -F= -v mask="$expected_mask" -v allowed="$allowed" \
			-v enabled="$enabled" -v bit="$bit" '
			NF >= 2 { key=$1; count[key]++; field[key]=substr($0, length(key)+2) }
			END {
				split("candidate_allowed candidate_ul_enabled candidate_mask candidate_dl_ofdma candidate_ul_ofdma candidate_dl_mumimo candidate_ul_mumimo fault_latched fault_latches policy sta_rec_attempted sta_rec_response_ok sta_rec_failed sta_rec_timeout he_sta_rec_updates mimo_capable_updates", required, " ")
				for (i in required) if (count[required[i]] != 1) exit 1
				if (field["candidate_allowed"] != allowed ||
				    field["candidate_ul_enabled"] != enabled ||
				    field["candidate_mask"] != mask ||
				    field["candidate_dl_ofdma"] != bit ||
				    field["candidate_ul_ofdma"] != bit ||
				    field["candidate_dl_mumimo"] != bit ||
				    field["candidate_ul_mumimo"] != bit ||
				    field["policy"] != "mediatek-25.12-mu-onoff-sta-rec-port") exit 1
				split("fault_latched fault_latches sta_rec_attempted sta_rec_response_ok sta_rec_failed sta_rec_timeout he_sta_rec_updates mimo_capable_updates", numeric, " ")
				for (i in numeric) if (field[numeric[i]] !~ /^[0-9]+$/) exit 1
				if (field["fault_latched"] != 0 || field["fault_latches"] != 0 ||
				    field["sta_rec_failed"] != 0 || field["sta_rec_timeout"] != 0 ||
				    field["sta_rec_response_ok"] > field["sta_rec_attempted"] ||
				    field["he_sta_rec_updates"] != field["sta_rec_response_ok"] ||
				    field["mimo_capable_updates"] > field["sta_rec_response_ok"]) exit 1
				if (mask == 0 && (field["sta_rec_attempted"] != 0 ||
				    field["sta_rec_response_ok"] != 0 || field["he_sta_rec_updates"] != 0 ||
				    field["mimo_capable_updates"] != 0)) exit 1
				printf "%s %s %s %s %s %s %s %s\n",
					field["fault_latched"], field["fault_latches"],
					field["sta_rec_attempted"], field["sta_rec_response_ok"],
					field["sta_rec_failed"], field["sta_rec_timeout"],
					field["he_sta_rec_updates"], field["mimo_capable_updates"]
			}' "$node" 2>/dev/null)" || continue
		set -- $record
		[ "$#" -eq 8 ] || continue
		fault=$1; latches=$2; attempted=$3; response_ok=$4
		failed=$5; timeout=$6; he_updates=$7; mimo_updates=$8
		state_ready=$((state_ready + 1))
		[ "$fault" -le "$fault_latched_max" ] || fault_latched_max="$fault"
		[ "$latches" -le "$fault_latches_max" ] || fault_latches_max="$latches"
		[ "$attempted" -le "$sta_rec_attempted_max" ] || sta_rec_attempted_max="$attempted"
		[ "$response_ok" -le "$sta_rec_response_ok_max" ] || sta_rec_response_ok_max="$response_ok"
		[ "$failed" -le "$sta_rec_failed_max" ] || sta_rec_failed_max="$failed"
		[ "$timeout" -le "$sta_rec_timeout_max" ] || sta_rec_timeout_max="$timeout"
	done
	[ "$state_count" -gt 0 ] && [ "$state_ready" -eq "$state_count" ]
}

guard_state="$(cat "$guard_state_file" 2>/dev/null || printf '{"state":"missing"}')"
guard_runtime_health() {
	guard_runtime_state="$(printf '%s\n' "$guard_state" |
		sed -n 's/.*"state":"\([^"]*\)".*/\1/p')"
	guard_heartbeat="$(printf '%s\n' "$guard_state" |
		sed -n 's/.*"time":\([0-9][0-9]*\).*/\1/p')"
	guard_now="$(date +%s 2>/dev/null || true)"
	[ -x "$guard_init" ] && "$guard_init" running >/dev/null 2>&1 || return 1
	case "$guard_heartbeat:$guard_now:$guard_max_age" in
		*[!0-9:]*|:*|*::*|*:) return 1 ;;
	esac
	[ "$guard_runtime_state" = armed ] || return 1
	guard_age=$((guard_now - guard_heartbeat))
	[ "$guard_age" -ge 0 ] && [ "$guard_age" -le "$guard_max_age" ]
}

profile="$(profile_kind)"
legacy_module_state="$(cat "$legacy_module_param" 2>/dev/null || printf missing)"
mask_module_state="$(cat "$mask_module_param" 2>/dev/null || printf missing)"
uci_legacy_state="$(uci -q get smartap.experimental.ul_muru 2>/dev/null || printf missing)"
uci_mask_state="$(uci -q get smartap.experimental.muru_mask 2>/dev/null || printf missing)"
persistent_legacy="$(module_token_value cr6608_ul_muru || printf inconsistent)"
persistent_mask="$(module_token_value cr6608_muru_mask || printf inconsistent)"
persistent_module_state=inconsistent
if [ "$persistent_legacy" = 0 ] && [ "$persistent_mask" = 0 ]; then
	persistent_module_state=disabled
elif [ "$persistent_legacy" = 0 ] && [ "$persistent_mask" = 15 ]; then
	persistent_module_state=mask-15
fi

guard_health=not-required-stable-disabled
if { [ "$profile" = ul-muru-ram-v1 ] || [ "$profile" = ul-muru-forced-lab-v1 ]; } && [ "$mask_module_state" = 15 ] &&
   [ "$uci_mask_state" = 15 ]; then
	if guard_runtime_health; then
		guard_health=armed-fresh
	else
		guard_health=missing-stopped-or-stale
	fi
fi

printf 'CR6608 MT7915 MURU verification\n'
printf '%-38s %s\n' 'artifact profile' "$profile"
printf '%-38s %s\n' 'legacy module request' "$legacy_module_state"
printf '%-38s %s\n' 'MURU bitmap module request' "$mask_module_state"
printf '%-38s %s\n' 'next-boot module policy' "$persistent_module_state"
printf '%-38s %s\n' 'legacy UCI request' "$uci_legacy_state"
printf '%-38s %s\n' 'MURU bitmap UCI request' "$uci_mask_state"
printf '%-38s %s\n' 'guard state' "$guard_state"
printf '%-38s %s\n' 'guard runtime health' "$guard_health"

legacy_module_off=0
case "$legacy_module_state" in N|0) legacy_module_off=1 ;; esac

if [ "$profile" = lab-operator-v1 ] || [ "$profile" = retail-v1 ]; then
	mask_count=0
	mask_zero=0
	legacy_count=0
	legacy_zero=0
	for node in "$debug_root"/phy*/mt76/cr6608_muru_mask; do
		[ -f "$node" ] || continue
		mask_count=$((mask_count + 1))
		[ "$(cat "$node" 2>/dev/null)" = 0 ] && mask_zero=$((mask_zero + 1))
	done
	for node in "$debug_root"/phy*/mt76/cr6608_ul_muru; do
		[ -f "$node" ] || continue
		legacy_count=$((legacy_count + 1))
		[ "$(cat "$node" 2>/dev/null)" = 0 ] && legacy_zero=$((legacy_zero + 1))
	done
	collect_state_contract 0 || true
	stable_cap_count="$(iw phy 2>/dev/null | grep -c 'Full Bandwidth UL MU-MIMO' || true)"
	printf '%-38s %s\n' 'driver bitmap masks disabled' "${mask_zero}/${mask_count}"
	printf '%-38s %s\n' 'legacy driver gates disabled' "${legacy_zero}/${legacy_count}"
	printf '%-38s %s\n' 'driver policies disabled' "${state_ready}/${state_count}"
	printf '%-38s %s\n' 'telemetry fault_latched/latches' "${fault_latched_max}/${fault_latches_max}"
	printf '%-38s %s\n' 'telemetry attempted/response_ok/failed/timeout' \
		"${sta_rec_attempted_max}/${sta_rec_response_ok_max}/${sta_rec_failed_max}/${sta_rec_timeout_max}"
	printf '%-38s %s\n' 'response_ok proof scope' 'command-response-only; not Firmware apply or OTA proof'
	printf '%-38s %s\n' 'advertised full-bandwidth UL MU-MIMO' "$stable_cap_count"
	if [ "$legacy_module_off" = 1 ] && [ "$mask_module_state" = 0 ] &&
	   [ "$persistent_module_state" = disabled ] &&
	   [ "$uci_legacy_state" = 0 ] && [ "$uci_mask_state" = 0 ] &&
	   [ "$mask_count" -gt 0 ] && [ "$mask_zero" -eq "$mask_count" ] &&
	   [ "$legacy_count" -eq "$mask_count" ] && [ "$legacy_zero" -eq "$legacy_count" ] &&
	   [ "$state_count" -eq "$mask_count" ] && [ "$state_ready" -eq "$state_count" ] &&
	   [ "$stable_cap_count" -eq 0 ]; then
		echo 'RESULT_UL_MURU_FW_POLICY=STABLE_DISABLED_UPSTREAM_HANG_RISK'
		echo 'RESULT_UL_MURU_MASK=0'
		echo 'RESULT_UL_MURU_HOST_PATH=DISABLED'
		echo 'RESULT_UL_MUMIMO_AGGREGATE_RADIO_COUNTER=NOT_APPLICABLE_DISABLED'
		echo 'RESULT_UL_OFDMA_AGGREGATE_RADIO_COUNTER=NOT_APPLICABLE_DISABLED'
		exit 0
	fi
	echo 'RESULT_UL_MURU_FW_POLICY=INCONSISTENT_DISABLED_STATE'
	echo 'RESULT_UL_MURU_HOST_PATH=FAIL'
	exit 1
fi

if [ "$profile" != ul-muru-ram-v1 ] && [ "$profile" != ul-muru-forced-lab-v1 ]; then
	echo 'RESULT_UL_MURU_FW_POLICY=INVALID_ARTIFACT_PROFILE'
	echo 'RESULT_UL_MURU_HOST_PATH=FAIL'
	exit 1
fi

muru_debug_node=""
muru_debug_original=""
restore_muru_debug() {
	[ -n "$muru_debug_node" ] || return 0
	[ -n "$muru_debug_original" ] || return 0
	printf '%s\n' "$muru_debug_original" >"$muru_debug_node" 2>/dev/null || true
}
trap restore_muru_debug EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

for node in "$debug_root"/phy*/mt76/muru_debug; do
	[ -f "$node" ] || continue
	muru_debug_node="$node"
	muru_debug_original="$(cat "$node" 2>/dev/null || printf error)"
	break
done

fw_stats_query=unavailable
if [ -n "$muru_debug_node" ]; then
	case "$muru_debug_original" in
		0)
			printf '1\n' >"$muru_debug_node" 2>/dev/null || true
			if [ "$(cat "$muru_debug_node" 2>/dev/null)" = 1 ]; then
				fw_stats_query=temporarily-enabled
			else
				fw_stats_query=enable-failed
			fi
			;;
		1) fw_stats_query=already-enabled ;;
		*) fw_stats_query=state-read-failed ;;
	esac
fi
printf '%-38s %s\n' 'firmware MURU stats query' "$fw_stats_query"

mask_count=0
mask_active=0
for node in "$debug_root"/phy*/mt76/cr6608_muru_mask; do
	[ -f "$node" ] || continue
	mask_count=$((mask_count + 1))
	value="$(cat "$node" 2>/dev/null || printf error)"
	[ "$value" = 15 ] && mask_active=$((mask_active + 1))
	printf '%-38s %s\n' "driver bitmap ${node}" "$value"
done
legacy_count=0
legacy_active=0
for node in "$debug_root"/phy*/mt76/cr6608_ul_muru; do
	[ -f "$node" ] || continue
	legacy_count=$((legacy_count + 1))
	value="$(cat "$node" 2>/dev/null || printf error)"
	[ "$value" = 1 ] && legacy_active=$((legacy_active + 1))
	printf '%-38s %s\n' "legacy driver gate ${node}" "$value"
done

collect_state_contract 15 || true
printf '%-38s %s\n' 'driver policy ABI valid' "${state_ready}/${state_count}"
printf '%-38s %s\n' 'telemetry fault_latched/latches' "${fault_latched_max}/${fault_latches_max}"
printf '%-38s %s\n' 'telemetry attempted/response_ok/failed/timeout' \
	"${sta_rec_attempted_max}/${sta_rec_response_ok_max}/${sta_rec_failed_max}/${sta_rec_timeout_max}"
printf '%-38s %s\n' 'response_ok proof scope' 'command-response-only; not Firmware apply or OTA proof'

cap_count="$(iw phy 2>/dev/null | grep -c 'Full Bandwidth UL MU-MIMO' || true)"
# The AP's B22 bit is a boot-frozen driver decision (patch 09): vendor parity
# is B22 OFF while the scheduler bits are still requested per peer, and the
# operator may opt in with cr6608_advertise_ul_mumimo=1.  Armed therefore
# does not imply B22; the beacon must match the driver's own decision.
case "$(cat "$advertise_module_param" 2>/dev/null || true)" in
	Y|1) cap_expected=advertised; cap_ok="$([ "$cap_count" -gt 0 ] && echo 1 || echo 0)" ;;
	*) cap_expected=not-advertised-vendor-parity; cap_ok="$([ "$cap_count" -eq 0 ] && echo 1 || echo 0)" ;;
esac
printf '%-38s %s\n' 'advertised full-bandwidth UL MU-MIMO' "$cap_count (driver decision: $cap_expected)"

ul_mumimo_ppdu=0
ul_ofdma_ppdu=0
stats_count=0
for stats in "$debug_root"/phy*/mt76/muru_stats; do
	[ -f "$stats" ] || continue
	data="$(cat "$stats" 2>/dev/null)"
	printf '%s\n' "$data" | grep -q '^Uplink$' || continue
	stats_count=$((stats_count + 1))
	printf '%s\n' "$data" | grep -E 'Total HE (MU-MIMO|OFDMA) UL TB PPDU count:' || true
	for value in $(printf '%s\n' "$data" | sed -n \
		's/.*Total HE MU-MIMO UL TB PPDU count: \([0-9][0-9]*\).*/\1/p'); do
		ul_mumimo_ppdu=$((ul_mumimo_ppdu + value))
	done
	for value in $(printf '%s\n' "$data" | sed -n \
		's/.*Total HE OFDMA UL TB PPDU count: \([0-9][0-9]*\).*/\1/p'); do
		ul_ofdma_ppdu=$((ul_ofdma_ppdu + value))
	done
done

associated_stations=0
for object in $(ubus list 'hostapd.*' 2>/dev/null); do
	iface="${object#hostapd.}"
	count="$(iw dev "$iface" station dump 2>/dev/null | grep -c '^Station ' || true)"
	associated_stations=$((associated_stations + count))
done
printf '%-38s %s\n' 'associated AP stations now' "$associated_stations"
printf '%-38s %s\n' 'aggregate UL MU-MIMO TB PPDU total' "$ul_mumimo_ppdu"
printf '%-38s %s\n' 'aggregate UL OFDMA TB PPDU total' "$ul_ofdma_ppdu"
printf '%-38s %s\n' 'firmware MURU stats radios' "$stats_count"

restore_muru_debug
muru_debug_node=""
muru_debug_original=""

if [ "$legacy_module_off" = 1 ] && [ "$mask_module_state" = 15 ] &&
   [ "$persistent_module_state" = mask-15 ] &&
	   [ "$uci_legacy_state" = 0 ] && [ "$uci_mask_state" = 15 ] &&
	   [ "$guard_health" = armed-fresh ] &&
	   [ "$mask_count" -gt 0 ] && [ "$mask_active" -eq "$mask_count" ] &&
	   [ "$legacy_count" -eq "$mask_count" ] && [ "$legacy_active" -eq "$legacy_count" ] &&
	   [ "$state_count" -eq "$mask_count" ] && [ "$state_ready" -eq "$state_count" ] &&
	   [ "$sta_rec_failed_max" -eq 0 ] && [ "$sta_rec_timeout_max" -eq 0 ] &&
	   [ "$stats_count" -eq "$mask_count" ] && [ "$cap_ok" = 1 ]; then
	echo 'RESULT_UL_MURU_FW_POLICY=MEDIATEK_VENDOR_STA_REC_ARMED'
	echo "RESULT_UL_MUMIMO_B22_ADVERTISEMENT=$cap_expected"
	echo 'RESULT_UL_MURU_MASK=15'
	echo 'RESULT_UL_MURU_HOST_PATH=ARMED'
else
	echo 'RESULT_UL_MURU_FW_POLICY=NOT_ARMED'
	echo 'RESULT_UL_MURU_HOST_PATH=NOT_ARMED'
	exit 1
fi

if [ "$ul_mumimo_ppdu" -gt 0 ]; then
	echo 'RESULT_UL_MUMIMO_AGGREGATE_RADIO_COUNTER=NONZERO_NOT_CLIENT_ATTRIBUTED'
else
	echo 'RESULT_UL_MUMIMO_AGGREGATE_RADIO_COUNTER=ZERO'
fi
if [ "$ul_ofdma_ppdu" -gt 0 ]; then
	echo 'RESULT_UL_OFDMA_AGGREGATE_RADIO_COUNTER=NONZERO_NOT_CLIENT_ATTRIBUTED'
else
	echo 'RESULT_UL_OFDMA_AGGREGATE_RADIO_COUNTER=ZERO'
fi
if [ "$ul_mumimo_ppdu" -gt 0 ] && [ "$ul_ofdma_ppdu" -gt 0 ]; then
	echo 'RESULT_UL_MURU_AGGREGATE_RADIO_COUNTERS=BOTH_NONZERO_NOT_CLIENT_ATTRIBUTED'
elif [ "$ul_mumimo_ppdu" -gt 0 ] || [ "$ul_ofdma_ppdu" -gt 0 ]; then
	echo 'RESULT_UL_MURU_AGGREGATE_RADIO_COUNTERS=PARTIAL_NONZERO_NOT_CLIENT_ATTRIBUTED'
else
	echo 'RESULT_UL_MURU_AGGREGATE_RADIO_COUNTERS=ZERO'
fi
echo 'EVIDENCE_SCOPE=AGGREGATE_RADIO_COUNTERS_NOT_CLIENT_ATTRIBUTION'
echo 'CLIENT_ATTRIBUTED_OTA_PROOF=REQUIRES_PER_PEER_SCHEDULER_TELEMETRY_OR_PACKET_CAPTURE_HARDWARE'
