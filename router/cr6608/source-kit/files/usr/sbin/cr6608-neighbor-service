#!/bin/sh

PRIVATE_RUNTIME_LIB=/usr/libexec/cr6608-private-runtime
SENDER=/usr/sbin/cr6608-mndp-advertise
[ -r "$PRIVATE_RUNTIME_LIB" ] || exit 1
. "$PRIVATE_RUNTIME_LIB"
umask 077
RUNTIME_DIR="$(cr6608_private_runtime_dir neighbor)" || exit 1
FIELDS="$RUNTIME_DIR/fields"
STATUS="$RUNTIME_DIR/status"
FIELDS_TMP=''

clean_text() {
  printf '%s' "$1" | tr '\r\n\t' '   ' | sed 's/|/-/g' |
    tr -d '\000-\010\013\014\016-\037\177' | cut -c1-128
}

clean_phone() {
  printf '%s' "$1" | sed 's/[^0-9+() -]//g' | cut -c1-32
}

read_interval() {
  interval="$(uci -q get smartap.identity.interval 2>/dev/null)"
  case "$interval" in ''|*[!0-9]*) interval=30 ;; esac
  [ "$interval" -ge 10 ] 2>/dev/null || interval=10
  [ "$interval" -le 300 ] 2>/dev/null || interval=300
  printf '%s' "$interval"
}

build_fields() {
  enabled="$(uci -q get smartap.identity.enabled 2>/dev/null)"
  [ -n "$enabled" ] || enabled=1
  case "$enabled" in 0|1) : ;; *) enabled=1 ;; esac

  customer="$(clean_text "$(uci -q get smartap.identity.customer_name 2>/dev/null)")"
  device="$(clean_text "$(uci -q get smartap.identity.device_name 2>/dev/null)")"
  phone="$(clean_phone "$(uci -q get smartap.identity.phone 2>/dev/null)")"
  [ -n "$device" ] || device="$(clean_text "$(cat /proc/sys/kernel/hostname 2>/dev/null)")"
  [ -n "$device" ] || device=CR6608

  identity="$device"
  [ -n "$customer" ] && identity="$customer | $identity"
  [ -n "$phone" ] && identity="$identity | Tel:$phone"
  identity="$(printf '%s' "$identity" | cut -c1-240)"

  release="$(. /etc/openwrt_release 2>/dev/null; printf '%s' "${DISTRIB_RELEASE:-unknown}" | cut -c1-100)"
  FIELDS_TMP="$(cr6608_private_mktemp "$RUNTIME_DIR" fields-new)" || return 1
  interval="$(read_interval)"
  printf '%s\n%s\n%s\n%s\n%s\n%s\n' "$identity" "SmartAP CR6608" "OpenWrt $release" "Xiaomi CR6608" "$enabled" "$interval" >"$FIELDS_TMP" || return 1
  cr6608_private_publish_file "$FIELDS_TMP" "$FIELDS" || return 1
  FIELDS_TMP=''
}

cleanup() {
  [ -z "$FIELDS_TMP" ] || rm -f -- "$FIELDS_TMP" 2>/dev/null || true
}
trap cleanup EXIT HUP INT TERM
build_fields || exit 1
[ -x "$SENDER" ] || exit 1

case "$1" in
  --once) exec "$SENDER" --status "$STATUS" "$FIELDS" ;;
  *) logger -t cr6608-neighbor 'MikroTik MNDP identity service started' 2>/dev/null || true
     exec "$SENDER" -d --status "$STATUS" "$FIELDS" ;;
esac
