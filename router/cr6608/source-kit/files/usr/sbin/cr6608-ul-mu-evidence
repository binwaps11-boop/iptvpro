#!/bin/sh
#
# Read-only report of client-attributed uplink MU evidence.
#
# Two independent sources, and the verdict names which ones agreed:
#
#   host    per-WCID counts of HE trigger-based (TB) PPDUs taken from RX
#           descriptors (kit patch 07).  A HE TB PPDU exists only as a
#           response to a Trigger frame this AP transmitted, and the
#           descriptor carries the transmitting peer's WCID, so this is
#           direct per-client evidence that the scheduler solicited uplink
#           airtime from that client.
#
#   firmware (--with-firmware) the MURU statistics the closed firmware
#           itself reports through MURU_GET_TXC_TX_STATS: hetrig_* counters
#           of HE TB PPDUs it received, split into UL OFDMA (by RU count)
#           and UL MU-MIMO (by user count).  This is the firmware's own
#           accounting of the uplink transmissions it scheduled.
#
# Host-observed scheduling evidence only.  Not an RF measurement, not a
# throughput claim, and not a regulatory or sale approval.
#
# usage: cr6608-ul-mu-evidence [--with-firmware] [--window SECONDS]

set -eu

debug_root="${CR6608_UL_MURU_DEBUG_ROOT:-/sys/kernel/debug/ieee80211}"
mask_param="${CR6608_MURU_MASK_MODULE_PARAM:-/sys/module/mt7915e/parameters/cr6608_muru_mask}"

with_firmware=0
window=30
while [ "$#" -gt 0 ]; do
	case "$1" in
		--with-firmware) with_firmware=1 ;;
		--window)
			shift
			case "${1:-}" in
				''|*[!0-9]*) printf 'error=window-must-be-an-integer\n'; exit 2 ;;
			esac
			window="$1" ;;
		-h|--help)
			sed -n '2,24p' "$0" | sed 's/^# \{0,1\}//'
			exit 0 ;;
		*) printf 'error=unknown-argument %s\n' "$1"; exit 2 ;;
	esac
	shift
done

read_field() {
	# $1 file, $2 key -> value, empty when absent or malformed
	[ -r "$1" ] || return 0
	awk -F= -v key="$2" '$1 == key { print $2; exit }' "$1" 2>/dev/null
}

is_uint() {
	case "${1:-}" in
		''|*[!0-9]*) return 1 ;;
	esac
	return 0
}

# muru_stats "Total HE MU-MIMO UL TB PPDU count: N" style lines.
fw_total() {
	# $1 muru_stats file, $2 label prefix
	[ -r "$1" ] || return 0
	sed -n "s/^$2: *\([0-9][0-9]*\).*/\1/p" "$1" 2>/dev/null | head -n1
}

phy_of() {
	printf '%s\n' "$1" | sed -n 's|.*/\(phy[0-9]*\)/.*|\1|p'
}

# ---------------------------------------------------------------------------
# Snapshot: one line per radio and per peer, machine-parseable, into $1.
snapshot() {
	out="$1"
	: > "$out"
	for node in "$debug_root"/phy*/mt76/cr6608_ul_attribution; do
		[ -f "$node" ] || continue
		phy="$(phy_of "$node")"
		tb="$(read_field "$node" he_tb_ppdu)"
		ofdma_ru="$(read_field "$node" he_tb_ul_ofdma_ru)"
		full_bw="$(read_field "$node" he_tb_full_bw)"
		ofdma_groups="$(read_field "$node" ul_ofdma_multi_user_ppdus)"
		mumimo_groups="$(read_field "$node" ul_mumimo_multi_user_ppdus)"
		max_peers="$(read_field "$node" max_peers_in_one_ppdu)"
		band="$(read_field "$node" band)"
		armed="$(read_field "$node" armed_mask)"
		ok=1
		for v in "$tb" "$ofdma_ru" "$full_bw" "$ofdma_groups" "$mumimo_groups" "$max_peers"; do
			is_uint "$v" || ok=0
		done
		if [ "$ok" = 1 ]; then
			printf 'radio %s %s %s %s %s %s %s %s %s\n' "$phy" "${band:-?}" "${armed:-?}" \
				"$tb" "$ofdma_ru" "$full_bw" "$ofdma_groups" "$mumimo_groups" "$max_peers" >> "$out"
		else
			printf 'radio %s malformed\n' "$phy" >> "$out"
		fi
		if [ "$with_firmware" = 1 ]; then
			stats="$debug_root/$phy/mt76/muru_stats"
			fw_all="$(fw_total "$stats" 'All HE UL TB PPDU count')"
			fw_mu="$(fw_total "$stats" 'Total HE MU-MIMO UL TB PPDU count')"
			fw_ofdma="$(fw_total "$stats" 'Total HE OFDMA UL TB PPDU count')"
			if is_uint "$fw_all" && is_uint "$fw_mu" && is_uint "$fw_ofdma"; then
				printf 'fw %s %s %s %s\n' "$phy" "$fw_all" "$fw_mu" "$fw_ofdma" >> "$out"
			else
				printf 'fw %s unavailable\n' "$phy" >> "$out"
			fi
		fi
	done
	for sta in "$debug_root"/phy*/netdev:*/stations/*/cr6608_ul_attribution; do
		[ -f "$sta" ] || continue
		phy="$(phy_of "$sta")"
		mac="$(printf '%s\n' "$sta" | sed -n 's|.*/stations/\([^/]*\)/.*|\1|p')"
		wcid="$(read_field "$sta" wcid)"
		tb="$(read_field "$sta" he_tb_ppdu)"
		ofdma_ru="$(read_field "$sta" he_tb_ul_ofdma_ru)"
		full_bw="$(read_field "$sta" he_tb_full_bw)"
		shared="$(read_field "$sta" he_tb_ul_mumimo_shared)"
		ok=1
		for v in "$tb" "$ofdma_ru" "$full_bw" "$shared"; do
			is_uint "$v" || ok=0
		done
		if [ "$ok" = 1 ]; then
			printf 'peer %s %s %s %s %s %s %s\n' "$phy" "$mac" "${wcid:-?}" "$tb" "$ofdma_ru" "$full_bw" "$shared" >> "$out"
		else
			printf 'peer %s %s malformed\n' "$phy" "$mac" >> "$out"
		fi
	done
}

# ---------------------------------------------------------------------------
# Firmware statistics are only produced while muru_debug is enabled.  Enable
# it for the window and put back exactly what was there before, on every exit.
restore_list=''
restore_muru_debug() {
	for entry in $restore_list; do
		f="${entry%%=*}"; v="${entry#*=}"
		printf '%s\n' "$v" > "$f" 2>/dev/null || :
	done
}
enable_muru_debug() {
	for f in "$debug_root"/phy*/mt76/muru_debug; do
		[ -f "$f" ] || continue
		cur="$(head -n1 "$f" 2>/dev/null | tr -d '[:space:]')"
		[ "$cur" = 1 ] && continue
		restore_list="$restore_list $f=${cur:-0}"
		printf '1\n' > "$f" 2>/dev/null || :
	done
}

tmp="$(mktemp -d)"
trap 'restore_muru_debug; rm -rf "$tmp"' EXIT INT TERM

printf 'schema=cr6608-ul-mu-evidence-v2\n'
printf 'mode=%s\n' "$([ "$with_firmware" = 1 ] && printf 'host-plus-firmware-window' || printf 'host-cumulative')"
if [ -r "$mask_param" ]; then
	printf 'module_mask=%s\n' "$(cat "$mask_param" 2>/dev/null || printf 'unreadable')"
else
	printf 'module_mask=unavailable\n'
fi

if [ "$with_firmware" = 1 ]; then
	enable_muru_debug
	snapshot "$tmp/before"
	printf 'window_seconds=%s\n' "$window"
	[ "$window" -gt 0 ] && sleep "$window"
	snapshot "$tmp/after"
	restore_muru_debug
	restore_list=''
else
	snapshot "$tmp/after"
	: > "$tmp/before"
fi

# ---------------------------------------------------------------------------
# Report.  In window mode every number is the delta over the window; in
# cumulative mode it is the counter itself.
delta() {
	# $1 after, $2 before (empty -> 0)
	printf '%s\n' "$(( ${1:-0} - ${2:-0} ))"
}
before_line() {
	# $1 kind, $2 key1 [, $3 key2] -> matching line from before, or empty
	if [ "$#" -ge 3 ]; then
		awk -v k="$1" -v a="$2" -v b="$3" '$1==k && $2==a && $3==b {print; exit}' "$tmp/before"
	else
		awk -v k="$1" -v a="$2" '$1==k && $2==a {print; exit}' "$tmp/before"
	fi
}

radios=0; tb_total=0; ofdma_total=0; mumimo_total=0
fw_radios=0; fw_all_total=0; fw_mu_total=0; fw_ofdma_total=0
peers_with_tb=0; peers_with_mumimo=0
verdict=UNKNOWN

while read -r kind phy rest; do
	case "$kind" in
	radio)
		radios=$((radios + 1))
		case "$rest" in malformed) printf 'radio=%s status=malformed\n' "$phy"; continue ;; esac
		set -- $rest
		band=$1; armed=$2; tb=$3; ofdma_ru=$4; full_bw=$5; og=$6; mg=$7; mp=$8
		# radio <phy> <band> <armed> <tb> <ofdma_ru> <full_bw> <og> <mg> <mp>
		b="$(before_line radio "$phy")"; set -- $b
		btb=${5:-0}; bofdma=${6:-0}; bfull=${7:-0}; bog=${8:-0}; bmg=${9:-0}
		d_tb=$(delta "$tb" "$btb"); d_ofdma=$(delta "$ofdma_ru" "$bofdma")
		d_full=$(delta "$full_bw" "$bfull"); d_og=$(delta "$og" "$bog"); d_mg=$(delta "$mg" "$bmg")
		tb_total=$((tb_total + d_tb)); ofdma_total=$((ofdma_total + d_og)); mumimo_total=$((mumimo_total + d_mg))
		printf 'radio=%s band=%s armed_mask=%s he_tb_ppdu=%s ul_ofdma_ru=%s full_bw=%s ul_ofdma_multi_user_ppdus=%s ul_mumimo_multi_user_ppdus=%s max_peers_in_one_ppdu=%s\n' \
			"$phy" "$band" "$armed" "$d_tb" "$d_ofdma" "$d_full" "$d_og" "$d_mg" "$mp"
		;;
	fw)
		case "$rest" in unavailable) printf 'firmware=%s status=unavailable-muru_stats-or-muru_debug\n' "$phy"; continue ;; esac
		fw_radios=$((fw_radios + 1))
		set -- $rest; fa=$1; fm=$2; fo=$3
		# fw <phy> <all> <mumimo> <ofdma>
		b="$(before_line fw "$phy")"; set -- $b
		bfa=${3:-0}; bfm=${4:-0}; bfo=${5:-0}
		d_fa=$(delta "$fa" "$bfa"); d_fm=$(delta "$fm" "$bfm"); d_fo=$(delta "$fo" "$bfo")
		fw_all_total=$((fw_all_total + d_fa)); fw_mu_total=$((fw_mu_total + d_fm)); fw_ofdma_total=$((fw_ofdma_total + d_fo))
		printf 'firmware=%s he_ul_tb_ppdu=%s he_mumimo_ul_tb_ppdu=%s he_ofdma_ul_tb_ppdu=%s source=MURU_GET_TXC_TX_STATS\n' \
			"$phy" "$d_fa" "$d_fm" "$d_fo"
		;;
	peer)
		set -- $rest; mac=$1
		case "${2:-}" in malformed) printf 'peer=%s status=malformed\n' "$mac"; continue ;; esac
		wcid=$2; tb=$3; ofdma_ru=$4; full_bw=$5; shared=$6
		# peer <phy> <mac> <wcid> <tb> <ofdma_ru> <full_bw> <shared>
		b="$(before_line peer "$phy" "$mac")"; set -- $b
		btb=${5:-0}; bofdma=${6:-0}; bfull=${7:-0}; bshared=${8:-0}
		d_tb=$(delta "$tb" "$btb"); d_ofdma=$(delta "$ofdma_ru" "$bofdma")
		d_full=$(delta "$full_bw" "$bfull"); d_shared=$(delta "$shared" "$bshared")
		[ "$d_tb" -gt 0 ] && peers_with_tb=$((peers_with_tb + 1))
		[ "$d_shared" -gt 0 ] && peers_with_mumimo=$((peers_with_mumimo + 1))
		printf 'peer=%s radio=%s wcid=%s he_tb_ppdu=%s ul_ofdma_ru=%s full_bw=%s ul_mumimo_shared=%s\n' \
			"$mac" "$phy" "$wcid" "$d_tb" "$d_ofdma" "$d_full" "$d_shared"
		;;
	esac
done < "$tmp/after"

printf 'radios=%s peers_with_trigger_response=%s peers_with_ul_mumimo=%s\n' \
	"$radios" "$peers_with_tb" "$peers_with_mumimo"
printf 'totals he_tb_ppdu=%s ul_ofdma_multi_user_ppdus=%s ul_mumimo_multi_user_ppdus=%s\n' \
	"$tb_total" "$ofdma_total" "$mumimo_total"
[ "$with_firmware" = 1 ] && printf 'firmware_totals he_ul_tb_ppdu=%s he_mumimo_ul_tb_ppdu=%s he_ofdma_ul_tb_ppdu=%s radios_reporting=%s\n' \
	"$fw_all_total" "$fw_mu_total" "$fw_ofdma_total" "$fw_radios"

# Host verdict first (client-attributed), then firmware corroboration.
if [ "$radios" -eq 0 ]; then
	verdict=NO_ATTRIBUTION_NODES
	printf 'reason=driver-lacks-the-uplink-attribution-patch-or-no-uplink-bit-is-armed\n'
elif [ "$mumimo_total" -gt 0 ] && [ "$peers_with_mumimo" -ge 2 ]; then
	verdict=UL_MUMIMO_CLIENT_ATTRIBUTED
elif [ "$ofdma_total" -gt 0 ] && [ "$peers_with_tb" -ge 2 ]; then
	verdict=UL_OFDMA_CLIENT_ATTRIBUTED
elif [ "$tb_total" -gt 0 ]; then
	verdict=TRIGGER_RESPONSE_ONLY_NO_MULTI_USER_PPDU_YET
	printf 'reason=peers-answer-triggers-but-no-two-peers-shared-one-uplink-ppdu\n'
else
	verdict=NO_TRIGGER_RESPONSE_OBSERVED
	printf 'reason=no-he-tb-ppdu-seen-run-simultaneous-uploads-from-two-he-clients\n'
fi

if [ "$with_firmware" = 1 ] && [ "$radios" -gt 0 ]; then
	if [ "$fw_radios" -eq 0 ]; then
		corroboration=FIRMWARE_STATS_UNAVAILABLE
	else
		case "$verdict" in
		UL_MUMIMO_CLIENT_ATTRIBUTED)
			[ "$fw_mu_total" -gt 0 ] && corroboration=FIRMWARE_CORROBORATED || corroboration=FIRMWARE_DISAGREES_MUMIMO_COUNTER_ZERO ;;
		UL_OFDMA_CLIENT_ATTRIBUTED)
			[ "$fw_ofdma_total" -gt 0 ] && corroboration=FIRMWARE_CORROBORATED || corroboration=FIRMWARE_DISAGREES_OFDMA_COUNTER_ZERO ;;
		TRIGGER_RESPONSE_ONLY_NO_MULTI_USER_PPDU_YET)
			[ "$fw_all_total" -gt 0 ] && corroboration=FIRMWARE_CORROBORATED || corroboration=FIRMWARE_DISAGREES_TB_COUNTER_ZERO ;;
		*)
			[ "$fw_all_total" -gt 0 ] && corroboration=FIRMWARE_SAW_TB_PPDUS_HOST_DID_NOT || corroboration=FIRMWARE_AGREES_NOTHING_SCHEDULED ;;
		esac
	fi
	printf 'firmware_corroboration=%s\n' "$corroboration"
	case "$corroboration" in FIRMWARE_DISAGREES*|FIRMWARE_SAW*)
		printf 'note=host-and-firmware-counters-disagree-treat-the-result-as-inconclusive\n' ;;
	esac
fi

printf 'verdict=%s\n' "$verdict"
printf 'evidence_boundary=host-observed-scheduling-evidence-not-an-rf-regulatory-or-throughput-measurement\n'
