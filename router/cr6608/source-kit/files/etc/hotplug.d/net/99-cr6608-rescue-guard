#!/bin/sh
# Keep the nft ifname set synchronized with live interfaces reported as APs.
case "$ACTION" in add|remove|register|unregister) ;; *) exit 0 ;; esac
rescue_netdev="${DEVICENAME:-$INTERFACE}"
case "$rescue_netdev" in phy*-ap*|wlan*) ;; *) exit 0 ;; esac
INIT=/etc/init.d/cr6608-rescue-guard
[ -x "$INIT" ] || exit 1
# wlanrescue itself is ignored by this netdev filter, preventing recursion.
if "$INIT" running >/dev/null 2>&1; then
	exec "$INIT" reload
fi
# Never create/replace a procd instance from hotplug. S99 owns initial
# publication and procd owns respawn; absence must remain fail-closed.
exit 0
