config prplmesh 'config'
	option management_mode 'Multi-AP-Controller-and-Agent'
	option operating_mode 'Gateway'
	option enable '0'
	option onboarding '0'
	option master '1'
	option gateway '1'
	option passive_mode '1'
	option wired_backhaul '1'
	# The CR6608 integration currently has an audited Ethernet Agent path only.
	# Runtime start rejects detached, WAN, CPU, and non-br-lan backhaul devices.
	option require_encrypted_fronthaul '1'
	option operational '0'
	# Active mode may change AP state.  It needs a second explicit opt-in.
	option active_control_confirmed '0'
	option ssid 'Smart ap 2.4G'
	option mode_enabled 'None'
	option key_passphrase ''
	option mem_only_psk '0'
	option backhaul_band 'auto'
	option zwdfs_flag '0'
	option best_channel_rank_th '0'
	option backhaul_wire_iface 'lan1'
	option band_steering '0'
	option client_11k_roaming '1'
	option load_balancing '0'
	option client_roaming '0'
	option certification_mode '0'
	option stop_on_failure_attempts '1'
	option dfs_reentry '0'
	option roaming_hysteresis_percent_bonus '10'
	option steering_disassoc_timer_msec '200'
	option link_metrics_request_interval_sec '60'
	option clients_measurement_mode '1'
	option radio_stats_enable '1'
	option unsuccessful_assoc_report_policy '1'
	option unsuccessful_assoc_max_reporting_rate '30'
	option ire_roaming '1'
	option exclude_hostap_iface '0'

config wifi-device 'radio0'
	option hostap_iface 'phy0-ap0'
	option ssid 'Smart ap 2.4G'
	option security_mode 'none'
	option psk ''
	option sta_iface ''
	option hostap_iface_steer_vaps ''
	option hostap_iface_monitor_vaps ''

config wifi-device 'radio1'
	option hostap_iface 'phy1-ap0'
	option ssid 'Smart ap 5G'
	option security_mode 'none'
	option psk ''
	option sta_iface ''
	option hostap_iface_steer_vaps ''
	option hostap_iface_monitor_vaps ''
