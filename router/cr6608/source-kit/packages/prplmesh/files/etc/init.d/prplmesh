#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

PRPLMESH_DIR=/opt/prplmesh
PRPLMESH_RUNTIME_DIR="${CR6608_PRPLMESH_RUNTIME_DIR:-/tmp/beerocks}"
PRPLMESH_CONTROL_DIR="${CR6608_PRPLMESH_CONTROL_DIR:-/var/run/prplmesh}"
PRPLMESH_EXPECT_UID="${CR6608_PRPLMESH_EXPECT_UID:-0}"
PRPLMESH_SYS_CLASS_NET="${CR6608_PRPLMESH_SYS_CLASS_NET:-/sys/class/net}"
PRPLMESH_UCI_BIN="${CR6608_PRPLMESH_UCI_BIN:-uci}"
PRPLMESH_IW_BIN="${CR6608_PRPLMESH_IW_BIN:-iw}"
PLATFORM_DB="$PRPLMESH_RUNTIME_DIR/prplmesh_platform_db"
PRPLMESH_PASSIVE=1

mode_has_controller() {
	case "$1" in
		Multi-AP-Controller|Multi-AP-Controller-and-Agent) return 0 ;;
	esac
	return 1
}

mode_has_agent() {
	case "$1" in
		Multi-AP-Agent|Multi-AP-Controller-and-Agent) return 0 ;;
	esac
	return 1
}

agent_runtime_policy_valid() {
	[ "$1" -eq 1 ] 2>/dev/null && [ "$2" -eq 1 ] 2>/dev/null
}

valid_lan_backhaul_name() {
	case "$1" in lan1|lan2|lan3) return 0 ;; esac
	return 1
}

# prplMesh sends IEEE1905 traffic over a physical DSA LAN slave.  Reject WAN,
# a CPU/master device, a detached slave, and a port enslaved to any bridge
# other than br-lan.  Carrier is deliberately not required at service start:
# a cable may be attached later.  The runtime verifier requires live carrier
# before reporting the wired control plane as operational.
backhaul_topology_valid() {
	local iface="$1" master ports bridge_section

	valid_lan_backhaul_name "$iface" || return 1
	[ -d "$PRPLMESH_SYS_CLASS_NET/$iface" ] || return 1
	[ -L "$PRPLMESH_SYS_CLASS_NET/$iface/master" ] || return 1
	master="$(readlink "$PRPLMESH_SYS_CLASS_NET/$iface/master" 2>/dev/null)" || return 1
	[ "${master##*/}" = br-lan ] || return 1
	bridge_section="$("$PRPLMESH_UCI_BIN" -q show network 2>/dev/null | sed -n \
		"s/^\(network\.[^.=]*\)\.name='br-lan'$/\1/p" | sed -n '1p')"
	[ -n "$bridge_section" ] || return 1
	[ "$("$PRPLMESH_UCI_BIN" -q get "$bridge_section" 2>/dev/null)" = device ] || return 1
	ports="$("$PRPLMESH_UCI_BIN" -q get "$bridge_section.ports" 2>/dev/null)" || return 1
	case " $ports " in *" $iface "*) return 0 ;; esac
	return 1
}

credential_field_safe() {
	local value="$1" clean
	case "$value" in *'#'*) return 1 ;; esac
	clean="$(printf '%s' "$value" | tr -d '\r\n')"
	[ "$clean" = "$value" ]
}

radio_credentials_valid() {
	local security="$1" ssid="$2" psk="$3" require_encrypted="$4"
	local ssid_bytes psk_bytes

	credential_field_safe "$ssid" && credential_field_safe "$psk" || return 1
	ssid_bytes="$(LC_ALL=C printf '%s' "$ssid" | wc -c | tr -d ' ')"
	psk_bytes="$(LC_ALL=C printf '%s' "$psk" | wc -c | tr -d ' ')"
	[ "$ssid_bytes" -ge 1 ] 2>/dev/null && [ "$ssid_bytes" -le 32 ] 2>/dev/null || return 1
	case "$security" in
		none)
			[ "$require_encrypted" -eq 0 ] 2>/dev/null || return 1
			[ -z "$psk" ]
			;;
		wpa2-psk)
			[ "$psk_bytes" -ge 8 ] 2>/dev/null && [ "$psk_bytes" -le 63 ] 2>/dev/null
			;;
		*) return 1 ;;
	esac
}

radio_runtime_valid() {
	local iface="$1" expected_ssid="$2" info live_ssid
	case "$iface" in ''|*[!A-Za-z0-9_.:-]*) return 1 ;; esac
	info="$("$PRPLMESH_IW_BIN" dev "$iface" info 2>/dev/null)" || return 1
	printf '%s\n' "$info" | grep -Eq '^[[:space:]]*type[[:space:]]+AP$' || return 1
	live_ssid="$(printf '%s\n' "$info" | sed -n 's/^[[:space:]]*ssid[[:space:]]//p' | sed -n '1p')"
	[ "$live_ssid" = "$expected_ssid" ] || return 1
	[ -S "/var/run/hostapd/$iface" ]
}

runtime_dir_secure() {
	local path="$1"
	[ -d "$path" ] && [ ! -L "$path" ] || return 1
	[ "$(stat -c '%u:%a' "$path" 2>/dev/null)" = "$PRPLMESH_EXPECT_UID:700" ]
}

runtime_paths_allowed() {
	case "$PRPLMESH_EXPECT_UID" in ''|*[!0-9]*) return 1 ;; esac
	case "$PRPLMESH_RUNTIME_DIR:$PRPLMESH_CONTROL_DIR" in
		/tmp/beerocks:/var/run/prplmesh) return 0 ;;
	esac
	[ "${CR6608_PRPLMESH_TEST_MODE:-0}" = 1 ] || return 1
	case "$PRPLMESH_RUNTIME_DIR:$PRPLMESH_CONTROL_DIR" in
		/tmp/cr6608-prplmesh-test.*/*:/tmp/cr6608-prplmesh-test.*/*) ;;
		*) return 1 ;;
	esac
	case "$PRPLMESH_RUNTIME_DIR:$PRPLMESH_CONTROL_DIR" in
		*'/../'*|*'/./'*|*'//'*) return 1 ;;
	esac
}

prepare_runtime_dirs() {
	runtime_paths_allowed || return 1
	if [ -e "$PRPLMESH_RUNTIME_DIR" ] || [ -L "$PRPLMESH_RUNTIME_DIR" ]; then
		rm -rf -- "$PRPLMESH_RUNTIME_DIR" || return 1
	fi
	[ ! -e "$PRPLMESH_RUNTIME_DIR" ] && [ ! -L "$PRPLMESH_RUNTIME_DIR" ] || return 1
	umask 077
	mkdir -m 0700 "$PRPLMESH_RUNTIME_DIR" || return 1
	runtime_dir_secure "$PRPLMESH_RUNTIME_DIR" || return 1
	mkdir -m 0700 "$PRPLMESH_RUNTIME_DIR/logs" || return 1
	runtime_dir_secure "$PRPLMESH_RUNTIME_DIR/logs" || return 1
	if [ -e "$PRPLMESH_CONTROL_DIR" ] || [ -L "$PRPLMESH_CONTROL_DIR" ]; then
		[ -d "$PRPLMESH_CONTROL_DIR" ] && [ ! -L "$PRPLMESH_CONTROL_DIR" ] || return 1
		[ "$(stat -c '%u' "$PRPLMESH_CONTROL_DIR" 2>/dev/null)" = "$PRPLMESH_EXPECT_UID" ] || return 1
		chmod 0700 "$PRPLMESH_CONTROL_DIR" || return 1
	else
		mkdir -m 0700 "$PRPLMESH_CONTROL_DIR" || return 1
	fi
	runtime_dir_secure "$PRPLMESH_CONTROL_DIR" || return 1
}

prepare_platform_db() {
	local mode="$1"
	local operating_mode="$2"
	local backhaul_iface certification stop_on_failure band_steering client_roaming
	local wired_backhaul require_encrypted
	local radio0_iface radio1_iface radio0_ssid radio1_ssid
	local radio0_security radio1_security radio0_psk radio1_psk tmp value clean

	[ -r "$PRPLMESH_DIR/share/prplmesh_platform_db" ] || return 1
	config_get backhaul_iface config backhaul_wire_iface lan1
	config_get_bool certification config certification_mode 0
	config_get_bool stop_on_failure config stop_on_failure_attempts 1
	config_get_bool band_steering config band_steering 0
	config_get_bool client_roaming config client_roaming 0
	config_get_bool wired_backhaul config wired_backhaul 1
	config_get_bool require_encrypted config require_encrypted_fronthaul 1
	if [ "$PRPLMESH_PASSIVE" -eq 1 ]; then
		# Passive mode is observational.  Ignore stale steering options from
		# preserved overlays instead of allowing them to mutate client state.
		band_steering=0
		client_roaming=0
	fi
	config_get radio0_iface radio0 hostap_iface phy0-ap0
	config_get radio1_iface radio1 hostap_iface phy1-ap0
	config_get radio0_ssid radio0 ssid 'Smart ap 2.4G'
	config_get radio1_ssid radio1 ssid 'Smart ap 5G'
	config_get radio0_security radio0 security_mode none
	config_get radio1_security radio1 security_mode none
	config_get radio0_psk radio0 psk ''
	config_get radio1_psk radio1 psk ''

	case "$backhaul_iface:$radio0_iface:$radio1_iface" in
		*[!A-Za-z0-9_.:-]*) logger -t prplmesh 'invalid interface name in UCI'; return 1 ;;
	esac
	for value in "$radio0_ssid" "$radio1_ssid" "$radio0_psk" "$radio1_psk"; do
		case "$value" in *'#'*) logger -t prplmesh 'SSID or PSK contains a platform-database delimiter'; return 1 ;; esac
		clean="$(printf '%s' "$value" | tr -d '\r\n')"
		[ "$clean" = "$value" ] || {
			logger -t prplmesh 'SSID or PSK contains a platform-database delimiter'
			return 1
		}
	done
	if mode_has_agent "$mode"; then
		agent_runtime_policy_valid "$wired_backhaul" "$require_encrypted" || {
			logger -t prplmesh 'Agent requires the audited wired backhaul and encrypted fronthaul policies'; return 1;
		}
		[ "$radio0_iface" != "$radio1_iface" ] || {
			logger -t prplmesh 'both EasyMesh radios resolve to the same AP interface'; return 1;
		}
		radio_runtime_valid "$radio0_iface" "$radio0_ssid" && \
			radio_runtime_valid "$radio1_iface" "$radio1_ssid" || {
			logger -t prplmesh 'an EasyMesh fronthaul is not a live hostapd AP'; return 1;
		}
		radio_credentials_valid "$radio0_security" "$radio0_ssid" "$radio0_psk" \
			"$require_encrypted" && \
			radio_credentials_valid "$radio1_security" "$radio1_ssid" "$radio1_psk" \
			"$require_encrypted" || {
			logger -t prplmesh 'invalid or unencrypted EasyMesh fronthaul credentials'; return 1;
		}
		backhaul_topology_valid "$backhaul_iface" || {
			logger -t prplmesh 'wired backhaul is not an attached br-lan DSA LAN port'; return 1;
		}
	fi

	umask 077
	tmp="$(mktemp "${PLATFORM_DB}.tmp.XXXXXX" 2>/dev/null)" || return 1
	{
		printf 'management_mode=%s\n' "$mode"
		printf 'operating_mode=%s\n' "$operating_mode"
		printf 'stop_on_failure_attempts=%s\n' "$stop_on_failure"
		printf 'certification_mode=%s\n' "$certification"
		printf 'hostapd_ctrl_path_%s=/var/run/hostapd/%s\n' "$radio0_iface" "$radio0_iface"
		printf 'hostapd_ctrl_path_%s=/var/run/hostapd/%s\n' "$radio1_iface" "$radio1_iface"
		printf 'wpa_supplicant_ctrl_path_%s=\n' "$radio0_iface"
		printf 'wpa_supplicant_ctrl_path_%s=\n' "$radio1_iface"
		printf 'wireless.%s.ssid=%s\n' "$radio0_iface" "$radio0_ssid"
		printf 'wireless.%s.security_mode=%s\n' "$radio0_iface" "$radio0_security"
		printf 'wireless.%s.psk=%s\n' "$radio0_iface" "$radio0_psk"
		printf 'wireless.%s.ssid=%s\n' "$radio1_iface" "$radio1_ssid"
		printf 'wireless.%s.security_mode=%s\n' "$radio1_iface" "$radio1_security"
		printf 'wireless.%s.psk=%s\n' "$radio1_iface" "$radio1_psk"
		printf 'backhaul_wire_iface=%s\n' "$backhaul_iface"
		printf 'band_steering=%s\n' "$band_steering"
		printf 'client_roaming=%s\n' "$client_roaming"
	} > "$tmp" || { rm -f "$tmp"; return 1; }
	mv "$tmp" "$PLATFORM_DB" || { rm -f "$tmp"; return 1; }
}

start_prplmesh_instance() {
	local name="$1"
	local delay="$2"

	procd_open_instance "$name"
	procd_set_param command /bin/sh -c \
		"sleep $delay; exec $PRPLMESH_DIR/bin/$name"
	procd_set_param env \
		"LD_LIBRARY_PATH=/usr/lib:$PRPLMESH_DIR/lib" \
		"MAPF_LOG_LEVEL=3" \
		"PRPLMESH_PASSIVE_MODE=$PRPLMESH_PASSIVE"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param limits core="0 0"
	procd_close_instance
}

start_service() {
	local enabled operational active_control_confirmed mode operating_mode
	local wired_backhaul require_encrypted

	config_load prplmesh
	config_get_bool enabled config enable 0
	[ "$enabled" -eq 1 ] || return 0
	config_get_bool operational config operational 0
	if [ "$operational" -ne 1 ]; then
		logger -t prplmesh 'enable requested while the operational gate is closed; refusing start'
		return 0
	fi
	config_get mode config management_mode Multi-AP-Controller-and-Agent
	config_get operating_mode config operating_mode Gateway
	config_get_bool PRPLMESH_PASSIVE config passive_mode 1
	config_get_bool active_control_confirmed config active_control_confirmed 0
	if [ "$PRPLMESH_PASSIVE" -ne 1 ] && [ "$active_control_confirmed" -ne 1 ]; then
		logger -t prplmesh 'active control requires active_control_confirmed=1; refusing start'
		return 1
	fi
	case "$mode" in
		Multi-AP-Controller-and-Agent|Multi-AP-Controller|Multi-AP-Agent) ;;
		*) return 1 ;;
	esac
	case "$operating_mode" in
		Gateway|WDS-Repeater) ;;
		*) return 1 ;;
	esac
	if mode_has_agent "$mode"; then
		config_get_bool wired_backhaul config wired_backhaul 1
		config_get_bool require_encrypted config require_encrypted_fronthaul 1
		agent_runtime_policy_valid "$wired_backhaul" "$require_encrypted" || {
			logger -t prplmesh 'Agent requires wired_backhaul=1 and require_encrypted_fronthaul=1; refusing start'
			return 1
		}
	fi

	prepare_runtime_dirs || {
		logger -t prplmesh 'secure runtime directory preparation failed; refusing start'
		return 1
	}
	prepare_platform_db "$mode" "$operating_mode" || return 1
	ebtables -C FORWARD -d 01:80:c2:00:00:13 -j DROP 2>/dev/null ||
		ebtables -A FORWARD -d 01:80:c2:00:00:13 -j DROP || {
			logger -t prplmesh 'could not install the IEEE1905 bridge-forwarding guard';
			return 1;
		}

	start_prplmesh_instance ieee1905_transport 0
	mode_has_controller "$mode" && start_prplmesh_instance beerocks_controller 2
	mode_has_agent "$mode" && start_prplmesh_instance beerocks_agent 4
	return 0
}

stop_service() {
	ebtables -D FORWARD -d 01:80:c2:00:00:13 -j DROP 2>/dev/null || true
}

service_triggers() {
	procd_add_reload_trigger prplmesh wireless network
}
