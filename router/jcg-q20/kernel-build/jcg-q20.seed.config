# Seed .config for a from-source SmartAP Q20 build. `make defconfig` expands the rest.
# Target: ramips / mt7621 / JCG Q20 (MT7621AT + MT7915 DBDC, 128 MiB NAND, 256 MiB RAM).
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_jcg_q20=y

# Wi-Fi 6 (MT7915) + regulatory database (SmartAP overlay ships a 38 dBm regdb, but the
# base package must be present so the kernel has a db to load).
CONFIG_PACKAGE_kmod-mt7915e=y
CONFIG_PACKAGE_kmod-mt7915-firmware=y
CONFIG_PACKAGE_wireless-regdb=y
CONFIG_PACKAGE_iw=y
CONFIG_PACKAGE_iwinfo=y

# LuCI (bootstrap theme — the SmartAP dashboard rides on top of this) over uhttpd.
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-theme-bootstrap=y

# Networking the SmartAP overlay expects.
CONFIG_PACKAGE_kmod-nft-bridge=y
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_kmod-ppp=y
CONFIG_PACKAGE_kmod-pppoe=y
CONFIG_PACKAGE_zram-swap=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_bridge=y

# =====================================================================================
# Curated feature set — the genuinely useful packages that independent/community builds
# (ImmortalWrt, Lean/coolsnowwolf, gl.inet, istoreOS) are actually loved for. Chosen to
# fit 256 MiB RAM: every daemon here is INSTALLED but idle until you configure it in
# LuCI/the dashboard, so none of it destabilises the default bridged-AP boot. The
# deliberately-rejected "turbo" mods (SFE/Shortcut-FE, BBR-for-routing, full-cone NAT,
# 160 MHz, "WED on MT7621") are documented in TUNING.md and NOT included — they are
# placebo or a stability/security risk on this SoC.
# =====================================================================================

# --- QoS / latency (bufferbloat) — research-endorsed, the real latency win ---
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_sqm-scripts=y

# --- Gaming / P2P NAT (miniupnpd: UPnP + NAT-PMP/PCP) ---
CONFIG_PACKAGE_luci-app-upnp=y

# --- VPN (WireGuard: light, modern) ---
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_PACKAGE_luci-app-wireguard=y

# --- Dynamic DNS ---
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_ddns-scripts=y

# --- Encrypted DNS over HTTPS (DoH) — light, privacy; idle until enabled ---
CONFIG_PACKAGE_luci-app-https-dns-proxy=y

# --- Network-wide ad/tracker blocking (adblock: script-based, light — NOT AdGuardHome,
#     which is too RAM-heavy for a 256 MiB always-on box) ---
CONFIG_PACKAGE_luci-app-adblock=y

# --- Reliability watchdog (watchcat: optional auto-recover on lost connectivity) ---
CONFIG_PACKAGE_luci-app-watchcat=y

# --- Wake-on-LAN ---
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_etherwake=y

# --- Admin quality-of-life: package-manager UI, web terminal, tools ---
CONFIG_PACKAGE_luci-app-opkg=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-bundle=y

# Squashfs sysupgrade image (what we flash), matching stock.
CONFIG_TARGET_ROOTFS_SQUASHFS=y
