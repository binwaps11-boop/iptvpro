#!/bin/sh

# Overlay-provided init scripts are not package-owned, so OpenWrt will not
# create their rc.d links automatically on a clean flash. Enable every service
# whose state must survive reboot; each command is idempotent on upgrades.
for service in smartap-qos cr6608-rescue-guard cr6608-quicksettings smartap-conntrack; do
	[ -x "/etc/init.d/$service" ] || exit 1
	"/etc/init.d/$service" enable || exit 1
	# start() is non-fatal: smartap-qos runs first and returns smartap-qos-apply's exit
	# code, which is non-zero when `nft -f` fails during early first-boot (before the
	# netfilter path is fully up). A hard `exit 1` there would strand the cron enable +
	# smartap-perf blocks below — leaving the session reaper and perf tuning off. The
	# rc.d link is already installed by enable, so the service still starts on next boot.
	"/etc/init.d/$service" start || logger -t smartap-init "$service start failed at first-boot (non-fatal; enabled for next boot)"
done

# cron drives the scheduled maintenance in /etc/crontabs/root: the session reaper
# (root-equivalent LuCI child sessions leak without it), the Wi-Fi sentinel, nightly
# auto-channel and the self-test. It is a stock package but not enabled by default, and
# an overlay crontab does nothing unless crond is actually running — so enable+start it
# here. Non-fatal (|| true) so a build without the busybox cron applet still boots.
if [ -x /etc/init.d/cron ]; then
	/etc/init.d/cron enable  >/dev/null 2>&1 || true
	/etc/init.d/cron start   >/dev/null 2>&1 || true
fi

# Runtime performance tuning (CPU governor + IRQ affinity). Entirely best-effort:
# every knob it touches is optional silicon-dependent hardware, so a failure must
# never abort first-boot provisioning — hence non-fatal, unlike the block above.
if [ -x /etc/init.d/smartap-perf ]; then
	/etc/init.d/smartap-perf enable >/dev/null 2>&1 || true
	/etc/init.d/smartap-perf start  >/dev/null 2>&1 || true
fi

exit 0
