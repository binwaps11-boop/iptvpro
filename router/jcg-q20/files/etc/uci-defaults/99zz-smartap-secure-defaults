#!/bin/sh
# First-boot security hardening — runs ONCE, LAST (after every 99-* seed script).
#
# Turns the shipped OPEN Wi-Fi into a per-device WPA2 network with a UNIQUE random
# passphrase, and records the credential where the operator can retrieve it:
#   * the boot console,
#   * /etc/smartap-credentials (root, 0600),
#   * the Quick Settings page (security = wpa2, wifi_key populated), reachable over the
#     WIRED LAN at http://192.168.1.1 with the default panel password.
#
# Safety: it NEVER overrides Wi-Fi an operator already secured, and never touches the LAN
# IP, the rescue interface 221.221.221.221 (which stays reachable over the LAN cable), SSH,
# or the panel password — so no recovery path is ever closed. Idempotent via
# smartap.secured.done. WPA2-PSK (psk2) is used deliberately: it is bulletproof on every
# wpad variant and closes the open-network exposure completely; upgrade to WPA3 from Quick
# Settings if desired.

# Run at most once.
[ "$(uci -q get smartap.secured.done 2>/dev/null)" = "1" ] && exit 0

e0="$(uci -q get wireless.wifinet0.encryption 2>/dev/null)"
e1="$(uci -q get wireless.wifinet1.encryption 2>/dev/null)"

mark_done() { uci -q set smartap.secured='state'; uci -q set smartap.secured.done='1'; uci -q commit smartap; }

# If neither radio is still open, an operator already secured Wi-Fi — leave it and stop.
if [ "$e0" != "none" ] && [ "$e1" != "none" ]; then
	mark_done
	exit 0
fi

# Require the kernel CRNG to be initialised before we mint a key. On kernel 6.6/6.12 a
# read from /dev/urandom already blocks until the pool is seeded, but as belt-and-braces
# refuse to generate anything until entropy_avail crosses a sane floor — if it hasn't,
# defer to the next boot instead of risking a low-entropy key. entropy_avail unreadable is
# treated as "assume seeded" (this script runs last in userspace, long after CRNG init).
_ent="$(cat /proc/sys/kernel/random/entropy_avail 2>/dev/null)"
case "$_ent" in ''|*[!0-9]*) _ent=256 ;; esac
if [ "$_ent" -lt 128 ] 2>/dev/null; then
	logger -t smartap-secure "CRNG entropy low ($_ent); deferring Wi-Fi secure step to next boot" 2>/dev/null || true
	exit 1
fi

# Unique 64-bit passphrase from the kernel CSPRNG (16 hex chars: WPA-valid, easy to read).
key="$(head -c 8 /dev/urandom 2>/dev/null | hexdump -v -e '/1 "%02x"' 2>/dev/null)"
[ "${#key}" = "16" ] || key="$(od -An -tx1 -N8 /dev/urandom 2>/dev/null | tr -d ' \n')"
# If the CSPRNG is unreadable, a MAC-derived or literal key would be PUBLIC (the BSSID is
# in every beacon; a literal is shared across units). Never ship a guessable PSK: bail so
# uci-defaults re-runs this on the next boot, when entropy is available. The radios stay in
# their current state (recoverable over the wired LAN) rather than "secured" with a weak key.
if [ "${#key}" != "16" ]; then
	logger -t smartap-secure "CSPRNG unavailable at first boot; deferring Wi-Fi secure step to next boot" 2>/dev/null || true
	exit 1
fi

# Apply WPA2-PSK + the key to both radios (only the ones still open are changed in spirit,
# but setting both keeps the pair consistent; an already-secured radio was handled above).
for ifc in wifinet0 wifinet1; do
	uci -q set "wireless.$ifc.encryption=psk2"
	uci -q set "wireless.$ifc.key=$key"
done
# The commit MUST succeed before we announce the network as secured. If it fails (transient
# flash/RO or a concurrent writer), bail with exit 1 so the whole step re-runs next boot
# instead of shipping an OPEN radio while the console/credentials claim it is secured.
uci -q commit wireless || {
	uci -q revert wireless 2>/dev/null || true
	logger -t smartap-secure "wireless commit failed at first boot; deferring secure step to next boot" 2>/dev/null || true
	exit 1
}

# Mirror into Quick Settings so the operator SEES the key in the panel and a later
# Save & Apply stays consistent instead of reverting to open.
uci -q set cr6608quick.default.security='wpa2'
uci -q set cr6608quick.default.wifi_key="$key"
uci -q commit cr6608quick
if uci -q get smartap.quick >/dev/null 2>&1; then
	uci -q set smartap.quick.security='wpa2'
	uci -q set smartap.quick.wifi_key="$key"
	uci -q commit smartap
fi

# Mint a UNIQUE per-device root SSH password to replace the shared, image-extractable
# default hash. Only the shipped default / an empty / a locked record is replaced — an
# operator-set password is never touched. SSH stays enabled with password auth exactly as
# configured; this only removes the shared-secret weakness (anyone who extracts the image
# otherwise has root on every unit). On ANY failure the existing valid record is left
# untouched, so the account is never emptied or locked, and the panel (root/admin over the
# wired LAN) plus the LAN cable remain as recovery paths regardless.
root_pw_line=""
_pinned='$6$cr66sshd911cc74$WZZ5iq9xtlMFpdpUnTcWbiepXouW9aKbOK9IklLguXC4cH1IvbWlWQFdYwFP1T1vkmATIWo7ldWI4SiI0z102.'
_curroot="$(awk -F: '/^root:/{print $2; exit}' /etc/shadow 2>/dev/null)"
case "$_curroot" in
	"$_pinned"|""|"!"|"x"|"*"|"!*")
		_rpw="$(head -c 12 /dev/urandom 2>/dev/null | hexdump -v -e '/1 "%02x"' 2>/dev/null | cut -c1-20)"
		if [ "${#_rpw}" -ge 16 ] && printf '%s\n%s\n' "$_rpw" "$_rpw" | passwd root >/dev/null 2>&1; then
			root_pw_line="root_ssh_password=$_rpw"
			logger -t smartap-secure "minted a unique per-device root SSH password (see /etc/smartap-credentials)" 2>/dev/null || true
		fi
		;;
esac

ssid24="$(uci -q get wireless.wifinet0.ssid 2>/dev/null)"
ssid5="$(uci -q get wireless.wifinet1.ssid 2>/dev/null)"
{
	echo "# SmartAP first-boot credentials (unique to THIS unit). Keep it safe."
	echo "# View or change them in the panel over the wired LAN: http://192.168.1.1"
	echo "# (default panel password: admin — change it after first login)."
	echo "wifi_ssid_2g=$ssid24"
	echo "wifi_ssid_5g=$ssid5"
	echo "wifi_security=WPA2-PSK"
	echo "wifi_key=$key"
	[ -n "$root_pw_line" ] && echo "$root_pw_line"
} > /etc/smartap-credentials 2>/dev/null
chmod 0600 /etc/smartap-credentials 2>/dev/null

logger -t smartap-secure "Wi-Fi secured with a unique per-device WPA2 key (see /etc/smartap-credentials)" 2>/dev/null || true
printf '\n==== SmartAP: Wi-Fi secured with a UNIQUE key ====\n  SSID : %s / %s\n  Key  : %s\n  Also saved to /etc/smartap-credentials (incl. a unique root SSH password).\n  Change it in the panel over the LAN cable (http://192.168.1.1).\n==================================================\n\n' \
	"$ssid24" "$ssid5" "$key" > /dev/console 2>/dev/null || true

mark_done
exit 0
