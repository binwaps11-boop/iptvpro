
config system
	option hostname 'SmartAP-Q20'
	option ttylogin '1'
	option log_size '128'
	option urandom_seed '0'
	option compat_version '1.1'
	option zram_size_mb '64'
	option zram_comp_algo 'lzo'
	option zonename 'Asia/Aden'
	option timezone '<+03>-3'
	option log_proto 'udp'
	option conloglevel '8'
	option cronloglevel '7'

config timeserver 'ntp'
	list server '0.openwrt.pool.ntp.org'
	list server '1.openwrt.pool.ntp.org'
	list server '2.openwrt.pool.ntp.org'
	list server '3.openwrt.pool.ntp.org'

# JCG Q20 has only two status LEDs, both driven from the device tree:
#   red:status  (GPIO14) - boot / failsafe / upgrade indicator
#   blue:status (GPIO15) - solid ON while the system is running
# There are no per-port activity LEDs on this board. The device-tree aliases already
# give the right behaviour - blue steady = up, red only during boot/failsafe - so NO
# UCI led sections are defined here (the Xiaomi's blue:net / yellow:net names do not
# exist on this board). Leaving the DTS defaults in place fixes the spurious-red-light
# problem for a bridged AP: red stays OFF in normal operation.
