    OIFS="$IFS"; IFS='
'
    for row in $parsed; do
      [ -n "$row" ] || continue
      b="$(printf '%s' "$row" | cut -f1)"; s="$(printf '%s' "$row" | cut -f2)"; c="$(printf '%s' "$row" | cut -f3)"; e="$(printf '%s' "$row" | cut -f4)"
      rogue=false
      if [ -n "$e" ] && printf '%s\n' "$our_ssids" | grep -qxF "$e"; then
        printf '%s\n' "$our_bssids" | grep -qxF "$(printf '%s' "$b" | tr A-F a-f)" || { rogue=true; rogues=$((rogues+1)); }
      fi
      si="$(printf '%s' "$s" | sed 's/\..*//; s/[^0-9-]//g')"
      [ "$nf" = 1 ] || neigh_json="$neigh_json,"
      neigh_json="$neigh_json{\"ssid\":$(jstr "${e:-<hidden>}"),\"bssid\":$(jstr "$b"),\"ch\":$(jnum "$c"),\"signal\":$(jnum "$si"),\"rogue\":$rogue}"
      nf=0
    done
    IFS="$OIFS"
    neigh_json="$neigh_json]"
    # least-congested channel advice (overlap-weighted 2.4G; exact-count non-DFS 5G)
    best24="$(printf '%s' "$parsed" | awk -F'\t' '$3>0&&$3<=11{cnt[$3]++} END{ best=1; bw=1e9; split("1 6 11",cand," "); for(i in cand){c=cand[i]; w=0; for(ch in cnt) if((ch-c)<=2&&(c-ch)<=2) w+=cnt[ch]; if(w<bw){bw=w; best=c}} print best }')"
    best5="$(printf '%s' "$parsed" | awk -F'\t' '$3>=36{cnt[$3]++} END{ best=36; bw=1e9; split("36 40 44 48 149 153 157 161",cand," "); for(i in cand){c=cand[i]; w=cnt[c]+0; if(w<bw){bw=w; best=c}} print best }')"
    [ -n "$best24" ] || best24=1; [ -n "$best5" ] || best5=36
    cur24="$(uci -q get wireless.radio0.channel)"; cur5="$(uci -q get wireless.radio1.channel)"
    printf '{"ok":true,"section":"wifiscan","total":%s,"rogues":%s,"best24":%s,"best5":%s,"cur24":%s,"cur5":%s,"neighbors":%s}\n' \
      "$(jnum "$total")" "$(jnum "$rogues")" "$(jnum "$best24")" "$(jnum "$best5")" "$(jnum "$cur24")" "$(jnum "$cur5")" "$neigh_json"
    exit 0 ;;
