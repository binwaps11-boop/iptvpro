  esac
  return 0
}

section="$(param section)"; action="$(param action)"; confirm="$(param confirm)"
[ -n "$section" ] || section="control"
apply_lock="/tmp/cr6608-apply.lock"
apply_lock_owner=0
apply_lock_start() { awk '{print $22}' "/proc/$1/stat" 2>/dev/null; }
release_apply_lock() {
  cleanup_wireless_plain_backup
  [ "$apply_lock_owner" = "1" ] || return 0
  read owner_pid owner_start < "$apply_lock/owner" 2>/dev/null
  [ "$owner_pid" = "$$" ] && [ "$owner_start" = "$apply_start" ] || return 0
  rm -f "$apply_lock/owner" 2>/dev/null; rmdir "$apply_lock" 2>/dev/null
}
if [ -n "$action" ]; then
  apply_start="$(apply_lock_start "$$")"
  [ -n "$apply_start" ] || { emit false "Control" "Lock failed" "[]" "Could not identify the configuration lock owner." "[]" "[]"; exit 0; }
  apply_lock_wait=0
  while ! mkdir "$apply_lock" 2>/dev/null; do
    owner_pid=""; owner_start=""
    read owner_pid owner_start < "$apply_lock/owner" 2>/dev/null || true
    case "$owner_pid:$owner_start" in
      *[!0-9:]*|:|*:)
        apply_lock_wait=$((apply_lock_wait + 1))
        if [ "$apply_lock_wait" -ge 3 ]; then
          rm -f "$apply_lock/owner" 2>/dev/null
          rmdir "$apply_lock" 2>/dev/null || true
        else
          sleep 1
        fi
        [ "$apply_lock_wait" -le 3 ] || { emit false "Control" "Busy" "[]" "Another configuration is being applied." "[]" "[]"; exit 0; }
        continue
        ;;
    esac
    live_start="$(apply_lock_start "$owner_pid")"
    if [ -n "$live_start" ] && [ "$live_start" = "$owner_start" ]; then
      emit false "Control" "Busy" "[]" "Another configuration is being applied." "[]" "[]"; exit 0
    fi
    rm -f "$apply_lock/owner" 2>/dev/null
    rmdir "$apply_lock" 2>/dev/null || true
    apply_lock_wait=$((apply_lock_wait + 1))
    [ "$apply_lock_wait" -le 3 ] || { emit false "Control" "Busy" "[]" "Another configuration is being applied." "[]" "[]"; exit 0; }
  done
  if ! printf '%s %s\n' "$$" "$apply_start" > "$apply_lock/owner"; then
    rm -f "$apply_lock/owner" 2>/dev/null
    rmdir "$apply_lock" 2>/dev/null
    emit false "Control" "Lock failed" "[]" "Could not record the configuration lock owner." "[]" "[]"
    exit 0
  fi
  apply_lock_owner=1
  trap release_apply_lock EXIT HUP INT TERM
  case "$action" in
    keep_changes|rollback_last) ;;
    *)
      if [ -e /etc/smartap-pending-rollback ] || [ -L /etc/smartap-pending-rollback ] ||
         [ -e /tmp/smartap-rollback-armed ] || [ -L /tmp/smartap-rollback-armed ]; then
        emit false "Control" "Safe Apply pending" "[]" "Confirm or roll back the current transaction before starting another action." "[]" "[]"
        exit 0
      fi
      ;;
  esac
fi
