set_wifi_security() {
  ifc="$1"; sec="$2"; key="$3"
  [ -n "$ifc" ] || return 0
  case "$sec" in
    open)
      royal_set "wireless.$ifc.encryption=none" || return 1
      royal_delete "wireless.$ifc.key" || return 1
      ;;
    wpa2|wpa3|mixed)
      case "$sec" in wpa2) _enc="psk2" ;; wpa3) _enc="sae" ;; *) _enc="sae-mixed" ;; esac
      royal_set "wireless.$ifc.encryption=$_enc" || return 1
      royal_set "wireless.$ifc.key=$key" || return 1
      ;;
    *) return 1 ;;
  esac
}

royal_backup_valid() {
  [ -n "$1" ] && [ -r "$1" ] && tar -tzf "$1" >/dev/null 2>&1
}

action_backup() {
  _action_tag="$1"
  capture_rollback_state
  backup="$(backup_cfg "$_action_tag")" || {
    emit false "Backup" "Backup failed" "[]" "No settings were changed because the backup could not be created." "[]" "[]"
    return 1
  }
  royal_backup_valid "$backup" || {
    emit false "Backup" "Backup verification failed" "[]" "No settings were changed because the new backup is unreadable." "[]" "[]"
    return 1
  }
  return 0
}

cleanup_wireless_plain_backup() {
  case "${wireless_plain_backup:-}" in
    /tmp/cr6608-dashctl-wireless.*) rm -f "$wireless_plain_backup" 2>/dev/null ;;
  esac
  wireless_plain_backup=""
}

capture_wireless_plain_backup() {
  cleanup_wireless_plain_backup
  [ -x /usr/sbin/cr6608-safe-wifi-reload ] || return 1
  [ -f /etc/config/wireless ] && [ ! -L /etc/config/wireless ] || return 1
  wireless_plain_backup="$(mktemp /tmp/cr6608-dashctl-wireless.XXXXXX 2>/dev/null)" || return 1
  chmod 0600 "$wireless_plain_backup" 2>/dev/null || {
    cleanup_wireless_plain_backup
    return 1
  }
  cp -f /etc/config/wireless "$wireless_plain_backup" 2>/dev/null || {
    cleanup_wireless_plain_backup
    return 1
  }
  grep -Eq '^[[:space:]]*config[[:space:]]+wifi-(device|iface)([[:space:]]|$)' \
    "$wireless_plain_backup" || {
    cleanup_wireless_plain_backup
    return 1
  }
}

verified_wifi_reload() {
  _verified_wifi_scope="${1:-all}"
  case "$_verified_wifi_scope" in radio0|radio1|all) ;; *) _verified_wifi_scope=all ;; esac
  [ -r "${wireless_plain_backup:-}" ] || {
    cleanup_wireless_plain_backup
    return 1
  }
  /usr/sbin/cr6608-safe-wifi-reload 30 \
    "$wireless_plain_backup" "$_verified_wifi_scope" >/tmp/dashctl.action 2>&1
  _verified_wifi_rc=$?
  cleanup_wireless_plain_backup
  return "$_verified_wifi_rc"
}

action_capture_wireless() {
  _action_title="$1"
  capture_wireless_plain_backup || {
    emit false "$_action_title" "Wireless backup failed" "[]" "No setting was changed because a plain wireless backup or the runtime verifier was unavailable." "[]" "[]"
    return 1
  }
}

action_wifi_reload() {
  _action_title="$1"; _action_summary="$2"; _action_scope="${3:-all}"
  verified_wifi_reload "$_action_scope" && return 0
  action_rollback_pending
  emit false "$_action_title" "$_action_summary" "[]" "The configured radio/netifd roles or hostapd runtime did not become ready. $_action_rollback_text $(cat /tmp/dashctl.action 2>/dev/null | redact)" "[]" "[]"
  return 1
}

action_commit() {
  _action_pkg="$1"; _action_title="$2"
  uci commit "$_action_pkg" >/tmp/dashctl.action 2>&1 || {
    uci -q revert "$_action_pkg" >/dev/null 2>&1 || true
    action_rollback_pending
    emit false "$_action_title" "Commit failed" "[]" "Could not commit $_action_pkg. $_action_rollback_text $(cat /tmp/dashctl.action 2>/dev/null | redact)" "[]" "[]"
    return 1
  }
  return 0
}

action_rollback_pending() {
  _action_rollback_text="Automatic rollback remains armed."
  if valid_rollback_token "${rollback_token:-}" && [ -x /usr/sbin/cr6608-safe-apply ]; then
    if /usr/sbin/cr6608-safe-apply rollback "$rollback_token" >/dev/null 2>&1; then
      rollback_token=""
      _action_rollback_text="Previous settings were restored."
    else
      _action_rollback_text="Immediate rollback did not complete; the guarded rollback remains authoritative."
    fi
  fi
}

action_reload() {
  _action_title="$1"; _action_summary="$2"; shift 2
  _action_network_reload=0
  [ "${1:-}" = "/etc/init.d/network" ] && [ "${2:-}" = "reload" ] && _action_network_reload=1
  "$@" >/tmp/dashctl.action 2>&1 || {
    action_rollback_pending
    emit false "$_action_title" "$_action_summary" "[]" "$_action_rollback_text $(cat /tmp/dashctl.action 2>/dev/null | redact)" "[]" "[]"
    return 1
  }
  if [ "$_action_network_reload" = "1" ] && /etc/init.d/firewall enabled >/dev/null 2>&1; then
    /etc/init.d/firewall reload >>/tmp/dashctl.action 2>&1 || {
      action_rollback_pending
      emit false "$_action_title" "$_action_summary" "[]" "Network reloaded, but fw4 could not bind the current LAN device. $_action_rollback_text $(cat /tmp/dashctl.action 2>/dev/null | redact)" "[]" "[]"
      return 1
    }
  fi
  return 0
}

action_arm_rollback() {
  _action_title="$1"
  arm_rollback "$backup" || {
    for _action_pkg in network wireless dhcp firewall smartap cr6608quick uhttpd dropbear; do uci -q revert "$_action_pkg" >/dev/null 2>&1 || true; done
    emit false "$_action_title" "Rollback record failed" "[]" "The rollback pointer could not be armed, so no disruptive reload is allowed. Backup: $backup" "[]" "[]"
    return 1
  }
  return 0
}

royal_begin_transaction() {
  _royal_tag="$1"
  capture_rollback_state
  backup="$(backup_cfg "$_royal_tag")" || { royal_backup_error="backup creation failed"; return 1; }
  royal_backup_valid "$backup" || { royal_backup_error="backup verification failed"; return 1; }
}

royal_commit_packages() {
  royal_commit_error=""
  for _royal_pkg in "$@"; do
    uci commit "$_royal_pkg" >/dev/null 2>&1 || { royal_commit_error="$_royal_pkg"; return 1; }
  done
}

royal_restore_backup() {
	_royal_backup="$1"; _royal_reload="$2"; _royal_old_fw="$3"; _royal_old_fw_runtime="$4"
	_royal_orig_existed="$5"; _royal_smartap_existed="$6"; _royal_quick_existed="$7"; _royal_reset_existed="$8"
	_royal_old_security="$9"; _royal_old_security_runtime="${10}"
  _royal_restore_rc=0
  royal_backup_valid "$_royal_backup" || return 1
  for _royal_pkg in network wireless dhcp firewall smartap cr6608quick; do uci -q revert "$_royal_pkg" >/dev/null 2>&1 || true; done
  tar -xzf "$_royal_backup" -C / >/dev/null 2>&1 || _royal_restore_rc=1
  [ "$_royal_smartap_existed" = "0" ] && rm -f /etc/config/smartap 2>/dev/null
  [ "$_royal_quick_existed" = "0" ] && rm -f /etc/config/cr6608quick 2>/dev/null
  [ "$_royal_reset_existed" = "0" ] && rm -f /etc/rc.button/reset 2>/dev/null
  [ "$_royal_orig_existed" = "0" ] && rm -f /etc/rc.button/reset.smartap-orig 2>/dev/null
  if [ "$_royal_reload" = "1" ] && [ "$_royal_restore_rc" = "0" ]; then
    /etc/init.d/network reload >/dev/null 2>&1 || _royal_restore_rc=1
    wifi reload >/dev/null 2>&1 || _royal_restore_rc=1
    if [ -x /usr/sbin/cr6608-safe-wifi-reload ]; then
      /usr/sbin/cr6608-safe-wifi-reload --verify-only 30 all >/dev/null 2>&1 || _royal_restore_rc=1
    fi
    /etc/init.d/dnsmasq restart >/dev/null 2>&1 || _royal_restore_rc=1
	if [ "$_royal_old_security" = "1" ]; then
	  /etc/init.d/cr6608-security enable >/dev/null 2>&1 || _royal_restore_rc=1
	  if [ -x /usr/sbin/cr6608-security-apply ]; then
	    if [ "$_royal_old_security_runtime" = "1" ]; then /usr/sbin/cr6608-security-apply boot >/dev/null 2>&1 || _royal_restore_rc=1; else /usr/sbin/cr6608-security-apply clear-runtime >/dev/null 2>&1 || _royal_restore_rc=1; fi
	  fi
    else
      /etc/init.d/cr6608-security disable >/dev/null 2>&1 || _royal_restore_rc=1
      if [ -x /usr/sbin/cr6608-security-apply ]; then /usr/sbin/cr6608-security-apply clear-runtime >/dev/null 2>&1 || _royal_restore_rc=1; fi
    fi
	if [ "$_royal_old_fw" = "1" ]; then
	  /etc/init.d/firewall enable >/dev/null 2>&1 || _royal_restore_rc=1
	  if [ "$_royal_old_fw_runtime" = "1" ]; then
	    /etc/init.d/firewall start >/dev/null 2>&1 || _royal_restore_rc=1
	    /etc/init.d/firewall reload >/dev/null 2>&1 || _royal_restore_rc=1
	  else
	    /etc/init.d/firewall stop >/dev/null 2>&1 || _royal_restore_rc=1
	  fi
    else
      /etc/init.d/firewall disable >/dev/null 2>&1 || _royal_restore_rc=1
      /etc/init.d/firewall stop >/dev/null 2>&1 || _royal_restore_rc=1
    fi
  fi
  return "$_royal_restore_rc"
}

royal_reset_policy() {
  _royal_reset_original="/etc/rc.button/reset.smartap-orig"
  _royal_reset_legacy="/etc/rc.button/reset.smartap.orig"
  # Migrate the old spelling once, then use only the canonical backup filename.
  if [ ! -f "$_royal_reset_original" ] && [ -f "$_royal_reset_legacy" ]; then
    cp -f "$_royal_reset_legacy" "$_royal_reset_original" || return 1
  fi
  case "$reset_button_enabled:$reset_mode" in
    0:*|*:disabled)
      if [ ! -f "$_royal_reset_original" ]; then
        cp -f /etc/rc.button/reset "$_royal_reset_original" || return 1
      fi
      printf '%s\n' '#!/bin/sh' 'logger -t cr6608 "reset button blocked by CR6608 policy"' 'exit 0' > /etc/rc.button/reset || return 1
      chmod 0755 /etc/rc.button/reset || return 1
      ;;
    1:reboot)
      if [ ! -f "$_royal_reset_original" ]; then
        cp -f /etc/rc.button/reset "$_royal_reset_original" || return 1
      fi
      printf '%s\n' '#!/bin/sh' 'logger -t cr6608 "reset button changed to reboot-only by CR6608 policy"' 'reboot' 'exit 0' > /etc/rc.button/reset || return 1
      chmod 0755 /etc/rc.button/reset || return 1
      ;;
    1:factory)
      if [ -f "$_royal_reset_original" ]; then cp -f "$_royal_reset_original" /etc/rc.button/reset || return 1; fi
      chmod 0755 /etc/rc.button/reset || return 1
      ;;
    *) return 1 ;;
  esac
}

reset_royal_stores() {
  royal_delete smartap.quick || return 1
  royal_delete cr6608quick.default || return 1
}

royal_reset_plain_switch_policy() {
  for _royal_port in lan1 lan2; do
    uci -q get "smartap.$_royal_port" >/dev/null 2>&1 ||
      royal_set "smartap.$_royal_port=port" || return 1
    royal_set "smartap.$_royal_port.enabled=1" || return 1
    royal_set "smartap.$_royal_port.isolate=0" || return 1
    royal_set "smartap.$_royal_port.vlan=1" || return 1
    royal_set "smartap.$_royal_port.vlan_mode=auto" || return 1
  done
}

royal_apply_services() {
  royal_service_error=""
  royal_wifi_backup_dir=""
  # fw4 resolves the lan network to its current device. Reload network/VLAN
  # first, then rebuild fw4 so AP <-> AP+VLAN never keeps stale br-lan bindings.
  /etc/init.d/network reload >/dev/null 2>&1 || royal_service_error="network reload"
  [ -n "$royal_service_error" ] || retain_management_address || royal_service_error="temporary management reachability"
  if [ "$firewall_enabled" = "1" ]; then
    [ -n "$royal_service_error" ] || { /etc/init.d/firewall enable >/dev/null 2>&1 && /etc/init.d/firewall start >/dev/null 2>&1 && /etc/init.d/firewall reload >/dev/null 2>&1; } || royal_service_error="firewall enable/reload"
  else
    [ -n "$royal_service_error" ] || { /etc/init.d/firewall disable >/dev/null 2>&1 && /etc/init.d/firewall stop >/dev/null 2>&1; } || royal_service_error="firewall disable/stop"
  fi
  if [ -z "$royal_service_error" ]; then
    royal_wifi_backup_dir="$(mktemp -d /tmp/cr6608-royal-wireless.XXXXXX 2>/dev/null)" ||
      royal_service_error="wireless backup workspace"
  fi
  if [ -z "$royal_service_error" ]; then
    tar -xzf "$backup" -C "$royal_wifi_backup_dir" etc/config/wireless >/dev/null 2>&1 ||
      royal_service_error="wireless backup extraction"
  fi
  if [ -z "$royal_service_error" ]; then
    [ -x /usr/sbin/cr6608-safe-wifi-reload ] ||
      royal_service_error="wireless runtime verifier missing"
  fi
  if [ -z "$royal_service_error" ]; then
    /usr/sbin/cr6608-safe-wifi-reload 30 \
      "$royal_wifi_backup_dir/etc/config/wireless" all >/dev/null 2>&1 ||
      royal_service_error="wireless runtime verification"
  fi
  [ -z "$royal_wifi_backup_dir" ] || rm -rf "$royal_wifi_backup_dir"
  [ -n "$royal_service_error" ] || /etc/init.d/dnsmasq restart >/dev/null 2>&1 || royal_service_error="dnsmasq restart"
  if [ -z "$royal_service_error" ] && [ -x /usr/sbin/cr6608-security-apply ]; then /usr/sbin/cr6608-security-apply boot >/dev/null 2>&1 || royal_service_error="security policy apply"; fi
  [ -z "$royal_service_error" ]
}

royal_abort_transaction() {
  _royal_reason="$1"; _royal_reload="${2:-1}"; _royal_title="${3:-Quick Setup}"
  if royal_restore_backup "$backup" "$_royal_reload" "$old_firewall_enabled" "$old_firewall_runtime" "$reset_original_existed" "$smartap_existed" "$cr6608quick_existed" "$reset_script_existed" "$old_security_enabled" "$old_security_runtime"; then
    if valid_rollback_token "$rollback_token"; then
      /usr/sbin/cr6608-safe-apply confirm "$rollback_token" >/dev/null 2>&1 || true
    fi
    _royal_rollback_text="Previous settings were restored."
  else
    _royal_rollback_text="Rollback was attempted but did not complete cleanly; use the backup from SSH."
  fi
  emit false "$_royal_title" "Apply failed" "[]" "$_royal_reason $_royal_rollback_text Backup: $backup" "[]" "[]"
  exit 0
}

royal_abort_apply() {
  royal_abort_transaction "$1" 1
}
valid_config() {
  case "$1" in network|wireless|dhcp|firewall|system|sqm|uhttpd|dropbear|smartap) return 0 ;; esac
  return 1
}
reload_by_config() {
  case "$1" in
    network)
      /etc/init.d/network reload >/dev/null 2>&1 || return 1
      if /etc/init.d/firewall enabled >/dev/null 2>&1; then /etc/init.d/firewall reload >/dev/null 2>&1 || return 1; fi
      if [ -x /usr/sbin/cr6608-security-apply ]; then /usr/sbin/cr6608-security-apply boot >/dev/null 2>&1 || return 1; fi
