#!/bin/sh
# cr6608-wifi-sentinel — self-healing for the RADIOS ONLY. NEVER reboots anything.
# Cron runs it every 5 minutes: if a radio is enabled in uci but its AP interface
# has been missing for TWO consecutive checks, bring that radio back with a
# targeted `wifi up radioX` (the other radio and its clients are untouched).
# Guards: skips the first 3 minutes after boot, skips while an apply/reload is
# in flight, and heals each radio at most once per 10 minutes (no flapping).
UP="$(cut -d. -f1 /proc/uptime)"
[ "${UP:-0}" -lt 180 ] && exit 0
pgrep -f cr6608-quicksettings-apply >/dev/null 2>&1 && exit 0
pgrep -f cr6608-safe-wifi-reload   >/dev/null 2>&1 && exit 0
pgrep -f cr6608-security-apply     >/dev/null 2>&1 && exit 0
pgrep -f smartap-autochannel       >/dev/null 2>&1 && exit 0

LOCK=/tmp/cr6608-apply.lock
LOCK_OWNER=0
process_start() { awk '{print $22}' "/proc/$1/stat" 2>/dev/null; }
release_lock() {
	[ "$LOCK_OWNER" = 1 ] || return 0
	read owner_pid owner_start <"$LOCK/owner" 2>/dev/null || return 0
	[ "$owner_pid" = "$$" ] && [ "$owner_start" = "$LOCK_START" ] || return 0
	rm -f "$LOCK/owner" 2>/dev/null
	rmdir "$LOCK" 2>/dev/null || true
}
acquire_lock() {
	attempts=0
	ownerless=0
	while ! mkdir "$LOCK" 2>/dev/null; do
		owner_pid=""; owner_start=""
		read owner_pid owner_start <"$LOCK/owner" 2>/dev/null || true
		case "$owner_pid:$owner_start" in
			*[!0-9:]*|:|*:)
				ownerless=$((ownerless + 1))
				attempts=$((attempts + 1))
				if [ "$ownerless" -ge 3 ]; then
					rm -f "$LOCK/owner" 2>/dev/null
					rmdir "$LOCK" 2>/dev/null || true
				else
					sleep 1
				fi
				[ "$attempts" -le 3 ] || return 1
				continue
				;;
		esac
		live_start="$(process_start "$owner_pid")"
		[ -z "$live_start" ] || [ "$live_start" != "$owner_start" ] || return 1
		rm -f "$LOCK/owner" 2>/dev/null
		rmdir "$LOCK" 2>/dev/null || true
		attempts=$((attempts + 1))
		[ "$attempts" -le 3 ] || return 1
	done
	LOCK_START="$(process_start "$$")"
	[ -n "$LOCK_START" ] || { rmdir "$LOCK" 2>/dev/null; return 1; }
	printf '%s %s\n' "$$" "$LOCK_START" >"$LOCK/owner" || {
		rmdir "$LOCK" 2>/dev/null
		return 1
	}
	LOCK_OWNER=1
}

acquire_lock || exit 0
trap release_lock EXIT
trap 'release_lock; exit 130' HUP INT TERM
# Re-check after taking the mutex; a transaction may have started between the
# cheap preflight checks above and lock acquisition.
pgrep -f cr6608-safe-wifi-reload >/dev/null 2>&1 && exit 0
pgrep -f cr6608-security-apply >/dev/null 2>&1 && exit 0
[ -e /etc/smartap-pending-rollback ] && exit 0
[ -e /tmp/smartap-rollback-armed ] && exit 0
ST=/tmp/cr6608-wifi-sentinel
mkdir -p "$ST"

# Escalation for the DBDC zombie state (mt76 #1083: a reconfigure can kill both
# radios of the single-function MT7915 and a targeted `wifi up` does not always
# revive them). When the targeted heal has failed twice in a row, apply the
# community-documented recovery — full driver reload. Radios are bound by PCIe
# *path* in uci, so re-enumeration rebinds cleanly. At most once per hour.
escalate_driver() {
	last_esc="$(cat "$ST/escalate" 2>/dev/null || echo 0)"
	case "$last_esc" in ''|*[!0-9]*) last_esc=0 ;; esac
	[ $(( UP - last_esc )) -lt 3600 ] && return 0
	echo "$UP" > "$ST/escalate"
	logger -t cr6608-sentinel "targeted heal failed twice -> full mt7915e reload (mt76#1083 DBDC recovery); radios rebind by path"
	wifi down >/dev/null 2>&1
	sleep 2
	rmmod mt7915e >/dev/null 2>&1 || true
	sleep 1
	modprobe mt7915e >/dev/null 2>&1 || true
	sleep 3
	wifi up >/dev/null 2>&1
	rm -f "$ST/radio0.miss" "$ST/radio1.miss" "$ST/radio0.healcount" "$ST/radio1.healcount"
}

check_radio() { # $1=radioX  $2=phyX
	radio="$1"; phy="$2"
	# owner intentionally disabled it -> nothing to heal
	[ "$(uci -q get wireless.$radio.disabled)" = "1" ] && { rm -f "$ST/$radio.miss"; return 0; }
	status="$(ubus call network.wireless status 2>/dev/null)"
	ifnames="$(printf '%s\n' "$status" | jsonfilter -e "@.$radio.interfaces[*].ifname" 2>/dev/null)"
	radio_up=0
	for ifname in $ifnames; do
		if [ -d "/sys/class/net/$ifname" ] && iw dev "$ifname" info >/dev/null 2>&1; then
			radio_up=1
			break
		fi
	done
	if [ "$radio_up" = "0" ] && [ -z "$ifnames" ]; then
		iw phy "$phy" info >/dev/null 2>&1 &&
			iw dev 2>/dev/null | awk -v target="${phy#phy}" '
				/^phy#[0-9]+/ { current=$1; sub(/^phy#/, "", current) }
				$1=="Interface" && current==target { found=1 }
				END { exit !found }
			' && radio_up=1
	fi
	if [ "$radio_up" = "1" ]; then
		rm -f "$ST/$radio.miss" "$ST/$radio.healcount"
		return 0
	fi
	miss=$(( $(cat "$ST/$radio.miss" 2>/dev/null || echo 0) + 1 ))
	echo "$miss" > "$ST/$radio.miss"
	[ "$miss" -lt 2 ] && return 0
	last="$(cat "$ST/$radio.heal" 2>/dev/null || echo 0)"
	case "$last" in ''|*[!0-9]*) last=0 ;; esac
	[ $(( UP - last )) -lt 600 ] && return 0
	echo "$UP" > "$ST/$radio.heal"
	rm -f "$ST/$radio.miss"
	hc=$(( $(cat "$ST/$radio.healcount" 2>/dev/null || echo 0) + 1 ))
	echo "$hc" > "$ST/$radio.healcount"
	if [ "$hc" -ge 2 ]; then
		escalate_driver
		return 0
	fi
	logger -t cr6608-sentinel "$radio ($phy) down for 2 checks -> targeted 'wifi up $radio' (no reboot, other radio untouched)"
	wifi up "$radio" >/dev/null 2>&1
}

check_radio radio0 phy0
check_radio radio1 phy1
exit 0
