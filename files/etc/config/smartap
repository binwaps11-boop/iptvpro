config smartap 'management'
	option ipaddr '192.168.1.1'
	option recovery_always '1'
	option recovery_wifi '1'
	option vlan '1'

config smartap 'security'
	option enabled '1'
	option flood_guard '1'
	option loop_guard '1'
	option rogue_dhcp_guard '1'

config smartap 'quick'
	option txpower '38'

config smartap 'autochannel'
	option enabled '0'

config port 'lan1'
	option enabled '1'
	option isolate '0'
	option vlan '1'
	option vlan_mode 'auto'

config port 'lan2'
	option enabled '1'
	option isolate '0'
	option vlan '1'
	option vlan_mode 'auto'

config port 'lan3'
	option enabled '1'
	option isolate '0'
	option vlan '1'
	option vlan_mode 'auto'

config identity 'identity'
	option enabled '1'
	option customer_name ''
	option device_name 'CR6608'
	option phone ''
	option interval '30'
