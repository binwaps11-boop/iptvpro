<?xml version="1.0" encoding="utf-8"?>
<!-- Router HTTP on local networks remains supported. LicenseServer and AdminApi
     independently require HTTPS and reject redirects before sending credentials. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors><certificates src="system" /></trust-anchors>
    </base-config>
</network-security-config>
