# ============================================================================
# IPTV Pro — أسرار وإعدادات (انسخه إلى .env ولا ترفعه إلى Git)
#   cp .env.example .env
# ============================================================================

# ----- التطبيق -----
USER_PORT=221
ADMIN_PORT=331
ADMIN_USER=admin
ADMIN_PASSWORD=ضع-كلمة-مرور-قوية

# ============================================================================
# VPN / Egress IP  (توجيه طلبات IPTV عبر دولة مسموحة مثل المكسيك)
# ============================================================================
# تفعيل خدمة الـ VPN
VPN_ENABLED=true

# نوع الـ VPN:  wireguard (مُفضّل للأداء)  |  openvpn
VPN_TYPE=wireguard

# الدولة الأساسية = اسم ملف الإعداد داخل VPN_CONF_DIR (مثل MX.conf)
VPN_COUNTRY=MX
# دولة احتياطية تُجرَّب تلقائياً إن فشلت الأساسية (اتركها فارغة لتعطيلها)
VPN_FALLBACK_COUNTRY=

# مجلد ملفات إعداد الـ VPN (هنا تضع مفاتيحك — لا داخل الكود):
#   WireGuard:  VPN_CONF_DIR/MX.conf   (ملف WireGuard كامل من مزوّدك)
#   OpenVPN:    VPN_CONF_DIR/MX.ovpn
VPN_CONF_DIR=/etc/iptvpro/vpn

# مستخدم النظام الذي يُوجَّه ترافيكه عبر VPN (مستخدم خدمة التطبيق)
VPN_APP_USER=www-data

# Kill Switch: إن انقطع VPN يُحجب ترافيك التطبيق بدل أن يتسرّب من IP السيرفر
VPN_KILL_SWITCH=true

# فحص الصحة وإعادة الاتصال
VPN_HEALTH_INTERVAL=60
VPN_HEALTH_URL=https://ifconfig.co/json

# (اختياري) رابط API لمزوّدك لاختبار النجاح فعلياً عبر VPN — يحوي بيانات اشتراكك:
#   مثال: https://HOST/player_api.php?username=USER&password=PASS
VPN_TEST_URL=

# داخلية (لا تغيّرها عادةً)
VPN_TABLE=51820
VPN_FWMARK=0x51820
VPN_IFACE=ipvpn
