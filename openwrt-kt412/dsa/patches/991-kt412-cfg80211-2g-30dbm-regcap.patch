+static inline void kt412_lift(struct ieee80211_channel *chan)
+{
+	if (chan->center_freq >= 2400) {
+		if (chan->max_reg_power < 30)
+			chan->max_reg_power = 30;
+		if (chan->orig_mpwr && chan->orig_mpwr < 30)
+			chan->orig_mpwr = 30;
+		if (chan->max_power < 30)
+			chan->max_power = 30;
+		printk_once(KERN_INFO "KT412-30DBM-REGCAP-ACTIVE\n");
+	}
+}
+
