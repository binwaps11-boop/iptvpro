#!/bin/sh
# 42-kt412-mac-unique  -- KT412 unique per-interface MAC on first boot.
#
# WHY: cloned/template KT412 (DW02-412H) units, and some MikroTik-style images,
# ship the SAME MAC on multiple interfaces (the classic "duplicate MAC" bug):
# WAN, LAN bridge, 2.4G and 5G end up identical -> bridge loops, ARP confusion,
# upstream DHCP handing one lease, random "no internet". This script gives EACH
# interface a UNIQUE, STABLE, locally-administered MAC derived from the board's
# base MAC, so no two interfaces ever collide.
#
# Real board MACs (from the unit): 00:07:89:43:67:7a / 7b / 7e.
# We take the base OUI+NIC 00:07:89:43:67 and append a per-interface low byte,
# then SET the locally-administered bit (0x02) on the first octet so the derived
# addresses are valid LAA and never clash with the factory globally-unique ones.
# Base first octet 0x00 -> 0x02 (locally administered, unicast).
#
# Idempotent: guarded by a marker file; re-running changes nothing.
# POSIX sh. Uses uci (network device macaddr / wireless macaddr).

MARK=/etc/kt412-mac-unique.done
[ -f "$MARK" ] && exit 0

# --- base MAC (first 5 octets) + locally-administered first octet -------------
# Prefer the real board base; fall back to the device's own label MAC if present.
BASE_PREFIX="00:07:89:43:67"
LABEL="$(cat /sys/class/net/eth0/address 2>/dev/null)"
case "$LABEL" in
	[0-9A-Fa-f][0-9A-Fa-f]:*)
		# use the live label MAC's first 5 octets so derived MACs track the unit
		BASE_PREFIX="$(echo "$LABEL" | cut -d: -f1-5)"
		;;
esac

# set locally-administered bit on octet 1 (OR 0x02), clear multicast bit (AND 0xFE)
o1="$(echo "$BASE_PREFIX" | cut -d: -f1)"
rest="$(echo "$BASE_PREFIX" | cut -d: -f2-5)"
o1d=$(( 0x$o1 ))
o1d=$(( (o1d | 2) & 254 ))
LAA_PREFIX="$(printf '%02x' "$o1d"):$rest"

mac_for() { printf '%s:%s\n' "$LAA_PREFIX" "$1"; }

# Distinct low-byte offsets per interface (never reused):
WAN_MAC="$(mac_for a0)"
LAN_MAC="$(mac_for a1)"
W24_MAC="$(mac_for a2)"
W5G_MAC="$(mac_for a3)"
MESH_MAC="$(mac_for a4)"

# --- helper: find/create a network 'device' section by name, set its macaddr ---
set_dev_mac() {  # $1=ifname  $2=mac
	name="$1"; mac="$2"; sec=""
	[ -n "$name" ] || return 0
	i=0
	while uci -q get network.@device[$i] >/dev/null 2>&1; do
		[ "$(uci -q get network.@device[$i].name)" = "$name" ] && { sec="@device[$i]"; break; }
		i=$((i+1))
	done
	if [ -z "$sec" ]; then
		sec="$(uci -q add network device)"
		uci -q set network.$sec.name="$name"
	fi
	uci -q set network.$sec.macaddr="$mac"
}

# --- LAN bridge (br-lan) ---
set_dev_mac "br-lan" "$LAN_MAC"

# --- WAN: its underlying netdev (DSA wan port) ---
WANDEV="$(uci -q get network.wan.device)"; [ -n "$WANDEV" ] || WANDEV="$(uci -q get network.wan.ifname)"
[ -n "$WANDEV" ] && set_dev_mac "$WANDEV" "$WAN_MAC"

# --- 2.4G (radio0) + 5G (radio1): set macaddr on the AP wifi-iface ------------
for s in $(uci show wireless 2>/dev/null | sed -n 's/^wireless\.\([^.=]*\)=wifi-iface/\1/p'); do
	dev="$(uci -q get wireless.$s.device)"
	band="$(uci -q get wireless.$dev.band)"
	case "$s" in
		kt412_mesh) uci -q set wireless.$s.macaddr="$MESH_MAC";;
		*)
			if [ "$band" = "5g" ]; then uci -q set wireless.$s.macaddr="$W5G_MAC"
			elif [ "$band" = "2g" ]; then uci -q set wireless.$s.macaddr="$W24_MAC"; fi
			;;
	esac
done
# reserve the mesh MAC even if no mesh vif exists yet: stored as a comment-free
# placeholder is not possible in uci, so it is simply applied when a mesh vif is
# created later by the wizard (which names it kt412_mesh -> matched above on
# re-provision). The offset a4 is never used by any other interface.

uci -q commit network
uci -q commit wireless

touch "$MARK"
exit 0
