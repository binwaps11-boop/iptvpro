#!/bin/sh /etc/rc.common
# KT412 NO-AUTO-REBOOT GUARD. Runs on EVERY boot (self-healing) to GUARANTEE the
# device never reboots itself: it strips any reboot cron line, removes the legacy
# scheduled-reboot/soft-watchcat crons, and fully disables the watchcat package's
# reboot modes (ping_reboot / periodic_reboot). This is the permanent backstop on
# top of the first-boot 43-kt412-maint cleanup — even if anything ever re-introduces
# a reboot trigger, it is killed at the next boot.
#
# (The procd HW /dev/watchdog stays as the ONLY remaining reset path, and only for a
#  genuine multi-second kernel hang — never a scheduled/ping/clock-jump reboot.)
START=99
USE_PROCD=1

_strip() {
	CR=/etc/crontabs/root
	if [ -f "$CR" ]; then
		# drop any cron that runs 'reboot', plus our legacy reboot marker.
		# NOTE: do NOT strip the kt412-watchcat cron — it is a SOFT (ifdown/ifup)
		# recovery that NEVER reboots, so removing it gave no reboot-safety benefit
		# and permanently killed the soft watchdog after the first reboot.
		sed -i '/reboot/d; /kt412-maint-reboot/d' "$CR" 2>/dev/null
	fi
	# disable the watchcat package entirely (its ping_reboot/periodic_reboot modes
	# are a clean-reboot source on upstream blips / clock jumps)
	if [ -x /etc/init.d/watchcat ]; then
		/etc/init.d/watchcat stop >/dev/null 2>&1
		/etc/init.d/watchcat disable >/dev/null 2>&1
		while uci -q delete watchcat.@watchcat[0] >/dev/null 2>&1; do :; done
		uci -q commit watchcat >/dev/null 2>&1
	fi
	/etc/init.d/cron restart >/dev/null 2>&1
	logger -t kt412-noreboot "auto-reboot sources stripped (reboot cron + watchcat disabled)"
}

# THEME LOCK: force the custom dark "Smart AP" skin (luci-theme-bootstrap, which
# carries the kt412-theme.css + theme-mk.css @imports) on EVERY boot. A keep-
# settings sysupgrade preserves /etc/config/luci, so a previously-saved
# mediaurlbase (e.g. /luci-static/openwrt2020) would otherwise stick and the
# Smart AP dashboard would never come back. Re-assert it here so the user's
# interface is ALWAYS the Smart AP skin regardless of what was saved.
_themelock() {
	cur="$(uci -q get luci.main.mediaurlbase)"
	if [ "$cur" != "/luci-static/bootstrap" ]; then
		uci -q get luci.main >/dev/null 2>&1 || uci -q set luci.main=internal
		uci -q set luci.main.mediaurlbase='/luci-static/bootstrap'
		uci -q set luci.main.lang='ar'
		uci -q commit luci
		logger -t kt412-noreboot "theme reset to Smart AP (bootstrap) from '$cur'"
	fi
}

boot()  { _strip; _themelock; }
start() { _strip; _themelock; }
