#!/bin/sh /etc/rc.common
# KT412 ROBUST early WiFi bring-up. SAFE: only reloads kernel modules + `wifi up`.
# It NEVER edits the DTS/ART/caldata, so it cannot brick the radios.
#
# CONFIRMED ROOT CAUSE (from device boot logs): ath9k loads ~30s but its WMAC
# probe gets DEFERRED (the ART/nvmem caldata isn't consumed in time) and is never
# retried, so phy1 only appears at ~7 min when the cron watchdog finally does
# `rmmod/modprobe ath9k`. A module reload AFTER the ART mtd is ready always works
# (ath9k falls back to the default template and registers phy1). 5G/ath10k loads
# its firmware in ~30-90s and occasionally fails its first OTP probe.
#
# This script forces the SAME proven recovery EARLY and reliably: wait until the
# ART mtd is readable, then for ~2 min keep ensuring BOTH radios have a live AP
# iface — reloading a radio's module if its phy is missing, or just `wifi up` if
# the phy is present but the iface isn't. Idempotent; stops as soon as both bands
# are up; never touches a healthy radio.
# START early (just after netifd=20) so the mtd-gated bring-up loop begins ASAP and
# is ready the moment the ART mtd is readable. The work is backgrounded and polls, so
# starting early never blocks boot; ubus/netifd calls inside simply retry until up.
START=21
USE_PROCD=1

boot() { ( _kt412_wifi_robust ) >/dev/null 2>&1 & }
start() { boot; }

_log() { logger -t kt412-wifi-early "$1"; }

_art_ready() {
	# the ART mtd partition exists AND is openable (nvmem source for ath9k caldata)
	a="$(sed -n 's/^\(mtd[0-9]*\):.*"art".*/\1/p' /proc/mtd 2>/dev/null | head -1)"
	[ -n "$a" ] && [ -e "/dev/$a" ] && dd "if=/dev/$a" of=/dev/null bs=4 count=1 2>/dev/null
}

# live AP iface for a radio?
_iface_live() {
	ifc="$(ubus call network.wireless status 2>/dev/null | jsonfilter -e "@.$1.interfaces[0].ifname" 2>/dev/null)"
	[ -n "$ifc" ] && [ -e "/sys/class/net/$ifc" ]
}

# does a phy for this band exist? 2g advertises 24xx MHz, 5g advertises 5xxx MHz.
_phy_present() {
	case "$1" in 2g) pat='24[0-9][0-9] MHz';; *) pat='5[0-9][0-9][0-9] MHz';; esac
	for p in /sys/class/ieee80211/phy*; do
		[ -e "$p" ] || continue
		iw phy "${p##*/}" channels 2>/dev/null | grep -q "$pat" && return 0
	done
	return 1
}

_reload_band() {
	case "$1" in
		2g) _log "2.4G phy absent -> rmmod/modprobe ath9k"
		    rmmod ath9k 2>/dev/null; sleep 1; modprobe ath9k 2>/dev/null ;;
		5g) _log "5G phy absent -> reload ath10k"
		    rmmod ath10k_pci 2>/dev/null; rmmod ath10k_core 2>/dev/null; sleep 1
		    modprobe ath10k_core 2>/dev/null; modprobe ath10k_pci 2>/dev/null ;;
	esac
}

# Apply the EXISTING /etc/config/wireless to a radio so the CONFIGURED interface
# (our "KT412" SSID, HT20, open) binds — never a fallback "OpenWrt"/null-HT default.
# Order: reload netifd's config view, then `wifi reload <radio>` (re-reads the config
# file and starts the configured ifaces). Targeted ubus up + a final bare `wifi up`
# are only belt-and-suspenders AFTER the config has been (re)read. NO `wifi config`.
_apply_config() {
	r="$1"
	ubus call network.reload >/dev/null 2>&1            # netifd re-reads network/wireless
	if   wifi reload "$r"        >/dev/null 2>&1; then :  # preferred: re-read + bring up configured ifaces
	elif wifi reload            >/dev/null 2>&1; then :  # some builds: reload takes no arg
	elif /sbin/wifi reload_legacy >/dev/null 2>&1; then : # legacy fallback
	fi
	# Targeted bring-up of THIS radio (now that config is reloaded) + last-resort kick.
	ubus call network.wireless up "{\"device\":\"$r\"}" >/dev/null 2>&1
	wifi up "$r" >/dev/null 2>&1
}

_kt412_wifi_robust() {
	# 1) Gate PURELY on the ART mtd becoming readable — no fixed pre-wait. The instant
	#    caldata is available we may act, so the worst case is ~mtd-ready + a few sec
	#    (not a fixed >=22-30s floor). Poll fast (0.5s) up to a 60s safety ceiling so a
	#    pathological boot still can't hang here. (preinit normally already loaded the
	#    stack and registered phy1, in which case the loop below just does `wifi up`.)
	w=0
	while [ "$w" -lt 120 ]; do
		_art_ready && break
		w=$((w+1)); sleep 0.5 2>/dev/null || sleep 1
	done
	_log "ART readable after ~$((w/2))s; starting WiFi bring-up"

	# 2) per-band reload budget (avoid thrashing): each band reloaded at most twice
	r2g=0; r5g=0
	t=0
	while [ "$t" -lt 120 ]; do
		need=0
		for r in $(uci show wireless 2>/dev/null | sed -n 's/^wireless\.\([^.=]*\)=wifi-device/\1/p'); do
			[ "$(uci -q get wireless.$r.disabled)" = "1" ] && continue
			_iface_live "$r" && continue
			need=1
			band="$(uci -q get wireless.$r.band)"
			if ! _phy_present "$band"; then
				case "$band" in
					2g) [ "$r2g" -lt 2 ] && { _reload_band 2g; r2g=$((r2g+1)); sleep 3; } ;;
					5g) [ "$r5g" -lt 2 ] && { _reload_band 5g; r5g=$((r5g+1)); sleep 3; } ;;
				esac
				# NOTE: deliberately NO `wifi config` here. `wifi config` regenerates
				# /etc/config/wireless from detected phys and, when a radio's phy is not
				# present at that instant (exactly our late-registration case), APPENDS a
				# fresh DEFAULT section -> the device then comes up as the stray "OpenWrt"
				# AP, open, "HT Mode: null" instead of our configured "KT412"/HT20. Our
				# static /etc/config/wireless already has both radios, so we never need it.
			fi
			# phy now there (or already was) but iface missing -> APPLY THE EXISTING
			# CONFIG (not a fallback). After a late phy add / module reload, netifd's
			# view is stale, so a bare `wifi up` can bring the radio up with a default
			# template. Re-read the real config first so the CONFIGURED SSID/HT20/
			# encryption bind: reload netifd's config, then `wifi reload <radio>` (which
			# re-reads /etc/config/wireless and starts the configured ifaces). Keep a
			# `wifi up` as a last-resort kick only AFTER the config has been reloaded.
			_apply_config "$r"
		done
		[ "$need" = 0 ] && { _log "both bands up at ${t}s"; break; }
		t=$((t+4)); sleep 4
	done
}
