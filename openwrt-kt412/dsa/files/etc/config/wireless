#
# KT412 DSA Wi-Fi — shipped ENABLED with SSIDs so both radios broadcast on
# first boot (the auto-generated config ships radios DISABLED with no SSID).
# 2.4G = ath9k (QCA9550) radio0/phy1 ; 5G = ath10k (QCA9880) radio1/phy0.
# Non-DFS channels (11 & 149) -> no radar disconnects. Country US.
# The Extreme variant raises 2.4G txpower to 30 via uci-defaults at boot.
# CHANGE THE KEY before real use (or from the dashboard: الشبكة > الواي‑فاي).
#
config wifi-device 'radio0'
	option type 'mac80211'
	option path 'platform/ahb/18100000.wmac'
	option band '2g'
	option channel '11'
	option htmode 'HT40'
	option noscan '1'
	option country 'US'
	option cell_density '0'
	option disabled '0'
	option txpower '24'

config wifi-iface 'default_radio0'
	option device 'radio0'
	option network 'lan'
	option mode 'ap'
	option ssid 'KT412'
	option encryption 'psk2'
	option key 'ChangeMe12345'

config wifi-device 'radio1'
	option type 'mac80211'
	option path 'pci0000:00/0000:00:00.0'
	option band '5g'
	option channel '149'
	option htmode 'VHT80'
	option country 'US'
	option cell_density '0'
	option disabled '0'
	option txpower '30'

config wifi-iface 'default_radio1'
	option device 'radio1'
	option network 'lan'
	option mode 'ap'
	option ssid 'KT412-5G'
	option encryption 'psk2'
	option key 'ChangeMe12345'
