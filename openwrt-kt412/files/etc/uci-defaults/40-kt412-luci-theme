#!/bin/sh
# KT412 — make the custom purple-glass re-skin apply to EVERY LuCI page.
#
# Mechanism (overlay-only, no theme package compile): the file
#   /www/luci-static/bootstrap/kt412-theme.css
# is shipped in the image. luci-theme-bootstrap loads /luci-static/bootstrap/
# cascade.css on every single LuCI page, so we append a single @import line to
# the END of that cascade.css at first boot. From then on every LuCI page
# (Status, Network, System, our Smart AP views, ...) pulls in the custom
# palette/cards/gradients + RTL Arabic direction. This is robust across LuCI
# layout changes because we never replace bootstrap's own cascade.css.
#
# bootstrap stays the selected default theme (luci.main.mediaurlbase), so no
# theme switch is needed — we only ensure it is set.

CASCADE="/www/luci-static/bootstrap/cascade.css"
IMPORT='@import "kt412-theme.css";'

if [ -f "$CASCADE" ]; then
	# add the import once (idempotent across re-runs / re-flash with kept settings)
	if ! grep -qF 'kt412-theme.css' "$CASCADE" 2>/dev/null; then
		# @import must precede other rules to be valid CSS in some parsers, but
		# bootstrap's cascade.css has no @import; appending works in every browser
		# for a final override layer. Prepend to be standards-strict:
		printf '%s\n' "$IMPORT" > "$CASCADE.kt412.tmp"
		cat "$CASCADE" >> "$CASCADE.kt412.tmp"
		mv "$CASCADE.kt412.tmp" "$CASCADE"
	fi
fi

# Ensure bootstrap is the active theme so the cascade.css above is the one loaded.
uci -q get luci.main >/dev/null 2>&1 || {
	uci -q set luci.main=internal
}
uci -q set luci.main.mediaurlbase='/luci-static/bootstrap'
# Arabic UI language for the LuCI chrome (falls back to English if the i18n
# package is absent — purely cosmetic, the CSS already forces RTL).
uci -q set luci.main.lang='ar'
uci -q commit luci

exit 0
