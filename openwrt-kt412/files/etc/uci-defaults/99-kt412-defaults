#!/bin/sh
# First-boot defaults for KT412. Idempotent. Runs once, then deletes itself.

# --- Real working buttons via luci-app-commands (no fake UI) ---
# These appear under  System -> Custom Commands  with a Run button.
uci -q delete luci.kt412_reconnect 2>/dev/null
add_cmd() {
	local id="$1" name="$2" cmd="$3"
	uci -q batch <<-EOF
		set luci.$id=command
		set luci.$id.name='$name'
		set luci.$id.command='$cmd'
		set luci.$id.public='0'
	EOF
}
add_cmd kt412_reconnect   'WAN: Reconnect'        'ifup wan'
add_cmd kt412_wifi        'Wi-Fi: Restart'        'wifi'
add_cmd kt412_mwan        'Multi-WAN: Status'     'mwan3 status'
add_cmd kt412_verifyall   'Verify: All'           '/root/verify-all.sh'
add_cmd kt412_verifyports 'Verify: Ports'         '/root/verify-ports.sh'
add_cmd kt412_verifywan   'Verify: WAN'           '/root/verify-wan.sh'
add_cmd kt412_verifysvc   'Verify: Services'      '/root/verify-services.sh'
add_cmd kt412_verifywifi  'Verify: Wi-Fi'         '/root/verify-wifi.sh'
uci -q commit luci

# --- Professional UI: set Material as the default theme (modern, colored) ---
uci -q set luci.main.mediaurlbase='/luci-static/material'
uci -q set luci.main.lang='auto'
uci -q commit luci

# --- Make verify scripts executable ---
chmod 0755 /root/verify-*.sh 2>/dev/null

# --- More shortcut buttons (Dashboard quick actions) ---
uci -q batch <<-EOF
	set luci.kt412_reboot=command
	set luci.kt412_reboot.name='System: Reboot'
	set luci.kt412_reboot.command='reboot'
	set luci.kt412_reboot.public='0'
	set luci.kt412_speed=command
	set luci.kt412_speed.name='Ports: Live status'
	set luci.kt412_speed.command='swconfig dev switch0 show'
	set luci.kt412_speed.public='0'
	set luci.kt412_wifipow=command
	set luci.kt412_wifipow.name='Wi-Fi: Tx-Power (real)'
	set luci.kt412_wifipow.command='iwinfo | grep -iE "ESSID|Tx-Power"'
	set luci.kt412_wifipow.public='0'
EOF
uci -q commit luci

# --- uhttpd: keep it light (fewer workers, no keepalive flood) ---
uci -q set uhttpd.main.max_requests='3'
uci -q set uhttpd.main.max_connections='30'
uci -q commit uhttpd

# --- KT412 custom dashboard: make the API CGI executable + brand the device ---
chmod 0755 /www/cgi-bin/kt412 2>/dev/null
uci -q set system.@system[0].hostname='KT412'
uci -q commit system
# restart rpcd so the 'session' ubus object the dashboard logs in against is fresh
/etc/init.d/rpcd restart 2>/dev/null
/etc/init.d/uhttpd restart 2>/dev/null

exit 0
