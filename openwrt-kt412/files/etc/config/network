#
# KT412 / Dongwon DW02-412H  (ath79-nand, QCA9557, swconfig switch0)
# Real port map (from OpenWrt board.d):  WAN=port1  LAN1..4=ports 5,4,3,2  CPU=eth0
# Management/LAN IP = 192.168.100.1  (br-lan over the 4 LAN ports)
#
config interface 'loopback'
	option device 'lo'
	option proto 'static'
	option ipaddr '127.0.0.1'
	option netmask '255.0.0.0'

config globals 'globals'
	option ula_prefix 'fd00:4120::/48'
	# packet steering: spreads NIC IRQs across the 4 cores -> lower latency, light
	option packet_steering '1'

# ---- LAN bridge (4 LAN ports), Management ----
config interface 'lan'
	option type 'bridge'
	option ifname 'eth0.1'
	option proto 'static'
	option ipaddr '192.168.100.1'
	option netmask '255.255.255.0'
	option ip6assign '60'

# ---- WAN (default: DHCP). Templates for static/pppoe are commented below ----
config interface 'wan'
	option ifname 'eth0.2'
	option proto 'dhcp'

config interface 'wan6'
	option ifname 'eth0.2'
	option proto 'dhcpv6'

