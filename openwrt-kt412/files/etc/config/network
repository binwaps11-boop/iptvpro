#	option proto 'dhcp'

# ---- swconfig: QCA8337 on switch0 ----
config switch
	option name 'switch0'
	option reset '1'
	option enable_vlan '1'

# VLAN1 = LAN  (LAN ports 2,3,4,5 + CPU tagged)
config switch_vlan
	option device 'switch0'
	option vlan '1'
	option ports '2 3 4 5 0t'

# VLAN2 = WAN  (WAN port 1 + CPU tagged)
config switch_vlan
	option device 'switch0'
	option vlan '2'
	option ports '1 0t'

