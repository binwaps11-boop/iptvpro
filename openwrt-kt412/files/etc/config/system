config system
	option hostname 'KT412'
	option timezone 'UTC'
	option ttylogin '0'
	option log_size '64'
	option log_proto 'udp'
	option urandom_seed '0'
	# keep logs small so flash/RAM never fills
	option conloglevel '7'
	option cronloglevel '7'

config timeserver 'ntp'
	option enabled '1'
	option enable_server '0'
	list server '0.openwrt.pool.ntp.org'
	list server '1.openwrt.pool.ntp.org'

# Hardware watchdog (QCA9557 has one). procd handles it; keep enabled.
