#
# mwan3: Multi-WAN ECMP / Failover / Health-check.
# Light health probe: targets 1.1.1.1 & 8.8.8.8, interval 10s (low CPU).
# Default is single-WAN safe: with only 'wan' up, traffic uses wan normally.
# To activate ECMP/Failover: bring up 'wan2', then pick a policy in Quick Setup.
#
config globals 'globals'
	option mmx_mask '0x3F00'

# ---- WAN1 ----
config interface 'wan'
	option enabled '1'
	list track_ip '1.1.1.1'
	list track_ip '8.8.8.8'
	option family 'ipv4'
	option reliability '1'
	option count '1'
	option timeout '4'
	option interval '10'
	option down '3'
	option up '3'
	option failure_interval '5'
	option recovery_interval '10'

# ---- WAN2 (enable when a 2nd WAN interface exists) ----
config interface 'wan2'
	option enabled '0'
	list track_ip '1.1.1.1'
	list track_ip '8.8.8.8'
	option family 'ipv4'
	option reliability '1'
	option count '1'
	option timeout '4'
	option interval '10'
	option down '3'
	option up '3'

# ---- Members (metric = priority, weight = ECMP share) ----
config member 'wan_m1_w3'
	option interface 'wan'
	option metric '1'
	option weight '3'

config member 'wan_m2_w1'
	option interface 'wan'
	option metric '2'
	option weight '1'

config member 'wan2_m1_w2'
	option interface 'wan2'
	option metric '1'
	option weight '2'

config member 'wan2_m2_w1'
	option interface 'wan2'
	option metric '2'
	option weight '1'

# ---- Policies ----
# ECMP/balanced: both metric 1 -> load balanced by weight (3:2)
config policy 'balanced'
	list use_member 'wan_m1_w3'
	list use_member 'wan2_m1_w2'
	option last_resort 'unreachable'

# Failover: wan primary (metric1), wan2 backup (metric2)
config policy 'failover'
	list use_member 'wan_m1_w3'
	list use_member 'wan2_m2_w1'
	option last_resort 'unreachable'

# Single-WAN safe default: only wan
config policy 'wan_only'
	list use_member 'wan_m1_w3'
	option last_resort 'unreachable'

# ---- Rules ---- (default: wan_only; switch to balanced/failover in Quick Setup)
config rule 'default_rule'
	option dest_ip '0.0.0.0/0'
	option use_policy 'wan_only'
	option family 'ipv4'
