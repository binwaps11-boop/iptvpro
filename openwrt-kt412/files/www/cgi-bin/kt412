#!/bin/sh
# KT412 Dashboard API -- real commands only, no fake output.
# Feature parity with the things LuCI does (network/VLAN/Wi-Fi modes/system/
# logs/clients), in the custom dashboard. Auth: login with the router's root
# password -> a ubus session token, re-validated on every privileged call.
# The CGI runs as root (uhttpd); the only gate is our token check. Port 80 is
# LAN-only via the firewall, same model LuCI used.

printf 'Content-Type: application/json\r\n'
printf 'Cache-Control: no-store\r\n'
printf 'X-Content-Type-Options: nosniff\r\n'
printf '\r\n'

QS="${QUERY_STRING}"
if [ "$REQUEST_METHOD" = "POST" ]; then
	CL="${CONTENT_LENGTH:-0}"
	case "$CL" in ''|*[!0-9]*) CL=0;; esac
	if [ "$CL" -gt 0 ] && [ "$CL" -lt 1048576 ]; then
		BODY="$(head -c "$CL")"
		QS="${QS}&${BODY}"
	fi
fi

urldecode() { printf '%b' "$(printf '%s' "$1" | sed 's/+/ /g; s/%/\\x/g')"; }
getp() {
	local want="$1" pair rest
	local IFS='&'
	for pair in $QS; do
		case "$pair" in
			"$want="*) rest="${pair#*=}"; urldecode "$rest"; return 0;;
		esac
	done
	return 1
}
json_esc() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }
sani()     { printf '%s' "$1" | tr -cd 'A-Za-z0-9 ._@!#%^*()+=:/-' | cut -c1-128; }
sani_ip()  { printf '%s' "$1" | tr -cd '0-9.' | cut -c1-15; }
sani_int() { printf '%s' "$1" | tr -cd '0-9' | cut -c1-9; }
sani_hex() { printf '%s' "$1" | tr -cd 'a-f0-9' | cut -c1-32; }
sani_word(){ printf '%s' "$1" | tr -cd 'A-Za-z0-9_-' | cut -c1-24; }
fail()     { printf '{"ok":false,"error":"%s"}\n' "$1"; exit 0; }

OP="$(getp op | tr -cd 'a-z_')"

# ---------- login (bootstrap, no token required) ----------
if [ "$OP" = "login" ]; then
	PW="$(getp password)"
	ESC="$(json_esc "$PW")"
	SID="$(ubus call session login "{\"username\":\"root\",\"password\":\"$ESC\",\"timeout\":3600}" 2>/dev/null | jsonfilter -e '@.ubus_rpc_session' 2>/dev/null)"
	if [ -n "$SID" ]; then
		ubus call session set "{\"ubus_rpc_session\":\"$SID\",\"values\":{\"kt412ok\":\"1\"}}" >/dev/null 2>&1
		printf '{"ok":true,"token":"%s"}\n' "$SID"
	else
		fail "bad_password"
	fi
	exit 0
fi

# ---------- everything else requires a valid session ----------
TOK="$(sani_hex "$(getp token)")"
[ -n "$TOK" ] || fail "no_token"
MARK="$(ubus call session get "{\"ubus_rpc_session\":\"$TOK\"}" 2>/dev/null | jsonfilter -e '@.values.kt412ok' 2>/dev/null)"
[ "$MARK" = "1" ] || fail "unauthorized"
ubus call session set "{\"ubus_rpc_session\":\"$TOK\",\"values\":{\"kt412ok\":\"1\"}}" >/dev/null 2>&1

wifi_iface_for() {  # $1 = radio  -> echoes the wifi-iface section name
	local s d
	for s in $(uci show wireless 2>/dev/null | sed -n "s/^wireless\.\([^.=]*\)=wifi-iface/\1/p"); do
		d="$(uci -q get wireless.$s.device)"
		[ "$d" = "$1" ] && { echo "$s"; return 0; }
	done
	return 1
}

# ---------- actions (state changing, POST only) ----------
ACT="$(getp act | tr -cd 'a-z_')"
if [ -n "$ACT" ]; then
	[ "$REQUEST_METHOD" = "POST" ] || fail "post_required"
	case "$ACT" in
		wan_dhcp)
			uci set network.wan.proto='dhcp'
			uci -q delete network.wan.username; uci -q delete network.wan.password
			uci commit network; ifup wan >/dev/null 2>&1
			printf '{"ok":true,"msg":"WAN -> DHCP"}\n';;
		wan_pppoe)
			u="$(getp user)"; p="$(getp pass)"   # raw (NOT sani) so & ? " in passwords survive
			uci set network.wan.proto='pppoe'
			uci set network.wan.username="$u"; uci set network.wan.password="$p"
			uci set network.wan.ipv6='auto'
			uci set network.wan.mtu='1492'   # PPPoE MTU clamp (avoid large-packet blackhole)
			uci commit network; ifup wan >/dev/null 2>&1
			printf '{"ok":true,"msg":"WAN -> PPPoE (%s)"}\n' "$(json_esc "$u")";;
		wan_static)
			ip="$(sani_ip "$(getp ip)")"; mask="$(sani_ip "$(getp mask)")"
			gw="$(sani_ip "$(getp gw)")"; dns="$(sani_ip "$(getp dns)")"
			[ -n "$ip" ] || fail "no_ip"
			uci set network.wan.proto='static'
			uci set network.wan.ipaddr="$ip"
			uci set network.wan.netmask="${mask:-255.255.255.0}"
			[ -n "$gw" ] && uci set network.wan.gateway="$gw"
			[ -n "$dns" ] && uci set network.wan.dns="$dns"
			uci commit network; ifup wan >/dev/null 2>&1
			printf '{"ok":true,"msg":"WAN -> Static"}\n';;
		wan_reconnect)
			ifup wan >/dev/null 2>&1
			printf '{"ok":true,"msg":"WAN reconnecting"}\n';;
		wan_vlan)
			vid="$(sani_int "$(getp vid)")"
			[ -n "$vid" ] || fail "no_vid"
			if command -v swconfig >/dev/null 2>&1 && swconfig dev switch0 show >/dev/null 2>&1; then
				# swconfig: retag the WAN switch_vlan + point wan at eth0.<vid>
				for v in $(uci show network 2>/dev/null | sed -n "s/^network\.\(@switch_vlan\[[0-9]*\]\)\.ports=.*/\1/p"); do
					pr="$(uci -q get network.$v.ports)"
					case "$pr" in *"1 "*|*" 1"*|"1"*) uci set network.$v.vlan="$vid";; esac
				done
				uci set network.wan.ifname="eth0.$vid"
				uci -q set network.wan.device="eth0.$vid"
				uci -q set network.wan6.ifname="eth0.$vid"
			else
				# DSA: tag the wan netdev
				uci set network.wan.device="wan.$vid"
				uci -q set network.wan6.device="wan.$vid"
			fi
			uci commit network
			/etc/init.d/network reload >/dev/null 2>&1; ifup wan >/dev/null 2>&1
			printf '{"ok":true,"msg":"WAN VLAN tag = %s"}\n' "$vid";;
		net_mode)
			mode="$(getp mode | tr -cd 'a-z')"
			wandev="$(uci -q get network.wan.device 2>/dev/null)"; [ -n "$wandev" ] || wandev="$(uci -q get network.wan.ifname 2>/dev/null)"
			brsec=""; i=0
			while uci -q get network.@device[$i] >/dev/null 2>&1; do
				[ "$(uci -q get network.@device[$i].name)" = "br-lan" ] && brsec="@device[$i]"
				i=$((i+1))
			done
			case "$mode" in
				ap)
					# dumb AP / switch: bridge WAN port into LAN, DHCP server off,
					# keep mgmt 192.168.100.1 so access is never lost. PPPoE stays WAN-only.
					if [ -n "$brsec" ] && [ -n "$wandev" ]; then
						uci -q del_list network.$brsec.ports="$wandev"
						uci -q add_list network.$brsec.ports="$wandev"
					elif [ -n "$wandev" ]; then
						cur="$(uci -q get network.lan.ifname 2>/dev/null)"
						case " $cur " in *" $wandev "*) :;; *) uci -q set network.lan.ifname="${cur:+$cur }$wandev";; esac
					fi
					uci -q set network.wan.disabled='1'; uci -q set network.wan.auto='0'
					uci -q set dhcp.lan.ignore='1'
					uci commit
					/etc/init.d/network reload >/dev/null 2>&1; /etc/init.d/dnsmasq restart >/dev/null 2>&1
					printf '{"ok":true,"msg":"Access Point: كل المنافذ موصولة، DHCP معطّل، الإدارة تبقى 192.168.100.1"}\n';;
				router)
					if [ -n "$brsec" ] && [ -n "$wandev" ]; then uci -q del_list network.$brsec.ports="$wandev"; fi
					if [ -n "$wandev" ]; then
						cur="$(uci -q get network.lan.ifname 2>/dev/null)"
						[ -n "$cur" ] && uci -q set network.lan.ifname="$(echo "$cur" | sed "s/ *$wandev//")"
					fi
					uci -q delete network.wan.disabled; uci -q delete network.wan.auto
					# DHCP stays as-is (off by default); control it from LAN > خادم DHCP.
					uci commit
					/etc/init.d/network reload >/dev/null 2>&1; /etc/init.d/dnsmasq restart >/dev/null 2>&1; ifup wan >/dev/null 2>&1
					printf '{"ok":true,"msg":"Router: WAN إنترنت + NAT (DHCP حسب الزر في LAN)"}\n';;
				*) fail "bad_mode";;
			esac;;
		vlan_add)
			vid="$(sani_int "$(getp vid)")"; ip="$(sani_ip "$(getp ip)")"; dh="$(getp dhcp | tr -cd '01')"
			routing="$(getp routing | tr -cd 'a-z')"; [ -n "$routing" ] || routing=internet   # KT412-VLAN-INTER
			allowv="$(getp allow_vids | tr -cd '0-9,')"
			dnsm="$(getp dns_mode | tr -cd 'a-z')"; [ -n "$dnsm" ] || dnsm=auto                # KT412-VLAN-DNS
			dns1="$(sani_ip "$(getp dns1)")"; dns2="$(sani_ip "$(getp dns2)")"
			nat="$(getp nat | tr -cd 'a-z')"; [ -n "$nat" ] || nat=on                          # KT412-VLAN-NAT
			[ -n "$vid" ] && [ "$vid" -ge 2 ] 2>/dev/null && [ "$vid" -le 4094 ] 2>/dev/null || fail "bad_vid"
			vip="${ip:-192.168.$vid.1}"
			brsec=""; i=0
			while uci -q get network.@device[$i] >/dev/null 2>&1; do
				[ "$(uci -q get network.@device[$i].name)" = "br-lan" ] && brsec="@device[$i]"; i=$((i+1))
			done
			[ -n "$brsec" ] || fail "no_bridge"
			uci -q set network.$brsec.vlan_filtering='1'
			# default VLAN 1 untagged + pvid on lan ports so MANAGEMENT survives filtering
			if ! uci show network 2>/dev/null | grep -q "vlan='1'"; then
				v1="$(uci add network bridge-vlan)"; uci set network.$v1.device='br-lan'; uci set network.$v1.vlan='1'
				for pp in lan1 lan2 lan3 lan4; do uci add_list network.$v1.ports="$pp:u*"; done
			fi
			vs="$(uci add network bridge-vlan)"; uci set network.$vs.device='br-lan'; uci set network.$vs.vlan="$vid"
			for pp in lan1 lan2 lan3 lan4; do uci add_list network.$vs.ports="$pp:t"; done
			uci set network.vlan$vid=interface; uci set network.vlan$vid.device="br-lan.$vid"
			uci set network.vlan$vid.proto='static'; uci set network.vlan$vid.ipaddr="$vip"; uci set network.vlan$vid.netmask='255.255.255.0'
			if [ "$dh" = "1" ]; then
				uci set dhcp.vlan$vid=dhcp; uci set dhcp.vlan$vid.interface="vlan$vid"
				uci set dhcp.vlan$vid.start='100'; uci set dhcp.vlan$vid.limit='150'; uci set dhcp.vlan$vid.leasetime='12h'
				case "$dnsm" in   # DNS per VLAN via DHCP option 6
					router|forced) uci add_list dhcp.vlan$vid.dhcp_option="6,$vip";;
					manual) o="6,${dns1:-1.1.1.1}"; [ -n "$dns2" ] && o="$o,$dns2"; uci add_list dhcp.vlan$vid.dhcp_option="$o";;
				esac
			fi
			z="$(uci add firewall zone)"; uci set firewall.$z.name="vlan$vid"; uci add_list firewall.$z.network="vlan$vid"
			uci set firewall.$z.input='ACCEPT'; uci set firewall.$z.output='ACCEPT'
			case "$routing" in inter) uci set firewall.$z.forward='ACCEPT';; *) uci set firewall.$z.forward='REJECT';; esac
			# internet via WAN NAT, unless nat=off or routing=isolated
			if [ "$nat" != "off" ] && [ "$routing" != "isolated" ]; then
				fwd="$(uci add firewall forwarding)"; uci set firewall.$fwd.src="vlan$vid"; uci set firewall.$fwd.dest='wan'
			fi
			if [ "$routing" = "inter" ]; then           # full inter-VLAN (with mgmt LAN)
				f2="$(uci add firewall forwarding)"; uci set firewall.$f2.src="vlan$vid"; uci set firewall.$f2.dest='lan'
				f3="$(uci add firewall forwarding)"; uci set firewall.$f3.src='lan'; uci set firewall.$f3.dest="vlan$vid"
			elif [ "$routing" = "selected" ] && [ -n "$allowv" ]; then   # route to selected VLANs only
				oIFS="$IFS"; IFS=','; for t in $allowv; do t="$(printf '%s' "$t" | tr -cd '0-9')"; [ -n "$t" ] || continue
					fa="$(uci add firewall forwarding)"; uci set firewall.$fa.src="vlan$vid"; uci set firewall.$fa.dest="vlan$t"
					fb="$(uci add firewall forwarding)"; uci set firewall.$fb.src="vlan$t"; uci set firewall.$fb.dest="vlan$vid"
				done; IFS="$oIFS"
			fi
			if [ "$dnsm" = "forced" ]; then             # force clients to router DNS (hijack 53)
				rd="$(uci add firewall redirect)"; uci set firewall.$rd.name="vlan$vid-dns"; uci set firewall.$rd.src="vlan$vid"
				uci set firewall.$rd.proto='tcp udp'; uci set firewall.$rd.src_dport='53'; uci set firewall.$rd.dest_ip="$vip"; uci set firewall.$rd.dest_port='53'; uci set firewall.$rd.target='DNAT'
			fi
			uci commit
			/etc/init.d/network reload >/dev/null 2>&1; /etc/init.d/dnsmasq restart >/dev/null 2>&1; /etc/init.d/firewall reload >/dev/null 2>&1
			printf '{"ok":true,"msg":"VLAN %s: routing=%s NAT=%s DNS=%s IP %s"}\n' "$vid" "$routing" "$nat" "$dnsm" "$(json_esc "$vip")";;
		vlan_import)
			data="$(getp config)"; [ -n "$data" ] || fail "no_data"
			dec="$(printf '%s' "$data" | base64 -d 2>/dev/null)"
			printf '%s' "$dec" | grep -q 'vlan' || fail "invalid_config"   # validate before apply
			printf '%s\n' "$dec" | while IFS= read -r line; do
				case "$line" in
					network.*vlan*=*|dhcp.*vlan*=*|firewall.*vlan*=*) uci set "$line" 2>/dev/null;;
				esac
			done
			uci commit
			/etc/init.d/network reload >/dev/null 2>&1; /etc/init.d/dnsmasq restart >/dev/null 2>&1; /etc/init.d/firewall reload >/dev/null 2>&1
			printf '{"ok":true,"msg":"تم استيراد إعداد VLAN (محمي بـ Safe Apply)"}\n';;
		vlan_del)
			vid="$(sani_int "$(getp vid)")"; [ -n "$vid" ] && [ "$vid" != "1" ] || fail "protected_vid"
			i=0; while uci -q get network.@bridge-vlan[$i] >/dev/null 2>&1; do
				if [ "$(uci -q get network.@bridge-vlan[$i].vlan)" = "$vid" ]; then uci delete network.@bridge-vlan[$i]; else i=$((i+1)); fi
			done
			uci -q delete network.vlan$vid; uci -q delete dhcp.vlan$vid
			j=0; while uci -q get firewall.@zone[$j] >/dev/null 2>&1; do
				if [ "$(uci -q get firewall.@zone[$j].name)" = "vlan$vid" ]; then uci delete firewall.@zone[$j]; else j=$((j+1)); fi
			done
			k=0; while uci -q get firewall.@forwarding[$k] >/dev/null 2>&1; do
				if [ "$(uci -q get firewall.@forwarding[$k].src)" = "vlan$vid" ]; then uci delete firewall.@forwarding[$k]; else k=$((k+1)); fi
			done
			uci commit
			/etc/init.d/network reload >/dev/null 2>&1; /etc/init.d/dnsmasq restart >/dev/null 2>&1; /etc/init.d/firewall reload >/dev/null 2>&1
			printf '{"ok":true,"msg":"VLAN %s حُذف"}\n' "$vid";;
		vlan_port)
			vid="$(sani_int "$(getp vid)")"; port="$(sani_word "$(getp port)")"; mode="$(getp mode | tr -cd 'a-z')"
			[ -n "$vid" ] && [ -n "$port" ] || fail "missing"
			i=0; sec=""
			while uci -q get network.@bridge-vlan[$i] >/dev/null 2>&1; do
				[ "$(uci -q get network.@bridge-vlan[$i].vlan)" = "$vid" ] && sec="@bridge-vlan[$i]"; i=$((i+1))
			done
			[ -n "$sec" ] || fail "no_vlan"
			# remove any existing entry for this port, then add new
			for e in $(uci -q get network.$sec.ports); do
				case "$e" in "$port"|"$port:"*) uci -q del_list network.$sec.ports="$e";; esac
			done
			case "$mode" in
				untagged) uci add_list network.$sec.ports="$port:u*";;
				tagged)   uci add_list network.$sec.ports="$port:t";;
				off)      : ;;  # leave removed
				*)        uci add_list network.$sec.ports="$port:t";;
			esac
			uci commit network; /etc/init.d/network reload >/dev/null 2>&1
			printf '{"ok":true,"msg":"المنفذ %s -> VLAN %s (%s)"}\n' "$port" "$vid" "${mode:-tagged}";;
		vlan_ssid)
			sec="$(sani_word "$(getp ssid)")"; vid="$(sani_int "$(getp vid)")"
			[ -n "$sec" ] || fail "no_ssid"
			if [ -z "$vid" ] || [ "$vid" = "1" ]; then uci set wireless.$sec.network='lan'; else uci set wireless.$sec.network="vlan$vid"; fi
			uci commit wireless; wifi reload >/dev/null 2>&1
			printf '{"ok":true,"msg":"SSID -> %s"}\n' "$([ -z "$vid" ] || [ "$vid" = 1 ] && echo lan || echo vlan$vid)";;
		vlan_reset)
			n=0; while [ "$n" -lt 64 ] && uci -q delete network.@bridge-vlan[0] 2>/dev/null; do n=$((n+1)); done
			for n in $(uci show network 2>/dev/null | sed -n "s/^network\.\(vlan[0-9]*\)=interface/\1/p"); do uci -q delete network.$n; done
			for d in $(uci show dhcp 2>/dev/null | sed -n "s/^dhcp\.\(vlan[0-9]*\)=dhcp/\1/p"); do uci -q delete dhcp.$d; done
			j=0; while uci -q get firewall.@zone[$j] >/dev/null 2>&1; do
				case "$(uci -q get firewall.@zone[$j].name)" in vlan[0-9]*) uci delete firewall.@zone[$j];; *) j=$((j+1));; esac
			done
			k=0; while uci -q get firewall.@forwarding[$k] >/dev/null 2>&1; do
				case "$(uci -q get firewall.@forwarding[$k].src)" in vlan[0-9]*) uci delete firewall.@forwarding[$k];; *) k=$((k+1));; esac
			done
			brsec=""; i=0; while uci -q get network.@device[$i] >/dev/null 2>&1; do
				[ "$(uci -q get network.@device[$i].name)" = "br-lan" ] && brsec="@device[$i]"; i=$((i+1)); done
			[ -n "$brsec" ] && uci -q delete network.$brsec.vlan_filtering
			uci commit
			/etc/init.d/network reload >/dev/null 2>&1; /etc/init.d/dnsmasq restart >/dev/null 2>&1; /etc/init.d/firewall reload >/dev/null 2>&1
			printf '{"ok":true,"msg":"تمت إعادة ضبط VLAN (الإدارة سليمة)"}\n';;
		wifi_apply)
			radio="$(sani_word "$(getp radio)")"
			ssid="$(sani "$(getp ssid)")"; key="$(sani "$(getp key)")"
			mode="$(printf '%s' "$(getp mode)" | tr -cd 'a-z-')"
			chan="$(sani_word "$(getp channel)")"; htmode="$(sani_word "$(getp htmode)")"
			country="$(printf '%s' "$(getp country)" | tr -cd 'A-Za-z' | cut -c1-2 | tr a-z A-Z)"
			hidden="$(getp hidden | tr -cd '01')"
			[ -n "$radio" ] || fail "no_radio"
			ifsec="$(wifi_iface_for "$radio")"
			[ -n "$ifsec" ] || fail "radio_not_found"
			[ -n "$mode" ] || mode=ap
			# reset mode-specific options first
			uci -q delete wireless.$ifsec.wds
			uci -q delete wireless.$ifsec.mesh_id
			case "$mode" in
				mesh)
					uci set wireless.$ifsec.mode='mesh'
					uci set wireless.$ifsec.mesh_id="${ssid:-kt412-mesh}"
					uci -q delete wireless.$ifsec.ssid
					if [ -n "$key" ]; then uci set wireless.$ifsec.encryption='sae'; uci set wireless.$ifsec.key="$key"
					else uci set wireless.$ifsec.encryption='none'; uci -q delete wireless.$ifsec.key; fi;;
				sta)
					uci set wireless.$ifsec.mode='sta'
					uci set wireless.$ifsec.ssid="$ssid"
					if [ -n "$key" ]; then uci set wireless.$ifsec.encryption='psk2'; uci set wireless.$ifsec.key="$key"
					else uci set wireless.$ifsec.encryption='none'; uci -q delete wireless.$ifsec.key; fi;;
				ap-wds)
					uci set wireless.$ifsec.mode='ap'; uci set wireless.$ifsec.wds='1'
					uci set wireless.$ifsec.ssid="$ssid"
					if [ -n "$key" ]; then uci set wireless.$ifsec.encryption='psk2'; uci set wireless.$ifsec.key="$key"
					else uci set wireless.$ifsec.encryption='none'; uci -q delete wireless.$ifsec.key; fi;;
				*)
					uci set wireless.$ifsec.mode='ap'
					uci set wireless.$ifsec.ssid="$ssid"
					if [ -n "$key" ]; then uci set wireless.$ifsec.encryption='psk2'; uci set wireless.$ifsec.key="$key"
					else uci set wireless.$ifsec.encryption='none'; uci -q delete wireless.$ifsec.key; fi;;
			esac
			[ -n "$hidden" ] && uci set wireless.$ifsec.hidden="$hidden"
			[ -n "$chan" ] && uci set wireless.$radio.channel="$chan"
			[ -n "$htmode" ] && uci set wireless.$radio.htmode="$htmode"
			[ -n "$country" ] && uci set wireless.$radio.country="$country"
			uci -q delete wireless.$radio.disabled
			uci commit wireless; wifi reload >/dev/null 2>&1
			printf '{"ok":true,"msg":"Wi-Fi updated (%s)"}\n' "$mode";;
		wifi_toggle)
			radio="$(sani_word "$(getp radio)")"; on="$(getp on | tr -cd '01')"
			[ -n "$radio" ] || fail "no_radio"
			if [ "$on" = "1" ]; then uci -q delete wireless.$radio.disabled; else uci set wireless.$radio.disabled='1'; fi
			uci commit wireless; wifi reload >/dev/null 2>&1
			printf '{"ok":true,"msg":"radio %s"}\n' "$([ "$on" = 1 ] && echo on || echo off)";;
		txpower)
			radio="$(sani_word "$(getp radio)")"; dbm="$(sani_int "$(getp dbm)")"
			[ -n "$radio" ] && [ -n "$dbm" ] || fail "missing_params"
			# clamp to the allowed range 0..30 (Max allowed = 30, Min = 0)
			[ "$dbm" -gt 30 ] 2>/dev/null && dbm=30
			[ "$dbm" -lt 0 ] 2>/dev/null && dbm=0
			uci set wireless.$radio.txpower="$dbm"; uci commit wireless
			idx="$(printf '%s' "$radio" | tr -cd '0-9')"
			# resolve the REAL phy + live iface via ubus (phy index != radio index here)
			dev="$(ubus call network.wireless status 2>/dev/null | jsonfilter -e "@.$radio.interfaces[0].ifname" 2>/dev/null)"
			[ -n "$dev" ] || dev="$(iwinfo 2>/dev/null | sed -n 's/^\([A-Za-z0-9._-]*\) *ESSID:.*/\1/p' | sed -n "$((idx+1))p")"
