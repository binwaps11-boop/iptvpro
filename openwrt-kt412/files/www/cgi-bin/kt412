			# NEVER remove packages whose loss bricks the dashboard or a radio (no UI recovery)
			case "$nm" in
				uhttpd|uhttpd-mod-ubus|libuhttpd*|rpcd|rpcd-mod-*|ubus*|ubusd|libubox*|uci|libuci*|netifd|procd*|\
				busybox|dropbear|mtd|fwtool|jsonfilter|libjson*|\
				kmod-ath9k|kmod-ath10k-ct|ath10k-firmware-*|kmod-mac80211|kmod-cfg80211|wpad*|hostapd*|wireless-regdb|\
				kmod-nft-*|nftables|firewall4|dnsmasq*|odhcpd*|kmod-qca8k*|kmod-mdio*)
					fail "protected_pkg";;
			esac
			out="$( (apk del "$nm" 2>&1 || opkg remove "$nm" 2>&1) | tail -8 )"
			b="$(printf '%s' "$out" | base64 2>/dev/null | tr -d '\n')"
			printf '{"ok":true,"msg":"إزالة %s","log":"%s"}\n' "$(json_esc "$nm")" "$b";;

		# ===================== SERVICES TOGGLES (ddns/upnp/adblock) =====================
		ddns_set)      # domain provider user pass
			dm="$(sani "$(getp domain)")"; pv="$(sani_word "$(getp provider)")"; u="$(sani "$(getp user)")"; p="$(sani "$(getp pass)")"
			[ -n "$dm" ] || fail "no_domain"
			uci set ddns.kt=service; uci set ddns.kt.enabled='1'
			uci set ddns.kt.service_name="${pv:-dyndns.org}"; uci set ddns.kt.domain="$dm"
			[ -n "$u" ] && uci set ddns.kt.username="$u"; [ -n "$p" ] && uci set ddns.kt.password="$p"
			uci set ddns.kt.ip_source='network'; uci set ddns.kt.ip_network='wan'
			uci commit ddns; /etc/init.d/ddns enable >/dev/null 2>&1; /etc/init.d/ddns restart >/dev/null 2>&1
			printf '{"ok":true,"msg":"DDNS مفعّل لـ %s"}\n' "$(json_esc "$dm")";;
		upnp_toggle)
			en="$(getp enabled | tr -cd '01')"
			uci -q get upnpd.config >/dev/null 2>&1 || { uci set upnpd.config=upnpd; }
			uci set upnpd.config.enabled="${en:-0}"
			uci commit upnpd
			if [ "$en" = "1" ]; then /etc/init.d/miniupnpd enable >/dev/null 2>&1; /etc/init.d/miniupnpd restart >/dev/null 2>&1
			else /etc/init.d/miniupnpd stop >/dev/null 2>&1; /etc/init.d/miniupnpd disable >/dev/null 2>&1; fi
			printf '{"ok":true,"msg":"UPnP: %s"}\n' "$( [ "$en" = "1" ] && echo مفعّل || echo معطّل )";;
		adblock_toggle)
			en="$(getp enabled | tr -cd '01')"
			uci -q get adblock.global >/dev/null 2>&1 || uci set adblock.global=adblock
			uci set adblock.global.adb_enabled="${en:-0}"; uci commit adblock
			if [ "$en" = "1" ]; then /etc/init.d/adblock enable >/dev/null 2>&1; /etc/init.d/adblock restart >/dev/null 2>&1
			else /etc/init.d/adblock stop >/dev/null 2>&1; /etc/init.d/adblock disable >/dev/null 2>&1; fi
			printf '{"ok":true,"msg":"حجب الإعلانات: %s"}\n' "$( [ "$en" = "1" ] && echo مفعّل || echo معطّل )";;

		# ===================== GUEST WIFI (one-click, isolated) =====================
		guest_wifi)    # enabled ssid key  -> isolated SSID + subnet 192.168.180.0/24 + WAN-only
			en="$(getp enabled | tr -cd '01')"; ss="$(sani "$(getp ssid)")"; ky="$(sani "$(getp key)")"
			if [ "$en" = "1" ]; then
				[ -n "$ss" ] || ss="KT412-Guest"
				uci set network.guest=interface; uci set network.guest.proto='static'
				uci set network.guest.ipaddr='192.168.180.1'; uci set network.guest.netmask='255.255.255.0'
				uci set dhcp.guest=dhcp; uci set dhcp.guest.interface='guest'
				uci set dhcp.guest.start='100'; uci set dhcp.guest.limit='100'; uci set dhcp.guest.leasetime='4h'
				uci -q delete dhcp.guest.ignore
				for r in $(uci show wireless 2>/dev/null | sed -n 's/^wireless\.\([^.=]*\)=wifi-device/\1/p'); do
					gi="guest_$r"
					uci set wireless.$gi=wifi-iface; uci set wireless.$gi.device="$r"
					uci set wireless.$gi.mode='ap'; uci set wireless.$gi.network='guest'
					uci set wireless.$gi.ssid="$ss"; uci set wireless.$gi.isolate='1'
					if [ -n "$ky" ]; then uci set wireless.$gi.encryption='psk2'; uci set wireless.$gi.key="$ky"
					else uci set wireless.$gi.encryption='none'; fi
				done
				uci set firewall.guest=zone; uci set firewall.guest.name='guest'
				uci set firewall.guest.network='guest'; uci set firewall.guest.input='REJECT'
				uci set firewall.guest.output='ACCEPT'; uci set firewall.guest.forward='REJECT'
				uci set firewall.guest_fw=forwarding; uci set firewall.guest_fw.src='guest'; uci set firewall.guest_fw.dest='wan'
				uci set firewall.guest_dns=rule; uci set firewall.guest_dns.name='guest-dns'; uci set firewall.guest_dns.src='guest'
				uci set firewall.guest_dns.dest_port='53'; uci set firewall.guest_dns.target='ACCEPT'
				uci set firewall.guest_dh=rule; uci set firewall.guest_dh.name='guest-dhcp'; uci set firewall.guest_dh.src='guest'
				uci set firewall.guest_dh.dest_port='67'; uci set firewall.guest_dh.target='ACCEPT'
				uci commit; /etc/init.d/network reload >/dev/null 2>&1; wifi reload >/dev/null 2>&1
				/etc/init.d/dnsmasq restart >/dev/null 2>&1; /etc/init.d/firewall reload >/dev/null 2>&1
				printf '{"ok":true,"msg":"شبكة الضيوف مفعّلة: %s (معزولة)"}\n' "$(json_esc "$ss")"
			else
				for s in $(uci show wireless 2>/dev/null | sed -n 's/^wireless\.\(guest_[^.=]*\)=wifi-iface/\1/p'); do uci -q delete wireless.$s; done
				uci -q delete network.guest; uci -q delete dhcp.guest
				uci -q delete firewall.guest; uci -q delete firewall.guest_fw
				uci -q delete firewall.guest_dns; uci -q delete firewall.guest_dh
				uci commit; /etc/init.d/network reload >/dev/null 2>&1; wifi reload >/dev/null 2>&1
				/etc/init.d/dnsmasq restart >/dev/null 2>&1; /etc/init.d/firewall reload >/dev/null 2>&1
				printf '{"ok":true,"msg":"شبكة الضيوف معطّلة"}\n'
			fi;;

		# ===================== RESTORE CONFIG (from backup) =====================
		restore_cfg)   # body = base64 of a tar.gz of etc/config
			b="$(getp body)"
			printf '%s' "$b" | base64 -d 2>/dev/null > /tmp/kt-restore.tgz || fail "bad_data"
			tar tzf /tmp/kt-restore.tgz >/dev/null 2>&1 || fail "bad_archive"
			cp -a /etc/config /etc/config.bak.$$ 2>/dev/null
			tar xzf /tmp/kt-restore.tgz -C / 2>/dev/null && { uci commit; for s in network dhcp firewall wireless system; do /etc/init.d/$s reload >/dev/null 2>&1; done; printf '{"ok":true,"msg":"تمت استعادة الإعدادات (نسخة احتياطية محفوظة)"}\n'; } || fail "restore_failed"
			rm -f /tmp/kt-restore.tgz;;

		# ===================== INTERFACES (enable/disable + MTU) =====================
		iface_toggle)
			ifc="$(sani_word "$(getp iface)")"; on="$(getp on | tr -cd '01')"; [ -n "$ifc" ] || fail "no_iface"
			if [ "$on" = "0" ]; then uci -q set network.$ifc.disabled='1'; ifdown "$ifc" >/dev/null 2>&1
			else uci -q delete network.$ifc.disabled; ifup "$ifc" >/dev/null 2>&1; fi
			uci commit network
			printf '{"ok":true,"msg":"%s: %s"}\n' "$(json_esc "$ifc")" "$( [ "$on" = "0" ] && echo معطّل || echo مفعّل )";;
		iface_mtu)
			ifc="$(sani_word "$(getp iface)")"; mtu="$(sani_int "$(getp mtu)")"
			[ -n "$ifc" ] && [ -n "$mtu" ] || fail "iface_mtu_required"
			uci set network.$ifc.mtu="$mtu"; uci commit network; /etc/init.d/network reload >/dev/null 2>&1
			printf '{"ok":true,"msg":"MTU %s = %s"}\n' "$(json_esc "$ifc")" "$mtu";;

		# ===================== FIREWALL zones / masquerade / restart =====================
		fw_masq)
			z="$(sani_word "$(getp zone)")"; on="$(getp on | tr -cd '01')"; [ -n "$z" ] || fail "no_zone"
			i=0; sec=""
			while uci -q get firewall.@zone[$i] >/dev/null 2>&1; do [ "$(uci -q get firewall.@zone[$i].name)" = "$z" ] && sec="@zone[$i]"; i=$((i+1)); done
			[ -n "$sec" ] || fail "zone_not_found"
			uci set firewall.$sec.masq="${on:-0}"; uci commit firewall; /etc/init.d/firewall reload >/dev/null 2>&1
			printf '{"ok":true,"msg":"masquerade %s: %s"}\n' "$(json_esc "$z")" "${on:-0}";;
		fw_restart)
			/etc/init.d/firewall restart >/dev/null 2>&1
			printf '{"ok":true,"msg":"أُعيد تشغيل الجدار الناري"}\n';;

		# ===================== CLIENT block / unblock (by MAC) =====================
		client_block)
			mac="$(getp mac | tr -cd 'A-Fa-f0-9:' | cut -c1-17)"; [ -n "$mac" ] || fail "no_mac"
			id="blk_$(printf '%s' "$mac" | tr -cd 'A-Fa-f0-9')"
			uci set firewall.$id=rule; uci set firewall.$id.name="kt-block-$mac"
			uci set firewall.$id.src='lan'; uci set firewall.$id.src_mac="$mac"
			uci set firewall.$id.dest='*'; uci set firewall.$id.target='REJECT'
			uci commit firewall; /etc/init.d/firewall reload >/dev/null 2>&1
			printf '{"ok":true,"msg":"حُظر %s من الإنترنت"}\n' "$(json_esc "$mac")";;
		client_unblock)
			mac="$(getp mac | tr -cd 'A-Fa-f0-9:' | cut -c1-17)"; [ -n "$mac" ] || fail "no_mac"
			id="blk_$(printf '%s' "$mac" | tr -cd 'A-Fa-f0-9')"
			uci -q delete firewall.$id; uci commit firewall; /etc/init.d/firewall reload >/dev/null 2>&1
			printf '{"ok":true,"msg":"رُفع الحظر عن %s"}\n' "$(json_esc "$mac")";;

		# ===================== NTP servers =====================
		ntp_set)
			s1="$(printf '%s' "$(getp ntp1)" | tr -cd 'A-Za-z0-9._-' | cut -c1-64)"
			s2="$(printf '%s' "$(getp ntp2)" | tr -cd 'A-Za-z0-9._-' | cut -c1-64)"
			uci -q get system.ntp >/dev/null 2>&1 || uci set system.ntp=timeserver
			uci -q delete system.ntp.server
			[ -n "$s1" ] && uci add_list system.ntp.server="$s1"
			[ -n "$s2" ] && uci add_list system.ntp.server="$s2"
			uci set system.ntp.enabled='1'; uci set system.ntp.enable_server='0'
			uci commit system; /etc/init.d/sysntpd restart >/dev/null 2>&1
			printf '{"ok":true,"msg":"خوادم NTP محدّثة"}\n';;

		# ===================== DSA: choose WAN port =====================
		wan_port)
			pt="$(sani_word "$(getp port)")"; [ -n "$pt" ] || fail "no_port"
			[ -e "/sys/class/net/$pt" ] || fail "port_not_found"
			uci set network.wan.device="$pt"; uci -q set network.wan6.device="$pt"; uci commit network
			/etc/init.d/network reload >/dev/null 2>&1; ifup wan >/dev/null 2>&1
			printf '{"ok":true,"msg":"منفذ WAN = %s"}\n' "$(json_esc "$pt")";;

		*) fail "unknown_action";;
	esac
	exit 0
fi

# ---------- read-only data ops ----------
case "$OP" in
	summary)
		BRD="$(ubus call system board 2>/dev/null)"
		INF="$(ubus call system info 2>/dev/null)"
		gv(){ printf '%s' "$1" | jsonfilter -e "$2" 2>/dev/null; }
		model="$(gv "$BRD" '@.model')"; host="$(gv "$BRD" '@.hostname')"
		kern="$(gv "$BRD" '@.kernel')"; rel="$(gv "$BRD" '@.release.description')"
		up="$(gv "$INF" '@.uptime')"; l1="$(gv "$INF" '@.load[0]')"
		mt="$(gv "$INF" '@.memory.total')"; mf="$(gv "$INF" '@.memory.free')"
		mb="$(gv "$INF" '@.memory.buffered')"
		ncpu="$(grep -c '^processor' /proc/cpuinfo 2>/dev/null)"; [ -n "$ncpu" ] || ncpu=1
		ovl="$(df -k /overlay 2>/dev/null | awk 'NR==2{print $2","$3}')"; [ -n "$ovl" ] || ovl="$(df -k / 2>/dev/null | awk 'NR==2{print $2","$3}')"
		fs_total="${ovl%,*}"; fs_used="${ovl#*,}"
		printf '{"ok":true,"model":"%s","host":"%s","kernel":"%s","release":"%s","uptime":%s,"load":%s,"mem_total":%s,"mem_free":%s,"mem_buf":%s,"ncpu":%s,"fs_total":%s,"fs_used":%s}\n' \
			"$(json_esc "$model")" "$(json_esc "$host")" "$(json_esc "$kern")" "$(json_esc "$rel")" \
			"${up:-0}" "${l1:-0}" "${mt:-0}" "${mf:-0}" "${mb:-0}" "${ncpu:-1}" "${fs_total:-0}" "${fs_used:-0}";;
	wan)
		S="$(ubus call network.interface.wan status 2>/dev/null)"
		gv(){ printf '%s' "$S" | jsonfilter -e "$1" 2>/dev/null; }
		up="$(gv '@.up')"; proto="$(gv '@.proto')"; dev="$(gv '@.l3_device')"
		ip="$(gv '@["ipv4-address"][0].address')"; mask="$(gv '@["ipv4-address"][0].mask')"
		gw="$(gv '@.route[0].nexthop')"; upt="$(gv '@.uptime')"; dns="$(gv '@["dns-server"][0]')"
		wandev="$(uci -q get network.wan.device || uci -q get network.wan.ifname)"
		vid="$(printf '%s' "$wandev" | sed -n 's/.*\.\([0-9]*\)$/\1/p')"
		printf '{"ok":true,"up":%s,"proto":"%s","device":"%s","ip":"%s","mask":%s,"gateway":"%s","dns":"%s","uptime":%s,"vlan":"%s"}\n' \
			"${up:-false}" "$(json_esc "$proto")" "$(json_esc "$dev")" "$(json_esc "$ip")" \
			"${mask:-0}" "$(json_esc "$gw")" "$(json_esc "$dns")" "${upt:-0}" "$(json_esc "$vid")";;
	lan)
		ip="$(uci -q get network.lan.ipaddr)"; mask="$(uci -q get network.lan.netmask)"
		ign="$(uci -q get dhcp.lan.ignore)"; st="$(uci -q get dhcp.lan.start)"
		lim="$(uci -q get dhcp.lan.limit)"; lt="$(uci -q get dhcp.lan.leasetime)"
		dh=true; [ "$ign" = "1" ] && dh=false
		printf '{"ok":true,"ip":"%s","mask":"%s","dhcp":%s,"start":"%s","limit":"%s","lease":"%s"}\n' \
			"$(json_esc "$ip")" "$(json_esc "$mask")" "$dh" "$(json_esc "${st:-100}")" "$(json_esc "${lim:-150}")" "$(json_esc "${lt:-12h}")";;
	netmode)
		dis="$(uci -q get network.wan.disabled)"
		# AP = WAN bridged into LAN. DHCP on/off is an INDEPENDENT toggle now
		# (off by default), so it no longer flips the detected mode.
		mode="router"; [ "$dis" = "1" ] && mode="ap"
		printf '{"ok":true,"mode":"%s"}\n' "$mode";;
	wifi)
		out=""; first=1
		for dev in $(iwinfo 2>/dev/null | sed -n 's/^\([A-Za-z0-9._-]*\) *ESSID:.*/\1/p'); do
			info="$(iwinfo "$dev" info 2>/dev/null)"
			essid="$(printf '%s' "$info" | sed -n 's/.*ESSID: "\(.*\)".*/\1/p' | head -1)"
			chan="$(printf '%s' "$info" | sed -n 's/.*Channel: \([0-9]*\).*/\1/p' | head -1)"
			txp="$(printf '%s' "$info" | sed -n 's/.*Tx-Power: \([0-9]*\).*/\1/p' | head -1)"
			sig="$(printf '%s' "$info" | sed -n 's/.*Signal: \(-\{0,1\}[0-9]*\).*/\1/p' | head -1)"
			enc="$(printf '%s' "$info" | sed -n 's/.*Encryption: \(.*\)/\1/p' | head -1)"
			modev="$(printf '%s' "$info" | sed -n 's/.*Mode: \([A-Za-z/]*\).*/\1/p' | head -1)"
			cnt="$(iwinfo "$dev" assoclist 2>/dev/null | grep -c 'SNR')"
			band="2.4 GHz"; [ -n "$chan" ] && [ "$chan" -gt 14 ] 2>/dev/null && band="5 GHz"
			[ "$first" -eq 1 ] || out="$out,"; first=0
			out="$out$(printf '{"dev":"%s","essid":"%s","channel":%s,"band":"%s","txpower":%s,"signal":%s,"enc":"%s","mode":"%s","clients":%s}' \
				"$(json_esc "$dev")" "$(json_esc "$essid")" "${chan:-0}" "$band" "${txp:-0}" "${sig:-0}" "$(json_esc "$enc")" "$(json_esc "$modev")" "${cnt:-0}")"
		done
		printf '{"ok":true,"radios":[%s]}\n' "$out";;
	wifi_radios)
		out=""; first=1
		for r in $(uci show wireless 2>/dev/null | sed -n 's/^wireless\.\([^.=]*\)=wifi-device/\1/p'); do
			band="$(uci -q get wireless.$r.band)"; ch="$(uci -q get wireless.$r.channel)"
			ht="$(uci -q get wireless.$r.htmode)"; cc="$(uci -q get wireless.$r.country)"
			tp="$(uci -q get wireless.$r.txpower)"; dis="$(uci -q get wireless.$r.disabled)"
			ssid=""; mode="ap"; hidden="0"
			s="$(wifi_iface_for "$r")"
			if [ -n "$s" ]; then
				mode="$(uci -q get wireless.$s.mode)"; hidden="$(uci -q get wireless.$s.hidden)"
				ssid="$(uci -q get wireless.$s.ssid)"; [ -z "$ssid" ] && ssid="$(uci -q get wireless.$s.mesh_id)"
				[ "$(uci -q get wireless.$s.wds)" = "1" ] && [ "$mode" = "ap" ] && mode="ap-wds"
			fi
			en=true; [ "$dis" = "1" ] && en=false
			[ "$first" -eq 1 ] || out="$out,"; first=0
			out="$out$(printf '{"radio":"%s","band":"%s","channel":"%s","htmode":"%s","country":"%s","ssid":"%s","mode":"%s","hidden":"%s","txpower":"%s","enabled":%s,"iface":"%s"}' \
				"$(json_esc "$r")" "$(json_esc "$band")" "$(json_esc "$ch")" "$(json_esc "$ht")" "$(json_esc "$cc")" \
				"$(json_esc "$ssid")" "$(json_esc "${mode:-ap}")" "$(json_esc "${hidden:-0}")" "$(json_esc "$tp")" "$en" "$(json_esc "$s")")"
		done
		printf '{"ok":true,"radios":[%s]}\n' "$out";;
	ports)
		out=""; first=1
		raw="$(swconfig dev switch0 show 2>/dev/null)"
		if [ -n "$raw" ]; then
			while IFS= read -r line; do
				case "$line" in
					*"link: port:"*)
						pn="$(printf '%s' "$line" | sed -n 's/.*port:\([0-9]*\).*/\1/p')"
						st=down; case "$line" in *"link:up"*) st=up;; esac
						sp="$(printf '%s' "$line" | sed -n 's/.*speed:\([0-9]*\)baseT.*/\1/p')"
						[ "$first" -eq 1 ] || out="$out,"; first=0
						out="$out$(printf '{"name":"port%s","link":"%s","speed":%s}' "${pn:-0}" "$st" "${sp:-0}")"
						;;
				esac
			done <<-EOF
			$raw
			EOF
		fi
		if [ -z "$out" ]; then
			for p in wan lan1 lan2 lan3 lan4; do
				[ -e "/sys/class/net/$p" ] || continue
				st="$(cat /sys/class/net/$p/operstate 2>/dev/null)"
				sp="$(cat /sys/class/net/$p/speed 2>/dev/null)"; case "$sp" in ''|*[!0-9]*) sp=0;; esac
				lk=down; [ "$st" = "up" ] && lk=up
				[ "$first" -eq 1 ] || out="$out,"; first=0
				out="$out$(printf '{"name":"%s","link":"%s","speed":%s}' "$p" "$lk" "${sp:-0}")"
			done
		fi
		printf '{"ok":true,"ports":[%s]}\n' "$out";;
	clients)
		out=""; first=1
		if [ -f /tmp/dhcp.leases ]; then
			while read -r exp mac ip name rest; do
				[ -n "$mac" ] || continue
				[ "$first" -eq 1 ] || out="$out,"; first=0
				out="$out$(printf '{"mac":"%s","ip":"%s","name":"%s"}' "$(json_esc "$mac")" "$(json_esc "$ip")" "$(json_esc "${name:-*}")")"
			done < /tmp/dhcp.leases
		fi
		printf '{"ok":true,"clients":[%s]}\n' "$out";;
	health)
		pl(){ printf '%s' "$1" | sed -n 's/.*, \([0-9]*\)% packet loss.*/\1/p' | head -1; }
		rt(){ printf '%s' "$1" | sed -n 's#.* = [0-9.]*/\([0-9.]*\)/.*#\1#p' | head -1; }
		a="$(ping -c2 -W1 1.1.1.1 2>/dev/null)"; b="$(ping -c2 -W1 8.8.8.8 2>/dev/null)"
		la="$(pl "$a")"; ra="$(rt "$a")"; lb="$(pl "$b")"; rb="$(rt "$b")"
		mw="$(mwan3 status 2>/dev/null | grep -c 'is online')"
		printf '{"ok":true,"cf":{"loss":%s,"rtt":%s},"goog":{"loss":%s,"rtt":%s},"mwan_online":%s}\n' \
			"${la:-100}" "${ra:-0}" "${lb:-100}" "${rb:-0}" "${mw:-0}";;
	traffic)
		out=""; first=1
		while IFS= read -r line; do
			case "$line" in
				*:*)
					name="$(printf '%s' "$line" | sed 's/^[[:space:]]*//; s/:.*//')"
					case "$name" in lo|''|Inter-*|*face*) continue;; esac
					rest="${line#*:}"
					rx="$(printf '%s' "$rest" | awk '{print $1+0}')"
					tx="$(printf '%s' "$rest" | awk '{print $9+0}')"
					[ "$first" -eq 1 ] || out="$out,"; first=0
					out="$out$(printf '{"if":"%s","rx":%s,"tx":%s}' "$(json_esc "$name")" "${rx:-0}" "${tx:-0}")"
					;;
			esac
		done < /proc/net/dev
		printf '{"ok":true,"ts":%s,"ifaces":[%s]}\n' "$(date +%s)" "$out";;
	system)
		host="$(uci -q get system.@system[0].hostname)"; tz="$(uci -q get system.@system[0].timezone)"
		now="$(date '+%Y-%m-%d %H:%M:%S')"
		rel="$(sed -n "s/^DISTRIB_DESCRIPTION='\(.*\)'/\1/p" /etc/openwrt_release 2>/dev/null)"
		rootpw="$(awk -F: '/^root:/{print $2}' /etc/shadow 2>/dev/null)"
		hp=true; case "$rootpw" in ''|'!'|'*'|'!*') hp=false;; esac
		ntp="$(uci -q get system.ntp.server | tr '\n' ' ')"
		printf '{"ok":true,"host":"%s","tz":"%s","time":"%s","release":"%s","has_password":%s,"ntp":"%s"}\n' \
			"$(json_esc "$host")" "$(json_esc "$tz")" "$(json_esc "$now")" "$(json_esc "$rel")" "$hp" "$(json_esc "$ntp")";;
	logs)
		# optional service filter: wifi|firewall|dhcp|pppoe (grep on logread)
		flt="$(getp filter | tr -cd 'a-z]|[')"
		case "$flt" in
			wifi)     pat='hostapd\|wlan\|ath9k\|ath10k\|wpa\|80211';;
			firewall) pat='firewall\|nft\|DROP\|REJECT';;
			dhcp)     pat='dnsmasq\|DHCP\|dhcp';;
			pppoe)    pat='ppp\|pppoe\|pppd\|chat';;
			*)        pat='';;
		esac
		if [ -n "$pat" ]; then sys="$(logread 2>/dev/null | grep -i "$pat" | tail -n 160 | base64 2>/dev/null | tr -d '\n')"
		else sys="$(logread 2>/dev/null | tail -n 160 | base64 2>/dev/null | tr -d '\n')"; fi
		ker="$(dmesg 2>/dev/null | tail -n 100 | base64 2>/dev/null | tr -d '\n')"
		printf '{"ok":true,"sys":"%s","ker":"%s"}\n' "$sys" "$ker";;
	power)
		mount -t debugfs debugfs /sys/kernel/debug 2>/dev/null
		out=""; first=1
		for r in $(uci show wireless 2>/dev/null | sed -n 's/^wireless\.\([^.=]*\)=wifi-device/\1/p'); do
			idx="$(printf '%s' "$r" | tr -cd '0-9')"
			band="$(uci -q get wireless.$r.band)"; req="$(uci -q get wireless.$r.txpower)"
			# resolve the LIVE ap iface + its REAL phy via ubus (phy index != radio index on this board)
			dev="$(ubus call network.wireless status 2>/dev/null | jsonfilter -e "@.$r.interfaces[0].ifname" 2>/dev/null)"
			[ -n "$dev" ] || dev="$(iwinfo 2>/dev/null | sed -n 's/^\([A-Za-z0-9._-]*\) *ESSID:.*/\1/p' | sed -n "$((idx+1))p")"
			phyn="$(cat /sys/class/net/$dev/phy80211/index 2>/dev/null)"; [ -n "$phyn" ] || phyn="$idx"
			ap="$(iwinfo "$dev" info 2>/dev/null | sed -n 's/.*Tx-Power: \([0-9]*\).*/\1/p' | head -1)"
			lim="$(iw phy "phy$phyn" info 2>/dev/null | sed -n 's/.*MHz.*(\([0-9]*\)\.[0-9]* dBm).*/\1/p' | sort -rn | head -1)"
			up="$(cat /sys/kernel/debug/ieee80211/phy$phyn/ath10k/*user* /sys/kernel/debug/ieee80211/phy$phyn/ath9k/*user* 2>/dev/null | head -1 | tr -cd '0-9')"
			[ -n "$up" ] || up="$(cat /sys/kernel/debug/ieee80211/phy$phyn/user_power 2>/dev/null | tr -cd '0-9')"
			nd="$(cat /sys/kernel/debug/ieee80211/phy$phyn/netdev:$dev/txpower 2>/dev/null | tr -cd '0-9')"
			[ "$first" -eq 1 ] || out="$out,"; first=0
			out="$out$(printf '{"radio":"%s","band":"%s","requested":"%s","applied":"%s","phy_limit":"%s","user_power":"%s","netdev":"%s"}' \
				"$(json_esc "$r")" "$(json_esc "$band")" "$(json_esc "${req:-?}")" "$(json_esc "${ap:-?}")" "$(json_esc "${lim:-?}")" "$(json_esc "${up:-?}")" "$(json_esc "${nd:-?}")")"
		done
		printf '{"ok":true,"radios":[%s]}\n' "$out";;
	scan)
		out=""; first=1
		for dev in $(iwinfo 2>/dev/null | sed -n 's/^\([A-Za-z0-9._-]*\) *ESSID:.*/\1/p'); do
			cells="$(iwinfo "$dev" scan 2>/dev/null | awk '
				BEGIN{RS="Cell ";n=0}
				NR>1{
					essid="";ch="";sig="";enc="";
					m=split($0,L,"\n");
					for(i=1;i<=m;i++){
						if(L[i] ~ /ESSID:/){t=L[i];sub(/.*ESSID: "/,"",t);sub(/".*/,"",t);essid=t}
						else if(L[i] ~ /Channel:/){t=L[i];sub(/.*Channel: /,"",t);sub(/[^0-9].*/,"",t);ch=t}
						else if(L[i] ~ /Signal:/){t=L[i];sub(/.*Signal: /,"",t);sub(/ .*/,"",t);sig=t}
						else if(L[i] ~ /Encryption:/){t=L[i];sub(/.*Encryption: /,"",t);sig=sig;enc=t}
					}
					gsub(/[\\"]/,"",essid); gsub(/[\\"]/,"",enc); gsub(/\r/,"",enc);
					if(ch!=""){ printf "%s{\"essid\":\"%s\",\"ch\":\"%s\",\"sig\":\"%s\",\"enc\":\"%s\"}", (n++?",":""), essid,ch,sig,substr(enc,1,24) }
				}')"
			[ -n "$cells" ] && { [ "$first" -eq 1 ] || out="$out,"; first=0; out="$out$cells"; }
		done
		printf '{"ok":true,"nets":[%s]}\n' "$out";;
	super_status)
		dn=false; [ -f /tmp/kt412-sc-done ] && dn=true
		rep="$(ls -t /tmp/kt412-super-check-*/report.txt 2>/dev/null | head -1)"
		b64="$(tail -n 250 "$rep" 2>/dev/null | base64 2>/dev/null | tr -d '\n')"
		bundle="$(ls -t /tmp/kt412-super-check-*.tar.gz 2>/dev/null | head -1)"
		printf '{"ok":true,"done":%s,"report":"%s","bundle":"%s"}\n' "$dn" "$b64" "$(json_esc "$bundle")";;
	vlan_list)
		out=""; first=1; i=0
		while uci -q get network.@bridge-vlan[$i] >/dev/null 2>&1; do
			v="$(uci -q get network.@bridge-vlan[$i].vlan)"
			ports="$(uci -q get network.@bridge-vlan[$i].ports | tr '\n' ' ')"
			ip="$(uci -q get network.vlan$v.ipaddr)"
			dh=false; uci -q get dhcp.vlan$v >/dev/null 2>&1 && dh=true
			[ "$first" -eq 1 ] || out="$out,"; first=0
			out="$out$(printf '{"vid":"%s","ports":"%s","ip":"%s","dhcp":%s}' "$v" "$(json_esc "$ports")" "$(json_esc "$ip")" "$dh")"
			i=$((i+1))
		done
		printf '{"ok":true,"vlans":[%s]}\n' "$out";;
	vlan_export)
		d="$( { uci show network 2>/dev/null | grep -E 'bridge-vlan|\.vlan[0-9]'; uci show dhcp 2>/dev/null | grep 'vlan[0-9]'; uci show firewall 2>/dev/null | grep 'vlan[0-9]'; } | base64 2>/dev/null | tr -d '\n')"
		printf '{"ok":true,"config":"%s"}\n' "$d";;
	readfile)
		ff="$(getp f | tr -cd 'A-Za-z-')"
		case "$ff" in
			POWER-REPORT) pp=/root/POWER-REPORT.txt;;
			RF-SOLUTION)  pp=/root/RF-SOLUTION.txt;;
			*) fail "bad_file";;
		esac
		b64="$(base64 < "$pp" 2>/dev/null | tr -d '\n')"
		printf '{"ok":true,"content":"%s"}\n' "$b64";;
	# ===================== DIAGNOSTICS (ping/traceroute/dns) =====================
	diag)
		ty="$(getp type | tr -cd 'a-z')"; tg="$(printf '%s' "$(getp target)" | tr -cd 'A-Za-z0-9._:-' | cut -c1-64)"
		[ -n "$tg" ] || fail "no_target"
		case "$ty" in
			ping)  out="$(ping -c4 -W2 "$tg" 2>&1)";;
			trace) out="$( (traceroute -w2 -m15 "$tg" 2>&1 || busybox traceroute "$tg" 2>&1) | head -25 )";;
			dns)   out="$(nslookup "$tg" 2>&1 | head -20)";;
			*) fail "bad_type";;
		esac
		b="$(printf '%s' "$out" | base64 2>/dev/null | tr -d '\n')"
		printf '{"ok":true,"out":"%s"}\n' "$b";;
	fw_list)
		out=""; first=1
		for s in $(uci show firewall 2>/dev/null | sed -n 's/^firewall\.\(kt_[^.=]*\)=redirect/\1/p'); do
			[ "$s" = "kt_dmz" ] && continue
			nm="$(uci -q get firewall.$s.name)"; sp="$(uci -q get firewall.$s.src_dport)"
			di="$(uci -q get firewall.$s.dest_ip)"; dp="$(uci -q get firewall.$s.dest_port)"; pr="$(uci -q get firewall.$s.proto)"
			key="${s#kt_}"
			[ "$first" -eq 1 ] || out="$out,"; first=0
			out="$out$(printf '{"id":"%s","name":"%s","proto":"%s","sport":"%s","dip":"%s","dport":"%s"}' "$(json_esc "$key")" "$(json_esc "$nm")" "$(json_esc "$pr")" "$(json_esc "$sp")" "$(json_esc "$di")" "$(json_esc "$dp")")"
		done
		dmz="$(uci -q get firewall.kt_dmz.dest_ip)"
		printf '{"ok":true,"rules":[%s],"dmz":"%s"}\n' "$out" "$(json_esc "$dmz")";;
	lease_list)
		out=""; first=1
		for s in $(uci show dhcp 2>/dev/null | sed -n 's/^dhcp\.\(h_[^.=]*\)=host/\1/p'); do
			mac="$(uci -q get dhcp.$s.mac)"; ip="$(uci -q get dhcp.$s.ip)"; nm="$(uci -q get dhcp.$s.name)"
			[ "$first" -eq 1 ] || out="$out,"; first=0
			out="$out$(printf '{"mac":"%s","ip":"%s","name":"%s"}' "$(json_esc "$mac")" "$(json_esc "$ip")" "$(json_esc "$nm")")"
		done
		printf '{"ok":true,"leases":[%s]}\n' "$out";;
	dns_get)
		sec="$(uci show dhcp 2>/dev/null | sed -n 's/^dhcp\.\([^.=]*\)=dnsmasq/\1/p' | head -1)"; [ -n "$sec" ] || sec="@dnsmasq[0]"
		srv="$(uci -q get dhcp.$sec.server | tr '\n' ' ')"; nr="$(uci -q get dhcp.$sec.noresolv)"
		set -- $srv
		printf '{"ok":true,"dns1":"%s","dns2":"%s","force":%s}\n' "$(json_esc "$1")" "$(json_esc "$2")" "$( [ "$nr" = "1" ] && echo true || echo false )";;
	route_list)
		out=""; first=1
		for s in $(uci show network 2>/dev/null | sed -n 's/^network\.\(r_[^.=]*\)=route/\1/p'); do
			tg="$(uci -q get network.$s.target)"; mk="$(uci -q get network.$s.netmask)"; gw="$(uci -q get network.$s.gateway)"; ifc="$(uci -q get network.$s.interface)"
			[ "$first" -eq 1 ] || out="$out,"; first=0
			out="$out$(printf '{"target":"%s","mask":"%s","gw":"%s","iface":"%s"}' "$(json_esc "$tg")" "$(json_esc "$mk")" "$(json_esc "$gw")" "$(json_esc "$ifc")")"
		done
		printf '{"ok":true,"routes":[%s]}\n' "$out";;
	svc_list)
		out=""; first=1
		for s in dnsmasq firewall network odhcpd uhttpd cron dropbear sqm mwan3 ddns miniupnpd adblock nlbwmon sysntpd; do
			[ -x "/etc/init.d/$s" ] || continue
			en=false; /etc/init.d/$s enabled 2>/dev/null && en=true
			rn=false; pgrep -f "$s" >/dev/null 2>&1 && rn=true
			[ "$first" -eq 1 ] || out="$out,"; first=0
			out="$out$(printf '{"name":"%s","enabled":%s,"running":%s}' "$s" "$en" "$rn")"
		done
		printf '{"ok":true,"services":[%s]}\n' "$out";;
	cron_get)
		b="$(base64 < /etc/crontabs/root 2>/dev/null | tr -d '\n')"
		printf '{"ok":true,"body":"%s"}\n' "$b";;
	pkg_list)
		lst="$( (apk list --installed 2>/dev/null | awk '{print $1}' | sed 's/-[0-9].*//' || opkg list-installed 2>/dev/null | awk '{print $1}') | sort -u | head -400 )"
		b="$(printf '%s' "$lst" | base64 2>/dev/null | tr -d '\n')"
		mgr="opkg"; command -v apk >/dev/null 2>&1 && mgr="apk"
		printf '{"ok":true,"mgr":"%s","list":"%s"}\n' "$mgr" "$b";;
	svc_states)
		up="$(uci -q get upnpd.config.enabled)"; ab="$(uci -q get adblock.global.adb_enabled)"; dd="$(uci -q get ddns.kt.enabled)"
		ddm="$(uci -q get ddns.kt.domain)"
		gw=false; uci -q get network.guest >/dev/null 2>&1 && gw=true
		printf '{"ok":true,"upnp":%s,"adblock":%s,"ddns":%s,"ddns_domain":"%s","guest":%s}\n' \
			"$( [ "$up" = "1" ] && echo true || echo false )" \
			"$( [ "$ab" = "1" ] && echo true || echo false )" \
			"$( [ "$dd" = "1" ] && echo true || echo false )" \
			"$(json_esc "$ddm")" "$gw";;
	backup_make)
		b="$(tar czf - -C / etc/config 2>/dev/null | base64 2>/dev/null | tr -d '\n')"
		printf '{"ok":true,"data":"%s"}\n' "$b";;

	# ===================== LIVE MONITOR (LuCI Status parity) =====================
	conns)
		cnt="$(cat /proc/sys/net/netfilter/nf_conntrack_count 2>/dev/null)"
		mx="$(cat /proc/sys/net/netfilter/nf_conntrack_max 2>/dev/null)"
		lst="$(awk '{p="";s="";d="";for(i=1;i<=NF;i++){if($i ~ /^(tcp|udp|icmp)$/&&p=="")p=$i;if($i ~ /^src=/&&s=="")s=substr($i,5);if($i ~ /^dst=/&&d=="")d=substr($i,5)} if(s!=""&&d!="")print p" "s" -> "d}' /proc/net/nf_conntrack 2>/dev/null | sort | uniq -c | sort -rn | head -25)"
		b="$(printf '%s' "$lst" | base64 2>/dev/null | tr -d '\n')"
		printf '{"ok":true,"count":"%s","max":"%s","top":"%s"}\n' "${cnt:-0}" "${mx:-0}" "$b";;
	routes)
		b="$( { echo '== IPv4 =='; ip route 2>/dev/null; echo; echo '== IPv6 =='; ip -6 route 2>/dev/null | head -20; } | head -60 | base64 2>/dev/null | tr -d '\n')"
		printf '{"ok":true,"out":"%s"}\n' "$b";;
	stations)
		txt=""
		for i in $(iwinfo 2>/dev/null | sed -n 's/^\([A-Za-z0-9._-]*\) *ESSID:.*/\1/p'); do
			txt="$txt== $i ==
$(iwinfo "$i" assoclist 2>/dev/null)
"
		done
		b="$(printf '%s' "$txt" | base64 2>/dev/null | tr -d '\n')"
		printf '{"ok":true,"out":"%s"}\n' "$b";;
	procs)
		b="$( (top -bn1 2>/dev/null | head -24 || ps w 2>/dev/null | head -24) | base64 2>/dev/null | tr -d '\n')"
		printf '{"ok":true,"out":"%s"}\n' "$b";;
	usage)
		b="$( (nlbw -c show 2>/dev/null | head -30 || echo 'nlbwmon لم يجمع بيانات بعد') | base64 2>/dev/null | tr -d '\n')"
		printf '{"ok":true,"out":"%s"}\n' "$b";;

	# ===================== INTERFACES overview =====================
	ifaces)
		out=""; first=1
		for s in $(uci show network 2>/dev/null | sed -n 's/^network\.\([^.=]*\)=interface/\1/p'); do
			case "$s" in loopback) continue;; esac
			dev="$(uci -q get network.$s.device)"
			[ -n "$dev" ] || dev="$(ubus call network.interface.$s status 2>/dev/null | jsonfilter -e '@.l3_device' 2>/dev/null)"
			proto="$(uci -q get network.$s.proto)"; mtu="$(cat /sys/class/net/$dev/mtu 2>/dev/null)"
			mac="$(cat /sys/class/net/$dev/address 2>/dev/null)"; oper="$(cat /sys/class/net/$dev/operstate 2>/dev/null)"
			rx="$(cat /sys/class/net/$dev/statistics/rx_bytes 2>/dev/null)"; tx="$(cat /sys/class/net/$dev/statistics/tx_bytes 2>/dev/null)"
			ip="$(ubus call network.interface.$s status 2>/dev/null | jsonfilter -e '@["ipv4-address"][0].address' 2>/dev/null)"
			dis="$(uci -q get network.$s.disabled)"; en=true; [ "$dis" = "1" ] && en=false
			[ "$first" -eq 1 ] || out="$out,"; first=0
			out="$out$(printf '{"name":"%s","device":"%s","proto":"%s","ip":"%s","mtu":"%s","mac":"%s","link":"%s","rx":"%s","tx":"%s","enabled":%s}' "$(json_esc "$s")" "$(json_esc "$dev")" "$(json_esc "$proto")" "$(json_esc "$ip")" "$(json_esc "$mtu")" "$(json_esc "$mac")" "$(json_esc "$oper")" "${rx:-0}" "${tx:-0}" "$en")"
		done
		printf '{"ok":true,"ifaces":[%s]}\n' "$out";;

	# ===================== FIREWALL zones =====================
	fw_zones)
		out=""; first=1; i=0
		while uci -q get firewall.@zone[$i] >/dev/null 2>&1; do
			nm="$(uci -q get firewall.@zone[$i].name)"; inp="$(uci -q get firewall.@zone[$i].input)"
			fwd="$(uci -q get firewall.@zone[$i].forward)"; outp="$(uci -q get firewall.@zone[$i].output)"
			mq="$(uci -q get firewall.@zone[$i].masq)"; net="$(uci -q get firewall.@zone[$i].network | tr '\n' ' ')"
			[ "$first" -eq 1 ] || out="$out,"; first=0
			out="$out$(printf '{"name":"%s","input":"%s","output":"%s","forward":"%s","masq":"%s","network":"%s"}' "$(json_esc "$nm")" "$(json_esc "$inp")" "$(json_esc "$outp")" "$(json_esc "$fwd")" "$(json_esc "${mq:-0}")" "$(json_esc "$net")")"
			i=$((i+1))
		done
		printf '{"ok":true,"zones":[%s]}\n' "$out";;

	# ===================== BLOCKED clients =====================
	blocklist)
		out=""; first=1
		for s in $(uci show firewall 2>/dev/null | sed -n 's/^firewall\.\(blk_[^.=]*\)=rule/\1/p'); do
			mac="$(uci -q get firewall.$s.src_mac)"
			[ "$first" -eq 1 ] || out="$out,"; first=0
			out="$out$(printf '{"mac":"%s"}' "$(json_esc "$mac")")"
		done
		printf '{"ok":true,"blocked":[%s]}\n' "$out";;

	# ===================== SPEED TEST (download) =====================
	speedtest)
		url="http://speedtest.tele2.net/10MB.zip"
		sp="$(curl -s -m25 -o /dev/null -w '%{speed_download}' "$url" 2>/dev/null)"
		[ -n "$sp" ] && [ "$sp" != "0" ] || { wget -q -O /dev/null "$url" 2>/dev/null; sp=0; }
		printf '{"ok":true,"bps":"%s"}\n' "${sp:-0}";;

	# ===================== UNIFIED DEVICES (bridge: DHCP + ARP + WiFi) =====================
	devices)
		L=/tmp/kt_l.$$; S=/tmp/kt_s.$$; N=/tmp/kt_n.$$; : >"$L"; : >"$S"; : >"$N"
		# DHCP leases:  mac<TAB>ip<TAB>name
		[ -f /tmp/dhcp.leases ] && awk '{print tolower($2)"\t"$3"\t"$4}' /tmp/dhcp.leases >"$L" 2>/dev/null
		# ARP/neighbour table (every L2 device on the bridge): mac<TAB>dev<TAB>ip
		ip neigh show 2>/dev/null | awk '/lladdr/{print tolower($5)"\t"$3"\t"$1}' >"$N" 2>/dev/null
		# WiFi stations:  mac<TAB>sig<TAB>rxrate<TAB>txrate<TAB>band<TAB>conn(sec)<TAB>bytes(rx+tx)
		for i in $(iwinfo 2>/dev/null | sed -n 's/^\([A-Za-z0-9._-]*\) *ESSID:.*/\1/p'); do
			bnd=2g; iwinfo "$i" info 2>/dev/null | grep -qi '5\.[0-9]* GHz' && bnd=5g
			iw dev "$i" station dump 2>/dev/null | awk -v b="$bnd" '
				function emit(){ if(mac!="") print mac"\t"sig"\t"rxr"\t"txr"\t"b"\t"conn"\t"(rxb+txb); mac="";sig="";rxr="";txr="";conn="";rxb=0;txb=0 }
				/^Station /{ emit(); mac=tolower($2) }
				/signal:/{ sig=$2 }
				/rx bytes:/{ rxb=$3 }
				/tx bytes:/{ txb=$3 }
				/rx bitrate:/{ rxr=$3 }
				/tx bitrate:/{ txr=$3 }
				/connected time:/{ conn=$3 }
				END{ emit() }' >>"$S" 2>/dev/null
		done
		macs="$( { cut -f1 "$L"; cut -f1 "$S"; cut -f1 "$N"; } 2>/dev/null | sort -u | grep -E '^[0-9a-f:]{17}$' )"
		out=""; first=1
		for m in $macs; do
			ip="$(awk -F'\t' -v m="$m" '$1==m{print $2;exit}' "$L")"; nm="$(awk -F'\t' -v m="$m" '$1==m{print $3;exit}' "$L")"
			[ -n "$ip" ] || ip="$(awk -F'\t' -v m="$m" '$1==m{print $3;exit}' "$N")"
			dev="$(awk -F'\t' -v m="$m" '$1==m{print $2;exit}' "$N")"
			sig="$(awk -F'\t' -v m="$m" '$1==m{print $2;exit}' "$S")"; rxr="$(awk -F'\t' -v m="$m" '$1==m{print $3;exit}' "$S")"
			txr="$(awk -F'\t' -v m="$m" '$1==m{print $4;exit}' "$S")"; band="$(awk -F'\t' -v m="$m" '$1==m{print $5;exit}' "$S")"
			conn="$(awk -F'\t' -v m="$m" '$1==m{print $6;exit}' "$S")"; byt="$(awk -F'\t' -v m="$m" '$1==m{print $7;exit}' "$S")"
			kind="lan"; [ -n "$band" ] && kind="wifi$band"
			case "$nm" in ''|'*') nm="";; esac
			[ "$first" -eq 1 ] || out="$out,"; first=0
			out="$out$(printf '{"mac":"%s","ip":"%s","name":"%s","kind":"%s","signal":"%s","rxrate":"%s","txrate":"%s","dev":"%s","conn":"%s","bytes":"%s"}' \
				"$m" "$(json_esc "$ip")" "$(json_esc "$nm")" "$kind" "$(json_esc "$sig")" "$(json_esc "$rxr")" "$(json_esc "$txr")" "$(json_esc "$dev")" "$(json_esc "${conn:-}")" "${byt:-0}")"
		done
		b24="$(awk -F'\t' '$5=="2g"{s+=$7}END{printf "%.0f", s+0}' "$S" 2>/dev/null)"
		b5="$(awk -F'\t' '$5=="5g"{s+=$7}END{printf "%.0f", s+0}' "$S" 2>/dev/null)"
		rm -f "$L" "$S" "$N"
		printf '{"ok":true,"band24":%s,"band5":%s,"devices":[%s]}\n' "${b24:-0}" "${b5:-0}" "$out";;

	# ===================== SMART AP HEALTH / SELF-HEAL (read-only) =====================
	selfheal)
		t="$( { echo '=== Smart AP — الصحة والشفاء الذاتي ==='; uptime 2>/dev/null
			echo; echo '## conntrack (المستخدم/الأقصى)'
			echo "$(cat /proc/sys/net/netfilter/nf_conntrack_count 2>/dev/null)/$(cat /proc/sys/net/netfilter/nf_conntrack_max 2>/dev/null)"
			echo; echo '## الذاكرة (MB)'; free -m 2>/dev/null | head -2
			echo; echo '## الراديوهات'; iwinfo 2>/dev/null | grep -iE 'ESSID|Tx-Power|Mode|Bit Rate' | head -12
			echo; echo '## أحداث الشفاء الذاتي (آخر 30)'
			logread 2>/dev/null | grep smartap-wd | tail -30 || true
			logread 2>/dev/null | grep smartap-wd >/dev/null 2>&1 || echo '(لا أحداث — الجهاز مستقر، لم يحتج تدخّلاً)'
			echo; echo '## watchdog العتاد (procd)'; ubus call system watchdog 2>/dev/null
			echo; echo '## مدّة عمل الخدمات الحرجة'
			for s in dnsmasq uhttpd rpcd netifd; do echo -n "$s: "; pidof "$s" >/dev/null 2>&1 && echo يعمل || echo متوقف; done
		} | base64 2>/dev/null | tr -d '\n')"
		printf '{"ok":true,"out":"%s"}\n' "$t";;

	*)
		fail "unknown_op";;
esac
exit 0
